export DBSQL_VERSION="$(sh -c '. ./dist/RELEASE; echo $DBSQL_VERSION')"
export DBSQL_VERSION_STRING="$(sh -c '. ./dist/RELEASE; echo $DBSQL_VERSION_STRING')"

#dotenv
watch_file devShell.nix shell.nix flake.nix
use flake || use nix
use project_steering c
# History on origin is rewritten deliberately (2026-10: master replaced by
# the 3.53 rebuild); --force-with-lease only, never bare --force.
use git_policy allow-force-push
use project_mcp context7
