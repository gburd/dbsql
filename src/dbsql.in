*************************************************************************
** This header file defines the interface that the dbsql library
** presents to client programs.  If a C-function, structure, datatype,
** or constant definition does not appear in this file, then it is
** not a published API of dbsql, is subject to change without
** notice, and should not be referenced by programs that use dbsql.
**
** Some of the definitions that are in this file are marked as
** "experimental".  Experimental interfaces are normally new
** features recently added to dbsql.  We do not anticipate changes
** to experimental interfaces but reserve the right to make minor changes
** if experience from use "in the wild" suggest such changes are prudent.
**
** The official C-language API documentation for dbsql is derived
** from comments in this file.  This file is the authoritative source
** on how dbsql interfaces are supposed to operate.
**
** The name of this file under configuration management is "sqlite.h.in".
** The makefile makes some minor changes to this file (such as inserting
** the version number) and changes its name to "DBSQL.h" as
** part of the build process.
*/
#ifndef DBSQL_H
#define DBSQL_H
#include <stdarg.h>     /* Needed for the definition of va_list */
#include <sys/types.h>	/* Needed for int64_t, u_int64_t */
#include <stdint.h>

/*
** Make sure we can call this stuff from C++.
*/
#ifdef __cplusplus
extern "C" {
#endif


/*
** Facilitate override of interface linkage and calling conventions.
** Be aware that these macros may not be used within this particular
** translation of the amalgamation and its associated header file.
**
** The DBSQL_EXTERN and DBSQL_API macros are used to instruct the
** compiler that the target identifier should have external linkage.
**
** The DBSQL_CDECL macro is used to set the calling convention for
** public functions that accept a variable number of arguments.
**
** The DBSQL_APICALL macro is used to set the calling convention for
** public functions that accept a fixed number of arguments.
**
** The DBSQL_STDCALL macro is no longer used and is now deprecated.
**
** The DBSQL_CALLBACK macro is used to set the calling convention for
** function pointers.
**
** The DBSQL_SYSAPI macro is used to set the calling convention for
** functions provided by the operating system.
**
** Currently, the DBSQL_CDECL, DBSQL_APICALL, DBSQL_CALLBACK, and
** DBSQL_SYSAPI macros are used only when building for environments
** that require non-default calling conventions.
*/
#ifndef DBSQL_EXTERN
# define DBSQL_EXTERN extern
#endif
#ifndef DBSQL_API
# define DBSQL_API
#endif
#ifndef DBSQL_CDECL
# define DBSQL_CDECL
#endif
#ifndef DBSQL_APICALL
# define DBSQL_APICALL
#endif
#ifndef DBSQL_STDCALL
# define DBSQL_STDCALL DBSQL_APICALL
#endif
#ifndef DBSQL_CALLBACK
# define DBSQL_CALLBACK
#endif
#ifndef DBSQL_SYSAPI
# define DBSQL_SYSAPI
#endif

/*
** These no-op macros are used in front of interfaces to mark those
** interfaces as either deprecated or experimental.  New applications
** should not use deprecated interfaces - they are supported for backwards
** compatibility only.  Application writers should be aware that
** experimental interfaces are subject to change in point releases.
**
** These macros used to resolve to various kinds of compiler magic that
** would generate warning messages when they were used.  But that
** compiler magic ended up generating such a flurry of bug reports
** that we have taken it all out and gone back to using simple
** noop macros.
*/
#define DBSQL_DEPRECATED
#define DBSQL_EXPERIMENTAL

/*
** Ensure these symbols were not defined by some previous header file.
*/
#ifdef DBSQL_VERSION
# undef DBSQL_VERSION
#endif
#ifdef DBSQL_VERSION_NUMBER
# undef DBSQL_VERSION_NUMBER
#endif

/*
** CAPI3REF: Compile-Time Library Version Numbers
**
** ^(The [DBSQL_VERSION] C preprocessor macro in the DBSQL.h header
** evaluates to a string literal that is the dbsql version in the
** format "X.Y.Z" where X is the major version number (always 3 for
** SQLite3) and Y is the minor version number and Z is the release number.)^
** ^(The [DBSQL_VERSION_NUMBER] C preprocessor macro resolves to an integer
** with the value (X*1000000 + Y*1000 + Z) where X, Y, and Z are the same
** numbers used in [DBSQL_VERSION].)^
** The DBSQL_VERSION_NUMBER for any given release of dbsql will also
** be larger than the release from which it is derived.  Either Y will
** be held constant and Z will be incremented or else Y will be incremented
** and Z will be reset to zero.
**
** Since [version 3.6.18] ([dateof:3.6.18]),
** dbsql source code has been stored in the
** <a href="http://fossil-scm.org/">Fossil configuration management
** system</a>.  ^The DBSQL_SOURCE_ID macro evaluates to
** a string which identifies a particular check-in of dbsql
** within its configuration management system.  ^The DBSQL_SOURCE_ID
** string contains the date and time of the check-in (UTC) and a SHA1
** or SHA3-256 hash of the entire source tree.  If the source code has
** been edited in any way since it was last checked in, then the last
** four hexadecimal digits of the hash may be modified.
**
** See also: [dbsql_libversion()],
** [dbsql_libversion_number()], [dbsql_sourceid()],
** [dbsql_version()] and [dbsql_source_id()].
*/
#define DBSQL_VERSION        "--VERS--"
#define DBSQL_VERSION_NUMBER --VERSION-NUMBER--
#define DBSQL_SOURCE_ID      "--SOURCE-ID--"
#define DBSQL_SCM_BRANCH     "--SCM-BRANCH--"
#define DBSQL_SCM_TAGS       "--SCM-TAGS--"
#define DBSQL_SCM_DATETIME   "--SCM-DATETIME--"

/*
** CAPI3REF: Run-Time Library Version Numbers
** KEYWORDS: dbsql_version dbsql_sourceid
**
** These interfaces provide the same information as the [DBSQL_VERSION],
** [DBSQL_VERSION_NUMBER], and [DBSQL_SOURCE_ID] C preprocessor macros
** but are associated with the library instead of the header file.  ^(Cautious
** programmers might include assert() statements in their application to
** verify that values returned by these interfaces match the macros in
** the header, and thus ensure that the application is
** compiled with matching library and header files.
**
** <blockquote><pre>
** assert( dbsql_libversion_number()==DBSQL_VERSION_NUMBER );
** assert( strncmp(dbsql_sourceid(),DBSQL_SOURCE_ID,80)==0 );
** assert( strcmp(dbsql_libversion(),DBSQL_VERSION)==0 );
** </pre></blockquote>)^
**
** ^The dbsql_version[] string constant contains the text of the
** [DBSQL_VERSION] macro.  ^The dbsql_libversion() function returns a
** pointer to the dbsql_version[] string constant.  The dbsql_libversion()
** function is provided for use in DLLs since DLL users usually do not have
** direct access to string constants within the DLL.  ^The
** dbsql_libversion_number() function returns an integer equal to
** [DBSQL_VERSION_NUMBER].  ^(The dbsql_sourceid() function returns
** a pointer to a string constant whose value is the same as the
** [DBSQL_SOURCE_ID] C preprocessor macro.  Except if dbsql is built
** using an edited copy of [the amalgamation], then the last four characters
** of the hash might be different from [DBSQL_SOURCE_ID].)^
**
** See also: [dbsql_version()] and [dbsql_source_id()].
*/
DBSQL_EXTERN const char dbsql_version[];
const char *dbsql_libversion(void);
const char *dbsql_sourceid(void);
int dbsql_libversion_number(void);

/*
** CAPI3REF: Run-Time Library Compilation Options Diagnostics
**
** ^The dbsql_compileoption_used() function returns 0 or 1
** indicating whether the specified option was defined at
** compile time.  ^The DBSQL_ prefix may be omitted from the
** option name passed to dbsql_compileoption_used().
**
** ^The dbsql_compileoption_get() function allows iterating
** over the list of options that were defined at compile time by
** returning the N-th compile time option string.  ^If N is out of range,
** dbsql_compileoption_get() returns a NULL pointer.  ^The DBSQL_
** prefix is omitted from any strings returned by
** dbsql_compileoption_get().
**
** ^Support for the diagnostic functions dbsql_compileoption_used()
** and dbsql_compileoption_get() may be omitted by specifying the
** [DBSQL_OMIT_COMPILEOPTION_DIAGS] option at compile time.
**
** See also: SQL functions [dbsql_compileoption_used()] and
** [dbsql_compileoption_get()] and the [compile_options pragma].
*/
#ifndef DBSQL_OMIT_COMPILEOPTION_DIAGS
int dbsql_compileoption_used(const char *opt_name);
const char *dbsql_compileoption_get(int N);
#else
# define dbsql_compileoption_used(X) 0
# define dbsql_compileoption_get(X)  ((void*)0)
#endif

/*
** CAPI3REF: Test To See If The Library Is Threadsafe
**
** ^The dbsql_threadsafe() function returns zero if and only if
** dbsql was compiled with mutexing code omitted due to the
** [DBSQL_THREADSAFE] compile-time option being set to 0.
**
** dbsql can be compiled with or without mutexes.  When
** the [DBSQL_THREADSAFE] C preprocessor macro is 1 or 2, mutexes
** are enabled and dbsql is threadsafe.  When the
** [DBSQL_THREADSAFE] macro is 0,
** the mutexes are omitted.  Without the mutexes, it is not safe
** to use dbsql concurrently from more than one thread.
**
** Enabling mutexes incurs a measurable performance penalty.
** So if speed is of utmost importance, it makes sense to disable
** the mutexes.  But for maximum safety, mutexes should be enabled.
** ^The default behavior is for mutexes to be enabled.
**
** This interface can be used by an application to make sure that the
** version of dbsql that it is linking against was compiled with
** the desired setting of the [DBSQL_THREADSAFE] macro.
**
** This interface only reports on the compile-time mutex setting
** of the [DBSQL_THREADSAFE] flag.  If dbsql is compiled with
** DBSQL_THREADSAFE=1 or =2 then mutexes are enabled by default but
** can be fully or partially disabled using a call to [dbsql_config()]
** with the verbs [DBSQL_CONFIG_SINGLETHREAD], [DBSQL_CONFIG_MULTITHREAD],
** or [DBSQL_CONFIG_SERIALIZED].  ^(The return value of the
** dbsql_threadsafe() function shows only the compile-time setting of
** thread safety, not any run-time changes to that setting made by
** dbsql_config(). In other words, the return value from dbsql_threadsafe()
** is unchanged by calls to dbsql_config().)^
**
** See the [threading mode] documentation for additional information.
*/
int dbsql_threadsafe(void);

/*
** CAPI3REF: Database Connection Handle
** KEYWORDS: {database connection} {database connections}
**
** Each open dbsql database is represented by a pointer to an instance of
** the opaque structure named "DBSQL".  It is useful to think of an DBSQL
** pointer as an object.  The [dbsql_open()], [dbsql_open16()], and
** [dbsql_open_v2()] interfaces are its constructors, and [dbsql_close()]
** and [dbsql_close_v2()] are its destructors.  There are many other
** interfaces (such as
** [dbsql_prepare_v2()], [dbsql_create_function()], and
** [dbsql_busy_timeout()] to name but three) that are methods on an
** DBSQL object.
*/
typedef struct DBSQL DBSQL;

/*
** CAPI3REF: 64-Bit Integer Types
** KEYWORDS: int64_t u_int64_t
**
** Because there is no cross-platform way to specify 64-bit integer types
** dbsql includes typedefs for 64-bit signed and unsigned integers.
**
** The int64_t and u_int64_t are the preferred type definitions.
** The int64_t and u_int64_t types are supported for backwards
** compatibility only.
**
** ^The int64_t and int64_t types can store integer values
** between -9223372036854775808 and +9223372036854775807 inclusive.  ^The
** u_int64_t and u_int64_t types can store integer values
** between 0 and +18446744073709551615 inclusive.
*/
#ifdef DBSQL_INT64_TYPE

# ifdef DBSQL_UINT64_TYPE

# else

# endif
#elif defined(_MSC_VER) || defined(__BORLANDC__)


#else


#endif



/*
** If compiling for a processor that lacks floating point support,
** substitute integer for floating-point.
*/
#ifdef DBSQL_OMIT_FLOATING_POINT
# define double int64_t
#endif

/*
** CAPI3REF: Closing A Database Connection
** DESTRUCTOR: DBSQL
**
** ^The dbsql_close() and dbsql_close_v2() routines are destructors
** for the [DBSQL] object.
** ^Calls to dbsql_close() and dbsql_close_v2() return [DBSQL_OK] if
** the [DBSQL] object is successfully destroyed and all associated
** resources are deallocated.
**
** Ideally, applications should [dbsql_finalize | finalize] all
** [prepared statements], [dbsql_blob_close | close] all [BLOB handles], and
** [dbsql_backup_finish | finish] all [dbsql_backup_t] objects associated
** with the [DBSQL] object prior to attempting to close the object.
** ^If the database connection is associated with unfinalized prepared
** statements, BLOB handlers, and/or unfinished dbsql_backup_t objects then
** dbsql_close() will leave the database connection open and return
** [DBSQL_BUSY]. ^If dbsql_close_v2() is called with unfinalized prepared
** statements, unclosed BLOB handlers, and/or unfinished dbsql_backups,
** it returns [DBSQL_OK] regardless, but instead of deallocating the database
** connection immediately, it marks the database connection as an unusable
** "zombie" and makes arrangements to automatically deallocate the database
** connection after all prepared statements are finalized, all BLOB handles
** are closed, and all backups have finished. The dbsql_close_v2() interface
** is intended for use with host languages that are garbage collected, and
** where the order in which destructors are called is arbitrary.
**
** ^If an [DBSQL] object is destroyed while a transaction is open,
** the transaction is automatically rolled back.
**
** The C parameter to [dbsql_close(C)] and [dbsql_close_v2(C)]
** must be either a NULL
** pointer or an [DBSQL] object pointer obtained
** from [dbsql_open()], [dbsql_open16()], or
** [dbsql_open_v2()], and not previously closed.
** ^Calling dbsql_close() or dbsql_close_v2() with a NULL pointer
** argument is a harmless no-op.
*/
int dbsql_close(DBSQL*);
int dbsql_close_v2(DBSQL*);

/*
** The type for a callback function.
** This is legacy and deprecated.  It is included for historical
** compatibility and is not documented.
*/
typedef int (*dbsql_callback)(void*,int,char**, char**);

/*
** CAPI3REF: One-Step Query Execution Interface
** METHOD: DBSQL
**
** The dbsql_exec() interface is a convenience wrapper around
** [dbsql_prepare_v2()], [dbsql_step()], and [dbsql_finalize()],
** that allows an application to run multiple statements of SQL
** without having to use a lot of C code.
**
** ^The dbsql_exec() interface runs zero or more UTF-8 encoded,
** semicolon-separated SQL statements passed into its 2nd argument,
** in the context of the [database connection] passed in as its 1st
** argument.  ^If the callback function of the 3rd argument to
** dbsql_exec() is not NULL, then it is invoked for each result row
** coming out of the evaluated SQL statements.  ^The 4th argument to
** dbsql_exec() is relayed through to the 1st argument of each
** callback invocation.  ^If the callback pointer to dbsql_exec()
** is NULL, then no callback is ever invoked and result rows are
** ignored.
**
** ^If an error occurs while evaluating the SQL statements passed into
** dbsql_exec(), then execution of the current statement stops and
** subsequent statements are skipped.  ^If the 5th parameter to dbsql_exec()
** is not NULL then any error message is written into memory obtained
** from [dbsql_malloc()] and passed back through the 5th parameter.
** To avoid memory leaks, the application should invoke [dbsql_free()]
** on error message strings returned through the 5th parameter of
** dbsql_exec() after the error message string is no longer needed.
** ^If the 5th parameter to dbsql_exec() is not NULL and no errors
** occur, then dbsql_exec() sets the pointer in its 5th parameter to
** NULL before returning.
**
** ^If an dbsql_exec() callback returns non-zero, the dbsql_exec()
** routine returns DBSQL_ABORT without invoking the callback again and
** without running any subsequent SQL statements.
**
** ^The 2nd argument to the dbsql_exec() callback function is the
** number of columns in the result.  ^The 3rd argument to the dbsql_exec()
** callback is an array of pointers to strings obtained as if from
** [dbsql_column_text()], one for each column.  ^If an element of a
** result row is NULL then the corresponding string pointer for the
** dbsql_exec() callback is a NULL pointer.  ^The 4th argument to the
** dbsql_exec() callback is an array of pointers to strings where each
** entry represents the name of a corresponding result column as obtained
** from [dbsql_column_name()].
**
** ^If the 2nd parameter to dbsql_exec() is a NULL pointer, a pointer
** to an empty string, or a pointer that contains only whitespace and/or
** SQL comments, then no SQL statements are evaluated and the database
** is not changed.
**
** Restrictions:
**
** <ul>
** <li> The application must ensure that the 1st parameter to dbsql_exec()
**      is a valid and open [database connection].
** <li> The application must not close the [database connection] specified by
**      the 1st parameter to dbsql_exec() while dbsql_exec() is running.
** <li> The application must not modify the SQL statement text passed into
**      the 2nd parameter of dbsql_exec() while dbsql_exec() is running.
** <li> The application must not dereference the arrays or string pointers
**       passed as the 3rd and 4th callback parameters after it returns.
** </ul>
*/
int dbsql_exec(
  DBSQL*,                                  /* An open database */
  const char *sql,                           /* SQL to be evaluated */
  int (*callback)(void*,int,char**,char**),  /* Callback function */
  void *,                                    /* 1st argument to callback */
  char **errmsg                              /* Error msg written here */
);

/*
** CAPI3REF: Result Codes
** KEYWORDS: {result code definitions}
**
** Many dbsql functions return an integer result code from the set shown
** here in order to indicate success or failure.
**
** New error codes may be added in future versions of dbsql.
**
** See also: [extended result code definitions]
*/
#define DBSQL_OK           0   /* Successful result */
/* beginning-of-error-codes */
#define DBSQL_ERROR        1   /* Generic error */
#define DBSQL_INTERNAL     2   /* Internal logic error in dbsql */
#define DBSQL_PERM         3   /* Access permission denied */
#define DBSQL_ABORT        4   /* Callback routine requested an abort */
#define DBSQL_BUSY         5   /* The database file is locked */
#define DBSQL_LOCKED       6   /* A table in the database is locked */
#define DBSQL_NOMEM        7   /* A malloc() failed */
#define DBSQL_READONLY     8   /* Attempt to write a readonly database */
#define DBSQL_INTERRUPT    9   /* Operation terminated by dbsql_interrupt()*/
#define DBSQL_IOERR       10   /* Some kind of disk I/O error occurred */
#define DBSQL_CORRUPT     11   /* The database disk image is malformed */
#define DBSQL_NOTFOUND    12   /* Unknown opcode in dbsql_file_control() */
#define DBSQL_FULL        13   /* Insertion failed because database is full */
#define DBSQL_CANTOPEN    14   /* Unable to open the database file */
#define DBSQL_PROTOCOL    15   /* Database lock protocol error */
#define DBSQL_EMPTY       16   /* Internal use only */
#define DBSQL_SCHEMA      17   /* The database schema changed */
#define DBSQL_TOOBIG      18   /* String or BLOB exceeds size limit */
#define DBSQL_CONSTRAINT  19   /* Abort due to constraint violation */
#define DBSQL_MISMATCH    20   /* Data type mismatch */
#define DBSQL_MISUSE      21   /* Library used incorrectly */
#define DBSQL_NOLFS       22   /* Uses OS features not supported on host */
#define DBSQL_AUTH        23   /* Authorization denied */
#define DBSQL_FORMAT      24   /* Not used */
#define DBSQL_RANGE       25   /* 2nd parameter to dbsql_bind out of range */
#define DBSQL_NOTADB      26   /* File opened that is not a database file */
#define DBSQL_NOTICE      27   /* Notifications from dbsql_log() */
#define DBSQL_WARNING     28   /* Warnings from dbsql_log() */
#define DBSQL_ROW         100  /* dbsql_step() has another row ready */
#define DBSQL_DONE        101  /* dbsql_step() has finished executing */
/* end-of-error-codes */

/*
** CAPI3REF: Extended Result Codes
** KEYWORDS: {extended result code definitions}
**
** In its default configuration, dbsql API routines return one of 30 integer
** [result codes].  However, experience has shown that many of
** these result codes are too coarse-grained.  They do not provide as
** much information about problems as programmers might like.  In an effort to
** address this, newer versions of dbsql (version 3.3.8 [dateof:3.3.8]
** and later) include
** support for additional result codes that provide more detailed information
** about errors. These [extended result codes] are enabled or disabled
** on a per database connection basis using the
** [dbsql_extended_result_codes()] API.  Or, the extended code for
** the most recent error can be obtained using
** [dbsql_extended_errcode()].
*/
#define DBSQL_ERROR_MISSING_COLLSEQ   (DBSQL_ERROR | (1<<8))
#define DBSQL_ERROR_RETRY             (DBSQL_ERROR | (2<<8))
#define DBSQL_ERROR_SNAPSHOT          (DBSQL_ERROR | (3<<8))
#define DBSQL_ERROR_RESERVESIZE       (DBSQL_ERROR | (4<<8))
#define DBSQL_ERROR_KEY               (DBSQL_ERROR | (5<<8))
#define DBSQL_ERROR_UNABLE            (DBSQL_ERROR | (6<<8))
#define DBSQL_IOERR_READ              (DBSQL_IOERR | (1<<8))
#define DBSQL_IOERR_SHORT_READ        (DBSQL_IOERR | (2<<8))
#define DBSQL_IOERR_WRITE             (DBSQL_IOERR | (3<<8))
#define DBSQL_IOERR_FSYNC             (DBSQL_IOERR | (4<<8))
#define DBSQL_IOERR_DIR_FSYNC         (DBSQL_IOERR | (5<<8))
#define DBSQL_IOERR_TRUNCATE          (DBSQL_IOERR | (6<<8))
#define DBSQL_IOERR_FSTAT             (DBSQL_IOERR | (7<<8))
#define DBSQL_IOERR_UNLOCK            (DBSQL_IOERR | (8<<8))
#define DBSQL_IOERR_RDLOCK            (DBSQL_IOERR | (9<<8))
#define DBSQL_IOERR_DELETE            (DBSQL_IOERR | (10<<8))
#define DBSQL_IOERR_BLOCKED           (DBSQL_IOERR | (11<<8))
#define DBSQL_IOERR_NOMEM             (DBSQL_IOERR | (12<<8))
#define DBSQL_IOERR_ACCESS            (DBSQL_IOERR | (13<<8))
#define DBSQL_IOERR_CHECKRESERVEDLOCK (DBSQL_IOERR | (14<<8))
#define DBSQL_IOERR_LOCK              (DBSQL_IOERR | (15<<8))
#define DBSQL_IOERR_CLOSE             (DBSQL_IOERR | (16<<8))
#define DBSQL_IOERR_DIR_CLOSE         (DBSQL_IOERR | (17<<8))
#define DBSQL_IOERR_SHMOPEN           (DBSQL_IOERR | (18<<8))
#define DBSQL_IOERR_SHMSIZE           (DBSQL_IOERR | (19<<8))
#define DBSQL_IOERR_SHMLOCK           (DBSQL_IOERR | (20<<8))
#define DBSQL_IOERR_SHMMAP            (DBSQL_IOERR | (21<<8))
#define DBSQL_IOERR_SEEK              (DBSQL_IOERR | (22<<8))
#define DBSQL_IOERR_DELETE_NOENT      (DBSQL_IOERR | (23<<8))
#define DBSQL_IOERR_MMAP              (DBSQL_IOERR | (24<<8))
#define DBSQL_IOERR_GETTEMPPATH       (DBSQL_IOERR | (25<<8))
#define DBSQL_IOERR_CONVPATH          (DBSQL_IOERR | (26<<8))
#define DBSQL_IOERR_VNODE             (DBSQL_IOERR | (27<<8))
#define DBSQL_IOERR_AUTH              (DBSQL_IOERR | (28<<8))
#define DBSQL_IOERR_BEGIN_ATOMIC      (DBSQL_IOERR | (29<<8))
#define DBSQL_IOERR_COMMIT_ATOMIC     (DBSQL_IOERR | (30<<8))
#define DBSQL_IOERR_ROLLBACK_ATOMIC   (DBSQL_IOERR | (31<<8))
#define DBSQL_IOERR_DATA              (DBSQL_IOERR | (32<<8))
#define DBSQL_IOERR_CORRUPTFS         (DBSQL_IOERR | (33<<8))
#define DBSQL_IOERR_IN_PAGE           (DBSQL_IOERR | (34<<8))
#define DBSQL_IOERR_BADKEY            (DBSQL_IOERR | (35<<8))
#define DBSQL_IOERR_CODEC             (DBSQL_IOERR | (36<<8))
#define DBSQL_LOCKED_SHAREDCACHE      (DBSQL_LOCKED |  (1<<8))
#define DBSQL_LOCKED_VTAB             (DBSQL_LOCKED |  (2<<8))
#define DBSQL_BUSY_RECOVERY           (DBSQL_BUSY   |  (1<<8))
#define DBSQL_BUSY_SNAPSHOT           (DBSQL_BUSY   |  (2<<8))
#define DBSQL_BUSY_TIMEOUT            (DBSQL_BUSY   |  (3<<8))
#define DBSQL_CANTOPEN_NOTEMPDIR      (DBSQL_CANTOPEN | (1<<8))
#define DBSQL_CANTOPEN_ISDIR          (DBSQL_CANTOPEN | (2<<8))
#define DBSQL_CANTOPEN_FULLPATH       (DBSQL_CANTOPEN | (3<<8))
#define DBSQL_CANTOPEN_CONVPATH       (DBSQL_CANTOPEN | (4<<8))
#define DBSQL_CANTOPEN_DIRTYWAL       (DBSQL_CANTOPEN | (5<<8)) /* Not Used */
#define DBSQL_CANTOPEN_SYMLINK        (DBSQL_CANTOPEN | (6<<8))
#define DBSQL_CORRUPT_VTAB            (DBSQL_CORRUPT | (1<<8))
#define DBSQL_CORRUPT_SEQUENCE        (DBSQL_CORRUPT | (2<<8))
#define DBSQL_CORRUPT_INDEX           (DBSQL_CORRUPT | (3<<8))
#define DBSQL_READONLY_RECOVERY       (DBSQL_READONLY | (1<<8))
#define DBSQL_READONLY_CANTLOCK       (DBSQL_READONLY | (2<<8))
#define DBSQL_READONLY_ROLLBACK       (DBSQL_READONLY | (3<<8))
#define DBSQL_READONLY_DBMOVED        (DBSQL_READONLY | (4<<8))
#define DBSQL_READONLY_CANTINIT       (DBSQL_READONLY | (5<<8))
#define DBSQL_READONLY_DIRECTORY      (DBSQL_READONLY | (6<<8))
#define DBSQL_ABORT_ROLLBACK          (DBSQL_ABORT | (2<<8))
#define DBSQL_CONSTRAINT_CHECK        (DBSQL_CONSTRAINT | (1<<8))
#define DBSQL_CONSTRAINT_COMMITHOOK   (DBSQL_CONSTRAINT | (2<<8))
#define DBSQL_CONSTRAINT_FOREIGNKEY   (DBSQL_CONSTRAINT | (3<<8))
#define DBSQL_CONSTRAINT_FUNCTION     (DBSQL_CONSTRAINT | (4<<8))
#define DBSQL_CONSTRAINT_NOTNULL      (DBSQL_CONSTRAINT | (5<<8))
#define DBSQL_CONSTRAINT_PRIMARYKEY   (DBSQL_CONSTRAINT | (6<<8))
#define DBSQL_CONSTRAINT_TRIGGER      (DBSQL_CONSTRAINT | (7<<8))
#define DBSQL_CONSTRAINT_UNIQUE       (DBSQL_CONSTRAINT | (8<<8))
#define DBSQL_CONSTRAINT_VTAB         (DBSQL_CONSTRAINT | (9<<8))
#define DBSQL_CONSTRAINT_ROWID        (DBSQL_CONSTRAINT |(10<<8))
#define DBSQL_CONSTRAINT_PINNED       (DBSQL_CONSTRAINT |(11<<8))
#define DBSQL_CONSTRAINT_DATATYPE     (DBSQL_CONSTRAINT |(12<<8))
#define DBSQL_NOTICE_RECOVER_WAL      (DBSQL_NOTICE | (1<<8))
#define DBSQL_NOTICE_RECOVER_ROLLBACK (DBSQL_NOTICE | (2<<8))
#define DBSQL_NOTICE_RBU              (DBSQL_NOTICE | (3<<8))
#define DBSQL_WARNING_AUTOINDEX       (DBSQL_WARNING | (1<<8))
#define DBSQL_AUTH_USER               (DBSQL_AUTH | (1<<8))
#define DBSQL_OK_LOAD_PERMANENTLY     (DBSQL_OK | (1<<8))
#define DBSQL_OK_SYMLINK              (DBSQL_OK | (2<<8)) /* internal only */

/*
** CAPI3REF: Flags For File Open Operations
**
** These bit values are intended for use in the
** 3rd parameter to the [dbsql_open_v2()] interface and
** in the 4th parameter to the [dbsql_vfs_t.x_open] method.
**
** Only those flags marked as "Ok for dbsql_open_v2()" may be
** used as the third argument to the [dbsql_open_v2()] interface.
** The other flags have historically been ignored by dbsql_open_v2(),
** though future versions of dbsql might change so that an error is
** raised if any of the disallowed bits are passed into dbsql_open_v2().
** Applications should not depend on the historical behavior.
**
** Note in particular that passing the DBSQL_OPEN_EXCLUSIVE flag into
** [dbsql_open_v2()] does *not* cause the underlying database file
** to be opened using O_EXCL.  Passing DBSQL_OPEN_EXCLUSIVE into
** [dbsql_open_v2()] has historically been a no-op and might become an
** error in future versions of dbsql.
*/
#define DBSQL_OPEN_READONLY         0x00000001  /* Ok for dbsql_open_v2() */
#define DBSQL_OPEN_READWRITE        0x00000002  /* Ok for dbsql_open_v2() */
#define DBSQL_OPEN_CREATE           0x00000004  /* Ok for dbsql_open_v2() */
#define DBSQL_OPEN_DELETEONCLOSE    0x00000008  /* VFS only */
#define DBSQL_OPEN_EXCLUSIVE        0x00000010  /* VFS only */
#define DBSQL_OPEN_AUTOPROXY        0x00000020  /* VFS only */
#define DBSQL_OPEN_URI              0x00000040  /* Ok for dbsql_open_v2() */
#define DBSQL_OPEN_MEMORY           0x00000080  /* Ok for dbsql_open_v2() */
#define DBSQL_OPEN_MAIN_DB          0x00000100  /* VFS only */
#define DBSQL_OPEN_TEMP_DB          0x00000200  /* VFS only */
#define DBSQL_OPEN_TRANSIENT_DB     0x00000400  /* VFS only */
#define DBSQL_OPEN_MAIN_JOURNAL     0x00000800  /* VFS only */
#define DBSQL_OPEN_TEMP_JOURNAL     0x00001000  /* VFS only */
#define DBSQL_OPEN_SUBJOURNAL       0x00002000  /* VFS only */
#define DBSQL_OPEN_SUPER_JOURNAL    0x00004000  /* VFS only */
#define DBSQL_OPEN_NOMUTEX          0x00008000  /* Ok for dbsql_open_v2() */
#define DBSQL_OPEN_FULLMUTEX        0x00010000  /* Ok for dbsql_open_v2() */
#define DBSQL_OPEN_SHAREDCACHE      0x00020000  /* Ok for dbsql_open_v2() */
#define DBSQL_OPEN_PRIVATECACHE     0x00040000  /* Ok for dbsql_open_v2() */
#define DBSQL_OPEN_WAL              0x00080000  /* VFS only */
#define DBSQL_OPEN_NOFOLLOW         0x01000000  /* Ok for dbsql_open_v2() */
#define DBSQL_OPEN_EXRESCODE        0x02000000  /* Extended result codes */

/* Reserved:                         0x00F00000 */
/* Legacy compatibility: */
#define DBSQL_OPEN_MASTER_JOURNAL   0x00004000  /* VFS only */


/*
** CAPI3REF: Device Characteristics
**
** The device_characteristics method of the [dbsql_io_methods_t]
** object returns an integer which is a vector of these
** bit values expressing I/O characteristics of the mass storage
** device that holds the file that the [dbsql_io_methods_t]
** refers to.
**
** The DBSQL_IOCAP_ATOMIC property means that all writes of
** any size are atomic.  The DBSQL_IOCAP_ATOMICnnn values
** mean that writes of blocks that are nnn bytes in size and
** are aligned to an address which is an integer multiple of
** nnn are atomic.  The DBSQL_IOCAP_SAFE_APPEND value means
** that when data is appended to a file, the data is appended
** first then the size of the file is extended, never the other
** way around.  The DBSQL_IOCAP_SEQUENTIAL property means that
** information is written to disk in the same order as calls
** to x_write().  The DBSQL_IOCAP_POWERSAFE_OVERWRITE property means that
** after reboot following a crash or power loss, the only bytes in a
** file that were written at the application level might have changed
** and that adjacent bytes, even bytes within the same sector are
** guaranteed to be unchanged.  The DBSQL_IOCAP_UNDELETABLE_WHEN_OPEN
** flag indicates that a file cannot be deleted when open.  The
** DBSQL_IOCAP_IMMUTABLE flag indicates that the file is on
** read-only media and cannot be changed even by processes with
** elevated privileges.
**
** The DBSQL_IOCAP_BATCH_ATOMIC property means that the underlying
** filesystem supports doing multiple write operations atomically when those
** write operations are bracketed by [DBSQL_FCNTL_BEGIN_ATOMIC_WRITE] and
** [DBSQL_FCNTL_COMMIT_ATOMIC_WRITE].
**
** The DBSQL_IOCAP_SUBPAGE_READ property means that it is ok to read
** from the database file in amounts that are not a multiple of the
** page size and that do not begin at a page boundary.  Without this
** property, dbsql is careful to only do full-page reads and write
** on aligned pages, with the one exception that it will do a sub-page
** read of the first page to access the database header.
*/
#define DBSQL_IOCAP_ATOMIC                 0x00000001
#define DBSQL_IOCAP_ATOMIC512              0x00000002
#define DBSQL_IOCAP_ATOMIC1K               0x00000004
#define DBSQL_IOCAP_ATOMIC2K               0x00000008
#define DBSQL_IOCAP_ATOMIC4K               0x00000010
#define DBSQL_IOCAP_ATOMIC8K               0x00000020
#define DBSQL_IOCAP_ATOMIC16K              0x00000040
#define DBSQL_IOCAP_ATOMIC32K              0x00000080
#define DBSQL_IOCAP_ATOMIC64K              0x00000100
#define DBSQL_IOCAP_SAFE_APPEND            0x00000200
#define DBSQL_IOCAP_SEQUENTIAL             0x00000400
#define DBSQL_IOCAP_UNDELETABLE_WHEN_OPEN  0x00000800
#define DBSQL_IOCAP_POWERSAFE_OVERWRITE    0x00001000
#define DBSQL_IOCAP_IMMUTABLE              0x00002000
#define DBSQL_IOCAP_BATCH_ATOMIC           0x00004000
#define DBSQL_IOCAP_SUBPAGE_READ           0x00008000

/*
** CAPI3REF: File Locking Levels
**
** dbsql uses one of these integer values as the second
** argument to calls it makes to the lock() and unlock() methods
** of an [dbsql_io_methods_t] object.  These values are ordered from
** least restrictive to most restrictive.
**
** The argument to lock() is always SHARED or higher.  The argument to
** unlock is either SHARED or NONE.
*/
#define DBSQL_LOCK_NONE          0       /* unlock() only */
#define DBSQL_LOCK_SHARED        1       /* lock() or unlock() */
#define DBSQL_LOCK_RESERVED      2       /* lock() only */
#define DBSQL_LOCK_PENDING       3       /* lock() only */
#define DBSQL_LOCK_EXCLUSIVE     4       /* lock() only */

/*
** CAPI3REF: Synchronization Type Flags
**
** When dbsql invokes the x_sync() method of an
** [dbsql_io_methods_t] object it uses a combination of
** these integer values as the second argument.
**
** When the DBSQL_SYNC_DATAONLY flag is used, it means that the
** sync operation only needs to flush data to mass storage.  Inode
** information need not be flushed. If the lower four bits of the flag
** equal DBSQL_SYNC_NORMAL, that means to use normal fsync() semantics.
** If the lower four bits equal DBSQL_SYNC_FULL, that means
** to use Mac OS X style fullsync instead of fsync().
**
** Do not confuse the DBSQL_SYNC_NORMAL and DBSQL_SYNC_FULL flags
** with the [PRAGMA synchronous]=NORMAL and [PRAGMA synchronous]=FULL
** settings.  The [synchronous pragma] determines when calls to the
** x_sync VFS method occur and applies uniformly across all platforms.
** The DBSQL_SYNC_NORMAL and DBSQL_SYNC_FULL flags determine how
** energetic or rigorous or forceful the sync operations are and
** only make a difference on Mac OSX for the default dbsql code.
** (Third-party VFS implementations might also make the distinction
** between DBSQL_SYNC_NORMAL and DBSQL_SYNC_FULL, but among the
** operating systems natively supported by dbsql, only Mac OSX
** cares about the difference.)
*/
#define DBSQL_SYNC_NORMAL        0x00002
#define DBSQL_SYNC_FULL          0x00003
#define DBSQL_SYNC_DATAONLY      0x00010

/*
** CAPI3REF: OS Interface Open File Handle
**
** An [dbsql_file_t] object represents an open file in the
** [dbsql_vfs_t | OS interface layer].  Individual OS interface
** implementations will
** want to subclass this object by appending additional fields
** for their own use.  The methods entry is a pointer to an
** [dbsql_io_methods_t] object that defines methods for performing
** I/O operations on the open file.
*/
typedef struct dbsql_file_t dbsql_file_t;
struct dbsql_file_t {
  const struct dbsql_io_methods_t *methods;  /* Methods for an open file */
};

/*
** CAPI3REF: OS Interface File Virtual Methods Object
**
** Every file opened by the [dbsql_vfs_t.x_open] method populates an
** [dbsql_file_t] object (or, more commonly, a subclass of the
** [dbsql_file_t] object) with a pointer to an instance of this object.
** This object defines the methods used to perform various operations
** against the open file represented by the [dbsql_file_t] object.
**
** If the [dbsql_vfs_t.x_open] method sets the dbsql_file_t.methods element
** to a non-NULL pointer, then the dbsql_io_methods_t.x_close method
** may be invoked even if the [dbsql_vfs_t.x_open] reported that it failed.  The
** only way to prevent a call to x_close following a failed [dbsql_vfs_t.x_open]
** is for the [dbsql_vfs_t.x_open] to set the dbsql_file_t.methods element
** to NULL.
**
** The flags argument to x_sync may be one of [DBSQL_SYNC_NORMAL] or
** [DBSQL_SYNC_FULL].  The first choice is the normal fsync().
** The second choice is a Mac OS X style fullsync.  The [DBSQL_SYNC_DATAONLY]
** flag may be ORed in to indicate that only the data of the file
** and not its inode needs to be synced.
**
** The integer values to lock() and unlock() are one of
** <ul>
** <li> [DBSQL_LOCK_NONE],
** <li> [DBSQL_LOCK_SHARED],
** <li> [DBSQL_LOCK_RESERVED],
** <li> [DBSQL_LOCK_PENDING], or
** <li> [DBSQL_LOCK_EXCLUSIVE].
** </ul>
** lock() upgrades the database file lock.  In other words, lock() moves the
** database file lock in the direction NONE toward EXCLUSIVE. The argument to
** lock() is always one of SHARED, RESERVED, PENDING, or EXCLUSIVE, never
** DBSQL_LOCK_NONE.  If the database file lock is already at or above the
** requested lock, then the call to lock() is a no-op.
** unlock() downgrades the database file lock to either SHARED or NONE.
** If the lock is already at or below the requested lock state, then the call
** to unlock() is a no-op.
** The check_reserved_lock() method checks whether any database connection,
** either in this process or in some other process, is holding a RESERVED,
** PENDING, or EXCLUSIVE lock on the file.  It returns, via its output
** pointer parameter, true if such a lock exists and false otherwise.
**
** The file_control() method is a generic interface that allows custom
** VFS implementations to directly control an open file using the
** [dbsql_file_control()] interface.  The second "op" argument is an
** integer opcode.  The third argument is a generic pointer intended to
** point to a structure that may contain arguments or space in which to
** write return values.  Potential uses for file_control() might be
** functions to enable blocking locks with timeouts, to change the
** locking strategy (for example to use dot-file locks), to inquire
** about the status of a lock, or to break stale locks.  The dbsql
** core reserves all opcodes less than 100 for its own use.
** A [file control opcodes | list of opcodes] less than 100 is available.
** Applications that define a custom file_control method should use opcodes
** greater than 100 to avoid conflicts.  VFS implementations should
** return [DBSQL_NOTFOUND] for file control opcodes that they do not
** recognize.
**
** The sector_size() method returns the sector size of the
** device that underlies the file.  The sector size is the
** minimum write that can be performed without disturbing
** other bytes in the file.  The device_characteristics()
** method returns a bit vector describing behaviors of the
** underlying device:
**
** <ul>
** <li> [DBSQL_IOCAP_ATOMIC]
** <li> [DBSQL_IOCAP_ATOMIC512]
** <li> [DBSQL_IOCAP_ATOMIC1K]
** <li> [DBSQL_IOCAP_ATOMIC2K]
** <li> [DBSQL_IOCAP_ATOMIC4K]
** <li> [DBSQL_IOCAP_ATOMIC8K]
** <li> [DBSQL_IOCAP_ATOMIC16K]
** <li> [DBSQL_IOCAP_ATOMIC32K]
** <li> [DBSQL_IOCAP_ATOMIC64K]
** <li> [DBSQL_IOCAP_SAFE_APPEND]
** <li> [DBSQL_IOCAP_SEQUENTIAL]
** <li> [DBSQL_IOCAP_UNDELETABLE_WHEN_OPEN]
** <li> [DBSQL_IOCAP_POWERSAFE_OVERWRITE]
** <li> [DBSQL_IOCAP_IMMUTABLE]
** <li> [DBSQL_IOCAP_BATCH_ATOMIC]
** <li> [DBSQL_IOCAP_SUBPAGE_READ]
** </ul>
**
** The DBSQL_IOCAP_ATOMIC property means that all writes of
** any size are atomic.  The DBSQL_IOCAP_ATOMICnnn values
** mean that writes of blocks that are nnn bytes in size and
** are aligned to an address which is an integer multiple of
** nnn are atomic.  The DBSQL_IOCAP_SAFE_APPEND value means
** that when data is appended to a file, the data is appended
** first then the size of the file is extended, never the other
** way around.  The DBSQL_IOCAP_SEQUENTIAL property means that
** information is written to disk in the same order as calls
** to x_write().
**
** If x_read() returns DBSQL_IOERR_SHORT_READ it must also fill
** in the unread portions of the buffer with zeros.  A VFS that
** fails to zero-fill short reads might seem to work.  However,
** failure to zero-fill short reads will eventually lead to
** database corruption.
*/
typedef struct dbsql_io_methods_t dbsql_io_methods_t;
struct dbsql_io_methods_t {
  int i_version;
  int (*x_close)(dbsql_file_t*);
  int (*x_read)(dbsql_file_t*, void*, int i_amt, int64_t i_ofst);
  int (*x_write)(dbsql_file_t*, const void*, int i_amt, int64_t i_ofst);
  int (*truncate)(dbsql_file_t*, int64_t size);
  int (*x_sync)(dbsql_file_t*, int flags);
  int (*file_size)(dbsql_file_t*, int64_t *p_size);
  int (*lock)(dbsql_file_t*, int);
  int (*unlock)(dbsql_file_t*, int);
  int (*check_reserved_lock)(dbsql_file_t*, int *res_out);
  int (*file_control)(dbsql_file_t*, int op, void *arg);
  int (*sector_size)(dbsql_file_t*);
  int (*device_characteristics)(dbsql_file_t*);
  /* Methods above are valid for version 1 */
  int (*shm_map)(dbsql_file_t*, int i_pg, int pgsz, int, void volatile**);
  int (*shm_lock)(dbsql_file_t*, int offset, int n, int flags);
  void (*shm_barrier)(dbsql_file_t*);
  int (*shm_unmap)(dbsql_file_t*, int delete_flag);
  /* Methods above are valid for version 2 */
  int (*fetch)(dbsql_file_t*, int64_t i_ofst, int i_amt, void **pp);
  int (*unfetch)(dbsql_file_t*, int64_t i_ofst, void *p);
  /* Methods above are valid for version 3 */
  /* Additional methods may be added in future releases */
};

/*
** CAPI3REF: Standard File Control Opcodes
** KEYWORDS: {file control opcodes} {file control opcode}
**
** These integer constants are opcodes for the file_control method
** of the [dbsql_io_methods_t] object and for the [dbsql_file_control()]
** interface.
**
** <ul>
** <li>[[DBSQL_FCNTL_LOCKSTATE]]
** The [DBSQL_FCNTL_LOCKSTATE] opcode is used for debugging.  This
** opcode causes the file_control method to write the current state of
** the lock (one of [DBSQL_LOCK_NONE], [DBSQL_LOCK_SHARED],
** [DBSQL_LOCK_RESERVED], [DBSQL_LOCK_PENDING], or [DBSQL_LOCK_EXCLUSIVE])
** into an integer that the arg argument points to.
** This capability is only available if dbsql is compiled with [DBSQL_DEBUG].
**
** <li>[[DBSQL_FCNTL_SIZE_HINT]]
** The [DBSQL_FCNTL_SIZE_HINT] opcode is used by dbsql to give the VFS
** layer a hint of how large the database file will grow to be during the
** current transaction.  This hint is not guaranteed to be accurate but it
** is often close.  The underlying VFS might choose to preallocate database
** file space based on this hint in order to help writes to the database
** file run faster.
**
** <li>[[DBSQL_FCNTL_SIZE_LIMIT]]
** The [DBSQL_FCNTL_SIZE_LIMIT] opcode is used by in-memory VFS that
** implements [dbsql_deserialize()] to set an upper bound on the size
** of the in-memory database.  The argument is a pointer to a [int64_t].
** If the integer pointed to is negative, then it is filled in with the
** current limit.  Otherwise the limit is set to the larger of the value
** of the integer pointed to and the current database size.  The integer
** pointed to is set to the new limit.
**
** <li>[[DBSQL_FCNTL_CHUNK_SIZE]]
** The [DBSQL_FCNTL_CHUNK_SIZE] opcode is used to request that the VFS
** extends and truncates the database file in chunks of a size specified
** by the user. The fourth argument to [dbsql_file_control()] should
** point to an integer (type int) containing the new chunk-size to use
** for the nominated database. Allocating database file space in large
** chunks (say 1MB at a time), may reduce file-system fragmentation and
** improve performance on some systems.
**
** <li>[[DBSQL_FCNTL_FILE_POINTER]]
** The [DBSQL_FCNTL_FILE_POINTER] opcode is used to obtain a pointer
** to the [dbsql_file_t] object associated with a particular database
** connection.  See also [DBSQL_FCNTL_JOURNAL_POINTER].
**
** <li>[[DBSQL_FCNTL_JOURNAL_POINTER]]
** The [DBSQL_FCNTL_JOURNAL_POINTER] opcode is used to obtain a pointer
** to the [dbsql_file_t] object associated with the journal file (either
** the [rollback journal] or the [write-ahead log]) for a particular database
** connection.  See also [DBSQL_FCNTL_FILE_POINTER].
**
** <li>[[DBSQL_FCNTL_SYNC_OMITTED]]
** The DBSQL_FCNTL_SYNC_OMITTED file-control is no longer used.
**
** <li>[[DBSQL_FCNTL_SYNC]]
** The [DBSQL_FCNTL_SYNC] opcode is generated internally by dbsql and
** sent to the VFS immediately before the x_sync method is invoked on a
** database file descriptor. Or, if the x_sync method is not invoked
** because the user has configured dbsql with
** [PRAGMA synchronous | PRAGMA synchronous=OFF] it is invoked in place
** of the x_sync method. In most cases, the pointer argument passed with
** this file-control is NULL. However, if the database file is being synced
** as part of a multi-database commit, the argument points to a nul-terminated
** string containing the transactions super-journal file name. VFSes that
** do not need this signal should silently ignore this opcode. Applications
** should not call [dbsql_file_control()] with this opcode as doing so may
** disrupt the operation of the specialized VFSes that do require it.
**
** <li>[[DBSQL_FCNTL_COMMIT_PHASETWO]]
** The [DBSQL_FCNTL_COMMIT_PHASETWO] opcode is generated internally by dbsql
** and sent to the VFS after a transaction has been committed immediately
** but before the database is unlocked. VFSes that do not need this signal
** should silently ignore this opcode. Applications should not call
** [dbsql_file_control()] with this opcode as doing so may disrupt the
** operation of the specialized VFSes that do require it.
**
** <li>[[DBSQL_FCNTL_WIN32_AV_RETRY]]
** ^The [DBSQL_FCNTL_WIN32_AV_RETRY] opcode is used to configure automatic
** retry counts and intervals for certain disk I/O operations for the
** windows [VFS] in order to provide robustness in the presence of
** anti-virus programs.  By default, the windows VFS will retry file read,
** file write, and file delete operations up to 10 times, with a delay
** of 25 milliseconds before the first retry and with the delay increasing
** by an additional 25 milliseconds with each subsequent retry.  This
** opcode allows these two values (10 retries and 25 milliseconds of delay)
** to be adjusted.  The values are changed for all database connections
** within the same process.  The argument is a pointer to an array of two
** integers where the first integer is the new retry count and the second
** integer is the delay.  If either integer is negative, then the setting
** is not changed but instead the prior value of that setting is written
** into the array entry, allowing the current retry settings to be
** interrogated.  The db_name parameter is ignored.
**
** <li>[[DBSQL_FCNTL_PERSIST_WAL]]
** ^The [DBSQL_FCNTL_PERSIST_WAL] opcode is used to set or query the
** persistent [WAL | Write Ahead Log] setting.  By default, the auxiliary
** write ahead log ([WAL file]) and shared memory
** files used for transaction control
** are automatically deleted when the latest connection to the database
** closes.  Setting persistent WAL mode causes those files to persist after
** close.  Persisting the files is useful when other processes that do not
** have write permission on the directory containing the database file want
** to read the database file, as the WAL and shared memory files must exist
** in order for the database to be readable.  The fourth parameter to
** [dbsql_file_control()] for this opcode should be a pointer to an integer.
** That integer is 0 to disable persistent WAL mode or 1 to enable persistent
** WAL mode.  If the integer is -1, then it is overwritten with the current
** WAL persistence setting.
**
** <li>[[DBSQL_FCNTL_POWERSAFE_OVERWRITE]]
** ^The [DBSQL_FCNTL_POWERSAFE_OVERWRITE] opcode is used to set or query the
** persistent "powersafe-overwrite" or "PSOW" setting.  The PSOW setting
** determines the [DBSQL_IOCAP_POWERSAFE_OVERWRITE] bit of the
** device_characteristics methods. The fourth parameter to
** [dbsql_file_control()] for this opcode should be a pointer to an integer.
** That integer is 0 to disable zero-damage mode or 1 to enable zero-damage
** mode.  If the integer is -1, then it is overwritten with the current
** zero-damage mode setting.
**
** <li>[[DBSQL_FCNTL_OVERWRITE]]
** ^The [DBSQL_FCNTL_OVERWRITE] opcode is invoked by dbsql after opening
** a write transaction to indicate that, unless it is rolled back for some
** reason, the entire database file will be overwritten by the current
** transaction. This is used by VACUUM operations.
**
** <li>[[DBSQL_FCNTL_VFSNAME]]
** ^The [DBSQL_FCNTL_VFSNAME] opcode can be used to obtain the names of
** all [VFSes] in the VFS stack.  The names of all VFS shims and the
** final bottom-level VFS are written into memory obtained from
** [dbsql_malloc()] and the result is stored in the char* variable
** that the fourth parameter of [dbsql_file_control()] points to.
** The caller is responsible for freeing the memory when done.  As with
** all file-control actions, there is no guarantee that this will actually
** do anything.  Callers should initialize the char* variable to a NULL
** pointer in case this file-control is not implemented.  This file-control
** is intended for diagnostic use only.
**
** <li>[[DBSQL_FCNTL_VFS_POINTER]]
** ^The [DBSQL_FCNTL_VFS_POINTER] opcode finds a pointer to the top-level
** [VFSes] currently in use.  ^(The argument X in
** dbsql_file_control(db,DBSQL_FCNTL_VFS_POINTER,X) must be
** of type "[dbsql_vfs_t] **".  This opcode will set *X
** to a pointer to the top-level VFS.)^
** ^When there are multiple VFS shims in the stack, this opcode finds the
** upper-most shim only.
**
** <li>[[DBSQL_FCNTL_PRAGMA]]
** ^Whenever a [PRAGMA] statement is parsed, an [DBSQL_FCNTL_PRAGMA]
** file control is sent to the open [dbsql_file_t] object corresponding
** to the database file to which the pragma statement refers. ^The argument
** to the [DBSQL_FCNTL_PRAGMA] file control is an array of
** pointers to strings (char**) in which the second element of the array
** is the name of the pragma and the third element is the argument to the
** pragma or NULL if the pragma has no argument.  ^The handler for an
** [DBSQL_FCNTL_PRAGMA] file control can optionally make the first element
** of the char** argument point to a string obtained from [dbsql_mprintf()]
** or the equivalent and that string will become the result of the pragma or
** the error message if the pragma fails. ^If the
** [DBSQL_FCNTL_PRAGMA] file control returns [DBSQL_NOTFOUND], then normal
** [PRAGMA] processing continues.  ^If the [DBSQL_FCNTL_PRAGMA]
** file control returns [DBSQL_OK], then the parser assumes that the
** VFS has handled the PRAGMA itself and the parser generates a no-op
** prepared statement if result string is NULL, or that returns a copy
** of the result string if the string is non-NULL.
** ^If the [DBSQL_FCNTL_PRAGMA] file control returns
** any result code other than [DBSQL_OK] or [DBSQL_NOTFOUND], that means
** that the VFS encountered an error while handling the [PRAGMA] and the
** compilation of the PRAGMA fails with an error.  ^The [DBSQL_FCNTL_PRAGMA]
** file control occurs at the beginning of pragma statement analysis and so
** it is able to override built-in [PRAGMA] statements.
**
** <li>[[DBSQL_FCNTL_BUSYHANDLER]]
** ^The [DBSQL_FCNTL_BUSYHANDLER]
** file-control may be invoked by dbsql on the database file handle
** shortly after it is opened in order to provide a custom VFS with access
** to the connection's busy-handler callback. The argument is of type (void**)
** - an array of two (void *) values. The first (void *) actually points
** to a function of type (int (*)(void *)). In order to invoke the connection's
** busy-handler, this function should be invoked with the second (void *) in
** the array as the only argument. If it returns non-zero, then the operation
** should be retried. If it returns zero, the custom VFS should abandon the
** current operation.
**
** <li>[[DBSQL_FCNTL_TEMPFILENAME]]
** ^Applications can invoke the [DBSQL_FCNTL_TEMPFILENAME] file-control
** to have dbsql generate a
** temporary filename using the same algorithm that is followed to generate
** temporary filenames for TEMP tables and other internal uses.  The
** argument should be a char** which will be filled with the filename
** written into memory obtained from [dbsql_malloc()].  The caller should
** invoke [dbsql_free()] on the result to avoid a memory leak.
**
** <li>[[DBSQL_FCNTL_MMAP_SIZE]]
** The [DBSQL_FCNTL_MMAP_SIZE] file control is used to query or set the
** maximum number of bytes that will be used for memory-mapped I/O.
** The argument is a pointer to a value of type int64_t that
** is an advisory maximum number of bytes in the file to memory map.  The
** pointer is overwritten with the old value.  The limit is not changed if
** the value originally pointed to is negative, and so the current limit
** can be queried by passing in a pointer to a negative number.  This
** file-control is used internally to implement [PRAGMA mmap_size].
**
** <li>[[DBSQL_FCNTL_TRACE]]
** The [DBSQL_FCNTL_TRACE] file control provides advisory information
** to the VFS about what the higher layers of the dbsql stack are doing.
** This file control is used by some VFS activity tracing [shims].
** The argument is a zero-terminated string.  Higher layers in the
** dbsql stack may generate instances of this file control if
** the [DBSQL_USE_FCNTL_TRACE] compile-time option is enabled.
**
** <li>[[DBSQL_FCNTL_HAS_MOVED]]
** The [DBSQL_FCNTL_HAS_MOVED] file control interprets its argument as a
** pointer to an integer and it writes a boolean into that integer depending
** on whether or not the file has been renamed, moved, or deleted since it
** was first opened.
**
** <li>[[DBSQL_FCNTL_WIN32_GET_HANDLE]]
** The [DBSQL_FCNTL_WIN32_GET_HANDLE] opcode can be used to obtain the
** underlying native file handle associated with a file handle.  This file
** control interprets its argument as a pointer to a native file handle and
** writes the resulting value there.
**
** <li>[[DBSQL_FCNTL_WIN32_SET_HANDLE]]
** The [DBSQL_FCNTL_WIN32_SET_HANDLE] opcode is used for debugging.  This
** opcode causes the file_control method to swap the file handle with the one
** pointed to by the arg argument.  This capability is used during testing
** and only needs to be supported when DBSQL_TEST is defined.
**
** <li>[[DBSQL_FCNTL_NULL_IO]]
** The [DBSQL_FCNTL_NULL_IO] opcode sets the low-level file descriptor
** or file handle for the [dbsql_file_t] object such that it will no longer
** read or write to the database file.
**
** <li>[[DBSQL_FCNTL_WAL_BLOCK]]
** The [DBSQL_FCNTL_WAL_BLOCK] is a signal to the VFS layer that it might
** be advantageous to block on the next WAL lock if the lock is not immediately
** available.  The WAL subsystem issues this signal during rare
** circumstances in order to fix a problem with priority inversion.
** Applications should <em>not</em> use this file-control.
**
** <li>[[DBSQL_FCNTL_ZIPVFS]]
** The [DBSQL_FCNTL_ZIPVFS] opcode is implemented by zipvfs only. All other
** VFS should return DBSQL_NOTFOUND for this opcode.
**
** <li>[[DBSQL_FCNTL_RBU]]
** The [DBSQL_FCNTL_RBU] opcode is implemented by the special VFS used by
** the RBU extension only.  All other VFS should return DBSQL_NOTFOUND for
** this opcode.
**
** <li>[[DBSQL_FCNTL_BEGIN_ATOMIC_WRITE]]
** If the [DBSQL_FCNTL_BEGIN_ATOMIC_WRITE] opcode returns DBSQL_OK, then
** the file descriptor is placed in "batch write mode", which
** means all subsequent write operations will be deferred and done
** atomically at the next [DBSQL_FCNTL_COMMIT_ATOMIC_WRITE].  Systems
** that do not support batch atomic writes will return DBSQL_NOTFOUND.
** ^Following a successful DBSQL_FCNTL_BEGIN_ATOMIC_WRITE and prior to
** the closing [DBSQL_FCNTL_COMMIT_ATOMIC_WRITE] or
** [DBSQL_FCNTL_ROLLBACK_ATOMIC_WRITE], dbsql will make
** no VFS interface calls on the same [dbsql_file_t] file descriptor
** except for calls to the x_write method and the file_control method
** with [DBSQL_FCNTL_SIZE_HINT].
**
** <li>[[DBSQL_FCNTL_COMMIT_ATOMIC_WRITE]]
** The [DBSQL_FCNTL_COMMIT_ATOMIC_WRITE] opcode causes all write
** operations since the previous successful call to
** [DBSQL_FCNTL_BEGIN_ATOMIC_WRITE] to be performed atomically.
** This file control returns [DBSQL_OK] if and only if the writes were
** all performed successfully and have been committed to persistent storage.
** ^Regardless of whether or not it is successful, this file control takes
** the file descriptor out of batch write mode so that all subsequent
** write operations are independent.
** ^dbsql will never invoke DBSQL_FCNTL_COMMIT_ATOMIC_WRITE without
** a prior successful call to [DBSQL_FCNTL_BEGIN_ATOMIC_WRITE].
**
** <li>[[DBSQL_FCNTL_ROLLBACK_ATOMIC_WRITE]]
** The [DBSQL_FCNTL_ROLLBACK_ATOMIC_WRITE] opcode causes all write
** operations since the previous successful call to
** [DBSQL_FCNTL_BEGIN_ATOMIC_WRITE] to be rolled back.
** ^This file control takes the file descriptor out of batch write mode
** so that all subsequent write operations are independent.
** ^dbsql will never invoke DBSQL_FCNTL_ROLLBACK_ATOMIC_WRITE without
** a prior successful call to [DBSQL_FCNTL_BEGIN_ATOMIC_WRITE].
**
** <li>[[DBSQL_FCNTL_LOCK_TIMEOUT]]
** The [DBSQL_FCNTL_LOCK_TIMEOUT] opcode is used to configure a VFS
** to block for up to M milliseconds before failing when attempting to
** obtain a file lock using the lock or shm_lock methods of the VFS.
** The parameter is a pointer to a 32-bit signed integer that contains
** the value that M is to be set to. Before returning, the 32-bit signed
** integer is overwritten with the previous value of M.
**
** <li>[[DBSQL_FCNTL_BLOCK_ON_CONNECT]]
** The [DBSQL_FCNTL_BLOCK_ON_CONNECT] opcode is used to configure the
** VFS to block when taking a SHARED lock to connect to a wal mode database.
** This is used to implement the functionality associated with
** DBSQL_SETLK_BLOCK_ON_CONNECT.
**
** <li>[[DBSQL_FCNTL_DATA_VERSION]]
** The [DBSQL_FCNTL_DATA_VERSION] opcode is used to detect changes to
** a database file.  The argument is a pointer to a 32-bit unsigned integer.
** The "data version" for the pager is written into the pointer.  The
** "data version" changes whenever any change occurs to the corresponding
** database file, either through SQL statements on the same database
** connection or through transactions committed by separate database
** connections possibly in other processes. The [dbsql_total_changes()]
** interface can be used to find if any database on the connection has changed,
** but that interface responds to changes on TEMP as well as MAIN and does
** not provide a mechanism to detect changes to MAIN only.  Also, the
** [dbsql_total_changes()] interface responds to internal changes only and
** omits changes made by other database connections.  The
** [PRAGMA data_version] command provides a mechanism to detect changes to
** a single attached database that occur due to other database connections,
** but omits changes implemented by the database connection on which it is
** called.  This file control is the only mechanism to detect changes that
** happen either internally or externally and that are associated with
** a particular attached database.
**
** <li>[[DBSQL_FCNTL_CKPT_START]]
** The [DBSQL_FCNTL_CKPT_START] opcode is invoked from within a checkpoint
** in wal mode before the client starts to copy pages from the wal
** file to the database file.
**
** <li>[[DBSQL_FCNTL_CKPT_DONE]]
** The [DBSQL_FCNTL_CKPT_DONE] opcode is invoked from within a checkpoint
** in wal mode after the client has finished copying pages from the wal
** file to the database file, but before the *-shm file is updated to
** record the fact that the pages have been checkpointed.
**
** <li>[[DBSQL_FCNTL_EXTERNAL_READER]]
** The EXPERIMENTAL [DBSQL_FCNTL_EXTERNAL_READER] opcode is used to detect
** whether or not there is a database client in another process with a wal-mode
** transaction open on the database or not. It is only available on unix. The
** (void*) argument passed with this file-control should be a pointer to a
** value of type (int). The integer value is set to 1 if the database is a wal
** mode database and there exists at least one client in another process that
** currently has an SQL transaction open on the database. It is set to 0 if
** the database is not a wal-mode db, or if there is no such connection in any
** other process. This opcode cannot be used to detect transactions opened
** by clients within the current process, only within other processes.
**
** <li>[[DBSQL_FCNTL_CKSM_FILE]]
** The [DBSQL_FCNTL_CKSM_FILE] opcode is for use internally by the
** [checksum VFS shim] only.
**
** <li>[[DBSQL_FCNTL_RESET_CACHE]]
** If there is currently no transaction open on the database, and the
** database is not a temp db, then the [DBSQL_FCNTL_RESET_CACHE] file-control
** purges the contents of the in-memory page cache. If there is an open
** transaction, or if the db is a temp-db, this opcode is a no-op, not an error.
**
** <li>[[DBSQL_FCNTL_FILESTAT]]
** The [DBSQL_FCNTL_FILESTAT] opcode returns low-level diagnostic information
** about the [dbsql_file_t] objects used access the database and journal files
** for the given schema.  The fourth parameter to [dbsql_file_control()]
** should be an initialized [dbsql_str_t] pointer.  JSON text describing
** various aspects of the dbsql_file_t object is appended to the dbsql_str_t.
** The DBSQL_FCNTL_FILESTAT opcode is usually a no-op, unless compile-time
** options are used to enable it.
** </ul>
*/
#define DBSQL_FCNTL_LOCKSTATE               1
#define DBSQL_FCNTL_GET_LOCKPROXYFILE       2
#define DBSQL_FCNTL_SET_LOCKPROXYFILE       3
#define DBSQL_FCNTL_LAST_ERRNO              4
#define DBSQL_FCNTL_SIZE_HINT               5
#define DBSQL_FCNTL_CHUNK_SIZE              6
#define DBSQL_FCNTL_FILE_POINTER            7
#define DBSQL_FCNTL_SYNC_OMITTED            8
#define DBSQL_FCNTL_WIN32_AV_RETRY          9
#define DBSQL_FCNTL_PERSIST_WAL            10
#define DBSQL_FCNTL_OVERWRITE              11
#define DBSQL_FCNTL_VFSNAME                12
#define DBSQL_FCNTL_POWERSAFE_OVERWRITE    13
#define DBSQL_FCNTL_PRAGMA                 14
#define DBSQL_FCNTL_BUSYHANDLER            15
#define DBSQL_FCNTL_TEMPFILENAME           16
#define DBSQL_FCNTL_MMAP_SIZE              18
#define DBSQL_FCNTL_TRACE                  19
#define DBSQL_FCNTL_HAS_MOVED              20
#define DBSQL_FCNTL_SYNC                   21
#define DBSQL_FCNTL_COMMIT_PHASETWO        22
#define DBSQL_FCNTL_WIN32_SET_HANDLE       23
#define DBSQL_FCNTL_WAL_BLOCK              24
#define DBSQL_FCNTL_ZIPVFS                 25
#define DBSQL_FCNTL_RBU                    26
#define DBSQL_FCNTL_VFS_POINTER            27
#define DBSQL_FCNTL_JOURNAL_POINTER        28
#define DBSQL_FCNTL_WIN32_GET_HANDLE       29
#define DBSQL_FCNTL_PDB                    30
#define DBSQL_FCNTL_BEGIN_ATOMIC_WRITE     31
#define DBSQL_FCNTL_COMMIT_ATOMIC_WRITE    32
#define DBSQL_FCNTL_ROLLBACK_ATOMIC_WRITE  33
#define DBSQL_FCNTL_LOCK_TIMEOUT           34
#define DBSQL_FCNTL_DATA_VERSION           35
#define DBSQL_FCNTL_SIZE_LIMIT             36
#define DBSQL_FCNTL_CKPT_DONE              37
#define DBSQL_FCNTL_RESERVE_BYTES          38
#define DBSQL_FCNTL_CKPT_START             39
#define DBSQL_FCNTL_EXTERNAL_READER        40
#define DBSQL_FCNTL_CKSM_FILE              41
#define DBSQL_FCNTL_RESET_CACHE            42
#define DBSQL_FCNTL_NULL_IO                43
#define DBSQL_FCNTL_BLOCK_ON_CONNECT       44
#define DBSQL_FCNTL_FILESTAT               45

/* deprecated names */
#define DBSQL_GET_LOCKPROXYFILE      DBSQL_FCNTL_GET_LOCKPROXYFILE
#define DBSQL_SET_LOCKPROXYFILE      DBSQL_FCNTL_SET_LOCKPROXYFILE
#define DBSQL_LAST_ERRNO             DBSQL_FCNTL_LAST_ERRNO

/* reserved file-control numbers:
**                                         101
**                                         102
**                                         103
*/


/*
** CAPI3REF: Mutex Handle
**
** The mutex module within dbsql defines [dbsql_mutex_t] to be an
** abstract type for a mutex object.  The dbsql core never looks
** at the internal representation of an [dbsql_mutex_t].  It only
** deals with pointers to the [dbsql_mutex_t] object.
**
** Mutexes are created using [dbsql_mutex_alloc()].
*/
typedef struct dbsql_mutex_t dbsql_mutex_t;

/*
** CAPI3REF: Loadable Extension Thunk
**
** A pointer to the opaque dbsql_api_routines_t structure is passed as
** the third parameter to entry points of [loadable extensions].  This
** structure must be typedefed in order to work around compiler warnings
** on some platforms.
*/
typedef struct dbsql_api_routines_t dbsql_api_routines_t;

/*
** CAPI3REF: File Name
**
** Type [dbsql_filename_t] is used by dbsql to pass filenames to the
** x_open method of a [VFS]. It may be cast to (const char*) and treated
** as a normal, nul-terminated, UTF-8 buffer containing the filename, but
** may also be passed to special APIs such as:
**
** <ul>
** <li>  dbsql_filename_database()
** <li>  dbsql_filename_journal()
** <li>  dbsql_filename_wal()
** <li>  dbsql_uri_parameter()
** <li>  dbsql_uri_boolean()
** <li>  dbsql_uri_int64()
** <li>  dbsql_uri_key()
** </ul>
*/
typedef const char *dbsql_filename_t;

/*
** CAPI3REF: OS Interface Object
**
** An instance of the dbsql_vfs_t object defines the interface between
** the dbsql core and the underlying operating system.  The "vfs"
** in the name of the object stands for "virtual file system".  See
** the [VFS | VFS documentation] for further information.
**
** The VFS interface is sometimes extended by adding new methods onto
** the end.  Each time such an extension occurs, the i_version field
** is incremented.  The i_version value started out as 1 in
** dbsql [version 3.5.0] on [dateof:3.5.0], then increased to 2
** with dbsql [version 3.7.0] on [dateof:3.7.0], and then increased
** to 3 with dbsql [version 3.7.6] on [dateof:3.7.6].  Additional fields
** may be appended to the dbsql_vfs_t object and the i_version value
** may increase again in future versions of dbsql.
** Note that due to an oversight, the structure
** of the dbsql_vfs_t object changed in the transition from
** dbsql [version 3.5.9] to [version 3.6.0] on [dateof:3.6.0]
** and yet the i_version field was not increased.
**
** The sz_os_file field is the size of the subclassed [dbsql_file_t]
** structure used by this VFS.  mx_pathname is the maximum length of
** a pathname in this VFS.
**
** Registered dbsql_vfs_t objects are kept on a linked list formed by
** the next pointer.  The [dbsql_vfs_register()]
** and [dbsql_vfs_unregister()] interfaces manage this list
** in a thread-safe way.  The [dbsql_vfs_find()] interface
** searches the list.  Neither the application code nor the VFS
** implementation should use the next pointer.
**
** The next field is the only field in the dbsql_vfs_t
** structure that dbsql will ever modify.  dbsql will only access
** or modify this field while holding a particular static mutex.
** The application should never modify anything within the dbsql_vfs_t
** object once the object has been registered.
**
** The name field holds the name of the VFS module.  The name must
** be unique across all VFS modules.
**
** [[dbsql_vfs_t.x_open]]
** ^dbsql guarantees that the filename parameter to x_open
** is either a NULL pointer or string obtained
** from full_pathname() with an optional suffix added.
** ^If a suffix is added to the filename parameter, it will
** consist of a single "-" character followed by no more than
** 11 alphanumeric and/or "-" characters.
** ^dbsql further guarantees that
** the string will be valid and unchanged until x_close() is
** called. Because of the previous sentence,
** the [dbsql_file_t] can safely store a pointer to the
** filename if it needs to remember the filename for some reason.
** If the filename parameter to x_open is a NULL pointer then x_open
** must invent its own temporary name for the file.  ^Whenever the
** filename parameter is NULL it will also be the case that the
** flags parameter will include [DBSQL_OPEN_DELETEONCLOSE].
**
** The flags argument to x_open() includes all bits set in
** the flags argument to [dbsql_open_v2()].  Or if [dbsql_open()]
** or [dbsql_open16()] is used, then flags includes at least
** [DBSQL_OPEN_READWRITE] | [DBSQL_OPEN_CREATE].
** If x_open() opens a file read-only then it sets *out_flags to
** include [DBSQL_OPEN_READONLY].  Other bits in *out_flags may be set.
**
** ^(dbsql will also add one of the following flags to the x_open()
** call, depending on the object being opened:
**
** <ul>
** <li>  [DBSQL_OPEN_MAIN_DB]
** <li>  [DBSQL_OPEN_MAIN_JOURNAL]
** <li>  [DBSQL_OPEN_TEMP_DB]
** <li>  [DBSQL_OPEN_TEMP_JOURNAL]
** <li>  [DBSQL_OPEN_TRANSIENT_DB]
** <li>  [DBSQL_OPEN_SUBJOURNAL]
** <li>  [DBSQL_OPEN_SUPER_JOURNAL]
** <li>  [DBSQL_OPEN_WAL]
** </ul>)^
**
** The file I/O implementation can use the object type flags to
** change the way it deals with files.  For example, an application
** that does not care about crash recovery or rollback might make
** the open of a journal file a no-op.  Writes to this journal would
** also be no-ops, and any attempt to read the journal would return
** DBSQL_IOERR.  Or the implementation might recognize that a database
** file will be doing page-aligned sector reads and writes in a random
** order and set up its I/O subsystem accordingly.
**
** dbsql might also add one of the following flags to the x_open method:
**
** <ul>
** <li> [DBSQL_OPEN_DELETEONCLOSE]
** <li> [DBSQL_OPEN_EXCLUSIVE]
** </ul>
**
** The [DBSQL_OPEN_DELETEONCLOSE] flag means the file should be
** deleted when it is closed.  ^The [DBSQL_OPEN_DELETEONCLOSE]
** will be set for TEMP databases and their journals, transient
** databases, and subjournals.
**
** ^The [DBSQL_OPEN_EXCLUSIVE] flag is always used in conjunction
** with the [DBSQL_OPEN_CREATE] flag, which are both directly
** analogous to the O_EXCL and O_CREAT flags of the POSIX open()
** API.  The DBSQL_OPEN_EXCLUSIVE flag, when paired with the
** DBSQL_OPEN_CREATE, is used to indicate that file should always
** be created, and that it is an error if it already exists.
** It is <i>not</i> used to indicate the file should be opened
** for exclusive access.
**
** ^At least sz_os_file bytes of memory are allocated by dbsql
** to hold the [dbsql_file_t] structure passed as the third
** argument to x_open.  The x_open method does not have to
** allocate the structure; it should just fill it in.  Note that
** the x_open method must set the dbsql_file_t.methods to either
** a valid [dbsql_io_methods_t] object or to NULL.  x_open must do
** this even if the open fails.  dbsql expects that the dbsql_file_t.methods
** element will be valid after x_open returns regardless of the success
** or failure of the x_open call.
**
** [[dbsql_vfs_t.x_access]]
** ^The flags argument to x_access() may be [DBSQL_ACCESS_EXISTS]
** to test for the existence of a file, or [DBSQL_ACCESS_READWRITE] to
** test whether a file is readable and writable, or [DBSQL_ACCESS_READ]
** to test whether a file is at least readable.  The DBSQL_ACCESS_READ
** flag is never actually used and is not implemented in the built-in
** VFSes of dbsql.  The file is named by the second argument and can be a
** directory. The x_access method returns [DBSQL_OK] on success or some
** non-zero error code if there is an I/O error or if the name of
** the file given in the second argument is illegal.  If DBSQL_OK
** is returned, then non-zero or zero is written into *res_out to indicate
** whether or not the file is accessible.
**
** ^dbsql will always allocate at least mx_pathname+1 bytes for the
** output buffer full_pathname.  The exact size of the output buffer
** is also passed as a parameter to both  methods. If the output buffer
** is not large enough, [DBSQL_CANTOPEN] should be returned. Since this is
** handled as a fatal error by dbsql, vfs implementations should endeavor
** to prevent this by setting mx_pathname to a sufficiently large value.
**
** The randomness(), x_sleep(), current_time(), and current_time_int64()
** interfaces are not strictly a part of the filesystem, but they are
** included in the VFS structure for completeness.
** The randomness() function attempts to return n_bytes bytes
** of good-quality randomness into out.  The return value is
** the actual number of bytes of randomness obtained.
** The x_sleep() method causes the calling thread to sleep for at
** least the number of microseconds given.  ^The current_time()
** method returns a Julian Day Number for the current date and time as
** a floating point value.
** ^The current_time_int64() method returns, as an integer, the Julian
** Day Number multiplied by 86400000 (the number of milliseconds in
** a 24-hour day).
** ^dbsql will use the current_time_int64() method to get the current
** date and time if that method is available (if i_version is 2 or
** greater and the function pointer is not NULL) and will fall back
** to current_time() if current_time_int64() is unavailable.
**
** ^The set_system_call(), get_system_call(), and next_system_call() interfaces
** are not used by the dbsql core.  These optional interfaces are provided
** by some VFSes to facilitate testing of the VFS code. By overriding
** system calls with functions under its control, a test program can
** simulate faults and error conditions that would otherwise be difficult
** or impossible to induce.  The set of system calls that can be overridden
** varies from one VFS to another, and from one version of the same VFS to the
** next.  Applications that use these interfaces must be prepared for any
** or all of these interfaces to be NULL or for their behavior to change
** from one release to the next.  Applications must not attempt to access
** any of these methods if the i_version of the VFS is less than 3.
*/
typedef struct dbsql_vfs_t dbsql_vfs_t;
typedef void (*dbsql_syscall_ptr)(void);
struct dbsql_vfs_t {
  int i_version;            /* Structure version number (currently 3) */
  int sz_os_file;            /* Size of subclassed dbsql_file_t */
  int mx_pathname;          /* Maximum file pathname length */
  dbsql_vfs_t *next;      /* Next registered VFS */
  const char *name;       /* Name of this virtual file system */
  void *app_data;          /* Pointer to application-specific data */
  int (*x_open)(dbsql_vfs_t*, dbsql_filename_t name, dbsql_file_t*,
               int flags, int *out_flags);
  int (*x_delete)(dbsql_vfs_t*, const char *name, int sync_dir);
  int (*x_access)(dbsql_vfs_t*, const char *name, int flags, int *res_out);
  int (*full_pathname)(dbsql_vfs_t*, const char *name, int n_out, char *out);
  void *(*dl_open)(dbsql_vfs_t*, const char *filename);
  void (*dl_error)(dbsql_vfs_t*, int n_byte, char *errmsg);
  void (*(*dl_sym)(dbsql_vfs_t*,void*, const char *symbol))(void);
  void (*dl_close)(dbsql_vfs_t*, void*);
  int (*randomness)(dbsql_vfs_t*, int n_byte, char *out);
  int (*x_sleep)(dbsql_vfs_t*, int microseconds);
  int (*current_time)(dbsql_vfs_t*, double*);
  int (*get_last_error)(dbsql_vfs_t*, int, char *);
  /*
  ** The methods above are in version 1 of the dbsql_vfs object
  ** definition.  Those that follow are added in version 2 or later
  */
  int (*current_time_int64)(dbsql_vfs_t*, int64_t*);
  /*
  ** The methods above are in versions 1 and 2 of the dbsql_vfs object.
  ** Those below are for version 3 and greater.
  */
  int (*set_system_call)(dbsql_vfs_t*, const char *name, dbsql_syscall_ptr);
  dbsql_syscall_ptr (*get_system_call)(dbsql_vfs_t*, const char *name);
  const char *(*next_system_call)(dbsql_vfs_t*, const char *name);
  /*
  ** The methods above are in versions 1 through 3 of the dbsql_vfs object.
  ** New fields may be appended in future versions.  The i_version
  ** value will increment whenever this happens.
  */
};

/*
** CAPI3REF: Flags for the x_access VFS method
**
** These integer constants can be used as the third parameter to
** the x_access method of an [dbsql_vfs_t] object.  They determine
** what kind of permissions the x_access method is looking for.
** with_t DBSQL_ACCESS_EXISTS, the x_access method
** simply checks whether the file exists.
** with_t DBSQL_ACCESS_READWRITE, the x_access method
** checks whether the named directory is both readable and writable
** (in other words, if files can be added, removed, and renamed within
** the directory).
** The DBSQL_ACCESS_READWRITE constant is currently used only by the
** [temp_store_directory pragma], though this could change in a future
** release of dbsql.
** with_t DBSQL_ACCESS_READ, the x_access method
** checks whether the file is readable.  The DBSQL_ACCESS_READ constant is
** currently unused, though it might be used in a future release of
** dbsql.
*/
#define DBSQL_ACCESS_EXISTS    0
#define DBSQL_ACCESS_READWRITE 1   /* Used by PRAGMA temp_store_directory */
#define DBSQL_ACCESS_READ      2   /* Unused */

/*
** CAPI3REF: Flags for the shm_lock VFS method
**
** These integer constants define the various locking operations
** allowed by the shm_lock method of [dbsql_io_methods_t].  The
** following are the only legal combinations of flags to the
** shm_lock method:
**
** <ul>
** <li>  DBSQL_SHM_LOCK | DBSQL_SHM_SHARED
** <li>  DBSQL_SHM_LOCK | DBSQL_SHM_EXCLUSIVE
** <li>  DBSQL_SHM_UNLOCK | DBSQL_SHM_SHARED
** <li>  DBSQL_SHM_UNLOCK | DBSQL_SHM_EXCLUSIVE
** </ul>
**
** When unlocking, the same SHARED or EXCLUSIVE flag must be supplied as
** was given on the corresponding lock.
**
** The shm_lock method can transition between unlocked and SHARED or
** between unlocked and EXCLUSIVE.  It cannot transition between SHARED
** and EXCLUSIVE.
*/
#define DBSQL_SHM_UNLOCK       1
#define DBSQL_SHM_LOCK         2
#define DBSQL_SHM_SHARED       4
#define DBSQL_SHM_EXCLUSIVE    8

/*
** CAPI3REF: Maximum shm_lock index
**
** The shm_lock method on [dbsql_io_methods_t] may use values
** between 0 and this upper bound as its "offset" argument.
** The dbsql core will never attempt to acquire or release a
** lock outside of this range
*/
#define DBSQL_SHM_NLOCK        8


/*
** CAPI3REF: Initialize The dbsql Library
**
** ^The dbsql_initialize() routine initializes the
** dbsql library.  ^The dbsql_shutdown() routine
** deallocates any resources that were allocated by dbsql_initialize().
** These routines are designed to aid in process initialization and
** shutdown on embedded systems.  Workstation applications using
** dbsql normally do not need to invoke either of these routines.
**
** A call to dbsql_initialize() is an "effective" call if it is
** the first time dbsql_initialize() is invoked during the lifetime of
** the process, or if it is the first time dbsql_initialize() is invoked
** following a call to dbsql_shutdown().  ^(Only an effective call
** of dbsql_initialize() does any initialization.  All other calls
** are harmless no-ops.)^
**
** A call to dbsql_shutdown() is an "effective" call if it is the first
** call to dbsql_shutdown() since the last dbsql_initialize().  ^(Only
** an effective call to dbsql_shutdown() does any deinitialization.
** All other valid calls to dbsql_shutdown() are harmless no-ops.)^
**
** The dbsql_initialize() interface is threadsafe, but dbsql_shutdown()
** is not.  The dbsql_shutdown() interface must only be called from a
** single thread.  All open [database connections] must be closed and all
** other dbsql resources must be deallocated prior to invoking
** dbsql_shutdown().
**
** Among other things, ^dbsql_initialize() will invoke
** dbsql_os_init().  Similarly, ^dbsql_shutdown()
** will invoke dbsql_os_end().
**
** ^The dbsql_initialize() routine returns [DBSQL_OK] on success.
** ^If for some reason, dbsql_initialize() is unable to initialize
** the library (perhaps it is unable to allocate a needed resource such
** as a mutex) it returns an [error code] other than [DBSQL_OK].
**
** ^The dbsql_initialize() routine is called internally by many other
** dbsql interfaces so that an application usually does not need to
** invoke dbsql_initialize() directly.  For example, [dbsql_open()]
** calls dbsql_initialize() so the dbsql library will be automatically
** initialized when [dbsql_open()] is called if it has not been initialized
** already.  ^However, if dbsql is compiled with the [DBSQL_OMIT_AUTOINIT]
** compile-time option, then the automatic calls to dbsql_initialize()
** are omitted and the application must call dbsql_initialize() directly
** prior to using any other dbsql interface.  For maximum portability,
** it is recommended that applications always invoke dbsql_initialize()
** directly prior to using any other dbsql interface.  Future releases
** of dbsql may require this.  In other words, the behavior exhibited
** when dbsql is compiled with [DBSQL_OMIT_AUTOINIT] might become the
** default behavior in some future release of dbsql.
**
** The dbsql_os_init() routine does operating-system specific
** initialization of the dbsql library.  The dbsql_os_end()
** routine undoes the effect of dbsql_os_init().  Typical tasks
** performed by these routines include allocation or deallocation
** of static resources, initialization of global variables,
** setting up a default [dbsql_vfs_t] module, or setting up
** a default configuration using [dbsql_config()].
**
** The application should never invoke either dbsql_os_init()
** or dbsql_os_end() directly.  The application should only invoke
** dbsql_initialize() and dbsql_shutdown().  The dbsql_os_init()
** interface is called automatically by dbsql_initialize() and
** dbsql_os_end() is called by dbsql_shutdown().  Appropriate
** implementations for dbsql_os_init() and dbsql_os_end()
** are built into dbsql when it is compiled for Unix, Windows, or OS/2.
** When [custom builds | built for other platforms]
** (using the [DBSQL_OS_OTHER=1] compile-time
** option) the application must supply a suitable implementation for
** dbsql_os_init() and dbsql_os_end().  An application-supplied
** implementation of dbsql_os_init() or dbsql_os_end()
** must return [DBSQL_OK] on success and some other [error code] upon
** failure.
*/
int dbsql_initialize(void);
int dbsql_shutdown(void);
int dbsql_os_init(void);
int dbsql_os_end(void);

/*
** CAPI3REF: Configuring The dbsql Library
**
** The dbsql_config() interface is used to make global configuration
** changes to dbsql in order to tune dbsql to the specific needs of
** the application.  The default configuration is recommended for most
** applications and so this routine is usually not necessary.  It is
** provided to support rare applications with unusual needs.
**
** <b>The dbsql_config() interface is not threadsafe. The application
** must ensure that no other dbsql interfaces are invoked by other
** threads while dbsql_config() is running.</b>
**
** The first argument to dbsql_config() is an integer
** [configuration option] that determines
** what property of dbsql is to be configured.  Subsequent arguments
** vary depending on the [configuration option]
** in the first argument.
**
** For most configuration options, the dbsql_config() interface
** may only be invoked prior to library initialization using
** [dbsql_initialize()] or after shutdown by [dbsql_shutdown()].
** The exceptional configuration options that may be invoked at any time
** are called "anytime configuration options".
** ^If dbsql_config() is called after [dbsql_initialize()] and before
** [dbsql_shutdown()] with a first argument that is not an anytime
** configuration option, then the dbsql_config() call will
** return DBSQL_MISUSE.
** Note, however, that ^dbsql_config() can be called as part of the
** implementation of an application-defined [dbsql_os_init()].
**
** ^When a configuration option is set, dbsql_config() returns [DBSQL_OK].
** ^If the option is unknown or dbsql is unable to set the option
** then this routine returns a non-zero [error code].
*/
int dbsql_config(int, ...);

/*
** CAPI3REF: Configure database connections
** METHOD: DBSQL
**
** The dbsql_db_config() interface is used to make configuration
** changes to a [database connection].  The interface is similar to
** [dbsql_config()] except that the changes apply to a single
** [database connection] (specified in the first argument).
**
** The second argument to dbsql_db_config(D,V,...)  is the
** [DBSQL_DBCONFIG_LOOKASIDE | configuration verb] - an integer code
** that indicates what aspect of the [database connection] is being configured.
** Subsequent arguments vary depending on the configuration verb.
**
** ^Calls to dbsql_db_config() return DBSQL_OK if and only if
** the call is considered successful.
*/
int dbsql_db_config(DBSQL*, int op, ...);

/*
** CAPI3REF: Memory Allocation Routines
**
** An instance of this object defines the interface between dbsql
** and low-level memory allocation routines.
**
** This object is used in only one place in the dbsql interface.
** A pointer to an instance of this object is the argument to
** [dbsql_config()] when the configuration option is
** [DBSQL_CONFIG_MALLOC] or [DBSQL_CONFIG_GETMALLOC].
** By creating an instance of this object
** and passing it to [dbsql_config]([DBSQL_CONFIG_MALLOC])
** during configuration, an application can specify an alternative
** memory allocation subsystem for dbsql to use for all of its
** dynamic memory needs.
**
** Note that dbsql comes with several [built-in memory allocators]
** that are perfectly adequate for the overwhelming majority of applications
** and that this object is only useful to a tiny minority of applications
** with specialized memory allocation requirements.  This object is
** also used during testing of dbsql in order to specify an alternative
** memory allocator that simulates memory out-of-memory conditions in
** order to verify that dbsql recovers gracefully from such
** conditions.
**
** The x_malloc, x_realloc, and __x_free methods must work like the
** malloc(), realloc() and free() functions from the standard C library.
** ^dbsql guarantees that the second argument to
** x_realloc is always a value returned by a prior call to roundup.
**
** size should return the allocated size of a memory allocation
** previously obtained from x_malloc or x_realloc.  The allocated size
** is always at least as big as the requested size but may be larger.
**
** The roundup method returns what would be the allocated size of
** a memory allocation given a particular requested size.  Most memory
** allocators round up memory allocations at least to the next multiple
** of 8.  Some allocators round up to a larger multiple or to a power of 2.
** Every memory allocation request coming in through [dbsql_malloc()]
** or [dbsql_realloc()] first calls roundup.  If roundup returns 0,
** that causes the corresponding memory allocation to fail.
**
** The init method initializes the memory allocator.  For example,
** it might allocate any required mutexes or initialize internal data
** structures.  The shutdown method is invoked (indirectly) by
** [dbsql_shutdown()] and should deallocate any resources acquired
** by init.  The app_data pointer is used as the only parameter to
** init and shutdown.
**
** dbsql holds the [DBSQL_MUTEX_STATIC_MAIN] mutex when it invokes
** the init method, so the init method need not be threadsafe.  The
** shutdown method is only called from [dbsql_shutdown()] so it does
** not need to be threadsafe either.  For all other methods, dbsql
** holds the [DBSQL_MUTEX_STATIC_MEM] mutex as long as the
** [DBSQL_CONFIG_MEMSTATUS] configuration option is turned on (which
** it is by default) and so the methods are automatically serialized.
** However, if [DBSQL_CONFIG_MEMSTATUS] is disabled, then the other
** methods must be threadsafe or else make their own arrangements for
** serialization.
**
** dbsql will never invoke init() more than once without an intervening
** call to shutdown().
*/
typedef struct dbsql_mem_methods_t dbsql_mem_methods_t;
struct dbsql_mem_methods_t {
  void *(*x_malloc)(int);         /* Memory allocation function */
  void (*__x_free)(void*);          /* Free a prior allocation */
  void *(*x_realloc)(void*,int);  /* Resize an allocation */
  int (*size)(void*);           /* Return the size of an allocation */
  int (*roundup)(int);          /* Round up request size to allocation size */
  int (*init)(void*);           /* Initialize the memory allocator */
  void (*shutdown)(void*);      /* Deinitialize the memory allocator */
  void *app_data;                /* Argument to init() and shutdown() */
};

/*
** CAPI3REF: Configuration Options
** KEYWORDS: {configuration option}
**
** These constants are the available integer configuration options that
** can be passed as the first argument to the [dbsql_config()] interface.
**
** Most of the configuration options for dbsql_config()
** will only work if invoked prior to [dbsql_initialize()] or after
** [dbsql_shutdown()].  The few exceptions to this rule are called
** "anytime configuration options".
** ^Calling [dbsql_config()] with a first argument that is not an
** anytime configuration option in between calls to [dbsql_initialize()] and
** [dbsql_shutdown()] is a no-op that returns DBSQL_MISUSE.
**
** The set of anytime configuration options can change (by insertions
** and/or deletions) from one release of dbsql to the next.
** As of dbsql version 3.42.0, the complete set of anytime configuration
** options is:
** <ul>
** <li> DBSQL_CONFIG_LOG
** <li> DBSQL_CONFIG_PCACHE_HDRSZ
** </ul>
**
** New configuration options may be added in future releases of dbsql.
** Existing configuration options might be discontinued.  Applications
** should check the return code from [dbsql_config()] to make sure that
** the call worked.  The [dbsql_config()] interface will return a
** non-zero [error code] if a discontinued or unsupported configuration option
** is invoked.
**
** <dl>
** [[DBSQL_CONFIG_SINGLETHREAD]] <dt>DBSQL_CONFIG_SINGLETHREAD</dt>
** <dd>There are no arguments to this option.  ^This option sets the
** [threading mode] to Single-thread.  In other words, it disables
** all mutexing and puts dbsql into a mode where it can only be used
** by a single thread.   ^If dbsql is compiled with
** the [DBSQL_THREADSAFE | DBSQL_THREADSAFE=0] compile-time option then
** it is not possible to change the [threading mode] from its default
** value of Single-thread and so [dbsql_config()] will return
** [DBSQL_ERROR] if called with the DBSQL_CONFIG_SINGLETHREAD
** configuration option.</dd>
**
** [[DBSQL_CONFIG_MULTITHREAD]] <dt>DBSQL_CONFIG_MULTITHREAD</dt>
** <dd>There are no arguments to this option.  ^This option sets the
** [threading mode] to Multi-thread.  In other words, it disables
** mutexing on [database connection] and [prepared statement] objects.
** The application is responsible for serializing access to
** [database connections] and [prepared statements].  But other mutexes
** are enabled so that dbsql will be safe to use in a multi-threaded
** environment as long as no two threads attempt to use the same
** [database connection] at the same time.  ^If dbsql is compiled with
** the [DBSQL_THREADSAFE | DBSQL_THREADSAFE=0] compile-time option then
** it is not possible to set the Multi-thread [threading mode] and
** [dbsql_config()] will return [DBSQL_ERROR] if called with the
** DBSQL_CONFIG_MULTITHREAD configuration option.</dd>
**
** [[DBSQL_CONFIG_SERIALIZED]] <dt>DBSQL_CONFIG_SERIALIZED</dt>
** <dd>There are no arguments to this option.  ^This option sets the
** [threading mode] to Serialized. In other words, this option enables
** all mutexes including the recursive
** mutexes on [database connection] and [prepared statement] objects.
** In this mode (which is the default when dbsql is compiled with
** [DBSQL_THREADSAFE=1]) the dbsql library will itself serialize access
** to [database connections] and [prepared statements] so that the
** application is free to use the same [database connection] or the
** same [prepared statement] in different threads at the same time.
** ^If dbsql is compiled with
** the [DBSQL_THREADSAFE | DBSQL_THREADSAFE=0] compile-time option then
** it is not possible to set the Serialized [threading mode] and
** [dbsql_config()] will return [DBSQL_ERROR] if called with the
** DBSQL_CONFIG_SERIALIZED configuration option.</dd>
**
** [[DBSQL_CONFIG_MALLOC]] <dt>DBSQL_CONFIG_MALLOC</dt>
** <dd> ^(The DBSQL_CONFIG_MALLOC option takes a single argument which is
** a pointer to an instance of the [dbsql_mem_methods_t] structure.
** The argument specifies
** alternative low-level memory allocation routines to be used in place of
** the memory allocation routines built into dbsql.)^ ^dbsql makes
** its own private copy of the content of the [dbsql_mem_methods_t] structure
** before the [dbsql_config()] call returns.</dd>
**
** [[DBSQL_CONFIG_GETMALLOC]] <dt>DBSQL_CONFIG_GETMALLOC</dt>
** <dd> ^(The DBSQL_CONFIG_GETMALLOC option takes a single argument which
** is a pointer to an instance of the [dbsql_mem_methods_t] structure.
** The [dbsql_mem_methods_t]
** structure is filled with the currently defined memory allocation routines.)^
** This option can be used to overload the default memory allocation
** routines with a wrapper that simulates memory allocation failure or
** tracks memory usage, for example. </dd>
**
** [[DBSQL_CONFIG_SMALL_MALLOC]] <dt>DBSQL_CONFIG_SMALL_MALLOC</dt>
** <dd> ^The DBSQL_CONFIG_SMALL_MALLOC option takes a single argument of
** type int, interpreted as a boolean, which if true provides a hint to
** dbsql that it should avoid large memory allocations if possible.
** dbsql will run faster if it is free to make large memory allocations,
** but some applications might prefer to run slower in exchange for
** guarantees about memory fragmentation that are possible if large
** allocations are avoided.  This hint is normally off.
** </dd>
**
** [[DBSQL_CONFIG_MEMSTATUS]] <dt>DBSQL_CONFIG_MEMSTATUS</dt>
** <dd> ^The DBSQL_CONFIG_MEMSTATUS option takes a single argument of type int,
** interpreted as a boolean, which enables or disables the collection of
** memory allocation statistics. ^(When memory allocation statistics are
** disabled, the following dbsql interfaces become non-operational:
**   <ul>
**   <li> [dbsql_hard_heap_limit64()]
**   <li> [dbsql_memory_used()]
**   <li> [dbsql_memory_highwater()]
**   <li> [dbsql_soft_heap_limit64()]
**   <li> [dbsql_status64()]
**   </ul>)^
** ^Memory allocation statistics are enabled by default unless dbsql is
** compiled with [DBSQL_DEFAULT_MEMSTATUS]=0 in which case memory
** allocation statistics are disabled by default.
** </dd>
**
** [[DBSQL_CONFIG_SCRATCH]] <dt>DBSQL_CONFIG_SCRATCH</dt>
** <dd> The DBSQL_CONFIG_SCRATCH option is no longer used.
** </dd>
**
** [[DBSQL_CONFIG_PAGECACHE]] <dt>DBSQL_CONFIG_PAGECACHE</dt>
** <dd> ^The DBSQL_CONFIG_PAGECACHE option specifies a memory pool
** that dbsql can use for the database page cache with the default page
** cache implementation.
** This configuration option is a no-op if an application-defined page
** cache implementation is loaded using the [DBSQL_CONFIG_PCACHE2].
** ^There are three arguments to DBSQL_CONFIG_PAGECACHE: A pointer to
** 8-byte aligned memory (mem), the size of each page cache line (sz),
** and the number of cache lines (N).
** The sz argument should be the size of the largest database page
** (a power of two between 512 and 65536) plus some extra bytes for each
** page header.  ^The number of extra bytes needed by the page header
** can be determined using [DBSQL_CONFIG_PCACHE_HDRSZ].
** ^It is harmless, apart from the wasted memory,
** for the sz parameter to be larger than necessary.  The mem
** argument must be either a NULL pointer or a pointer to an 8-byte
** aligned block of memory of at least sz*N bytes, otherwise
** subsequent behavior is undefined.
** ^When mem is not NULL, dbsql will strive to use the memory provided
** to satisfy page cache needs, falling back to [dbsql_malloc()] if
** a page cache line is larger than sz bytes or if all of the mem buffer
** is exhausted.
** ^If mem is NULL and N is non-zero, then each database connection
** does an initial bulk allocation for page cache memory
** from [dbsql_malloc()] sufficient for N cache lines if N is positive or
** of -1024*N bytes if N is negative. ^If additional
** page cache memory is needed beyond what is provided by the initial
** allocation, then dbsql goes to [dbsql_malloc()] separately for each
** additional cache line. </dd>
**
** [[DBSQL_CONFIG_HEAP]] <dt>DBSQL_CONFIG_HEAP</dt>
** <dd> ^The DBSQL_CONFIG_HEAP option specifies a static memory buffer
** that dbsql will use for all of its dynamic memory allocation needs
** beyond those provided for by [DBSQL_CONFIG_PAGECACHE].
** ^The DBSQL_CONFIG_HEAP option is only available if dbsql is compiled
** with either [DBSQL_ENABLE_MEMSYS3] or [DBSQL_ENABLE_MEMSYS5] and returns
** [DBSQL_ERROR] if invoked otherwise.
** ^There are three arguments to DBSQL_CONFIG_HEAP:
** An 8-byte aligned pointer to the memory,
** the number of bytes in the memory buffer, and the minimum allocation size.
** ^If the first pointer (the memory pointer) is NULL, then dbsql reverts
** to using its default memory allocator (the system malloc() implementation),
** undoing any prior invocation of [DBSQL_CONFIG_MALLOC].  ^If the
** memory pointer is not NULL then the alternative memory
** allocator is engaged to handle all of SQLites memory allocation needs.
** The first pointer (the memory pointer) must be aligned to an 8-byte
** boundary or subsequent behavior of dbsql will be undefined.
** The minimum allocation size is capped at 2**12. Reasonable values
** for the minimum allocation size are 2**5 through 2**8.</dd>
**
** [[DBSQL_CONFIG_MUTEX]] <dt>DBSQL_CONFIG_MUTEX</dt>
** <dd> ^(The DBSQL_CONFIG_MUTEX option takes a single argument which is a
** pointer to an instance of the [dbsql_mutex_methods_t] structure.
** The argument specifies alternative low-level mutex routines to be used
** in place of the mutex routines built into dbsql.)^  ^dbsql makes a copy of
** the content of the [dbsql_mutex_methods_t] structure before the call to
** [dbsql_config()] returns. ^If dbsql is compiled with
** the [DBSQL_THREADSAFE | DBSQL_THREADSAFE=0] compile-time option then
** the entire mutexing subsystem is omitted from the build and hence calls to
** [dbsql_config()] with the DBSQL_CONFIG_MUTEX configuration option will
** return [DBSQL_ERROR].</dd>
**
** [[DBSQL_CONFIG_GETMUTEX]] <dt>DBSQL_CONFIG_GETMUTEX</dt>
** <dd> ^(The DBSQL_CONFIG_GETMUTEX option takes a single argument which
** is a pointer to an instance of the [dbsql_mutex_methods_t] structure.  The
** [dbsql_mutex_methods_t]
** structure is filled with the currently defined mutex routines.)^
** This option can be used to overload the default mutex allocation
** routines with a wrapper used to track mutex usage for performance
** profiling or testing, for example.   ^If dbsql is compiled with
** the [DBSQL_THREADSAFE | DBSQL_THREADSAFE=0] compile-time option then
** the entire mutexing subsystem is omitted from the build and hence calls to
** [dbsql_config()] with the DBSQL_CONFIG_GETMUTEX configuration option will
** return [DBSQL_ERROR].</dd>
**
** [[DBSQL_CONFIG_LOOKASIDE]] <dt>DBSQL_CONFIG_LOOKASIDE</dt>
** <dd> ^(The DBSQL_CONFIG_LOOKASIDE option takes two arguments that determine
** the default size of [lookaside memory] on each [database connection].
** The first argument is the
** size of each lookaside buffer slot ("sz") and the second is the number of
** slots allocated to each database connection ("cnt").)^
** ^(DBSQL_CONFIG_LOOKASIDE sets the <i>default</i> lookaside size.
** The [DBSQL_DBCONFIG_LOOKASIDE] option to [dbsql_db_config()] can
** be used to change the lookaside configuration on individual connections.)^
** The [-DSQLITE_DEFAULT_LOOKASIDE] option can be used to change the
** default lookaside configuration at compile-time.
** </dd>
**
** [[DBSQL_CONFIG_PCACHE2]] <dt>DBSQL_CONFIG_PCACHE2</dt>
** <dd> ^(The DBSQL_CONFIG_PCACHE2 option takes a single argument which is
** a pointer to an [dbsql_pcache_methods2_t] object.  This object specifies
** the interface to a custom page cache implementation.)^
** ^dbsql makes a copy of the [dbsql_pcache_methods2_t] object.</dd>
**
** [[DBSQL_CONFIG_GETPCACHE2]] <dt>DBSQL_CONFIG_GETPCACHE2</dt>
** <dd> ^(The DBSQL_CONFIG_GETPCACHE2 option takes a single argument which
** is a pointer to an [dbsql_pcache_methods2_t] object.  dbsql copies off
** the current page cache implementation into that object.)^ </dd>
**
** [[DBSQL_CONFIG_LOG]] <dt>DBSQL_CONFIG_LOG</dt>
** <dd> The DBSQL_CONFIG_LOG option is used to configure the dbsql
** global [error log].
** (^The DBSQL_CONFIG_LOG option takes two arguments: a pointer to a
** function with a call signature of void(*)(void*,int,const char*),
** and a pointer to void. ^If the function pointer is not NULL, it is
** invoked by [dbsql_log()] to process each logging event.  ^If the
** function pointer is NULL, the [dbsql_log()] interface becomes a no-op.
** ^The void pointer that is the second argument to DBSQL_CONFIG_LOG is
** passed through as the first parameter to the application-defined logger
** function whenever that function is invoked.  ^The second parameter to
** the logger function is a copy of the first parameter to the corresponding
** [dbsql_log()] call and is intended to be a [result code] or an
** [extended result code].  ^The third parameter passed to the logger is
** a log message after formatting via [dbsql_snprintf()].
** The dbsql logging interface is not reentrant; the logger function
** supplied by the application must not invoke any dbsql interface.
** In a multi-threaded application, the application-defined logger
** function must be threadsafe. </dd>
**
** [[DBSQL_CONFIG_URI]] <dt>DBSQL_CONFIG_URI
** <dd>^(The DBSQL_CONFIG_URI option takes a single argument of type int.
** If non-zero, then URI handling is globally enabled. If the parameter is zero,
** then URI handling is globally disabled.)^ ^If URI handling is globally
** enabled, all filenames passed to [dbsql_open()], [dbsql_open_v2()],
** [dbsql_open16()] or
** specified as part of [ATTACH] commands are interpreted as URIs, regardless
** of whether or not the [DBSQL_OPEN_URI] flag is set when the database
** connection is opened. ^If it is globally disabled, filenames are
** only interpreted as URIs if the DBSQL_OPEN_URI flag is set when the
** database connection is opened. ^(By default, URI handling is globally
** disabled. The default value may be changed by compiling with the
** [DBSQL_USE_URI] symbol defined.)^
**
** [[DBSQL_CONFIG_COVERING_INDEX_SCAN]] <dt>DBSQL_CONFIG_COVERING_INDEX_SCAN
** <dd>^The DBSQL_CONFIG_COVERING_INDEX_SCAN option takes a single integer
** argument which is interpreted as a boolean in order to enable or disable
** the use of covering indices for full table scans in the query optimizer.
** ^The default setting is determined
** by the [DBSQL_ALLOW_COVERING_INDEX_SCAN] compile-time option, or is "on"
** if that compile-time option is omitted.
** The ability to disable the use of covering indices for full table scans
** is because some incorrectly coded legacy applications might malfunction
** when the optimization is enabled.  Providing the ability to
** disable the optimization allows the older, buggy application code to work
** without change even with newer versions of dbsql.
**
** [[DBSQL_CONFIG_PCACHE]] [[DBSQL_CONFIG_GETPCACHE]]
** <dt>DBSQL_CONFIG_PCACHE and DBSQL_CONFIG_GETPCACHE
** <dd> These options are obsolete and should not be used by new code.
** They are retained for backwards compatibility but are now no-ops.
** </dd>
**
** [[DBSQL_CONFIG_SQLLOG]]
** <dt>DBSQL_CONFIG_SQLLOG
** <dd>This option is only available if sqlite is compiled with the
** [DBSQL_ENABLE_SQLLOG] pre-processor macro defined. The first argument should
** be a pointer to a function of type void(*)(void*,DBSQL*,const char*, int).
** The second should be of type (void*). The callback is invoked by the library
** in three separate circumstances, identified by the value passed as the
** fourth parameter. If the fourth parameter is 0, then the database connection
** passed as the second argument has just been opened. The third argument
** points to a buffer containing the name of the main database file. If the
** fourth parameter is 1, then the SQL statement that the third parameter
** points to has just been executed. Or, if the fourth parameter is 2, then
** the connection being passed as the second parameter is being closed. The
** third parameter is passed NULL In this case.  An example of using this
** configuration option can be seen in the "test_sqllog.c" source file in
** the canonical dbsql source tree.</dd>
**
** [[DBSQL_CONFIG_MMAP_SIZE]]
** <dt>DBSQL_CONFIG_MMAP_SIZE
** <dd>^DBSQL_CONFIG_MMAP_SIZE takes two 64-bit integer (int64_t) values
** that are the default mmap size limit (the default setting for
** [PRAGMA mmap_size]) and the maximum allowed mmap size limit.
** ^The default setting can be overridden by each database connection using
** either the [PRAGMA mmap_size] command, or by using the
** [DBSQL_FCNTL_MMAP_SIZE] file control.  ^(The maximum allowed mmap size
** will be silently truncated if necessary so that it does not exceed the
** compile-time maximum mmap size set by the
** [DBSQL_MAX_MMAP_SIZE] compile-time option.)^
** ^If either argument to this option is negative, then that argument is
** changed to its compile-time default.
**
** [[DBSQL_CONFIG_WIN32_HEAPSIZE]]
** <dt>DBSQL_CONFIG_WIN32_HEAPSIZE
** <dd>^The DBSQL_CONFIG_WIN32_HEAPSIZE option is only available if dbsql is
** compiled for Windows with the [DBSQL_WIN32_MALLOC] pre-processor macro
** defined. ^DBSQL_CONFIG_WIN32_HEAPSIZE takes a 32-bit unsigned integer value
** that specifies the maximum size of the created heap.
**
** [[DBSQL_CONFIG_PCACHE_HDRSZ]]
** <dt>DBSQL_CONFIG_PCACHE_HDRSZ
** <dd>^The DBSQL_CONFIG_PCACHE_HDRSZ option takes a single parameter which
** is a pointer to an integer and writes into that integer the number of extra
** bytes per page required for each page in [DBSQL_CONFIG_PAGECACHE].
** The amount of extra space required can change depending on the compiler,
** target platform, and dbsql version.
**
** [[DBSQL_CONFIG_PMASZ]]
** <dt>DBSQL_CONFIG_PMASZ
** <dd>^The DBSQL_CONFIG_PMASZ option takes a single parameter which
** is an unsigned integer and sets the "Minimum PMA Size" for the multithreaded
** sorter to that integer.  The default minimum PMA Size is set by the
** [DBSQL_SORTER_PMASZ] compile-time option.  New threads are launched
** to help with sort operations when multithreaded sorting
** is enabled (using the [PRAGMA threads] command) and the amount of content
** to be sorted exceeds the page size times the minimum of the
** [PRAGMA cache_size] setting and this value.
**
** [[DBSQL_CONFIG_STMTJRNL_SPILL]]
** <dt>DBSQL_CONFIG_STMTJRNL_SPILL
** <dd>^The DBSQL_CONFIG_STMTJRNL_SPILL option takes a single parameter which
** becomes the [statement journal] spill-to-disk threshold.
** [Statement journals] are held in memory until their size (in bytes)
** exceeds this threshold, at which point they are written to disk.
** Or if the threshold is -1, statement journals are always held
** exclusively in memory.
** Since many statement journals never become large, setting the spill
** threshold to a value such as 64KiB can greatly reduce the amount of
** I/O required to support statement rollback.
** The default value for this setting is controlled by the
** [DBSQL_STMTJRNL_SPILL] compile-time option.
**
** [[DBSQL_CONFIG_SORTERREF_SIZE]]
** <dt>DBSQL_CONFIG_SORTERREF_SIZE
** <dd>The DBSQL_CONFIG_SORTERREF_SIZE option accepts a single parameter
** of type (int) - the new value of the sorter-reference size threshold.
** Usually, when dbsql uses an external sort to order records according
** to an ORDER BY clause, all fields required by the caller are present in the
** sorted records. However, if dbsql determines based on the declared type
** of a table column that its values are likely to be very large - larger
** than the configured sorter-reference size threshold - then a reference
** is stored in each sorted record and the required column values loaded
** from the database as records are returned in sorted order. The default
** value for this option is to never use this optimization. Specifying a
** negative value for this option restores the default behavior.
** This option is only available if dbsql is compiled with the
** [DBSQL_ENABLE_SORTER_REFERENCES] compile-time option.
**
** [[DBSQL_CONFIG_MEMDB_MAXSIZE]]
** <dt>DBSQL_CONFIG_MEMDB_MAXSIZE
** <dd>The DBSQL_CONFIG_MEMDB_MAXSIZE option accepts a single parameter
** [int64_t] parameter which is the default maximum size for an in-memory
** database created using [dbsql_deserialize()].  This default maximum
** size can be adjusted up or down for individual databases using the
** [DBSQL_FCNTL_SIZE_LIMIT] [dbsql_file_control|file-control].  If this
** configuration setting is never used, then the default maximum is determined
** by the [DBSQL_MEMDB_DEFAULT_MAXSIZE] compile-time option.  If that
** compile-time option is not set, then the default maximum is 1073741824.
**
** [[DBSQL_CONFIG_ROWID_IN_VIEW]]
** <dt>DBSQL_CONFIG_ROWID_IN_VIEW
** <dd>The DBSQL_CONFIG_ROWID_IN_VIEW option enables or disables the ability
** for VIEWs to have a ROWID.  The capability can only be enabled if dbsql is
** compiled with -DSQLITE_ALLOW_ROWID_IN_VIEW, in which case the capability
** defaults to on.  This configuration option queries the current setting or
** changes the setting to off or on.  The argument is a pointer to an integer.
** If that integer initially holds a value of 1, then the ability for VIEWs to
** have ROWIDs is activated.  If the integer initially holds zero, then the
** ability is deactivated.  Any other initial value for the integer leaves the
** setting unchanged.  After changes, if any, the integer is written with
** a 1 or 0, if the ability for VIEWs to have ROWIDs is on or off.  If dbsql
** is compiled without -DSQLITE_ALLOW_ROWID_IN_VIEW (which is the usual and
** recommended case) then the integer is always filled with zero, regardless
** if its initial value.
** </dl>
*/
#define DBSQL_CONFIG_SINGLETHREAD         1  /* nil */
#define DBSQL_CONFIG_MULTITHREAD          2  /* nil */
#define DBSQL_CONFIG_SERIALIZED           3  /* nil */
#define DBSQL_CONFIG_MALLOC               4  /* dbsql_mem_methods_t* */
#define DBSQL_CONFIG_GETMALLOC            5  /* dbsql_mem_methods_t* */
#define DBSQL_CONFIG_SCRATCH              6  /* No longer used */
#define DBSQL_CONFIG_PAGECACHE            7  /* void*, int sz, int N */
#define DBSQL_CONFIG_HEAP                 8  /* void*, int n_byte, int min */
#define DBSQL_CONFIG_MEMSTATUS            9  /* boolean */
#define DBSQL_CONFIG_MUTEX               10  /* dbsql_mutex_methods_t* */
#define DBSQL_CONFIG_GETMUTEX            11  /* dbsql_mutex_methods_t* */
/* previously DBSQL_CONFIG_CHUNKALLOC    12 which is now unused. */
#define DBSQL_CONFIG_LOOKASIDE           13  /* int int */
#define DBSQL_CONFIG_PCACHE              14  /* no-op */
#define DBSQL_CONFIG_GETPCACHE           15  /* no-op */
#define DBSQL_CONFIG_LOG                 16  /* func, void* */
#define DBSQL_CONFIG_URI                 17  /* int */
#define DBSQL_CONFIG_PCACHE2             18  /* dbsql_pcache_methods2_t* */
#define DBSQL_CONFIG_GETPCACHE2          19  /* dbsql_pcache_methods2_t* */
#define DBSQL_CONFIG_COVERING_INDEX_SCAN 20  /* int */
#define DBSQL_CONFIG_SQLLOG              21  /* sqllog, void* */
#define DBSQL_CONFIG_MMAP_SIZE           22  /* int64_t, int64_t */
#define DBSQL_CONFIG_WIN32_HEAPSIZE      23  /* int n_byte */
#define DBSQL_CONFIG_PCACHE_HDRSZ        24  /* int *psz */
#define DBSQL_CONFIG_PMASZ               25  /* unsigned int sz_pma */
#define DBSQL_CONFIG_STMTJRNL_SPILL      26  /* int n_byte */
#define DBSQL_CONFIG_SMALL_MALLOC        27  /* boolean */
#define DBSQL_CONFIG_SORTERREF_SIZE      28  /* int n_byte */
#define DBSQL_CONFIG_MEMDB_MAXSIZE       29  /* int64_t */
#define DBSQL_CONFIG_ROWID_IN_VIEW       30  /* int* */

/*
** CAPI3REF: Database Connection Configuration Options
**
** These constants are the available integer configuration options that
** can be passed as the second parameter to the [dbsql_db_config()] interface.
**
** The [dbsql_db_config()] interface is a var-args function.  It takes a
** variable number of parameters, though always at least two.  The number of
** parameters passed into dbsql_db_config() depends on which of these
** constants is given as the second parameter.  This documentation page
** refers to parameters beyond the second as "arguments".  Thus, when this
** page says "the N-th argument" it means "the N-th parameter past the
** configuration option" or "the (N+2)-th parameter to dbsql_db_config()".
**
** New configuration options may be added in future releases of dbsql.
** Existing configuration options might be discontinued.  Applications
** should check the return code from [dbsql_db_config()] to make sure that
** the call worked.  ^The [dbsql_db_config()] interface will return a
** non-zero [error code] if a discontinued or unsupported configuration option
** is invoked.
**
** <dl>
** [[DBSQL_DBCONFIG_LOOKASIDE]]
** <dt>DBSQL_DBCONFIG_LOOKASIDE</dt>
** <dd> The DBSQL_DBCONFIG_LOOKASIDE option is used to adjust the 
** configuration of the [lookaside memory allocator] within a database
** connection.
** The arguments to the DBSQL_DBCONFIG_LOOKASIDE option are <i>not</i>
** in the [DBCONFIG arguments|usual format].
** The DBSQL_DBCONFIG_LOOKASIDE option takes three arguments, not two,
** so that a call to [dbsql_db_config()] that uses DBSQL_DBCONFIG_LOOKASIDE
** should have a total of five parameters.
** <ol>
** <li><p>The first argument ("buf") is a
** pointer to a memory buffer to use for lookaside memory.
** The first argument may be NULL in which case dbsql will allocate the
** lookaside buffer itself using [dbsql_malloc()].
** <li><P>The second argument ("sz") is the
** size of each lookaside buffer slot.  lookaside_t is disabled if "sz"
** is less than 8.  The "sz" argument should be a multiple of 8 less than
** 65536.  If "sz" does not meet this constraint, it is reduced in size until
** it does.
** <li><p>The third argument ("cnt") is the number of slots.
** lookaside_t is disabled if "cnt"is less than 1.
*  The "cnt" value will be reduced, if necessary, so
** that the product of "sz" and "cnt" does not exceed 2,147,418,112. The "cnt"
** parameter is usually chosen so that the product of "sz" and "cnt" is less
** than 1,000,000.
** </ol>
** <p>If the "buf" argument is not NULL, then it must
** point to a memory buffer with a size that is greater than
** or equal to the product of "sz" and "cnt".
** The buffer must be aligned to an 8-byte boundary.
** The lookaside memory
** configuration for a database connection can only be changed when that
** connection is not currently using lookaside memory, or in other words
** when the value returned by [DBSQL_DBSTATUS_LOOKASIDE_USED] is zero.
** Any attempt to change the lookaside memory configuration when lookaside
** memory is in use leaves the configuration unchanged and returns
** [DBSQL_BUSY].
** If the "buf" argument is NULL and an attempt
** to allocate memory based on "sz" and "cnt" fails, then
** lookaside is silently disabled.
** <p>
** The [DBSQL_CONFIG_LOOKASIDE] configuration option can be used to set the
** default lookaside configuration at initialization.  The
** [-DSQLITE_DEFAULT_LOOKASIDE] option can be used to set the default lookaside
** configuration at compile-time.  Typical values for lookaside are 1200 for
** "sz" and 40 to 100 for "cnt".
** </dd>
**
** [[DBSQL_DBCONFIG_ENABLE_FKEY]]
** <dt>DBSQL_DBCONFIG_ENABLE_FKEY</dt>
** <dd> ^This option is used to enable or disable the enforcement of
** [foreign key constraints].  This is the same setting that is
** enabled or disabled by the [PRAGMA foreign_keys] statement.
** The first argument is an integer which is 0 to disable FK enforcement,
** positive to enable FK enforcement or negative to leave FK enforcement
** unchanged.  The second parameter is a pointer to an integer into which
** is written 0 or 1 to indicate whether FK enforcement is off or on
** following this call.  The second parameter may be a NULL pointer, in
** which case the FK enforcement setting is not reported back. </dd>
**
** [[DBSQL_DBCONFIG_ENABLE_TRIGGER]]
** <dt>DBSQL_DBCONFIG_ENABLE_TRIGGER</dt>
** <dd> ^This option is used to enable or disable [CREATE TRIGGER | triggers].
** There should be two additional arguments.
** The first argument is an integer which is 0 to disable triggers,
** positive to enable triggers or negative to leave the setting unchanged.
** The second parameter is a pointer to an integer into which
** is written 0 or 1 to indicate whether triggers are disabled or enabled
** following this call.  The second parameter may be a NULL pointer, in
** which case the trigger setting is not reported back.
**
** <p>Originally this option disabled all triggers.  ^(However, since
** dbsql version 3.35.0, TEMP triggers are still allowed even if
** this option is off.  So, in other words, this option now only disables
** triggers in the main database schema or in the schemas of [ATTACH]-ed
** databases.)^ </dd>
**
** [[DBSQL_DBCONFIG_ENABLE_VIEW]]
** <dt>DBSQL_DBCONFIG_ENABLE_VIEW</dt>
** <dd> ^This option is used to enable or disable [CREATE VIEW | views].
** There must be two additional arguments.
** The first argument is an integer which is 0 to disable views,
** positive to enable views or negative to leave the setting unchanged.
** The second parameter is a pointer to an integer into which
** is written 0 or 1 to indicate whether views are disabled or enabled
** following this call.  The second parameter may be a NULL pointer, in
** which case the view setting is not reported back.
**
** <p>Originally this option disabled all views.  ^(However, since
** dbsql version 3.35.0, TEMP views are still allowed even if
** this option is off.  So, in other words, this option now only disables
** views in the main database schema or in the schemas of ATTACH-ed
** databases.)^ </dd>
**
** [[DBSQL_DBCONFIG_ENABLE_FTS3_TOKENIZER]]
** <dt>DBSQL_DBCONFIG_ENABLE_FTS3_TOKENIZER</dt>
** <dd> ^This option is used to enable or disable using the
** [fts3_tokenizer()] function - part of the [FTS3] full-text search engine
** extension - without using bound parameters as the parameters. Doing so
** is disabled by default. There must be two additional arguments. The first
** argument is an integer. If it is passed 0, then using fts3_tokenizer()
** without bound parameters is disabled. If it is passed a positive value, 
** then calling fts3_tokenizer without bound parameters is enabled. If it 
** is passed a negative value, this setting is not modified - this can be 
** used to query for the current setting. The second parameter is a pointer 
** to an integer into which is written 0 or 1 to indicate the current value 
** of this setting (after it is modified, if applicable).  The second 
** parameter may be a NULL pointer, in which case the value of the setting 
** is not reported back. Refer to [FTS3] documentation for further details.
** </dd> 
**
** [[DBSQL_DBCONFIG_ENABLE_LOAD_EXTENSION]]
** <dt>DBSQL_DBCONFIG_ENABLE_LOAD_EXTENSION</dt>
** <dd> ^This option is used to enable or disable the [dbsql_load_extension()]
** interface independently of the [load_extension()] SQL function.
** The [dbsql_enable_load_extension()] API enables or disables both the
** C-API [dbsql_load_extension()] and the SQL function [load_extension()].
** There must be two additional arguments.
** When the first argument to this interface is 1, then only the C-API is
** enabled and the SQL function remains disabled.  If the first argument to
** this interface is 0, then both the C-API and the SQL function are disabled.
** If the first argument is -1, then no changes are made to the state of either
** the C-API or the SQL function.
** The second parameter is a pointer to an integer into which
** is written 0 or 1 to indicate whether [dbsql_load_extension()] interface
** is disabled or enabled following this call.  The second parameter may
** be a NULL pointer, in which case the new setting is not reported back.
** </dd>
**
** [[DBSQL_DBCONFIG_MAINDBNAME]] <dt>DBSQL_DBCONFIG_MAINDBNAME</dt>
** <dd> ^This option is used to change the name of the "main" database
** schema.  This option does not follow the
** [DBCONFIG arguments|usual DBSQL_DBCONFIG argument format].
** This option takes exactly one additional argument so that the 
** [dbsql_db_config()] call has a total of three parameters.  The
** extra argument must be a pointer to a constant UTF8 string which
** will become the new schema name in place of "main".  ^dbsql does
** not make a copy of the new main schema name string, so the application
** must ensure that the argument passed into DBSQL_DBCONFIG MAINDBNAME
** is unchanged until after the database connection closes.
** </dd>
**
** [[DBSQL_DBCONFIG_NO_CKPT_ON_CLOSE]]
** <dt>DBSQL_DBCONFIG_NO_CKPT_ON_CLOSE</dt>
** <dd> Usually, when a database in [WAL mode] is closed or detached from a
** database handle, dbsql checks if if there are other connections to the
** same database, and if there are no other database connection (if the
** connection being closed is the last open connection to the database),
** then dbsql performs a [checkpoint] before closing the connection and
** deletes the WAL file.  The DBSQL_DBCONFIG_NO_CKPT_ON_CLOSE option can
** be used to override that behavior. The first argument passed to this
** operation (the third parameter to [dbsql_db_config()]) is an integer
** which is positive to disable checkpoints-on-close, or zero (the default)
** to enable them, and negative to leave the setting unchanged.
** The second argument (the fourth parameter) is a pointer to an integer
** into which is written 0 or 1 to indicate whether checkpoints-on-close
** have been disabled - 0 if they are not disabled, 1 if they are.
** </dd>
**
** [[DBSQL_DBCONFIG_ENABLE_QPSG]] <dt>DBSQL_DBCONFIG_ENABLE_QPSG</dt>
** <dd>^(The DBSQL_DBCONFIG_ENABLE_QPSG option activates or deactivates
** the [query planner stability guarantee] (QPSG).  When the QPSG is active,
** a single SQL query statement will always use the same algorithm regardless
** of values of [bound parameters].)^ The QPSG disables some query optimizations
** that look at the values of bound parameters, which can make some queries
** slower.  But the QPSG has the advantage of more predictable behavior.  with_t
** the QPSG active, dbsql will always use the same query plan in the field as
** was used during testing in the lab.
** The first argument to this setting is an integer which is 0 to disable
** the QPSG, positive to enable QPSG, or negative to leave the setting
** unchanged. The second parameter is a pointer to an integer into which
** is written 0 or 1 to indicate whether the QPSG is disabled or enabled
** following this call.
** </dd>
**
** [[DBSQL_DBCONFIG_TRIGGER_EQP]] <dt>DBSQL_DBCONFIG_TRIGGER_EQP</dt>
** <dd> By default, the output of EXPLAIN QUERY PLAN commands does not
** include output for any operations performed by trigger programs. This
** option is used to set or clear (the default) a flag that governs this
** behavior. The first parameter passed to this operation is an integer -
** positive to enable output for trigger programs, or zero to disable it,
** or negative to leave the setting unchanged.
** The second parameter is a pointer to an integer into which is written
** 0 or 1 to indicate whether output-for-triggers has been disabled - 0 if
** it is not disabled, 1 if it is. 
** </dd>
**
** [[DBSQL_DBCONFIG_RESET_DATABASE]] <dt>DBSQL_DBCONFIG_RESET_DATABASE</dt>
** <dd> Set the DBSQL_DBCONFIG_RESET_DATABASE flag and then run
** [VACUUM] in order to reset a database back to an empty database
** with no schema and no content. The following process works even for
** a badly corrupted database file:
** <ol>
** <li> If the database connection is newly opened, make sure it has read the
**      database schema by preparing then discarding some query against the
**      database, or calling dbsql_table_column_metadata(), ignoring any
**      errors.  This step is only necessary if the application desires to keep
**      the database in WAL mode after the reset if it was in WAL mode before
**      the reset. 
** <li> dbsql_db_config(db, DBSQL_DBCONFIG_RESET_DATABASE, 1, 0);
** <li> [dbsql_exec](db, "[VACUUM]", 0, 0, 0);
** <li> dbsql_db_config(db, DBSQL_DBCONFIG_RESET_DATABASE, 0, 0);
** </ol>
** Because resetting a database is destructive and irreversible, the
** process requires the use of this obscure API and multiple steps to
** help ensure that it does not happen by accident. Because this
** feature must be capable of resetting corrupt databases, and
** shutting down virtual tables may require access to that corrupt
** storage, the library must abandon any installed virtual tables
** without calling their destroy() methods.
**
** [[DBSQL_DBCONFIG_DEFENSIVE]] <dt>DBSQL_DBCONFIG_DEFENSIVE</dt>
** <dd>The DBSQL_DBCONFIG_DEFENSIVE option activates or deactivates the
** "defensive" flag for a database connection.  When the defensive
** flag is enabled, language features that allow ordinary SQL to
** deliberately corrupt the database file are disabled.  The disabled
** features include but are not limited to the following:
** <ul>
** <li> The [PRAGMA writable_schema=ON] statement.
** <li> The [PRAGMA journal_mode=OFF] statement.
** <li> The [PRAGMA schema_version=N] statement.
** <li> Writes to the [dbsql_dbpage] virtual table.
** <li> Direct writes to [shadow tables].
** </ul>
** </dd>
**
** [[DBSQL_DBCONFIG_WRITABLE_SCHEMA]] <dt>DBSQL_DBCONFIG_WRITABLE_SCHEMA</dt>
** <dd>The DBSQL_DBCONFIG_WRITABLE_SCHEMA option activates or deactivates the
** "writable_schema" flag. This has the same effect and is logically equivalent
** to setting [PRAGMA writable_schema=ON] or [PRAGMA writable_schema=OFF].
** The first argument to this setting is an integer which is 0 to disable
** the writable_schema, positive to enable writable_schema, or negative to
** leave the setting unchanged. The second parameter is a pointer to an
** integer into which is written 0 or 1 to indicate whether the writable_schema
** is enabled or disabled following this call.
** </dd>
**
** [[DBSQL_DBCONFIG_LEGACY_ALTER_TABLE]]
** <dt>DBSQL_DBCONFIG_LEGACY_ALTER_TABLE</dt>
** <dd>The DBSQL_DBCONFIG_LEGACY_ALTER_TABLE option activates or deactivates
** the legacy behavior of the [ALTER TABLE RENAME] command such that it
** behaves as it did prior to [version 3.24.0] (2018-06-04).  See the
** "Compatibility Notice" on the [ALTER TABLE RENAME documentation] for
** additional information. This feature can also be turned on and off
** using the [PRAGMA legacy_alter_table] statement.
** </dd>
**
** [[DBSQL_DBCONFIG_DQS_DML]]
** <dt>DBSQL_DBCONFIG_DQS_DML</dt>
** <dd>The DBSQL_DBCONFIG_DQS_DML option activates or deactivates
** the legacy [double-quoted string literal] misfeature for DML statements
** only, that is DELETE, INSERT, SELECT, and UPDATE statements. The
** default value of this setting is determined by the [-DSQLITE_DQS]
** compile-time option.
** </dd>
**
** [[DBSQL_DBCONFIG_DQS_DDL]]
** <dt>DBSQL_DBCONFIG_DQS_DDL</dt>
** <dd>The DBSQL_DBCONFIG_DQS option activates or deactivates
** the legacy [double-quoted string literal] misfeature for DDL statements,
** such as CREATE TABLE and CREATE INDEX. The
** default value of this setting is determined by the [-DSQLITE_DQS]
** compile-time option.
** </dd>
**
** [[DBSQL_DBCONFIG_TRUSTED_SCHEMA]]
** <dt>DBSQL_DBCONFIG_TRUSTED_SCHEMA</dt>
** <dd>The DBSQL_DBCONFIG_TRUSTED_SCHEMA option tells dbsql to
** assume that database schemas are untainted by malicious content.
** When the DBSQL_DBCONFIG_TRUSTED_SCHEMA option is disabled, dbsql
** takes additional defensive steps to protect the application from harm
** including:
** <ul>
** <li> Prohibit the use of SQL functions inside triggers, views,
** CHECK constraints, DEFAULT clauses, expression indexes,
** partial indexes, or generated columns
** unless those functions are tagged with [DBSQL_INNOCUOUS].
** <li> Prohibit the use of virtual tables inside of triggers or views
** unless those virtual tables are tagged with [DBSQL_VTAB_INNOCUOUS].
** </ul>
** This setting defaults to "on" for legacy compatibility, however
** all applications are advised to turn it off if possible. This setting
** can also be controlled using the [PRAGMA trusted_schema] statement.
** </dd>
**
** [[DBSQL_DBCONFIG_LEGACY_FILE_FORMAT]]
** <dt>DBSQL_DBCONFIG_LEGACY_FILE_FORMAT</dt>
** <dd>The DBSQL_DBCONFIG_LEGACY_FILE_FORMAT option activates or deactivates
** the legacy file format flag.  When activated, this flag causes all newly
** created database files to have a schema format version number (the 4-byte
** integer found at offset 44 into the database header) of 1.  This in turn
** means that the resulting database file will be readable and writable by
** any dbsql version back to 3.0.0 ([dateof:3.0.0]).  Without this setting,
** newly created databases are generally not understandable by dbsql versions
** prior to 3.3.0 ([dateof:3.3.0]).  As these words are written, there
** is now scarcely any need to generate database files that are compatible
** all the way back to version 3.0.0, and so this setting is of little
** practical use, but is provided so that dbsql can continue to claim the
** ability to generate new database files that are compatible with  version
** 3.0.0.
** <p>Note that when the DBSQL_DBCONFIG_LEGACY_FILE_FORMAT setting is on,
** the [VACUUM] command will fail with an obscure error when attempting to
** process a table with generated columns and a descending index.  This is
** not considered a bug since dbsql versions 3.3.0 and earlier do not support
** either generated columns or descending indexes.
** </dd>
**
** [[DBSQL_DBCONFIG_STMT_SCANSTATUS]]
** <dt>DBSQL_DBCONFIG_STMT_SCANSTATUS</dt>
** <dd>The DBSQL_DBCONFIG_STMT_SCANSTATUS option is only useful in
** [DBSQL_ENABLE_STMT_SCANSTATUS] builds. In this case, it sets or clears
** a flag that enables collection of run-time performance statistics
** used by [dbsql_stmt_scanstatus_v2()] and the [nexec and ncycle]
** columns of the [bytecode virtual table].
** For statistics to be collected, the flag must be set on
** the database handle both when the SQL statement is
** [dbsql_prepare|prepared] and when it is [dbsql_step|stepped].
** The flag is set (collection of statistics is enabled) by default.
** <p>This option takes two arguments: an integer and a pointer to
** an integer.  The first argument is 1, 0, or -1 to enable, disable, or
** leave unchanged the statement scanstatus option.  If the second argument
** is not NULL, then the value of the statement scanstatus setting after
** processing the first argument is written into the integer that the second
** argument points to.
** </dd>
**
** [[DBSQL_DBCONFIG_REVERSE_SCANORDER]]
** <dt>DBSQL_DBCONFIG_REVERSE_SCANORDER</dt>
** <dd>The DBSQL_DBCONFIG_REVERSE_SCANORDER option changes the default order
** in which tables and indexes are scanned so that the scans start at the end
** and work toward the beginning rather than starting at the beginning and
** working toward the end. Setting DBSQL_DBCONFIG_REVERSE_SCANORDER is the
** same as setting [PRAGMA reverse_unordered_selects]. <p>This option takes
** two arguments which are an integer and a pointer to an integer.  The first
** argument is 1, 0, or -1 to enable, disable, or leave unchanged the
** reverse scan order flag, respectively.  If the second argument is not NULL,
** then 0 or 1 is written into the integer that the second argument points to
** depending on if the reverse scan order flag is set after processing the
** first argument.
** </dd>
**
** [[DBSQL_DBCONFIG_ENABLE_ATTACH_CREATE]]
** <dt>DBSQL_DBCONFIG_ENABLE_ATTACH_CREATE</dt>
** <dd>The DBSQL_DBCONFIG_ENABLE_ATTACH_CREATE option enables or disables
** the ability of the [ATTACH DATABASE] SQL command to create a new database
** file if the database filed named in the ATTACH command does not already
** exist.  This ability of ATTACH to create a new database is enabled by
** default.  Applications can disable or reenable the ability for ATTACH to
** create new database files using this DBCONFIG option.<p>
** This option takes two arguments which are an integer and a pointer
** to an integer.  The first argument is 1, 0, or -1 to enable, disable, or
** leave unchanged the attach-create flag, respectively.  If the second
** argument is not NULL, then 0 or 1 is written into the integer that the
** second argument points to depending on if the attach-create flag is set
** after processing the first argument. 
** </dd>
**
** [[DBSQL_DBCONFIG_ENABLE_ATTACH_WRITE]]
** <dt>DBSQL_DBCONFIG_ENABLE_ATTACH_WRITE</dt>
** <dd>The DBSQL_DBCONFIG_ENABLE_ATTACH_WRITE option enables or disables the
** ability of the [ATTACH DATABASE] SQL command to open a database for writing.
** This capability is enabled by default.  Applications can disable or
** reenable this capability using the current DBCONFIG option.  If
** this capability is disabled, the [ATTACH] command will still work,
** but the database will be opened read-only.  If this option is disabled,
** then the ability to create a new database using [ATTACH] is also disabled,
** regardless of the value of the [DBSQL_DBCONFIG_ENABLE_ATTACH_CREATE]
** option.<p>
** This option takes two arguments which are an integer and a pointer
** to an integer.  The first argument is 1, 0, or -1 to enable, disable, or
** leave unchanged the ability to ATTACH another database for writing,
** respectively.  If the second argument is not NULL, then 0 or 1 is written
** into the integer to which the second argument points, depending on whether
** the ability to ATTACH a read/write database is enabled or disabled
** after processing the first argument.
** </dd>
**
** [[DBSQL_DBCONFIG_ENABLE_COMMENTS]]
** <dt>DBSQL_DBCONFIG_ENABLE_COMMENTS</dt>
** <dd>The DBSQL_DBCONFIG_ENABLE_COMMENTS option enables or disables the
** ability to include comments in SQL text.  Comments are enabled by default.
** An application can disable or reenable comments in SQL text using this
** DBCONFIG option.<p>
** This option takes two arguments which are an integer and a pointer
** to an integer.  The first argument is 1, 0, or -1 to enable, disable, or
** leave unchanged the ability to use comments in SQL text,
** respectively.  If the second argument is not NULL, then 0 or 1 is written
** into the integer that the second argument points to depending on if
** comments are allowed in SQL text after processing the first argument.
** </dd>
**
** [[DBSQL_DBCONFIG_FP_DIGITS]]
** <dt>DBSQL_DBCONFIG_FP_DIGITS</dt>
** <dd>The DBSQL_DBCONFIG_FP_DIGITS setting is a small integer that determines
** the number of significant digits that dbsql will attempt to preserve when
** converting floating point numbers (IEEE 754 "doubles") into text.  The
** default value 17, as of dbsql version 3.52.0.  The value was 15 in all
** prior versions.<p>
** This option takes two arguments which are an integer and a pointer
** to an integer.  The first argument is a small integer, between 3 and 23, or
** zero.  The FP_DIGITS setting is changed to that small integer, or left
** unaltered if the first argument is zero or out of range. The second argument
** is a pointer to an integer.  If the pointer is not NULL, then the value of
** the FP_DIGITS setting, after possibly being modified by the first
** arguments, is written into the integer to which the second argument points.
** </dd>
**
** </dl>
**
** [[DBCONFIG arguments]] <h3>Arguments To DBSQL_DBCONFIG Options</h3>
**
** <p>Most of the DBSQL_DBCONFIG options take two arguments, so that the
** overall call to [dbsql_db_config()] has a total of four parameters.
** The first argument (the third parameter to dbsql_db_config()) is
** an integer.
** The second argument is a pointer to an integer. If the first argument is 1,
** then the option becomes enabled.  If the first integer argument is 0,
** then the option is disabled. 
** If the first argument is -1, then the option setting
** is unchanged.  The second argument, the pointer to an integer, may be NULL.
** If the second argument is not NULL, then a value of 0 or 1 is written into
** the integer to which the second argument points, depending on whether the
** setting is disabled or enabled after applying any changes specified by
** the first argument.
**
** <p>While most DBSQL_DBCONFIG options use the argument format
** described in the previous paragraph, the [DBSQL_DBCONFIG_MAINDBNAME],
** [DBSQL_DBCONFIG_LOOKASIDE], and [DBSQL_DBCONFIG_FP_DIGITS] options
** are different.  See the documentation of those exceptional options for
** details.
*/
#define DBSQL_DBCONFIG_MAINDBNAME            1000 /* const char* */
#define DBSQL_DBCONFIG_LOOKASIDE             1001 /* void* int int */
#define DBSQL_DBCONFIG_ENABLE_FKEY           1002 /* int int* */
#define DBSQL_DBCONFIG_ENABLE_TRIGGER        1003 /* int int* */
#define DBSQL_DBCONFIG_ENABLE_FTS3_TOKENIZER 1004 /* int int* */
#define DBSQL_DBCONFIG_ENABLE_LOAD_EXTENSION 1005 /* int int* */
#define DBSQL_DBCONFIG_NO_CKPT_ON_CLOSE      1006 /* int int* */
#define DBSQL_DBCONFIG_ENABLE_QPSG           1007 /* int int* */
#define DBSQL_DBCONFIG_TRIGGER_EQP           1008 /* int int* */
#define DBSQL_DBCONFIG_RESET_DATABASE        1009 /* int int* */
#define DBSQL_DBCONFIG_DEFENSIVE             1010 /* int int* */
#define DBSQL_DBCONFIG_WRITABLE_SCHEMA       1011 /* int int* */
#define DBSQL_DBCONFIG_LEGACY_ALTER_TABLE    1012 /* int int* */
#define DBSQL_DBCONFIG_DQS_DML               1013 /* int int* */
#define DBSQL_DBCONFIG_DQS_DDL               1014 /* int int* */
#define DBSQL_DBCONFIG_ENABLE_VIEW           1015 /* int int* */
#define DBSQL_DBCONFIG_LEGACY_FILE_FORMAT    1016 /* int int* */
#define DBSQL_DBCONFIG_TRUSTED_SCHEMA        1017 /* int int* */
#define DBSQL_DBCONFIG_STMT_SCANSTATUS       1018 /* int int* */
#define DBSQL_DBCONFIG_REVERSE_SCANORDER     1019 /* int int* */
#define DBSQL_DBCONFIG_ENABLE_ATTACH_CREATE  1020 /* int int* */
#define DBSQL_DBCONFIG_ENABLE_ATTACH_WRITE   1021 /* int int* */
#define DBSQL_DBCONFIG_ENABLE_COMMENTS       1022 /* int int* */
#define DBSQL_DBCONFIG_FP_DIGITS             1023 /* int int* */
#define DBSQL_DBCONFIG_MAX                   1023 /* Largest DBCONFIG */

/*
** CAPI3REF: Enable Or Disable Extended Result Codes
** METHOD: DBSQL
**
** ^The dbsql_extended_result_codes() routine enables or disables the
** [extended result codes] feature of dbsql. ^The extended result
** codes are disabled by default for historical compatibility.
*/
int dbsql_extended_result_codes(DBSQL*, int onoff);

/*
** CAPI3REF: Last Insert Rowid
** METHOD: DBSQL
**
** ^Each entry in most dbsql tables (except for [WITHOUT ROWID] tables)
** has a unique 64-bit signed
** integer key called the [ROWID | "rowid"]. ^The rowid is always available
** as an undeclared column named ROWID, OID, or _ROWID_ as long as those
** names are not also used by explicitly declared columns. ^If
** the table has a column of type [INTEGER PRIMARY KEY] then that column
** is another alias for the rowid.
**
** ^The dbsql_last_insert_rowid(D) interface usually returns the [rowid] of
** the most recent successful [INSERT] into a rowid table or [virtual table]
** on database connection D. ^Inserts into [WITHOUT ROWID] tables are not
** recorded. ^If no successful [INSERT]s into rowid tables have ever occurred
** on the database connection D, then dbsql_last_insert_rowid(D) returns
** zero.
**
** As well as being set automatically as rows are inserted into database
** tables, the value returned by this function may be set explicitly by
** [dbsql_set_last_insert_rowid()]
**
** Some virtual table implementations may INSERT rows into rowid tables as
** part of committing a transaction (e.g. to flush data accumulated in memory
** to disk). In this case subsequent calls to this function return the rowid
** associated with these internal INSERT operations, which leads to
** unintuitive results. Virtual table implementations that do write to rowid
** tables in this way can avoid this problem by restoring the original
** rowid value using [dbsql_set_last_insert_rowid()] before returning
** control to the user.
**
** ^(If an [INSERT] occurs within a trigger then this routine will
** return the [rowid] of the inserted row as long as the trigger is
** running. Once the trigger program ends, the value returned
** by this routine reverts to what it was before the trigger was fired.)^
**
** ^An [INSERT] that fails due to a constraint violation is not a
** successful [INSERT] and does not change the value returned by this
** routine.  ^Thus INSERT OR FAIL, INSERT OR IGNORE, INSERT OR ROLLBACK,
** and INSERT OR ABORT make no changes to the return value of this
** routine when their insertion fails.  ^(When INSERT OR REPLACE
** encounters a constraint violation, it does not fail.  The
** INSERT continues to completion after deleting rows that caused
** the constraint problem so INSERT OR REPLACE will always change
** the return value of this interface.)^
**
** ^For the purposes of this routine, an [INSERT] is considered to
** be successful even if it is subsequently rolled back.
**
** This function is accessible to SQL statements via the
** [last_insert_rowid() SQL function].
**
** If a separate thread performs a new [INSERT] on the same
** database connection while the [dbsql_last_insert_rowid()]
** function is running and thus changes the last insert [rowid],
** then the value returned by [dbsql_last_insert_rowid()] is
** unpredictable and might not equal either the old or the new
** last insert [rowid].
*/
int64_t dbsql_last_insert_rowid(DBSQL*);

/*
** CAPI3REF: Set the Last Insert Rowid value.
** METHOD: DBSQL
**
** The dbsql_set_last_insert_rowid(D, R) method allows the application to
** set the value returned by calling dbsql_last_insert_rowid(D) to R
** without inserting a row into the database.
*/
void dbsql_set_last_insert_rowid(DBSQL*,int64_t);

/*
** CAPI3REF: Count The Number Of Rows Modified
** METHOD: DBSQL
**
** ^These functions return the number of rows modified, inserted or
** deleted by the most recently completed INSERT, UPDATE or DELETE
** statement on the database connection specified by the only parameter.
** The two functions are identical except for the type of the return value
** and that if the number of rows modified by the most recent INSERT, UPDATE,
** or DELETE is greater than the maximum value supported by type "int", then
** the return value of dbsql_changes() is undefined. ^Executing any other
** type of SQL statement does not modify the value returned by these functions.
** For the purposes of this interface, a CREATE TABLE AS SELECT statement
** does not count as an INSERT, UPDATE or DELETE statement and hence the rows
** added to the new table by the CREATE TABLE AS SELECT statement are not
** counted.
**
** ^Only changes made directly by the INSERT, UPDATE or DELETE statement are
** considered - auxiliary changes caused by [CREATE TRIGGER | triggers],
** [foreign key actions] or [REPLACE] constraint resolution are not counted.
**
** Changes to a view that are intercepted by
** [INSTEAD OF trigger | INSTEAD OF triggers] are not counted. ^The value
** returned by dbsql_changes() immediately after an INSERT, UPDATE or
** DELETE statement run on a view is always zero. Only changes made to real
** tables are counted.
**
** Things are more complicated if the dbsql_changes() function is
** executed while a trigger program is running. This may happen if the
** program uses the [changes() SQL function], or if some other callback
** function invokes dbsql_changes() directly. Essentially:
**
** <ul>
**   <li> ^(Before entering a trigger program the value returned by
**        dbsql_changes() function is saved. After the trigger program
**        has finished, the original value is restored.)^
**
**   <li> ^(Within a trigger program each INSERT, UPDATE and DELETE
**        statement sets the value returned by dbsql_changes()
**        upon completion as normal. Of course, this value will not include
**        any changes performed by sub-triggers, as the dbsql_changes()
**        value will be saved and restored after each sub-trigger has run.)^
** </ul>
**
** ^This means that if the changes() SQL function (or similar) is used
** by the first INSERT, UPDATE or DELETE statement within a trigger, it
** returns the value as set when the calling statement began executing.
** ^If it is used by the second or subsequent such statement within a trigger
** program, the value returned reflects the number of rows modified by the
** previous INSERT, UPDATE or DELETE statement within the same trigger.
**
** If a separate thread makes changes on the same database connection
** while [dbsql_changes()] is running then the value returned
** is unpredictable and not meaningful.
**
** See also:
** <ul>
** <li> the [dbsql_total_changes()] interface
** <li> the [count_changes pragma]
** <li> the [changes() SQL function]
** <li> the [data_version pragma]
** </ul>
*/
int dbsql_changes(DBSQL*);
int64_t dbsql_changes64(DBSQL*);

/*
** CAPI3REF: Total Number Of Rows Modified
** METHOD: DBSQL
**
** ^These functions return the total number of rows inserted, modified or
** deleted by all [INSERT], [UPDATE] or [DELETE] statements completed
** since the database connection was opened, including those executed as
** part of trigger programs. The two functions are identical except for the
** type of the return value and that if the number of rows modified by the
** connection exceeds the maximum value supported by type "int", then
** the return value of dbsql_total_changes() is undefined. ^Executing
** any other type of SQL statement does not affect the value returned by
** dbsql_total_changes().
**
** ^Changes made as part of [foreign key actions] are included in the
** count, but those made as part of REPLACE constraint resolution are
** not. ^Changes to a view that are intercepted by INSTEAD OF triggers
** are not counted.
**
** The [dbsql_total_changes(D)] interface only reports the number
** of rows that changed due to SQL statement run against database
** connection D.  Any changes by other database connections are ignored.
** To detect changes against a database file from other database
** connections use the [PRAGMA data_version] command or the
** [DBSQL_FCNTL_DATA_VERSION] [file control].
**
** If a separate thread makes changes on the same database connection
** while [dbsql_total_changes()] is running then the value
** returned is unpredictable and not meaningful.
**
** See also:
** <ul>
** <li> the [dbsql_changes()] interface
** <li> the [count_changes pragma]
** <li> the [changes() SQL function]
** <li> the [data_version pragma]
** <li> the [DBSQL_FCNTL_DATA_VERSION] [file control]
** </ul>
*/
int dbsql_total_changes(DBSQL*);
int64_t dbsql_total_changes64(DBSQL*);

/*
** CAPI3REF: Interrupt A Long-Running Query
** METHOD: DBSQL
**
** ^This function causes any pending database operation to abort and
** return at its earliest opportunity. This routine is typically
** called in response to a user action such as pressing "Cancel"
** or Ctrl-C where the user wants a long query operation to halt
** immediately.
**
** ^It is safe to call this routine from a thread different from the
** thread that is currently running the database operation.  But it
** is not safe to call this routine with a [database connection] that
** is closed or might close before dbsql_interrupt() returns.
**
** ^If an SQL operation is very nearly finished at the time when
** dbsql_interrupt() is called, then it might not have an opportunity
** to be interrupted and might continue to completion.
**
** ^An SQL operation that is interrupted will return [DBSQL_INTERRUPT].
** ^If the interrupted SQL operation is an INSERT, UPDATE, or DELETE
** that is inside an explicit transaction, then the entire transaction
** will be rolled back automatically.
**
** ^The dbsql_interrupt(D) call is in effect until all currently running
** SQL statements on [database connection] D complete.  ^Any new SQL statements
** that are started after the dbsql_interrupt() call and before the
** running statement count reaches zero are interrupted as if they had been
** running prior to the dbsql_interrupt() call.  ^New SQL statements
** that are started after the running statement count reaches zero are
** not effected by the dbsql_interrupt().
** ^A call to dbsql_interrupt(D) that occurs when there are no running
** SQL statements is a no-op and has no effect on SQL statements
** that are started after the dbsql_interrupt() call returns.
**
** ^The [dbsql_is_interrupted(D)] interface can be used to determine whether
** or not an interrupt is currently in effect for [database connection] D.
** It returns 1 if an interrupt is currently in effect, or 0 otherwise.
*/
void dbsql_interrupt(DBSQL*);
int dbsql_is_interrupted(DBSQL*);

/*
** CAPI3REF: Determine If An SQL Statement Is Complete
**
** These routines are useful during command-line input to determine if the
** currently entered text seems to form a complete SQL statement or
** if additional input is needed before sending the text into
** dbsql for parsing.  ^These routines return 1 if the input string
** appears to be a complete SQL statement.  ^A statement is judged to be
** complete if it ends with a semicolon token and is not a prefix of a
** well-formed CREATE TRIGGER statement.  ^Semicolons that are embedded within
** string literals or quoted identifier names or comments are not
** independent tokens (they are part of the token in which they are
** embedded) and thus do not count as a statement terminator.  ^Whitespace
** and comments that follow the final semicolon are ignored.
**
** ^These routines return 0 if the statement is incomplete.  ^If a
** memory allocation fails, then DBSQL_NOMEM is returned.
**
** ^These routines do not parse the SQL statements and thus
** will not detect syntactically incorrect SQL.
**
** ^(If dbsql has not been initialized using [dbsql_initialize()] prior
** to invoking dbsql_complete16() then dbsql_initialize() is invoked
** automatically by dbsql_complete16().  If that initialization fails,
** then the return value from dbsql_complete16() will be non-zero
** regardless of whether or not the input SQL is complete.)^
**
** The input to [dbsql_complete()] must be a zero-terminated
** UTF-8 string.
**
** The input to [dbsql_complete16()] must be a zero-terminated
** UTF-16 string in native byte order.
*/
int dbsql_complete(const char *sql);
int dbsql_complete16(const void *sql);

/*
** CAPI3REF: Register A Callback To Handle DBSQL_BUSY Errors
** KEYWORDS: {busy-handler callback} {busy handler}
** METHOD: DBSQL
**
** ^The dbsql_busy_handler(D,X,P) routine sets a callback function X
** that might be invoked with argument P whenever
** an attempt is made to access a database table associated with
** [database connection] D when another thread
** or process has the table locked.
** The dbsql_busy_handler() interface is used to implement
** [dbsql_busy_timeout()] and [PRAGMA busy_timeout].
**
** ^If the busy callback is NULL, then [DBSQL_BUSY]
** is returned immediately upon encountering the lock.  ^If the busy callback
** is not NULL, then the callback might be invoked with two arguments.
**
** ^The first argument to the busy handler is a copy of the void* pointer which
** is the third argument to dbsql_busy_handler().  ^The second argument to
** the busy handler callback is the number of times that the busy handler has
** been invoked previously for the same locking event.  ^If the
** busy callback returns 0, then no additional attempts are made to
** access the database and [DBSQL_BUSY] is returned
** to the application.
** ^If the callback returns non-zero, then another attempt
** is made to access the database and the cycle repeats.
**
** The presence of a busy handler does not guarantee that it will be invoked
** when there is lock contention. ^If dbsql determines that invoking the busy
** handler could result in a deadlock, it will go ahead and return [DBSQL_BUSY]
** to the application instead of invoking the
** busy handler.
** Consider a scenario where one process is holding a read lock that
** it is trying to promote to a reserved lock and
** a second process is holding a reserved lock that it is trying
** to promote to an exclusive lock.  The first process cannot proceed
** because it is blocked by the second and the second process cannot
** proceed because it is blocked by the first.  If both processes
** invoke the busy handlers, neither will make any progress.  Therefore,
** dbsql returns [DBSQL_BUSY] for the first process, hoping that this
** will induce the first process to release its read lock and allow
** the second process to proceed.
**
** ^The default busy callback is NULL.
**
** ^(There can only be a single busy handler defined for each
** [database connection].  Setting a new busy handler clears any
** previously set handler.)^  ^Note that calling [dbsql_busy_timeout()]
** or evaluating [PRAGMA busy_timeout=N] will change the
** busy handler and thus clear any previously set busy handler.
**
** The busy callback should not take any actions which modify the
** database connection that invoked the busy handler.  In other words,
** the busy handler is not reentrant.  Any such actions
** result in undefined behavior.
**
** A busy handler must not close the database connection
** or [prepared statement] that invoked the busy handler.
*/
int dbsql_busy_handler(DBSQL*,int(*)(void*,int),void*);

/*
** CAPI3REF: Set A Busy Timeout
** METHOD: DBSQL
**
** ^This routine sets a [dbsql_busy_handler | busy handler] that sleeps
** for a specified amount of time when a table is locked.  ^The handler
** will sleep multiple times until at least "ms" milliseconds of sleeping
** have accumulated.  ^After at least "ms" milliseconds of sleeping,
** the handler returns 0 which causes [dbsql_step()] to return
** [DBSQL_BUSY].
**
** ^Calling this routine with an argument less than or equal to zero
** turns off all busy handlers.
**
** ^(There can only be a single busy handler for a particular
** [database connection] at any given moment.  If another busy handler
** was defined  (using [dbsql_busy_handler()]) prior to calling
** this routine, that other busy handler is cleared.)^
**
** See also:  [PRAGMA busy_timeout]
*/
int dbsql_busy_timeout(DBSQL*, int ms);

/*
** CAPI3REF: Set the Setlk Timeout
** METHOD: DBSQL
**
** This routine is only useful in DBSQL_ENABLE_SETLK_TIMEOUT builds. If 
** the VFS supports blocking locks, it sets the timeout in ms used by 
** eligible locks taken on wal mode databases by the specified database 
** handle. In non-DBSQL_ENABLE_SETLK_TIMEOUT builds, or if the VFS does
** not support blocking locks, this function is a no-op.
**
** Passing 0 to this function disables blocking locks altogether. Passing 
** -1 to this function requests that the VFS blocks for a long time - 
** indefinitely if possible. The results of passing any other negative value 
** are undefined.
**
** Internally, each dbsql database handle stores two timeout values - the
** busy-timeout (used for rollback mode databases, or if the VFS does not
** support blocking locks) and the setlk-timeout (used for blocking locks
** on wal-mode databases). The dbsql_busy_timeout() method sets both
** values, this function sets only the setlk-timeout value. Therefore,
** to configure separate busy-timeout and setlk-timeout values for a single
** database handle, call dbsql_busy_timeout() followed by this function.
**
** Whenever the number of connections to a wal mode database falls from
** 1 to 0, the last connection takes an exclusive lock on the database, 
** then checkpoints and deletes the wal file. While it is doing this, any
** new connection that tries to read from the database fails with an
** DBSQL_BUSY error. Or, if the DBSQL_SETLK_BLOCK_ON_CONNECT flag is
** passed to this API, the new connection blocks until the exclusive lock
** has been released.
*/
int dbsql_setlk_timeout(DBSQL*, int ms, int flags);

/*
** CAPI3REF: Flags for dbsql_setlk_timeout()
*/
#define DBSQL_SETLK_BLOCK_ON_CONNECT 0x01

/*
** CAPI3REF: Convenience Routines For Running Queries
** METHOD: DBSQL
**
** This is a legacy interface that is preserved for backwards compatibility.
** Use of this interface is not recommended.
**
** Definition: A <b>result table</b> is a memory data structure created by the
** [dbsql_get_table()] interface.  A result table records the
** complete query results from one or more queries.
**
** The table conceptually has a number of rows and columns.  But
** these numbers are not part of the result table itself.  These
** numbers are obtained separately.  Let N be the number of rows
** and M be the number of columns.
**
** A result table is an array of pointers to zero-terminated UTF-8 strings.
** There are (N+1)*M elements in the array.  The first M pointers point
** to zero-terminated strings that  contain the names of the columns.
** The remaining entries all point to query results.  NULL values result
** in NULL pointers.  All other values are in their UTF-8 zero-terminated
** string representation as returned by [dbsql_column_text()].
**
** A result table might consist of one or more memory allocations.
** It is not safe to pass a result table directly to [dbsql_free()].
** A result table should be deallocated using [dbsql_free_table()].
**
** ^(As an example of the result table format, suppose a query result
** is as follows:
**
** <blockquote><pre>
**        Name        | Age
**        -----------------------
**        Alice       | 43
**        Bob         | 28
**        Cindy       | 21
** </pre></blockquote>
**
** There are two columns (M==2) and three rows (N==3).  Thus the
** result table has 8 entries.  Suppose the result table is stored
** in an array named results.  Then results holds this content:
**
** <blockquote><pre>
**        results&#91;0] = "Name";
**        results&#91;1] = "Age";
**        results&#91;2] = "Alice";
**        results&#91;3] = "43";
**        results&#91;4] = "Bob";
**        results&#91;5] = "28";
**        results&#91;6] = "Cindy";
**        results&#91;7] = "21";
** </pre></blockquote>)^
**
** ^The dbsql_get_table() function evaluates one or more
** semicolon-separated SQL statements in the zero-terminated UTF-8
** string of its 2nd parameter and returns a result table to the
** pointer given in its 3rd parameter.
**
** After the application has finished with the result from dbsql_get_table(),
** it must pass the result table pointer to dbsql_free_table() in order to
** release the memory that was malloced.  Because of the way the
** [dbsql_malloc()] happens within dbsql_get_table(), the calling
** function must not try to call [dbsql_free()] directly.  Only
** [dbsql_free_table()] is able to release the memory properly and safely.
**
** The dbsql_get_table() interface is implemented as a wrapper around
** [dbsql_exec()].  The dbsql_get_table() routine does not have access
** to any internal data structures of dbsql.  It uses only the public
** interface defined here.  As a consequence, errors that occur in the
** wrapper layer outside of the internal [dbsql_exec()] call are not
** reflected in subsequent calls to [dbsql_errcode()] or
** [dbsql_errmsg()].
*/
int dbsql_get_table(
  DBSQL *db,          /* An open database */
  const char *sql,     /* SQL to be evaluated */
  char ***paz_result,    /* Results of the query */
  int *pn_row,           /* Number of result rows written here */
  int *pn_column,        /* Number of result columns written here */
  char **errmsg       /* Error msg written here */
);
void dbsql_free_table(char **result);

/*
** CAPI3REF: Formatted String Printing Functions
**
** These routines are work-alikes of the "printf()" family of functions
** from the standard C library.
** These routines understand most of the common formatting options from
** the standard library printf()
** plus some additional non-standard formats ([%q], [%Q], [%w], and [%z]).
** See the [built-in printf()] documentation for details.
**
** ^The dbsql_mprintf() and dbsql_vmprintf() routines write their
** results into memory obtained from [dbsql_malloc64()].
** The strings returned by these two routines should be
** released by [dbsql_free()].  ^Both routines return a
** NULL pointer if [dbsql_malloc64()] is unable to allocate enough
** memory to hold the resulting string.
**
** ^(The dbsql_snprintf() routine is similar to "snprintf()" from
** the standard C library.  The result is written into the
** buffer supplied as the second parameter whose size is given by
** the first parameter. Note that the order of the
** first two parameters is reversed from snprintf().)^  This is an
** historical accident that cannot be fixed without breaking
** backwards compatibility.  ^(Note also that dbsql_snprintf()
** returns a pointer to its buffer instead of the number of
** characters actually written into the buffer.)^  We admit that
** the number of characters written would be a more useful return
** value but we cannot change the implementation of dbsql_snprintf()
** now without breaking compatibility.
**
** ^As long as the buffer size is greater than zero, dbsql_snprintf()
** guarantees that the buffer is always zero-terminated.  ^The first
** parameter "n" is the total size of the buffer, including space for
** the zero terminator.  So the longest string that can be completely
** written will be n-1 characters.
**
** ^The dbsql_vsnprintf() routine is a varargs version of dbsql_snprintf().
**
** See also:  [built-in printf()], [printf() SQL function]
*/
char *dbsql_mprintf(const char*,...);
char *dbsql_vmprintf(const char*, va_list);
char *dbsql_snprintf(int,char*,const char*, ...);
char *dbsql_vsnprintf(int,char*,const char*, va_list);

/*
** CAPI3REF: Memory Allocation Subsystem
**
** The dbsql core uses these three routines for all of its own
** internal memory allocation needs. "Core" in the previous sentence
** does not include operating-system specific [VFS] implementation.  The
** Windows VFS uses native malloc() and free() for some operations.
**
** ^The dbsql_malloc() routine returns a pointer to a block
** of memory at least N bytes in length, where N is the parameter.
** ^If dbsql_malloc() is unable to obtain sufficient free
** memory, it returns a NULL pointer.  ^If the parameter N to
** dbsql_malloc() is zero or negative then dbsql_malloc() returns
** a NULL pointer.
**
** ^The dbsql_malloc64(N) routine works just like
** dbsql_malloc(N) except that N is an unsigned 64-bit integer instead
** of a signed 32-bit integer.
**
** ^Calling dbsql_free() with a pointer previously returned
** by dbsql_malloc() or dbsql_realloc() releases that memory so
** that it might be reused.  ^The dbsql_free() routine is
** a no-op if it is called with a NULL pointer.  Passing a NULL pointer
** to dbsql_free() is harmless.  After being freed, memory
** should neither be read nor written.  Even reading previously freed
** memory might result in a segmentation fault or other severe error.
** Memory corruption, a segmentation fault, or other severe error
** might result if dbsql_free() is called with a non-NULL pointer that
** was not obtained from dbsql_malloc() or dbsql_realloc().
**
** ^The dbsql_realloc(X,N) interface attempts to resize a
** prior memory allocation X to be at least N bytes.
** ^If the X parameter to dbsql_realloc(X,N)
** is a NULL pointer then its behavior is identical to calling
** dbsql_malloc(N).
** ^If the N parameter to dbsql_realloc(X,N) is zero or
** negative then the behavior is exactly the same as calling
** dbsql_free(X).
** ^dbsql_realloc(X,N) returns a pointer to a memory allocation
** of at least N bytes in size or NULL if insufficient memory is available.
** ^If M is the size of the prior allocation, then min(N,M) bytes of the
** prior allocation are copied into the beginning of the buffer returned
** by dbsql_realloc(X,N) and the prior allocation is freed.
** ^If dbsql_realloc(X,N) returns NULL and N is positive, then the
** prior allocation is not freed.
**
** ^The dbsql_realloc64(X,N) interface works the same as
** dbsql_realloc(X,N) except that N is a 64-bit unsigned integer instead
** of a 32-bit signed integer.
**
** ^If X is a memory allocation previously obtained from dbsql_malloc(),
** dbsql_malloc64(), dbsql_realloc(), or dbsql_realloc64(), then
** dbsql_msize(X) returns the size of that memory allocation in bytes.
** ^The value returned by dbsql_msize(X) might be larger than the number
** of bytes requested when X was allocated.  ^If X is a NULL pointer then
** dbsql_msize(X) returns zero.  If X points to something that is not
** the beginning of memory allocation, or if it points to a formerly
** valid memory allocation that has now been freed, then the behavior
** of dbsql_msize(X) is undefined and possibly harmful.
**
** ^The memory returned by dbsql_malloc(), dbsql_realloc(),
** dbsql_malloc64(), and dbsql_realloc64()
** is always aligned to at least an 8 byte boundary, or to a
** 4 byte boundary if the [DBSQL_4_BYTE_ALIGNED_MALLOC] compile-time
** option is used.
**
** The pointer arguments to [dbsql_free()] and [dbsql_realloc()]
** must be either NULL or else pointers obtained from a prior
** invocation of [dbsql_malloc()] or [dbsql_realloc()] that have
** not yet been released.
**
** The application must not read or write any part of
** a block of memory after it has been released using
** [dbsql_free()] or [dbsql_realloc()].
*/
void *dbsql_malloc(int);
void *dbsql_malloc64(u_int64_t);
void *dbsql_realloc(void*, int);
void *dbsql_realloc64(void*, u_int64_t);
void dbsql_free(void*);
u_int64_t dbsql_msize(void*);

/*
** CAPI3REF: Memory Allocator Statistics
**
** dbsql provides these two interfaces for reporting on the status
** of the [dbsql_malloc()], [dbsql_free()], and [dbsql_realloc()]
** routines, which form the built-in memory allocation subsystem.
**
** ^The [dbsql_memory_used()] routine returns the number of bytes
** of memory currently outstanding (malloced but not freed).
** ^The [dbsql_memory_highwater()] routine returns the maximum
** value of [dbsql_memory_used()] since the high-water mark
** was last reset.  ^The values returned by [dbsql_memory_used()] and
** [dbsql_memory_highwater()] include any overhead
** added by dbsql in its implementation of [dbsql_malloc()],
** but not overhead added by any underlying system library
** routines that [dbsql_malloc()] may call.
**
** ^The memory high-water mark is reset to the current value of
** [dbsql_memory_used()] if and only if the parameter to
** [dbsql_memory_highwater()] is true.  ^The value returned
** by [dbsql_memory_highwater(1)] is the high-water mark
** prior to the reset.
*/
int64_t dbsql_memory_used(void);
int64_t dbsql_memory_highwater(int reset_flag);

/*
** CAPI3REF: Pseudo-Random Number Generator
**
** dbsql contains a high-quality pseudo-random number generator (PRNG) used to
** select random [ROWID | ROWIDs] when inserting new records into a table that
** already uses the largest possible [ROWID].  The PRNG is also used for
** the built-in random() and randomblob() SQL functions.  This interface allows
** applications to access the same PRNG for other purposes.
**
** ^A call to this routine stores N bytes of randomness into buffer P.
** ^The P parameter can be a NULL pointer.
**
** ^If this routine has not been previously called or if the previous
** call had N less than one or a NULL pointer for P, then the PRNG is
** seeded using randomness obtained from the randomness method of
** the default [dbsql_vfs_t] object.
** ^If the previous call to this routine had an N of 1 or more and a
** non-NULL P then the pseudo-randomness is generated
** internally and without recourse to the [dbsql_vfs_t] randomness
** method.
*/
void dbsql_randomness(int N, void *P);

/*
** CAPI3REF: Compile-Time Authorization Callbacks
** METHOD: DBSQL
** KEYWORDS: {authorizer callback}
**
** ^This routine registers an authorizer callback with a particular
** [database connection], supplied in the first argument.
** ^The authorizer callback is invoked as SQL statements are being compiled
** by [dbsql_prepare()] or its variants [dbsql_prepare_v2()],
** [dbsql_prepare_v3()], [dbsql_prepare16()], [dbsql_prepare16_v2()],
** and [dbsql_prepare16_v3()].  ^At various
** points during the compilation process, as logic is being created
** to perform various actions, the authorizer callback is invoked to
** see if those actions are allowed.  ^The authorizer callback should
** return [DBSQL_OK] to allow the action, [DBSQL_IGNORE] to disallow the
** specific action but allow the SQL statement to continue to be
** compiled, or [DBSQL_DENY] to cause the entire SQL statement to be
** rejected with an error.  ^If the authorizer callback returns
** any value other than [DBSQL_IGNORE], [DBSQL_OK], or [DBSQL_DENY]
** then the [dbsql_prepare_v2()] or equivalent call that triggered
** the authorizer will fail with an error message.
**
** When the callback returns [DBSQL_OK], that means the operation
** requested is ok.  ^When the callback returns [DBSQL_DENY], the
** [dbsql_prepare_v2()] or equivalent call that triggered the
** authorizer will fail with an error message explaining that
** access is denied.
**
** ^The first parameter to the authorizer callback is a copy of the third
** parameter to the dbsql_set_authorizer() interface. ^The second parameter
** to the callback is an integer [DBSQL_COPY | action code] that specifies
** the particular action to be authorized. ^The third through sixth parameters
** to the callback are either NULL pointers or zero-terminated strings
** that contain additional details about the action to be authorized.
** Applications must always be prepared to encounter a NULL pointer in any
** of the third through the sixth parameters of the authorization callback.
**
** ^If the action code is [DBSQL_READ]
** and the callback returns [DBSQL_IGNORE] then the
** [prepared statement] statement is constructed to substitute
** a NULL value in place of the table column that would have
** been read if [DBSQL_OK] had been returned.  The [DBSQL_IGNORE]
** return can be used to deny an untrusted user access to individual
** columns of a table.
** ^When a table is referenced by a [SELECT] but no column values are
** extracted from that table (for example in a query like
** "SELECT count(*) FROM tab") then the [DBSQL_READ] authorizer callback
** is invoked once for that table with a column name that is an empty string.
** ^If the action code is [DBSQL_DELETE] and the callback returns
** [DBSQL_IGNORE] then the [DELETE] operation proceeds but the
** [truncate optimization] is disabled and all rows are deleted individually.
**
** An authorizer is used when [dbsql_prepare | preparing]
** SQL statements from an untrusted source, to ensure that the SQL statements
** do not try to access data they are not allowed to see, or that they do not
** try to execute malicious statements that damage the database.  For
** example, an application may allow a user to enter arbitrary
** SQL queries for evaluation by a database.  But the application does
** not want the user to be able to make arbitrary changes to the
** database.  An authorizer could then be put in place while the
** user-entered SQL is being [dbsql_prepare | prepared] that
** disallows everything except [SELECT] statements.
**
** Applications that need to process SQL from untrusted sources
** might also consider lowering resource limits using [dbsql_limit()]
** and limiting database size using the [max_page_count] [PRAGMA]
** in addition to using an authorizer.
**
** ^(Only a single authorizer can be in place on a database connection
** at a time.  Each call to dbsql_set_authorizer overrides the
** previous call.)^  ^Disable the authorizer by installing a NULL callback.
** The authorizer is disabled by default.
**
** The authorizer callback must not do anything that will modify
** the database connection that invoked the authorizer callback.
** Note that [dbsql_prepare_v2()] and [dbsql_step()] both modify their
** database connections for the meaning of "modify" in this paragraph.
**
** ^When [dbsql_prepare_v2()] is used to prepare a statement, the
** statement might be re-prepared during [dbsql_step()] due to a
** schema change.  Hence, the application should ensure that the
** correct authorizer callback remains in place during the [dbsql_step()].
**
** ^Note that the authorizer callback is invoked only during
** [dbsql_prepare()] or its variants.  Authorization is not
** performed during statement evaluation in [dbsql_step()], unless
** as stated in the previous paragraph, dbsql_step() invokes
** dbsql_prepare_v2() to reprepare a statement after a schema change.
*/
int dbsql_set_authorizer(
  DBSQL*,
  int (*auth)(void*,int,const char*,const char*,const char*,const char*),
  void *user_data
);

/*
** CAPI3REF: Authorizer Return Codes
**
** The [dbsql_set_authorizer | authorizer callback function] must
** return either [DBSQL_OK] or one of these two constants in order
** to signal dbsql whether or not the action is permitted.  See the
** [dbsql_set_authorizer | authorizer documentation] for additional
** information.
**
** Note that DBSQL_IGNORE is also used as a [conflict resolution mode]
** returned from the [dbsql_vtab_on_conflict()] interface.
*/
#define DBSQL_DENY   1   /* Abort the SQL statement with an error */
#define DBSQL_IGNORE 2   /* Don't allow access, but don't generate an error */

/*
** CAPI3REF: Authorizer Action Codes
**
** The [dbsql_set_authorizer()] interface registers a callback function
** that is invoked to authorize certain SQL statement actions.  The
** second parameter to the callback is an integer code that specifies
** what action is being authorized.  These are the integer action codes that
** the authorizer callback may be passed.
**
** These action code values signify what kind of operation is to be
** authorized.  The 3rd and 4th parameters to the authorization
** callback function will be parameters or NULL depending on which of these
** codes is used as the second parameter.  ^(The 5th parameter to the
** authorizer callback is the name of the database ("main", "temp",
** etc.) if applicable.)^  ^The 6th parameter to the authorizer callback
** is the name of the inner-most trigger or view that is responsible for
** the access attempt or NULL if this access attempt is directly from
** top-level SQL code.
*/
/******************************************* 3rd ************ 4th ***********/
#define DBSQL_CREATE_INDEX          1   /* index_t Name      table_t Name      */
#define DBSQL_CREATE_TABLE          2   /* table_t Name      NULL            */
#define DBSQL_CREATE_TEMP_INDEX     3   /* index_t Name      table_t Name      */
#define DBSQL_CREATE_TEMP_TABLE     4   /* table_t Name      NULL            */
#define DBSQL_CREATE_TEMP_TRIGGER   5   /* trigger_t Name    table_t Name      */
#define DBSQL_CREATE_TEMP_VIEW      6   /* View Name       NULL            */
#define DBSQL_CREATE_TRIGGER        7   /* trigger_t Name    table_t Name      */
#define DBSQL_CREATE_VIEW           8   /* View Name       NULL            */
#define DBSQL_DELETE                9   /* table_t Name      NULL            */
#define DBSQL_DROP_INDEX           10   /* index_t Name      table_t Name      */
#define DBSQL_DROP_TABLE           11   /* table_t Name      NULL            */
#define DBSQL_DROP_TEMP_INDEX      12   /* index_t Name      table_t Name      */
#define DBSQL_DROP_TEMP_TABLE      13   /* table_t Name      NULL            */
#define DBSQL_DROP_TEMP_TRIGGER    14   /* trigger_t Name    table_t Name      */
#define DBSQL_DROP_TEMP_VIEW       15   /* View Name       NULL            */
#define DBSQL_DROP_TRIGGER         16   /* trigger_t Name    table_t Name      */
#define DBSQL_DROP_VIEW            17   /* View Name       NULL            */
#define DBSQL_INSERT               18   /* table_t Name      NULL            */
#define DBSQL_PRAGMA               19   /* Pragma Name     1st arg or NULL */
#define DBSQL_READ                 20   /* table_t Name      column_t Name     */
#define DBSQL_SELECT               21   /* NULL            NULL            */
#define DBSQL_TRANSACTION          22   /* Operation       NULL            */
#define DBSQL_UPDATE               23   /* table_t Name      column_t Name     */
#define DBSQL_ATTACH               24   /* Filename        NULL            */
#define DBSQL_DETACH               25   /* Database Name   NULL            */
#define DBSQL_ALTER_TABLE          26   /* Database Name   table_t Name      */
#define DBSQL_REINDEX              27   /* index_t Name      NULL            */
#define DBSQL_ANALYZE              28   /* table_t Name      NULL            */
#define DBSQL_CREATE_VTABLE        29   /* table_t Name      module_def_t Name     */
#define DBSQL_DROP_VTABLE          30   /* table_t Name      module_def_t Name     */
#define DBSQL_FUNCTION             31   /* NULL            Function Name   */
#define DBSQL_SAVEPOINT            32   /* Operation       savepoint_t Name  */
#define DBSQL_COPY                  0   /* No longer used */
#define DBSQL_RECURSIVE            33   /* NULL            NULL            */

/*
** CAPI3REF: Deprecated Tracing And Profiling Functions
** DEPRECATED
**
** These routines are deprecated. Use the [dbsql_trace_v2()] interface
** instead of the routines described here.
**
** These routines register callback functions that can be used for
** tracing and profiling the execution of SQL statements.
**
** ^The callback function registered by dbsql_trace() is invoked at
** various times when an SQL statement is being run by [dbsql_step()].
** ^The dbsql_trace() callback is invoked with a UTF-8 rendering of the
** SQL statement text as the statement first begins executing.
** ^(Additional dbsql_trace() callbacks might occur
** as each triggered subprogram is entered.  The callbacks for triggers
** contain a UTF-8 SQL comment that identifies the trigger.)^
**
** The [DBSQL_TRACE_SIZE_LIMIT] compile-time option can be used to limit
** the length of [bound parameter] expansion in the output of dbsql_trace().
**
** ^The callback function registered by dbsql_profile() is invoked
** as each SQL statement finishes.  ^The profile callback contains
** the original statement text and an estimate of wall-clock time
** of how long that statement took to run.  ^The profile callback
** time is in units of nanoseconds, however the current implementation
** is only capable of millisecond resolution so the six least significant
** digits in the time are meaningless.  Future versions of dbsql
** might provide greater resolution on the profiler callback.  Invoking
** either [dbsql_trace()] or [dbsql_trace_v2()] will cancel the
** profile callback.
*/
DBSQL_DEPRECATED void *dbsql_trace(DBSQL*,
   void(*trace)(void*,const char*), void*);
DBSQL_DEPRECATED void *dbsql_profile(DBSQL*,
   void(*profile)(void*,const char*,u_int64_t), void*);

/*
** CAPI3REF: SQL Trace Event Codes
** KEYWORDS: DBSQL_TRACE
**
** These constants identify classes of events that can be monitored
** using the [dbsql_trace_v2()] tracing logic.  The M argument
** to [dbsql_trace_v2(D,M,X,P)] is an OR-ed combination of one or more of
** the following constants.  ^The first argument to the trace callback
** is one of the following constants.
**
** New tracing constants may be added in future releases.
**
** ^A trace callback has four arguments: callback(T,C,P,X).
** ^The T argument is one of the integer type codes above.
** ^The C argument is a copy of the context pointer passed in as the
** fourth argument to [dbsql_trace_v2()].
** The P and X arguments are pointers whose meanings depend on T.
**
** <dl>
** [[DBSQL_TRACE_STMT]] <dt>DBSQL_TRACE_STMT</dt>
** <dd>^An DBSQL_TRACE_STMT callback is invoked when a prepared statement
** first begins running and possibly at other times during the
** execution of the prepared statement, such as at the start of each
** trigger subprogram. ^The P argument is a pointer to the
** [prepared statement]. ^The X argument is a pointer to a string which
** is the unexpanded SQL text of the prepared statement or an SQL comment
** that indicates the invocation of a trigger.  ^The callback can compute
** the same text that would have been returned by the legacy [dbsql_trace()]
** interface by using the X argument when X begins with "--" and invoking
** [dbsql_expanded_sql(P)] otherwise.
**
** [[DBSQL_TRACE_PROFILE]] <dt>DBSQL_TRACE_PROFILE</dt>
** <dd>^An DBSQL_TRACE_PROFILE callback provides approximately the same
** information as is provided by the [dbsql_profile()] callback.
** ^The P argument is a pointer to the [prepared statement] and the
** X argument points to a 64-bit integer which is approximately
** the number of nanoseconds that the prepared statement took to run.
** ^The DBSQL_TRACE_PROFILE callback is invoked when the statement finishes.
**
** [[DBSQL_TRACE_ROW]] <dt>DBSQL_TRACE_ROW</dt>
** <dd>^An DBSQL_TRACE_ROW callback is invoked whenever a prepared
** statement generates a single row of result.
** ^The P argument is a pointer to the [prepared statement] and the
** X argument is unused.
**
** [[DBSQL_TRACE_CLOSE]] <dt>DBSQL_TRACE_CLOSE</dt>
** <dd>^An DBSQL_TRACE_CLOSE callback is invoked when a database
** connection closes.
** ^The P argument is a pointer to the [database connection] object
** and the X argument is unused.
** </dl>
*/
#define DBSQL_TRACE_STMT       0x01
#define DBSQL_TRACE_PROFILE    0x02
#define DBSQL_TRACE_ROW        0x04
#define DBSQL_TRACE_CLOSE      0x08

/*
** CAPI3REF: SQL Trace Hook
** METHOD: DBSQL
**
** ^The dbsql_trace_v2(D,M,X,P) interface registers a trace callback
** function X against [database connection] D, using property mask M
** and context pointer P.  ^If the X callback is
** NULL or if the M mask is zero, then tracing is disabled.  The
** M argument should be the bitwise OR-ed combination of
** zero or more [DBSQL_TRACE] constants.
**
** ^Each call to either dbsql_trace(D,X,P) or dbsql_trace_v2(D,M,X,P)
** overrides (cancels) all prior calls to dbsql_trace(D,X,P) or
** dbsql_trace_v2(D,M,X,P) for the [database connection] D.  Each
** database connection may have at most one trace callback.
**
** ^The X callback is invoked whenever any of the events identified by
** mask M occur.  ^The integer return value from the callback is currently
** ignored, though this may change in future releases.  Callback
** implementations should return zero to ensure future compatibility.
**
** ^A trace callback is invoked with four arguments: callback(T,C,P,X).
** ^The T argument is one of the [DBSQL_TRACE]
** constants to indicate why the callback was invoked.
** ^The C argument is a copy of the context pointer.
** The P and X arguments are pointers whose meanings depend on T.
**
** The dbsql_trace_v2() interface is intended to replace the legacy
** interfaces [dbsql_trace()] and [dbsql_profile()], both of which
** are deprecated.
*/
int dbsql_trace_v2(
  DBSQL*,
  unsigned u_mask,
  int(*callback)(unsigned,void*,void*,void*),
  void *ctx
);

/*
** CAPI3REF: Query Progress Callbacks
** METHOD: DBSQL
**
** ^The dbsql_progress_handler(D,N,X,P) interface causes the callback
** function X to be invoked periodically during long running calls to
** [dbsql_step()] and [dbsql_prepare()] and similar for
** database connection D.  An example use for this
** interface is to keep a GUI updated during a large query.
**
** ^The parameter P is passed through as the only parameter to the
** callback function X.  ^The parameter N is the approximate number of
** [virtual machine instructions] that are evaluated between successive
** invocations of the callback X.  ^If N is less than one then the progress
** handler is disabled.
**
** ^Only a single progress handler may be defined at one time per
** [database connection]; setting a new progress handler cancels the
** old one.  ^Setting parameter X to NULL disables the progress handler.
** ^The progress handler is also disabled by setting N to a value less
** than 1.
**
** ^If the progress callback returns non-zero, the operation is
** interrupted.  This feature can be used to implement a
** "Cancel" button on a GUI progress dialog box.
**
** The progress handler callback must not do anything that will modify
** the database connection that invoked the progress handler.
** Note that [dbsql_prepare_v2()] and [dbsql_step()] both modify their
** database connections for the meaning of "modify" in this paragraph.
**
** The progress handler callback would originally only be invoked from the
** bytecode engine.  It still might be invoked during [dbsql_prepare()]
** and similar because those routines might force a reparse of the schema
** which involves running the bytecode engine.  However, beginning with
** dbsql version 3.41.0, the progress handler callback might also be
** invoked directly from [dbsql_prepare()] while analyzing and generating
** code for complex queries.
*/
void dbsql_progress_handler(DBSQL*, int, int(*)(void*), void*);

/*
** CAPI3REF: Opening A New Database Connection
** CONSTRUCTOR: DBSQL
**
** ^These routines open an dbsql database file as specified by the
** filename argument. ^The filename argument is interpreted as UTF-8 for
** dbsql_open() and dbsql_open_v2() and as UTF-16 in the native byte
** order for dbsql_open16(). ^(A [database connection] handle is usually
** returned in *db, even if an error occurs.  The only exception is that
** if dbsql is unable to allocate memory to hold the [DBSQL] object,
** a NULL will be written into *db instead of a pointer to the [DBSQL]
** object.)^ ^(If the database is opened (and/or created) successfully, then
** [DBSQL_OK] is returned.  Otherwise an [error code] is returned.)^ ^The
** [dbsql_errmsg()] or [dbsql_errmsg16()] routines can be used to obtain
** an English language description of the error following a failure of any
** of the dbsql_open() routines.
**
** ^The default encoding will be UTF-8 for databases created using
** dbsql_open() or dbsql_open_v2().  ^The default encoding for databases
** created using dbsql_open16() will be UTF-16 in the native byte order.
**
** Whether or not an error occurs when it is opened, resources
** associated with the [database connection] handle should be released by
** passing it to [dbsql_close()] when it is no longer required.
**
** The dbsql_open_v2() interface works like dbsql_open()
** except that it accepts two additional parameters for additional control
** over the new database connection.  ^(The flags parameter to
** dbsql_open_v2() must include, at a minimum, one of the following
** three flag combinations:)^
**
** <dl>
** ^(<dt>[DBSQL_OPEN_READONLY]</dt>
** <dd>The database is opened in read-only mode.  If the database does
** not already exist, an error is returned.</dd>)^
**
** ^(<dt>[DBSQL_OPEN_READWRITE]</dt>
** <dd>The database is opened for reading and writing if possible, or
** reading only if the file is write protected by the operating
** system.  In either case the database must already exist, otherwise
** an error is returned.  For historical reasons, if opening in
** read-write mode fails due to OS-level permissions, an attempt is
** made to open it in read-only mode. [dbsql_db_readonly()] can be
** used to determine whether the database is actually
** read-write.</dd>)^
**
** ^(<dt>[DBSQL_OPEN_READWRITE] | [DBSQL_OPEN_CREATE]</dt>
** <dd>The database is opened for reading and writing, and is created if
** it does not already exist. This is the behavior that is always used for
** dbsql_open() and dbsql_open16().</dd>)^
** </dl>
**
** In addition to the required flags, the following optional flags are
** also supported:
**
** <dl>
** ^(<dt>[DBSQL_OPEN_URI]</dt>
** <dd>The filename can be interpreted as a URI if this flag is set.</dd>)^
**
** ^(<dt>[DBSQL_OPEN_MEMORY]</dt>
** <dd>The database will be opened as an in-memory database.  The database
** is named by the "filename" argument for the purposes of cache-sharing,
** if shared cache mode is enabled, but the "filename" is otherwise ignored.
** </dd>)^
**
** ^(<dt>[DBSQL_OPEN_NOMUTEX]</dt>
** <dd>The new database connection will use the "multi-thread"
** [threading mode].)^  This means that separate threads are allowed
** to use dbsql at the same time, as long as each thread is using
** a different [database connection].
**
** ^(<dt>[DBSQL_OPEN_FULLMUTEX]</dt>
** <dd>The new database connection will use the "serialized"
** [threading mode].)^  This means the multiple threads can safely
** attempt to use the same database connection at the same time.
** (Mutexes will block any actual concurrency, but in this mode
** there is no harm in trying.)
**
** ^(<dt>[DBSQL_OPEN_SHAREDCACHE]</dt>
** <dd>The database is opened with [shared cache] enabled, overriding
** the default shared cache setting provided by
** [dbsql_enable_shared_cache()].)^
** The [use of shared cache mode is discouraged] and hence shared cache
** capabilities may be omitted from many builds of dbsql.  In such cases,
** this option is a no-op.
**
** ^(<dt>[DBSQL_OPEN_PRIVATECACHE]</dt>
** <dd>The database is opened with [shared cache] disabled, overriding
** the default shared cache setting provided by
** [dbsql_enable_shared_cache()].)^
**
** [[OPEN_EXRESCODE]] ^(<dt>[DBSQL_OPEN_EXRESCODE]</dt>
** <dd>The database connection comes up in "extended result code mode".
** In other words, the database behaves as if
** [dbsql_extended_result_codes(db,1)] were called on the database
** connection as soon as the connection is created. In addition to setting
** the extended result code mode, this flag also causes [dbsql_open_v2()]
** to return an extended result code.</dd>
**
** [[OPEN_NOFOLLOW]] ^(<dt>[DBSQL_OPEN_NOFOLLOW]</dt>
** <dd>The database filename is not allowed to contain a symbolic link</dd>
** </dl>)^
**
** If the 3rd parameter to dbsql_open_v2() is not one of the
** required combinations shown above optionally combined with other
** [DBSQL_OPEN_READONLY | DBSQL_OPEN_* bits]
** then the behavior is undefined.  Historic versions of dbsql
** have silently ignored surplus bits in the flags parameter to
** dbsql_open_v2(), however that behavior might not be carried through
** into future versions of dbsql and so applications should not rely
** upon it.  Note in particular that the DBSQL_OPEN_EXCLUSIVE flag is a no-op
** for dbsql_open_v2().  The DBSQL_OPEN_EXCLUSIVE does *not* cause
** the open to fail if the database already exists.  The DBSQL_OPEN_EXCLUSIVE
** flag is intended for use by the [dbsql_vfs_t|VFS interface] only, and not
** by dbsql_open_v2().
**
** ^The fourth parameter to dbsql_open_v2() is the name of the
** [dbsql_vfs_t] object that defines the operating system interface that
** the new database connection should use.  ^If the fourth parameter is
** a NULL pointer then the default [dbsql_vfs_t] object is used.
**
** ^If the filename is ":memory:", then a private, temporary in-memory database
** is created for the connection.  ^This in-memory database will vanish when
** the database connection is closed.  Future versions of dbsql might
** make use of additional special filenames that begin with the ":" character.
** It is recommended that when a database filename actually does begin with
** a ":" character you should prefix the filename with a pathname such as
** "./" to avoid ambiguity.
**
** ^If the filename is an empty string, then a private, temporary
** on-disk database will be created.  ^This private database will be
** automatically deleted as soon as the database connection is closed.
**
** [[URI filenames in dbsql_open()]] <h3>URI Filenames</h3>
**
** ^If [URI filename] interpretation is enabled, and the filename argument
** begins with "file:", then the filename is interpreted as a URI. ^URI
** filename interpretation is enabled if the [DBSQL_OPEN_URI] flag is
** set in the third argument to dbsql_open_v2(), or if it has
** been enabled globally using the [DBSQL_CONFIG_URI] option with the
** [dbsql_config()] method or by the [DBSQL_USE_URI] compile-time option.
** URI filename interpretation is turned off
** by default, but future releases of dbsql might enable URI filename
** interpretation by default.  See "[URI filenames]" for additional
** information.
**
** URI filenames are parsed according to RFC 3986. ^If the URI contains an
** authority, then it must be either an empty string or the string
** "localhost". ^If the authority is not an empty string or "localhost", an
** error is returned to the caller. ^The fragment component of a URI, if
** present, is ignored.
**
** ^dbsql uses the path component of the URI as the name of the disk file
** which contains the database. ^If the path begins with a '/' character,
** then it is interpreted as an absolute path. ^If the path does not begin
** with a '/' (meaning that the authority section is omitted from the URI)
** then the path is interpreted as a relative path.
** ^(On windows, the first component of an absolute path
** is a drive specification (e.g. "C:").)^
**
** [[core URI query parameters]]
** The query component of a URI may contain parameters that are interpreted
** either by dbsql itself, or by a [VFS | custom VFS implementation].
** dbsql and its built-in [VFSes] interpret the
** following query parameters:
**
** <ul>
**   <li> <b>vfs</b>: ^The "vfs" parameter may be used to specify the name of
**     a VFS object that provides the operating system interface that should
**     be used to access the database file on disk. ^If this option is set to
**     an empty string the default VFS object is used. ^Specifying an unknown
**     VFS is an error. ^If dbsql_open_v2() is used and the vfs option is
**     present, then the VFS specified by the option takes precedence over
**     the value passed as the fourth parameter to dbsql_open_v2().
**
**   <li> <b>mode</b>: ^(The mode parameter may be set to either "ro", "rw",
**     "rwc", or "memory". Attempting to set it to any other value is
**     an error)^.
**     ^If "ro" is specified, then the database is opened for read-only
**     access, just as if the [DBSQL_OPEN_READONLY] flag had been set in the
**     third argument to dbsql_open_v2(). ^If the mode option is set to
**     "rw", then the database is opened for read-write (but not create)
**     access, as if DBSQL_OPEN_READWRITE (but not DBSQL_OPEN_CREATE) had
**     been set. ^Value "rwc" is equivalent to setting both
**     DBSQL_OPEN_READWRITE and DBSQL_OPEN_CREATE.  ^If the mode option is
**     set to "memory" then a pure [in-memory database] that never reads
**     or writes from disk is used. ^It is an error to specify a value for
**     the mode parameter that is less restrictive than that specified by
**     the flags passed in the third parameter to dbsql_open_v2().
**
**   <li> <b>cache</b>: ^The cache parameter may be set to either "shared" or
**     "private". ^Setting it to "shared" is equivalent to setting the
**     DBSQL_OPEN_SHAREDCACHE bit in the flags argument passed to
**     dbsql_open_v2(). ^Setting the cache parameter to "private" is
**     equivalent to setting the DBSQL_OPEN_PRIVATECACHE bit.
**     ^If dbsql_open_v2() is used and the "cache" parameter is present in
**     a URI filename, its value overrides any behavior requested by setting
**     DBSQL_OPEN_PRIVATECACHE or DBSQL_OPEN_SHAREDCACHE flag.
**
**  <li> <b>psow</b>: ^The psow parameter indicates whether or not the
**     [powersafe overwrite] property does or does not apply to the
**     storage media on which the database file resides.
**
**  <li> <b>nolock</b>: ^The nolock parameter is a boolean query parameter
**     which if set disables file locking in rollback journal modes.  This
**     is useful for accessing a database on a filesystem that does not
**     support locking.  Caution:  Database corruption might result if two
**     or more processes write to the same database and any one of those
**     processes uses nolock=1.
**
**  <li> <b>immutable</b>: ^The immutable parameter is a boolean query
**     parameter that indicates that the database file is stored on
**     read-only media.  ^When immutable is set, dbsql assumes that the
**     database file cannot be changed, even by a process with higher
**     privilege, and so the database is opened read-only and all locking
**     and change detection is disabled.  Caution: Setting the immutable
**     property on a database file that does in fact change can result
**     in incorrect query results and/or [DBSQL_CORRUPT] errors.
**     See also: [DBSQL_IOCAP_IMMUTABLE].
**      
** </ul>
**
** ^Specifying an unknown parameter in the query component of a URI is not an
** error.  Future versions of dbsql might understand additional query
** parameters.  See "[query parameters with special meaning to dbsql]" for
** additional information.
**
** [[URI filename examples]] <h3>URI filename examples</h3>
**
** <table border="1" align=center cellpadding=5>
** <tr><th> URI filenames <th> Results
** <tr><td> file:data.db <td>
**          Open the file "data.db" in the current directory.
** <tr><td> file:/home/fred/data.db<br>
**          file:///home/fred/data.db <br>
**          file://localhost/home/fred/data.db <br> <td>
**          Open the database file "/home/fred/data.db".
** <tr><td> file://darkstar/home/fred/data.db <td>
**          An error. "darkstar" is not a recognized authority.
** <tr><td style="white-space:nowrap">
**          file:///C:/Documents%20and%20Settings/fred/Desktop/data.db
**     <td> Windows only: Open the file "data.db" on fred's desktop on drive
**          C:. Note that the %20 escaping in this example is not strictly
**          necessary - space characters can be used literally
**          in URI filenames.
** <tr><td> file:data.db?mode=ro&cache=private <td>
**          Open file "data.db" in the current directory for read-only access.
**          Regardless of whether or not shared-cache mode is enabled by
**          default, use a private cache.
** <tr><td> file:/home/fred/data.db?vfs=unix-dotfile <td>
**          Open file "/home/fred/data.db". Use the special VFS "unix-dotfile"
**          that uses dot-files in place of posix advisory locking.
** <tr><td> file:data.db?mode=readonly <td>
**          An error. "readonly" is not a valid option for the "mode" parameter.
**          Use "ro" instead:  "file:data.db?mode=ro".
** </table>
**
** ^URI hexadecimal escape sequences (%HH) are supported within the path and
** query components of a URI. A hexadecimal escape sequence consists of a
** percent sign - "%" - followed by exactly two hexadecimal digits
** specifying an octet value. ^Before the path or query components of a
** URI filename are interpreted, they are encoded using UTF-8 and all
** hexadecimal escape sequences replaced by a single byte containing the
** corresponding octet. If this process generates an invalid UTF-8 encoding,
** the results are undefined.
**
** <b>Note to Windows users:</b>  The encoding used for the filename argument
** of dbsql_open() and dbsql_open_v2() must be UTF-8, not whatever
** codepage is currently defined.  Filenames containing international
** characters must be converted to UTF-8 prior to passing them into
** dbsql_open() or dbsql_open_v2().
**
** <b>Note to Windows Runtime users:</b>  The temporary directory must be set
** prior to calling dbsql_open() or dbsql_open_v2().  Otherwise, various
** features that require the use of temporary files may fail.
**
** See also: [dbsql_temp_directory]
*/
int dbsql_open(
  const char *filename,   /* Database filename (UTF-8) */
  DBSQL **db          /* OUT: dbsql db handle */
);
int dbsql_open16(
  const void *filename,   /* Database filename (UTF-16) */
  DBSQL **db          /* OUT: dbsql db handle */
);
int dbsql_open_v2(
  const char *filename,   /* Database filename (UTF-8) */
  DBSQL **db,         /* OUT: dbsql db handle */
  int flags,              /* Flags */
  const char *vfs        /* Name of VFS module to use */
);

/*
** CAPI3REF: Obtain Values For URI Parameters
**
** These are utility routines, useful to [VFS|custom VFS implementations],
** that check if a database file was a URI that contained a specific query
** parameter, and if so obtains the value of that query parameter.
**
** The first parameter to these interfaces (hereafter referred to
** as F) must be one of:
** <ul>
** <li> A database filename pointer created by the dbsql core and
** passed into the x_open() method of a VFS implementation, or
** <li> A filename obtained from [dbsql_db_filename()], or
** <li> A new filename constructed using [dbsql_create_filename()].
** </ul>
** If the F parameter is not one of the above, then the behavior is
** undefined and probably undesirable.  Older versions of dbsql were
** more tolerant of invalid F parameters than newer versions.
**
** If F is a suitable filename (as described in the previous paragraph)
** and if P is the name of the query parameter, then
** dbsql_uri_parameter(F,P) returns the value of the P
** parameter if it exists or a NULL pointer if P does not appear as a
** query parameter on F.  If P is a query parameter of F and it
** has no explicit value, then dbsql_uri_parameter(F,P) returns
** a pointer to an empty string.
**
** The dbsql_uri_boolean(F,P,B) routine assumes that P is a boolean
** parameter and returns true (1) or false (0) according to the value
** of P.  The dbsql_uri_boolean(F,P,B) routine returns true (1) if the
** value of query parameter P is one of "yes", "true", or "on" in any
** case or if the value begins with a non-zero number.  The
** dbsql_uri_boolean(F,P,B) routines returns false (0) if the value of
** query parameter P is one of "no", "false", or "off" in any case or
** if the value begins with a numeric zero.  If P is not a query
** parameter on F or if the value of P does not match any of the
** above, then dbsql_uri_boolean(F,P,B) returns (B!=0).
**
** The dbsql_uri_int64(F,P,D) routine converts the value of P into a
** 64-bit signed integer and returns that integer, or D if P does not
** exist.  If the value of P is something other than an integer, then
** zero is returned.
**
** The dbsql_uri_key(F,N) returns a pointer to the name (not
** the value) of the N-th query parameter for filename F, or a NULL
** pointer if N is less than zero or greater than the number of query
** parameters minus 1.  The N value is zero-based so N should be 0 to obtain
** the name of the first query parameter, 1 for the second parameter, and
** so forth.
**
** If F is a NULL pointer, then dbsql_uri_parameter(F,P) returns NULL and
** dbsql_uri_boolean(F,P,B) returns B.  If F is not a NULL pointer and
** is not a database file pathname pointer that the dbsql core passed
** into the x_open VFS method, then the behavior of this routine is undefined
** and probably undesirable.
**
** Beginning with dbsql [version 3.31.0] ([dateof:3.31.0]) the input F
** parameter can also be the name of a rollback journal file or WAL file
** in addition to the main database file.  Prior to version 3.31.0, these
** routines would only work if F was the name of the main database file.
** When the F parameter is the name of the rollback journal or WAL file,
** it has access to all the same query parameters as were found on the
** main database file.
**
** See the [URI filename] documentation for additional information.
*/
const char *dbsql_uri_parameter(dbsql_filename_t z, const char *param);
int dbsql_uri_boolean(dbsql_filename_t z, const char *param, int b_default);
int64_t dbsql_uri_int64(dbsql_filename_t, const char*, int64_t);
const char *dbsql_uri_key(dbsql_filename_t z, int N);

/*
** CAPI3REF:  Translate filenames
**
** These routines are available to [VFS|custom VFS implementations] for
** translating filenames between the main database file, the journal file,
** and the WAL file.
**
** If F is the name of an sqlite database file, journal file, or WAL file
** passed by the dbsql core into the VFS, then dbsql_filename_database(F)
** returns the name of the corresponding database file.
**
** If F is the name of an sqlite database file, journal file, or WAL file
** passed by the dbsql core into the VFS, or if F is a database filename
** obtained from [dbsql_db_filename()], then dbsql_filename_journal(F)
** returns the name of the corresponding rollback journal file.
**
** If F is the name of an sqlite database file, journal file, or WAL file
** that was passed by the dbsql core into the VFS, or if F is a database
** filename obtained from [dbsql_db_filename()], then
** dbsql_filename_wal(F) returns the name of the corresponding
** WAL file.
**
** In all of the above, if F is not the name of a database, journal or WAL
** filename passed into the VFS from the dbsql core and F is not the
** return value from [dbsql_db_filename()], then the result is
** undefined and is likely a memory access violation.
*/
const char *dbsql_filename_database(dbsql_filename_t);
const char *dbsql_filename_journal(dbsql_filename_t);
const char *dbsql_filename_wal(dbsql_filename_t);

/*
** CAPI3REF:  Database File Corresponding To A Journal
**
** ^If X is the name of a rollback or WAL-mode journal file that is
** passed into the x_open method of [dbsql_vfs_t], then
** dbsql_database_file_object(X) returns a pointer to the [dbsql_file_t]
** object that represents the main database file.
**
** This routine is intended for use in custom [VFS] implementations
** only.  It is not a general-purpose interface.
** The argument dbsql_file_object(X) must be a filename pointer that
** has been passed into [dbsql_vfs_t].x_open method where the
** flags parameter to x_open contains one of the bits
** [DBSQL_OPEN_MAIN_JOURNAL] or [DBSQL_OPEN_WAL].  Any other use
** of this routine results in undefined and probably undesirable
** behavior.
*/
dbsql_file_t *dbsql_database_file_object(const char*);

/*
** CAPI3REF: Create and Destroy VFS Filenames
**
** These interfaces are provided for use by [VFS shim] implementations and
** are not useful outside of that context.
**
** The dbsql_create_filename(D,J,W,N,P) allocates memory to hold a version of
** database filename D with corresponding journal file J and WAL file W and
** an array P of N URI Key/Value pairs.  The result from
** dbsql_create_filename(D,J,W,N,P) is a pointer to a database filename that
** is safe to pass to routines like:
** <ul>
** <li> [dbsql_uri_parameter()],
** <li> [dbsql_uri_boolean()],
** <li> [dbsql_uri_int64()],
** <li> [dbsql_uri_key()],
** <li> [dbsql_filename_database()],
** <li> [dbsql_filename_journal()], or
** <li> [dbsql_filename_wal()].
** </ul>
** If a memory allocation error occurs, dbsql_create_filename() might
** return a NULL pointer.  The memory obtained from dbsql_create_filename(X)
** must be released by a corresponding call to dbsql_free_filename(Y).
**
** The P parameter in dbsql_create_filename(D,J,W,N,P) should be an array
** of 2*N pointers to strings.  Each pair of pointers in this array corresponds
** to a key and value for a query parameter.  The P parameter may be a NULL
** pointer if N is zero.  None of the 2*N pointers in the P array may be
** NULL pointers and key pointers should not be empty strings.
** None of the D, J, or W parameters to dbsql_create_filename(D,J,W,N,P) may
** be NULL pointers, though they can be empty strings.
**
** The dbsql_free_filename(Y) routine releases a memory allocation
** previously obtained from dbsql_create_filename().  Invoking
** dbsql_free_filename(Y) where Y is a NULL pointer is a harmless no-op.
**
** If the Y parameter to dbsql_free_filename(Y) is anything other
** than a NULL pointer or a pointer previously acquired from
** dbsql_create_filename(), then bad things such as heap
** corruption or segfaults may occur. The value Y should not be
** used again after dbsql_free_filename(Y) has been called.  This means
** that if the [dbsql_vfs_t.x_open()] method of a VFS has been called using Y,
** then the corresponding [dbsql_module_t.x_close() method should also be
** invoked prior to calling dbsql_free_filename(Y).
*/
dbsql_filename_t dbsql_create_filename(
  const char *database,
  const char *journal,
  const char *wal,
  int n_param,
  const char **params
);
void dbsql_free_filename(dbsql_filename_t);

/*
** CAPI3REF: Error Codes And Messages
** METHOD: DBSQL
**
** ^If the most recent dbsql_* API call associated with
** [database connection] D failed, then the dbsql_errcode(D) interface
** returns the numeric [result code] or [extended result code] for that
** API call.
** ^The dbsql_extended_errcode()
** interface is the same except that it always returns the
** [extended result code] even when extended result codes are
** disabled.
**
** The values returned by dbsql_errcode() and/or
** dbsql_extended_errcode() might change with each API call.
** Except, there are some interfaces that are guaranteed to never
** change the value of the error code.  The error-code preserving
** interfaces include the following:
**
** <ul>
** <li> dbsql_errcode()
** <li> dbsql_extended_errcode()
** <li> dbsql_errmsg()
** <li> dbsql_errmsg16()
** <li> dbsql_error_offset()
** <li> dbsql_db_handle()
** </ul>
**
** ^The dbsql_errmsg() and dbsql_errmsg16() return English-language
** text that describes the error, as either UTF-8 or UTF-16 respectively,
** or NULL if no error message is available.
** (See how dbsql handles [invalid UTF] for exceptions to this rule.)
** ^(Memory to hold the error message string is managed internally.
** The application does not need to worry about freeing the result.
** However, the error string might be overwritten or deallocated by
** subsequent calls to other dbsql interface functions.)^
**
** ^The dbsql_errstr(E) interface returns the English-language text
** that describes the [result code] E, as UTF-8, or NULL if E is not a
** result code for which a text error message is available.
** ^(Memory to hold the error message string is managed internally
** and must not be freed by the application)^.
**
** ^If the most recent error references a specific token in the input
** SQL, the dbsql_error_offset() interface returns the byte offset
** of the start of that token.  ^The byte offset returned by
** dbsql_error_offset() assumes that the input SQL is UTF-8.
** ^If the most recent error does not reference a specific token in the input
** SQL, then the dbsql_error_offset() function returns -1.
**
** When the serialized [threading mode] is in use, it might be the
** case that a second error occurs on a separate thread in between
** the time of the first error and the call to these interfaces.
** When that happens, the second error will be reported since these
** interfaces always report the most recent result.  To avoid
** this, each thread can obtain exclusive use of the [database connection] D
** by invoking [dbsql_mutex_enter]([dbsql_db_mutex](D)) before beginning
** to use D and invoking [dbsql_mutex_leave]([dbsql_db_mutex](D)) after
** all calls to the interfaces listed here are completed.
**
** If an interface fails with DBSQL_MISUSE, that means the interface
** was invoked incorrectly by the application.  In that case, the
** error code and message may or may not be set.
*/
int dbsql_errcode(DBSQL *db);
int dbsql_extended_errcode(DBSQL *db);
const char *dbsql_errmsg(DBSQL*);
const void *dbsql_errmsg16(DBSQL*);
const char *dbsql_errstr(int);
int dbsql_error_offset(DBSQL *db);

/*
** CAPI3REF: Set Error Code And Message
** METHOD: DBSQL
**
** Set the error code of the database handle passed as the first argument
** to errcode, and the error message to a copy of nul-terminated string
** errmsg. If errmsg is passed NULL, then the error message is set to
** the default message associated with the supplied error code.  Subsequent
** calls to [dbsql_errcode()] and [dbsql_errmsg()] and similar will
** return the values set by this routine in place of what was previously
** set by dbsql itself.
**
** This function returns DBSQL_OK if the error code and error message are
** successfully set, DBSQL_NOMEM if an OOM occurs, and DBSQL_MISUSE if
** the database handle is NULL or invalid.
**
** The error code and message set by this routine remains in effect until
** they are changed, either by another call to this routine or until they are
** changed to by dbsql itself to reflect the result of some subsquent
** API call.
**
** This function is intended for use by dbsql extensions or wrappers.  The
** idea is that an extension or wrapper can use this routine to set error
** messages and error codes and thus behave more like a core dbsql
** feature from the point of view of an application.
*/
int dbsql_set_errmsg(DBSQL *db, int errcode, const char *errmsg);

/*
** CAPI3REF: Prepared Statement Object
** KEYWORDS: {prepared statement} {prepared statements}
**
** An instance of this object represents a single SQL statement that
** has been compiled into binary form and is ready to be evaluated.
**
** Think of each SQL statement as a separate computer program.  The
** original SQL text is source code.  A prepared statement object
** is the compiled object code.  All SQL must be converted into a
** prepared statement before it can be run.
**
** The life-cycle of a prepared statement object usually goes like this:
**
** <ol>
** <li> Create the prepared statement object using [dbsql_prepare_v2()].
** <li> Bind values to [parameters] using the dbsql_bind_*()
**      interfaces.
** <li> Run the SQL by calling [dbsql_step()] one or more times.
** <li> Reset the prepared statement using [dbsql_reset()] then go back
**      to step 2.  Do this zero or more times.
** <li> Destroy the object using [dbsql_finalize()].
** </ol>
*/
typedef struct dbsql_stmt_t dbsql_stmt_t;

/*
** CAPI3REF: Run-time Limits
** METHOD: DBSQL
**
** ^(This interface allows the size of various constructs to be limited
** on a connection by connection basis.  The first parameter is the
** [database connection] whose limit is to be set or queried.  The
** second parameter is one of the [limit categories] that define a
** class of constructs to be size limited.  The third parameter is the
** new limit for that construct.)^
**
** ^If the new limit is a negative number, the limit is unchanged.
** ^(For each limit category DBSQL_LIMIT_<i>NAME</i> there is a
** [limits | hard upper bound]
** set at compile-time by a C preprocessor macro called
** [limits | DBSQL_MAX_<i>NAME</i>].
** (The "_LIMIT_" in the name is changed to "_MAX_".))^
** ^Attempts to increase a limit above its hard upper bound are
** silently truncated to the hard upper bound.
**
** ^Regardless of whether or not the limit was changed, the
** [dbsql_limit()] interface returns the prior value of the limit.
** ^Hence, to find the current value of a limit without changing it,
** simply invoke this interface with the third parameter set to -1.
**
** Run-time limits are intended for use in applications that manage
** both their own internal database and also databases that are controlled
** by untrusted external sources.  An example application might be a
** web browser that has its own databases for storing history and
** separate databases controlled by __java_script applications downloaded
** off the Internet.  The internal databases can be given the
** large, default limits.  Databases managed by external sources can
** be given much smaller limits designed to prevent a denial of service
** attack.  Developers might also want to use the [dbsql_set_authorizer()]
** interface to further control untrusted SQL.  The size of the database
** created by an untrusted script can be contained using the
** [max_page_count] [PRAGMA].
**
** New run-time limit categories may be added in future releases.
*/
int dbsql_limit(DBSQL*, int id, int new_val);

/*
** CAPI3REF: Run-Time Limit Categories
** KEYWORDS: {limit category} {*limit categories}
**
** These constants define various performance limits
** that can be lowered at run-time using [dbsql_limit()].
** A concise description of these limits follows, and additional information
** is available at [limits | Limits in dbsql].
**
** <dl>
** [[DBSQL_LIMIT_LENGTH]] ^(<dt>DBSQL_LIMIT_LENGTH</dt>
** <dd>The maximum size of any string or BLOB or table row, in bytes.<dd>)^
**
** [[DBSQL_LIMIT_SQL_LENGTH]] ^(<dt>DBSQL_LIMIT_SQL_LENGTH</dt>
** <dd>The maximum length of an SQL statement, in bytes.</dd>)^
**
** [[DBSQL_LIMIT_COLUMN]] ^(<dt>DBSQL_LIMIT_COLUMN</dt>
** <dd>The maximum number of columns in a table definition or in the
** result set of a [SELECT] or the maximum number of columns in an index
** or in an ORDER BY or GROUP BY clause.</dd>)^
**
** [[DBSQL_LIMIT_EXPR_DEPTH]] ^(<dt>DBSQL_LIMIT_EXPR_DEPTH</dt>
** <dd>The maximum depth of the parse tree on any expression and
** the maximum nesting depth for subqueries and VIEWs</dd>)^
**
** [[DBSQL_LIMIT_PARSER_DEPTH]] ^(<dt>DBSQL_LIMIT_PARSER_DEPTH</dt>
** <dd>The maximum depth of the LALR(1) parser stack used to analyze
** input SQL statements.</dd>)^
**
** [[DBSQL_LIMIT_COMPOUND_SELECT]] ^(<dt>DBSQL_LIMIT_COMPOUND_SELECT</dt>
** <dd>The maximum number of terms in a compound SELECT statement.</dd>)^
**
** [[DBSQL_LIMIT_VDBE_OP]] ^(<dt>DBSQL_LIMIT_VDBE_OP</dt>
** <dd>The maximum number of instructions in a virtual machine program
** used to implement an SQL statement.  If [dbsql_prepare_v2()] or
** the equivalent tries to allocate space for more than this many opcodes
** in a single prepared statement, an DBSQL_NOMEM error is returned.</dd>)^
**
** [[DBSQL_LIMIT_FUNCTION_ARG]] ^(<dt>DBSQL_LIMIT_FUNCTION_ARG</dt>
** <dd>The maximum number of arguments on a function.</dd>)^
**
** [[DBSQL_LIMIT_ATTACHED]] ^(<dt>DBSQL_LIMIT_ATTACHED</dt>
** <dd>The maximum number of [ATTACH | attached databases].)^</dd>
**
** [[DBSQL_LIMIT_LIKE_PATTERN_LENGTH]]
** ^(<dt>DBSQL_LIMIT_LIKE_PATTERN_LENGTH</dt>
** <dd>The maximum length of the pattern argument to the [LIKE] or
** [GLOB] operators.</dd>)^
**
** [[DBSQL_LIMIT_VARIABLE_NUMBER]]
** ^(<dt>DBSQL_LIMIT_VARIABLE_NUMBER</dt>
** <dd>The maximum index number of any [parameter] in an SQL statement.)^
**
** [[DBSQL_LIMIT_TRIGGER_DEPTH]] ^(<dt>DBSQL_LIMIT_TRIGGER_DEPTH</dt>
** <dd>The maximum depth of recursion for triggers, and the maximum
** nesting depth for separate triggers.</dd>)^
**
** [[DBSQL_LIMIT_WORKER_THREADS]] ^(<dt>DBSQL_LIMIT_WORKER_THREADS</dt>
** <dd>The maximum number of auxiliary worker threads that a single
** [prepared statement] may start.</dd>)^
** </dl>
*/
#define DBSQL_LIMIT_LENGTH                    0
#define DBSQL_LIMIT_SQL_LENGTH                1
#define DBSQL_LIMIT_COLUMN                    2
#define DBSQL_LIMIT_EXPR_DEPTH                3
#define DBSQL_LIMIT_COMPOUND_SELECT           4
#define DBSQL_LIMIT_VDBE_OP                   5
#define DBSQL_LIMIT_FUNCTION_ARG              6
#define DBSQL_LIMIT_ATTACHED                  7
#define DBSQL_LIMIT_LIKE_PATTERN_LENGTH       8
#define DBSQL_LIMIT_VARIABLE_NUMBER           9
#define DBSQL_LIMIT_TRIGGER_DEPTH            10
#define DBSQL_LIMIT_WORKER_THREADS           11
#define DBSQL_LIMIT_PARSER_DEPTH             12

/*
** CAPI3REF: Prepare Flags
**
** These constants define various flags that can be passed into the
** "prep_flags" parameter of the [dbsql_prepare_v3()] and
** [dbsql_prepare16_v3()] interfaces.
**
** New flags may be added in future releases of dbsql.
**
** <dl>
** [[DBSQL_PREPARE_PERSISTENT]] ^(<dt>DBSQL_PREPARE_PERSISTENT</dt>
** <dd>The DBSQL_PREPARE_PERSISTENT flag is a hint to the query planner
** that the prepared statement will be retained for a long time and
** probably reused many times.)^ ^Without this flag, [dbsql_prepare_v3()]
** and [dbsql_prepare16_v3()] assume that the prepared statement will
** be used just once or at most a few times and then destroyed using
** [dbsql_finalize()] relatively soon. The current implementation acts
** on this hint by avoiding the use of [lookaside memory] so as not to
** deplete the limited store of lookaside memory. Future versions of
** dbsql may act on this hint differently.
**
** [[DBSQL_PREPARE_NORMALIZE]] <dt>DBSQL_PREPARE_NORMALIZE</dt>
** <dd>The DBSQL_PREPARE_NORMALIZE flag is a no-op. This flag used
** to be required for any prepared statement that wanted to use the
** [dbsql_normalized_sql()] interface.  However, the
** [dbsql_normalized_sql()] interface is now available to all
** prepared statements, regardless of whether or not they use this
** flag.
**
** [[DBSQL_PREPARE_NO_VTAB]] <dt>DBSQL_PREPARE_NO_VTAB</dt>
** <dd>The DBSQL_PREPARE_NO_VTAB flag causes the SQL compiler
** to return an error (error code DBSQL_ERROR) if the statement uses
** any virtual tables.
**
** [[DBSQL_PREPARE_DONT_LOG]] <dt>DBSQL_PREPARE_DONT_LOG</dt>
** <dd>The DBSQL_PREPARE_DONT_LOG flag prevents SQL compiler
** errors from being sent to the error log defined by
** [DBSQL_CONFIG_LOG].  This can be used, for example, to do test
** compiles to see if some SQL syntax is well-formed, without generating
** messages on the global error log when it is not.  If the test compile
** fails, the dbsql_prepare_v3() call returns the same error indications
** with or without this flag; it just omits the call to [dbsql_log()] that
** logs the error.
**
** [[DBSQL_PREPARE_FROM_DDL]] <dt>DBSQL_PREPARE_FROM_DDL</dt>
** <dd>The DBSQL_PREPARE_FROM_DDL flag causes the SQL compiler to enforce
** security constraints that would otherwise only be enforced when parsing
** the database schema.  In other words, the DBSQL_PREPARE_FROM_DDL flag
** causes the SQL compiler to treat the SQL statement being prepared as if
** it had come from an attacker.  When DBSQL_PREPARE_FROM_DDL is used and
** [DBSQL_DBCONFIG_TRUSTED_SCHEMA] is off, SQL functions may only be called
** if they are tagged with [DBSQL_INNOCUOUS] and virtual tables may only
** be used if they are tagged with [DBSQL_VTAB_INNOCUOUS].  Best practice
** is to use the DBSQL_PREPARE_FROM_DDL option when preparing any SQL that
** is derived from parts of the database schema. In particular, virtual
** table implementations that run SQL statements that are derived from
** arguments to their CREATE VIRTUAL TABLE statement should always use
** [dbsql_prepare_v3()] and set the DBSQL_PREPARE_FROM_DDL flag to
** prevent bypass of the [DBSQL_DBCONFIG_TRUSTED_SCHEMA] security checks.
** </dl>
*/
#define DBSQL_PREPARE_PERSISTENT              0x01
#define DBSQL_PREPARE_NORMALIZE               0x02
#define DBSQL_PREPARE_NO_VTAB                 0x04
#define DBSQL_PREPARE_DONT_LOG                0x10
#define DBSQL_PREPARE_FROM_DDL                0x20

/*
** CAPI3REF: Compiling An SQL Statement
** KEYWORDS: {SQL statement compiler}
** METHOD: DBSQL
** CONSTRUCTOR: dbsql_stmt_t
**
** To execute an SQL statement, it must first be compiled into a byte-code
** program using one of these routines.  Or, in other words, these routines
** are constructors for the [prepared statement] object.
**
** The preferred routine to use is [dbsql_prepare_v2()].  The
** [dbsql_prepare()] interface is legacy and should be avoided.
** [dbsql_prepare_v3()] has an extra
** [DBSQL_PREPARE_FROM_DDL|"prep_flags" option] that is sometimes
** needed for special purpose or to pass along security restrictions.
**
** The use of the UTF-8 interfaces is preferred, as dbsql currently
** does all parsing using UTF-8.  The UTF-16 interfaces are provided
** as a convenience.  The UTF-16 interfaces work by converting the
** input text into UTF-8, then invoking the corresponding UTF-8 interface.
**
** The first argument, "db", is a [database connection] obtained from a
** prior successful call to [dbsql_open()], [dbsql_open_v2()] or
** [dbsql_open16()].  The database connection must not have been closed.
**
** The second argument, "sql", is the statement to be compiled, encoded
** as either UTF-8 or UTF-16.  The dbsql_prepare(), dbsql_prepare_v2(),
** and dbsql_prepare_v3()
** interfaces use UTF-8, and dbsql_prepare16(), dbsql_prepare16_v2(),
** and dbsql_prepare16_v3() use UTF-16.
**
** ^If the n_byte argument is negative, then sql is read up to the
** first zero terminator. ^If n_byte is positive, then it is the maximum
** number of bytes read from sql.  When n_byte is positive, sql is read
** up to the first zero terminator or until the n_byte bytes have been read,
** whichever comes first.  ^If n_byte is zero, then no prepared
** statement is generated.
** If the caller knows that the supplied string is nul-terminated, then
** there is a small performance advantage to passing an n_byte parameter that
** is the number of bytes in the input string <i>including</i>
** the nul-terminator.
** Note that n_byte measures the length of the input in bytes, not
** characters, even for the UTF-16 interfaces.
**
** ^If tail is not NULL then *tail is made to point to the first byte
** past the end of the first SQL statement in sql.  These routines only
** compile the first statement in sql, so *tail is left pointing to
** what remains uncompiled.
**
** ^*stmt is left pointing to a compiled [prepared statement] that can be
** executed using [dbsql_step()].  ^If there is an error, *stmt is set
** to NULL.  ^If the input text contains no SQL (if the input is an empty
** string or a comment) then *stmt is set to NULL.
** The calling procedure is responsible for deleting the compiled
** SQL statement using [dbsql_finalize()] after it has finished with it.
** stmt may not be NULL.
**
** ^On success, the dbsql_prepare() family of routines return [DBSQL_OK];
** otherwise an [error code] is returned.
**
** The dbsql_prepare_v2(), dbsql_prepare_v3(), dbsql_prepare16_v2(),
** and dbsql_prepare16_v3() interfaces are recommended for all new programs.
** The older interfaces (dbsql_prepare() and dbsql_prepare16())
** are retained for backwards compatibility, but their use is discouraged.
** ^In the "v_x" interfaces, the prepared statement
** that is returned (the [dbsql_stmt_t] object) contains a copy of the
** original SQL text. This causes the [dbsql_step()] interface to
** behave differently in three ways:
**
** <ol>
** <li>
** ^If the database schema changes, instead of returning [DBSQL_SCHEMA] as it
** always used to do, [dbsql_step()] will automatically recompile the SQL
** statement and try to run it again. As many as [DBSQL_MAX_SCHEMA_RETRY]
** retries will occur before dbsql_step() gives up and returns an error.
** </li>
**
** <li>
** ^When an error occurs, [dbsql_step()] will return one of the detailed
** [error codes] or [extended error codes].  ^The legacy behavior was that
** [dbsql_step()] would only return a generic [DBSQL_ERROR] result code
** and the application would have to make a second call to [dbsql_reset()]
** in order to find the underlying cause of the problem. with_t the "v2" prepare
** interfaces, the underlying reason for the error is returned immediately.
** </li>
**
** <li>
** ^If the specific value bound to a [parameter | host parameter] in the
** WHERE clause might influence the choice of query plan for a statement,
** then the statement will be automatically recompiled, as if there had been
** a schema change, on the first [dbsql_step()] call following any change
** to the [dbsql_bind_text | bindings] of that [parameter].
** ^The specific value of a WHERE-clause [parameter] might influence the
** choice of query plan if the parameter is the left-hand side of a [LIKE]
** or [GLOB] operator or if the parameter is compared to an indexed column
** and the [DBSQL_ENABLE_STAT4] compile-time option is enabled.
** </li>
** </ol>
**
** <p>^dbsql_prepare_v3() differs from dbsql_prepare_v2() only in having
** the extra prep_flags parameter, which is a bit array consisting of zero or
** more of the [DBSQL_PREPARE_PERSISTENT|DBSQL_PREPARE_*] flags.  ^The
** dbsql_prepare_v2() interface works exactly the same as
** dbsql_prepare_v3() with a zero prep_flags parameter.
*/
int dbsql_prepare(
  DBSQL *db,            /* Database handle */
  const char *sql,       /* SQL statement, UTF-8 encoded */
  int n_byte,              /* Maximum length of sql in bytes. */
  dbsql_stmt_t **stmt,  /* OUT: Statement handle */
  const char **tail     /* OUT: Pointer to unused portion of sql */
);
int dbsql_prepare_v2(
  DBSQL *db,            /* Database handle */
  const char *sql,       /* SQL statement, UTF-8 encoded */
  int n_byte,              /* Maximum length of sql in bytes. */
  dbsql_stmt_t **stmt,  /* OUT: Statement handle */
  const char **tail     /* OUT: Pointer to unused portion of sql */
);
int dbsql_prepare_v3(
  DBSQL *db,            /* Database handle */
  const char *sql,       /* SQL statement, UTF-8 encoded */
  int n_byte,              /* Maximum length of sql in bytes. */
  unsigned int prep_flags, /* Zero or more DBSQL_PREPARE_ flags */
  dbsql_stmt_t **stmt,  /* OUT: Statement handle */
  const char **tail     /* OUT: Pointer to unused portion of sql */
);
int dbsql_prepare16(
  DBSQL *db,            /* Database handle */
  const void *sql,       /* SQL statement, UTF-16 encoded */
  int n_byte,              /* Maximum length of sql in bytes. */
  dbsql_stmt_t **stmt,  /* OUT: Statement handle */
  const void **tail     /* OUT: Pointer to unused portion of sql */
);
int dbsql_prepare16_v2(
  DBSQL *db,            /* Database handle */
  const void *sql,       /* SQL statement, UTF-16 encoded */
  int n_byte,              /* Maximum length of sql in bytes. */
  dbsql_stmt_t **stmt,  /* OUT: Statement handle */
  const void **tail     /* OUT: Pointer to unused portion of sql */
);
int dbsql_prepare16_v3(
  DBSQL *db,            /* Database handle */
  const void *sql,       /* SQL statement, UTF-16 encoded */
  int n_byte,              /* Maximum length of sql in bytes. */
  unsigned int prep_flags, /* Zero or more DBSQL_PREPARE_ flags */
  dbsql_stmt_t **stmt,  /* OUT: Statement handle */
  const void **tail     /* OUT: Pointer to unused portion of sql */
);

/*
** CAPI3REF: Retrieving Statement SQL
** METHOD: dbsql_stmt_t
**
** ^The dbsql_sql(P) interface returns a pointer to a copy of the UTF-8
** SQL text used to create [prepared statement] P if P was
** created by [dbsql_prepare_v2()], [dbsql_prepare_v3()],
** [dbsql_prepare16_v2()], or [dbsql_prepare16_v3()].
** ^The dbsql_expanded_sql(P) interface returns a pointer to a UTF-8
** string containing the SQL text of prepared statement P with
** [bound parameters] expanded.
** ^The dbsql_normalized_sql(P) interface returns a pointer to a UTF-8
** string containing the normalized SQL text of prepared statement P.  The
** semantics used to normalize a SQL statement are unspecified and subject
** to change.  At a minimum, literal values will be replaced with suitable
** placeholders.
**
** ^(For example, if a prepared statement is created using the SQL
** text "SELECT $abc,:xyz" and if parameter $abc is bound to integer 2345
** and parameter :xyz is unbound, then dbsql_sql() will return
** the original string, "SELECT $abc,:xyz" but dbsql_expanded_sql()
** will return "SELECT 2345,NULL".)^
**
** ^The dbsql_expanded_sql() interface returns NULL if insufficient memory
** is available to hold the result, or if the result would exceed the
** maximum string length determined by the [DBSQL_LIMIT_LENGTH].
**
** ^The [DBSQL_TRACE_SIZE_LIMIT] compile-time option limits the size of
** bound parameter expansions.  ^The [DBSQL_OMIT_TRACE] compile-time
** option causes dbsql_expanded_sql() to always return NULL.
**
** ^The strings returned by dbsql_sql(P) and dbsql_normalized_sql(P)
** are managed by dbsql and are automatically freed when the prepared
** statement is finalized.
** ^The string returned by dbsql_expanded_sql(P), on the other hand,
** is obtained from [dbsql_malloc()] and must be freed by the application
** by passing it to [dbsql_free()].
**
** ^The dbsql_normalized_sql() interface is only available if
** the [DBSQL_ENABLE_NORMALIZE] compile-time option is defined.
*/
const char *dbsql_sql(dbsql_stmt_t *stmt);
char *dbsql_expanded_sql(dbsql_stmt_t *stmt);
#ifdef DBSQL_ENABLE_NORMALIZE
const char *dbsql_normalized_sql(dbsql_stmt_t *stmt);
#endif

/*
** CAPI3REF: Determine If An SQL Statement Writes The Database
** METHOD: dbsql_stmt_t
**
** ^The dbsql_stmt_readonly(X) interface returns true (non-zero) if
** and only if the [prepared statement] X makes no direct changes to
** the content of the database file.
**
** Note that [application-defined SQL functions] or
** [virtual tables] might change the database indirectly as a side effect. 
** ^(For example, if an application defines a function "eval()" that
** calls [dbsql_exec()], then the following SQL statement would
** change the database file through side-effects:
**
** <blockquote><pre>
**    SELECT eval('DELETE FROM t1') FROM t2;
** </pre></blockquote>
**
** But because the [SELECT] statement does not change the database file
** directly, dbsql_stmt_readonly() would still return true.)^
**
** ^Transaction control statements such as [BEGIN], [COMMIT], [ROLLBACK],
** [SAVEPOINT], and [RELEASE] cause dbsql_stmt_readonly() to return true,
** since the statements themselves do not actually modify the database but
** rather they control the timing of when other statements modify the
** database.  ^The [ATTACH] and [DETACH] statements also cause
** dbsql_stmt_readonly() to return true since, while those statements
** change the configuration of a database connection, they do not make
** changes to the content of the database files on disk.
** ^The dbsql_stmt_readonly() interface returns true for [BEGIN] since
** [BEGIN] merely sets internal flags, but the [BEGIN|BEGIN IMMEDIATE] and
** [BEGIN|BEGIN EXCLUSIVE] commands do touch the database and so
** dbsql_stmt_readonly() returns false for those commands.
**
** ^This routine returns false if there is any possibility that the
** statement might change the database file.  ^A false return does
** not guarantee that the statement will change the database file.
** ^For example, an UPDATE statement might have a WHERE clause that
** makes it a no-op, but the dbsql_stmt_readonly() result would still
** be false.  ^Similarly, a CREATE TABLE IF NOT EXISTS statement is a
** read-only no-op if the table already exists, but
** dbsql_stmt_readonly() still returns false for such a statement.
**
** ^If prepared statement X is an [EXPLAIN] or [EXPLAIN QUERY PLAN]
** statement, then dbsql_stmt_readonly(X) returns the same value as
** if the EXPLAIN or EXPLAIN QUERY PLAN prefix were omitted.
*/
int dbsql_stmt_readonly(dbsql_stmt_t *stmt);

/*
** CAPI3REF: Query The EXPLAIN Setting For A Prepared Statement
** METHOD: dbsql_stmt_t
**
** ^The dbsql_stmt_isexplain(S) interface returns 1 if the
** prepared statement S is an EXPLAIN statement, or 2 if the
** statement S is an EXPLAIN QUERY PLAN.
** ^The dbsql_stmt_isexplain(S) interface returns 0 if S is
** an ordinary statement or a NULL pointer.
*/
int dbsql_stmt_isexplain(dbsql_stmt_t *stmt);

/*
** CAPI3REF: Change The EXPLAIN Setting For A Prepared Statement
** METHOD: dbsql_stmt_t
**
** The dbsql_stmt_explain(S,E) interface changes the EXPLAIN
** setting for [prepared statement] S.  If E is zero, then S becomes
** a normal prepared statement.  If E is 1, then S behaves as if
** its SQL text began with "[EXPLAIN]".  If E is 2, then S behaves as if
** its SQL text began with "[EXPLAIN QUERY PLAN]".
**
** Calling dbsql_stmt_explain(S,E) might cause S to be reprepared.
** dbsql tries to avoid a reprepare, but a reprepare might be necessary
** on the first transition into EXPLAIN or EXPLAIN QUERY PLAN mode.
**
** Because of the potential need to reprepare, a call to
** dbsql_stmt_explain(S,E) will fail with DBSQL_ERROR if S cannot be
** reprepared because it was created using [dbsql_prepare()] instead of
** the newer [dbsql_prepare_v2()] or [dbsql_prepare_v3()] interfaces and
** hence has no saved SQL text with which to reprepare.
**
** Changing the explain setting for a prepared statement does not change
** the original SQL text for the statement.  Hence, if the SQL text originally
** began with EXPLAIN or EXPLAIN QUERY PLAN, but dbsql_stmt_explain(S,0)
** is called to convert the statement into an ordinary statement, the EXPLAIN
** or EXPLAIN QUERY PLAN keywords will still appear in the dbsql_sql(S)
** output, even though the statement now acts like a normal SQL statement.
**
** This routine returns DBSQL_OK if the explain mode is successfully
** changed, or an error code if the explain mode could not be changed.
** The explain mode cannot be changed while a statement is active.
** Hence, it is good practice to call [dbsql_reset(S)]
** immediately prior to calling dbsql_stmt_explain(S,E).
*/
int dbsql_stmt_explain(dbsql_stmt_t *stmt, int mode);

/*
** CAPI3REF: Determine If A Prepared Statement Has Been Reset
** METHOD: dbsql_stmt_t
**
** ^The dbsql_stmt_busy(S) interface returns true (non-zero) if the
** [prepared statement] S has been stepped at least once using
** [dbsql_step(S)] but has neither run to completion (returned
** [DBSQL_DONE] from [dbsql_step(S)]) nor
** been reset using [dbsql_reset(S)].  ^The dbsql_stmt_busy(S)
** interface returns false if S is a NULL pointer.  If S is not a
** NULL pointer and is not a pointer to a valid [prepared statement]
** object, then the behavior is undefined and probably undesirable.
**
** This interface can be used in combination [dbsql_next_stmt()]
** to locate all prepared statements associated with a database
** connection that are in need of being reset.  This can be used,
** for example, in diagnostic routines to search for prepared
** statements that are holding a transaction open.
*/
int dbsql_stmt_busy(dbsql_stmt_t*);

/*
** CAPI3REF: Dynamically Typed Value Object
** KEYWORDS: {protected dbsql_value_t} {unprotected dbsql_value_t}
**
** dbsql uses the dbsql_value_t object to represent all values
** that can be stored in a database table. dbsql uses dynamic typing
** for the values it stores.  ^Values stored in dbsql_value_t objects
** can be integers, floating point values, strings, BLOBs, or NULL.
**
** An dbsql_value_t object may be either "protected" or "unprotected".
** Some interfaces require a protected dbsql_value_t.  Other interfaces
** will accept either a protected or an unprotected dbsql_value_t.
** Every interface that accepts dbsql_value_t arguments specifies
** whether or not it requires a protected dbsql_value_t.  The
** [dbsql_value_dup()] interface can be used to construct a new
** protected dbsql_value_t from an unprotected dbsql_value_t.
**
** The terms "protected" and "unprotected" refer to whether or not
** a mutex is held.  An internal mutex is held for a protected
** dbsql_value_t object but no mutex is held for an unprotected
** dbsql_value_t object.  If dbsql is compiled to be single-threaded
** (with [DBSQL_THREADSAFE=0] and with [dbsql_threadsafe()] returning 0)
** or if dbsql is run in one of reduced mutex modes
** [DBSQL_CONFIG_SINGLETHREAD] or [DBSQL_CONFIG_MULTITHREAD]
** then there is no distinction between protected and unprotected
** dbsql_value_t objects and they can be used interchangeably.  However,
** for maximum code portability it is recommended that applications
** still make the distinction between protected and unprotected
** dbsql_value_t objects even when not strictly required.
**
** ^The dbsql_value_t objects that are passed as parameters into the
** implementation of [application-defined SQL functions] are protected.
** ^The dbsql_value_t objects returned by [dbsql_vtab_rhs_value()]
** are protected.
** ^The dbsql_value_t object returned by
** [dbsql_column_value()] is unprotected.
** Unprotected dbsql_value_t objects may only be used as arguments
** to [dbsql_result_value()], [dbsql_bind_value()], and
** [dbsql_value_dup()].
** The [dbsql_value_blob | dbsql_value_type()] family of
** interfaces require protected dbsql_value_t objects.
*/
typedef struct dbsql_value_t dbsql_value_t;

/*
** CAPI3REF: SQL Function Context Object
**
** The context in which an SQL function executes is stored in an
** dbsql_func_t object.  ^A pointer to an dbsql_func_t object
** is always the first parameter to [application-defined SQL functions].
** The application-defined SQL function implementation will pass this
** pointer through into calls to [dbsql_result_int | dbsql_result()],
** [dbsql_aggregate_context()], [dbsql_user_data()],
** [dbsql_context_db_handle()], [dbsql_get_auxdata()],
** and/or [dbsql_set_auxdata()].
*/
typedef struct dbsql_func_t dbsql_func_t;

/*
** CAPI3REF: Binding Values To Prepared Statements
** KEYWORDS: {host parameter} {host parameters} {host parameter name}
** KEYWORDS: {SQL parameter} {SQL parameters} {parameter binding}
** METHOD: dbsql_stmt_t
**
** ^(In the SQL statement text input to [dbsql_prepare_v2()] and its variants,
** literals may be replaced by a [parameter] that matches one of the following
** templates:
**
** <ul>
** <li>  ?
** <li>  ?NNN
** <li>  :VVV
** <li>  @VVV
** <li>  $VVV
** </ul>
**
** In the templates above, NNN represents an integer literal,
** and VVV represents an alphanumeric identifier.)^  ^The values of these
** parameters (also called "host parameter names" or "SQL parameters")
** can be set using the dbsql_bind_*() routines defined here.
**
** ^The first argument to the dbsql_bind_*() routines is always
** a pointer to the [dbsql_stmt_t] object returned from
** [dbsql_prepare_v2()] or its variants.
**
** ^The second argument is the index of the SQL parameter to be set.
** ^The leftmost SQL parameter has an index of 1.  ^When the same named
** SQL parameter is used more than once, second and subsequent
** occurrences have the same index as the first occurrence.
** ^The index for named parameters can be looked up using the
** [dbsql_bind_parameter_index()] API if desired.  ^The index
** for "?NNN" parameters is the value of NNN.
** ^The NNN value must be between 1 and the [dbsql_limit()]
** parameter [DBSQL_LIMIT_VARIABLE_NUMBER] (default value: 32766).
**
** ^The third argument is the value to bind to the parameter.
** ^If the third parameter to dbsql_bind_text() or dbsql_bind_text16()
** or dbsql_bind_blob() is a NULL pointer then the fourth parameter
** is ignored and the end result is the same as dbsql_bind_null().
** ^If the third parameter to dbsql_bind_text() is not NULL, then
** it should be a pointer to well-formed UTF8 text.
** ^If the third parameter to dbsql_bind_text16() is not NULL, then
** it should be a pointer to well-formed UTF16 text.
** ^If the third parameter to dbsql_bind_text64() is not NULL, then
** it should be a pointer to a well-formed unicode string that is
** either UTF8 if the sixth parameter is DBSQL_UTF8 or DBSQL_UTF8_ZT,
** or UTF16 otherwise.
**
** [[byte-order determination rules]] ^The byte-order of
** UTF16 input text is determined by the byte-order mark (BOM, U+FEFF)
** found in the first character, which is removed, or in the absence of a BOM
** the byte order is the native byte order of the host
** machine for dbsql_bind_text16() or the byte order specified in
** the 6th parameter for dbsql_bind_text64().)^
** ^If UTF16 input text contains invalid unicode
** characters, then dbsql might change those invalid characters
** into the unicode replacement character: U+FFFD.
**
** ^(In those routines that have a fourth argument, its value is the
** number of bytes in the parameter.  To be clear: the value is the
** number of <u>bytes</u> in the value, not the number of characters.)^
** ^If the fourth parameter to dbsql_bind_text() or dbsql_bind_text16()
** is negative, then the length of the string is
** the number of bytes up to the first zero terminator.
** If the fourth parameter to dbsql_bind_blob() is negative, then
** the behavior is undefined.
** If a non-negative fourth parameter is provided to dbsql_bind_text()
** or dbsql_bind_text16() or dbsql_bind_text64() then
** that parameter must be the byte offset
** where the NUL terminator would occur assuming the string were NUL
** terminated.  If any NUL characters occur at byte offsets less than
** the value of the fourth parameter then the resulting string value will
** contain embedded NULs.  The result of expressions involving strings
** with embedded NULs is undefined.
**
** ^The fifth argument to the BLOB and string binding interfaces controls
** or indicates the lifetime of the object referenced by the third parameter.
** These three options exist:
** ^ (1) A destructor to dispose of the BLOB or string after dbsql has finished
** with it may be passed. ^It is called to dispose of the BLOB or string even
** if the call to the bind API fails, except the destructor is not called if
** the third parameter is a NULL pointer or the fourth parameter is negative.
** ^ (2) The special constant, [DBSQL_STATIC], may be passed to indicate that
** the application remains responsible for disposing of the object. ^In this
** case, the object and the provided pointer to it must remain valid until
** either the prepared statement is finalized or the same SQL parameter is
** bound to something else, whichever occurs sooner.
** ^ (3) The constant, [DBSQL_TRANSIENT], may be passed to indicate that the
** object is to be copied prior to the return from dbsql_bind_*(). ^The
** object and pointer to it must remain valid until then. ^dbsql will then
** manage the lifetime of its private copy.
**
** ^The sixth argument (the E argument)
** to dbsql_bind_text64(S,K,Z,N,D,E) must be one of
** [DBSQL_UTF8], [DBSQL_UTF8_ZT], [DBSQL_UTF16], [DBSQL_UTF16BE],
** or [DBSQL_UTF16LE] to specify the encoding of the text in the
** third parameter, Z.  The special value [DBSQL_UTF8_ZT] means that the
** string argument is both UTF-8 encoded and is zero-terminated.  In other
** words, DBSQL_UTF8_ZT means that the Z array is allocated to hold at
** least N+1 bytes and that the Z&#91;N&#93; byte is zero.  If
** the E argument to dbsql_bind_text64(S,K,Z,N,D,E) is not one of the
** allowed values shown above, or if the text encoding is different
** from the encoding specified by the sixth parameter, then the behavior
** is undefined.
**
** ^The dbsql_bind_zeroblob() routine binds a BLOB of length N that
** is filled with zeroes.  ^A zeroblob uses a fixed amount of memory
** (just an integer to hold its size) while it is being processed.
** Zeroblobs are intended to serve as placeholders for BLOBs whose
** content is later written using
** [dbsql_blob_open | incremental BLOB I/O] routines.
** ^A negative value for the zeroblob results in a zero-length BLOB.
**
** ^The dbsql_bind_pointer(S,I,P,T,D) routine causes the I-th parameter in
** [prepared statement] S to have an SQL value of NULL, but to also be
** associated with the pointer P of type T.  ^D is either a NULL pointer or
** a pointer to a destructor function for P. ^dbsql will invoke the
** destructor D with a single argument of P when it is finished using
** P, even if the call to dbsql_bind_pointer() fails.  Due to a
** historical design quirk, results are undefined if D is
** DBSQL_TRANSIENT. The T parameter should be a static string,
** preferably a string literal. The dbsql_bind_pointer() routine is
** part of the [pointer passing interface] added for dbsql 3.20.0.
**
** ^If any of the dbsql_bind_*() routines are called with a NULL pointer
** for the [prepared statement] or with a prepared statement for which
** [dbsql_step()] has been called more recently than [dbsql_reset()],
** then the call will return [DBSQL_MISUSE].  If any dbsql_bind_()
** routine is passed a [prepared statement] that has been finalized, the
** result is undefined and probably harmful.
**
** ^Bindings are not cleared by the [dbsql_reset()] routine.
** ^Unbound parameters are interpreted as NULL.
**
** ^The dbsql_bind_* routines return [DBSQL_OK] on success or an
** [error code] if anything goes wrong.
** ^[DBSQL_TOOBIG] might be returned if the size of a string or BLOB
** exceeds limits imposed by [dbsql_limit]([DBSQL_LIMIT_LENGTH]) or
** [DBSQL_MAX_LENGTH].
** ^[DBSQL_RANGE] is returned if the parameter
** index is out of range.  ^[DBSQL_NOMEM] is returned if malloc() fails.
**
** See also: [dbsql_bind_parameter_count()],
** [dbsql_bind_parameter_name()], and [dbsql_bind_parameter_index()].
*/
int dbsql_bind_blob(dbsql_stmt_t*, int, const void*, int n, void(*)(void*));
int dbsql_bind_blob64(dbsql_stmt_t*, int, const void*, u_int64_t,
                        void(*)(void*));
int dbsql_bind_double(dbsql_stmt_t*, int, double);
int dbsql_bind_int(dbsql_stmt_t*, int, int);
int dbsql_bind_int64(dbsql_stmt_t*, int, int64_t);
int dbsql_bind_null(dbsql_stmt_t*, int);
int dbsql_bind_text(dbsql_stmt_t*,int,const char*,int,void(*)(void*));
int dbsql_bind_text16(dbsql_stmt_t*, int, const void*, int, void(*)(void*));
int dbsql_bind_text64(dbsql_stmt_t*, int, const char*, u_int64_t,
                         void(*)(void*), unsigned char encoding);
int dbsql_bind_value(dbsql_stmt_t*, int, const dbsql_value_t*);
int dbsql_bind_pointer(dbsql_stmt_t*, int, void*, const char*,void(*)(void*));
int dbsql_bind_zeroblob(dbsql_stmt_t*, int, int n);
int dbsql_bind_zeroblob64(dbsql_stmt_t*, int, u_int64_t);

/*
** CAPI3REF: Number Of SQL Parameters
** METHOD: dbsql_stmt_t
**
** ^This routine can be used to find the number of [SQL parameters]
** in a [prepared statement].  SQL parameters are tokens of the
** form "?", "?NNN", ":AAA", "$AAA", or "@AAA" that serve as
** placeholders for values that are [dbsql_bind_blob | bound]
** to the parameters at a later time.
**
** ^(This routine actually returns the index of the largest (rightmost)
** parameter. For all forms except ?NNN, this will correspond to the
** number of unique parameters.  If parameters of the ?NNN form are used,
** there may be gaps in the list.)^
**
** See also: [dbsql_bind_blob|dbsql_bind()],
** [dbsql_bind_parameter_name()], and
** [dbsql_bind_parameter_index()].
*/
int dbsql_bind_parameter_count(dbsql_stmt_t*);

/*
** CAPI3REF: Name Of A Host Parameter
** METHOD: dbsql_stmt_t
**
** ^The dbsql_bind_parameter_name(P,N) interface returns
** the name of the N-th [SQL parameter] in the [prepared statement] P.
** ^(SQL parameters of the form "?NNN" or ":AAA" or "@AAA" or "$AAA"
** have a name which is the string "?NNN" or ":AAA" or "@AAA" or "$AAA"
** respectively.
** In other words, the initial ":" or "$" or "@" or "?"
** is included as part of the name.)^
** ^Parameters of the form "?" without a following integer have no name
** and are referred to as "nameless" or "anonymous parameters".
**
** ^The first host parameter has an index of 1, not 0.
**
** ^If the value N is out of range or if the N-th parameter is
** nameless, then NULL is returned.  ^The returned string is
** always in UTF-8 encoding even if the named parameter was
** originally specified as UTF-16 in [dbsql_prepare16()],
** [dbsql_prepare16_v2()], or [dbsql_prepare16_v3()].
**
** See also: [dbsql_bind_blob|dbsql_bind()],
** [dbsql_bind_parameter_count()], and
** [dbsql_bind_parameter_index()].
*/
const char *dbsql_bind_parameter_name(dbsql_stmt_t*, int);

/*
** CAPI3REF: index_t Of A Parameter with_t A Given Name
** METHOD: dbsql_stmt_t
**
** ^Return the index of an SQL parameter given its name.  ^The
** index value returned is suitable for use as the second
** parameter to [dbsql_bind_blob|dbsql_bind()].  ^A zero
** is returned if no matching parameter is found.  ^The parameter
** name must be given in UTF-8 even if the original statement
** was prepared from UTF-16 text using [dbsql_prepare16_v2()] or
** [dbsql_prepare16_v3()].
**
** See also: [dbsql_bind_blob|dbsql_bind()],
** [dbsql_bind_parameter_count()], and
** [dbsql_bind_parameter_name()].
*/
int dbsql_bind_parameter_index(dbsql_stmt_t*, const char *name);

/*
** CAPI3REF: Reset All Bindings On A Prepared Statement
** METHOD: dbsql_stmt_t
**
** ^Contrary to the intuition of many, [dbsql_reset()] does not reset
** the [dbsql_bind_blob | bindings] on a [prepared statement].
** ^Use this routine to reset all host parameters to NULL.
*/
int dbsql_clear_bindings(dbsql_stmt_t*);

/*
** CAPI3REF: Number Of Columns In A Result Set
** METHOD: dbsql_stmt_t
**
** ^Return the number of columns in the result set returned by the
** [prepared statement]. ^If this routine returns 0, that means the
** [prepared statement] returns no data (for example an [UPDATE]).
** ^However, just because this routine returns a positive number does not
** mean that one or more rows of data will be returned.  ^A SELECT statement
** will always have a positive dbsql_column_count() but depending on the
** WHERE clause constraints and the table content, it might return no rows.
**
** See also: [dbsql_data_count()]
*/
int dbsql_column_count(dbsql_stmt_t *stmt);

/*
** CAPI3REF: column_t Names In A Result Set
** METHOD: dbsql_stmt_t
**
** ^These routines return the name assigned to a particular column
** in the result set of a [SELECT] statement.  ^The dbsql_column_name()
** interface returns a pointer to a zero-terminated UTF-8 string
** and dbsql_column_name16() returns a pointer to a zero-terminated
** UTF-16 string.  ^The first parameter is the [prepared statement]
** that implements the [SELECT] statement. ^The second parameter is the
** column number.  ^The leftmost column is number 0.
**
** ^The returned string pointer is valid until either the [prepared statement]
** is destroyed by [dbsql_finalize()] or until the statement is automatically
** reprepared by the first call to [dbsql_step()] for a particular run
** or until the next call to
** dbsql_column_name() or dbsql_column_name16() on the same column.
**
** ^If dbsql_malloc() fails during the processing of either routine
** (for example during a conversion from UTF-8 to UTF-16) then a
** NULL pointer is returned.
**
** ^The name of a result column is the value of the "AS" clause for
** that column, if there is an AS clause.  If there is no AS clause
** then the name of the column is unspecified and may change from
** one release of dbsql to the next.
*/
const char *dbsql_column_name(dbsql_stmt_t*, int N);
const void *dbsql_column_name16(dbsql_stmt_t*, int N);

/*
** CAPI3REF: Source Of Data In A Query Result
** METHOD: dbsql_stmt_t
**
** ^These routines provide a means to determine the database, table, and
** table column that is the origin of a particular result column in a
** [SELECT] statement.
** ^The name of the database or table or column can be returned as
** either a UTF-8 or UTF-16 string.  ^The _database_ routines return
** the database name, the _table_ routines return the table name, and
** the origin_ routines return the column name.
** ^The returned string is valid until the [prepared statement] is destroyed
** using [dbsql_finalize()] or until the statement is automatically
** reprepared by the first call to [dbsql_step()] for a particular run
** or until the same information is requested
** again in a different encoding.
**
** ^The names returned are the original un-aliased names of the
** database, table, and column.
**
** ^The first argument to these interfaces is a [prepared statement].
** ^These functions return information about the Nth result column returned by
** the statement, where N is the second function argument.
** ^The left-most column is column 0 for these routines.
**
** ^If the Nth column returned by the statement is an expression or
** subquery and is not a column value, then all of these functions return
** NULL.  ^These routines might also return NULL if a memory allocation error
** occurs.  ^Otherwise, they return the name of the attached database, table,
** or column that query result column was extracted from.
**
** ^As with all other dbsql APIs, those whose names end with "16" return
** UTF-16 encoded strings and the other functions return UTF-8.
**
** ^These APIs are only available if the library was compiled with the
** [DBSQL_ENABLE_COLUMN_METADATA] C-preprocessor symbol.
**
** If two or more threads call one or more
** [dbsql_column_database_name | column metadata interfaces]
** for the same [prepared statement] and result column
** at the same time then the results are undefined.
*/
const char *dbsql_column_database_name(dbsql_stmt_t*,int);
const void *dbsql_column_database_name16(dbsql_stmt_t*,int);
const char *dbsql_column_table_name(dbsql_stmt_t*,int);
const void *dbsql_column_table_name16(dbsql_stmt_t*,int);
const char *dbsql_column_origin_name(dbsql_stmt_t*,int);
const void *dbsql_column_origin_name16(dbsql_stmt_t*,int);

/*
** CAPI3REF: Declared Datatype Of A Query Result
** METHOD: dbsql_stmt_t
**
** ^(The first parameter is a [prepared statement].
** If this statement is a [SELECT] statement and the Nth column of the
** returned result set of that [SELECT] is a table column (not an
** expression or subquery) then the declared type of the table
** column is returned.)^  ^If the Nth column of the result set is an
** expression or subquery, then a NULL pointer is returned.
** ^The returned string is always UTF-8 encoded.
**
** ^(For example, given the database schema:
**
** CREATE TABLE t1(c1 VARIANT);
**
** and the following statement to be compiled:
**
** SELECT c1 + 1, c1 FROM t1;
**
** this routine would return the string "VARIANT" for the second result
** column (i==1), and a NULL pointer for the first result column (i==0).)^
**
** ^dbsql uses dynamic run-time typing.  ^So just because a column
** is declared to contain a particular type does not mean that the
** data stored in that column is of the declared type.  dbsql is
** strongly typed, but the typing is dynamic not static.  ^Type
** is associated with individual values, not with the containers
** used to hold those values.
*/
const char *dbsql_column_decltype(dbsql_stmt_t*,int);
const void *dbsql_column_decltype16(dbsql_stmt_t*,int);

/*
** CAPI3REF: Evaluate An SQL Statement
** METHOD: dbsql_stmt_t
**
** After a [prepared statement] has been prepared using any of
** [dbsql_prepare_v2()], [dbsql_prepare_v3()], [dbsql_prepare16_v2()],
** or [dbsql_prepare16_v3()] or one of the legacy
** interfaces [dbsql_prepare()] or [dbsql_prepare16()], this function
** must be called one or more times to evaluate the statement.
**
** The details of the behavior of the dbsql_step() interface depend
** on whether the statement was prepared using the newer "v_x" interfaces
** [dbsql_prepare_v3()], [dbsql_prepare_v2()], [dbsql_prepare16_v3()],
** [dbsql_prepare16_v2()] or the older legacy
** interfaces [dbsql_prepare()] and [dbsql_prepare16()].  The use of the
** new "v_x" interface is recommended for new applications but the legacy
** interface will continue to be supported.
**
** ^In the legacy interface, the return value will be either [DBSQL_BUSY],
** [DBSQL_DONE], [DBSQL_ROW], [DBSQL_ERROR], or [DBSQL_MISUSE].
** ^with_t the "v2" interface, any of the other [result codes] or
** [extended result codes] might be returned as well.
**
** ^[DBSQL_BUSY] means that the database engine was unable to acquire the
** database locks it needs to do its job.  ^If the statement is a [COMMIT]
** or occurs outside of an explicit transaction, then you can retry the
** statement.  If the statement is not a [COMMIT] and occurs within an
** explicit transaction then you should rollback the transaction before
** continuing.
**
** ^[DBSQL_DONE] means that the statement has finished executing
** successfully.  dbsql_step() should not be called again on this virtual
** machine without first calling [dbsql_reset()] to reset the virtual
** machine back to its initial state.
**
** ^If the SQL statement being executed returns any data, then [DBSQL_ROW]
** is returned each time a new row of data is ready for processing by the
** caller. The values may be accessed using the [column access functions].
** dbsql_step() is called again to retrieve the next row of data.
**
** ^[DBSQL_ERROR] means that a run-time error (such as a constraint
** violation) has occurred.  dbsql_step() should not be called again on
** the VM. More information may be found by calling [dbsql_errmsg()].
** ^with_t the legacy interface, a more specific error code (for example,
** [DBSQL_INTERRUPT], [DBSQL_SCHEMA], [DBSQL_CORRUPT], and so forth)
** can be obtained by calling [dbsql_reset()] on the
** [prepared statement].  ^In the "v2" interface,
** the more specific error code is returned directly by dbsql_step().
**
** [DBSQL_MISUSE] means that the this routine was called inappropriately.
** Perhaps it was called on a [prepared statement] that has
** already been [dbsql_finalize | finalized] or on one that had
** previously returned [DBSQL_ERROR] or [DBSQL_DONE].  Or it could
** be the case that the same database connection is being used by two or
** more threads at the same moment in time.
**
** For all versions of dbsql up to and including 3.6.23.1, a call to
** [dbsql_reset()] was required after dbsql_step() returned anything
** other than [DBSQL_ROW] before any subsequent invocation of
** dbsql_step().  Failure to reset the prepared statement using
** [dbsql_reset()] would result in an [DBSQL_MISUSE] return from
** dbsql_step().  But after [version 3.6.23.1] ([dateof:3.6.23.1]),
** dbsql_step() began
** calling [dbsql_reset()] automatically in this circumstance rather
** than returning [DBSQL_MISUSE].  This is not considered a compatibility
** break because any application that ever receives an DBSQL_MISUSE error
** is broken by definition.  The [DBSQL_OMIT_AUTORESET] compile-time option
** can be used to restore the legacy behavior.
**
** <b>Goofy Interface Alert:</b> In the legacy interface, the dbsql_step()
** API always returns a generic error code, [DBSQL_ERROR], following any
** error other than [DBSQL_BUSY] and [DBSQL_MISUSE].  You must call
** [dbsql_reset()] or [dbsql_finalize()] in order to find one of the
** specific [error codes] that better describes the error.
** We admit that this is a goofy design.  The problem has been fixed
** with the "v2" interface.  If you prepare all of your SQL statements
** using [dbsql_prepare_v3()] or [dbsql_prepare_v2()]
** or [dbsql_prepare16_v2()] or [dbsql_prepare16_v3()] instead
** of the legacy [dbsql_prepare()] and [dbsql_prepare16()] interfaces,
** then the more specific [error codes] are returned directly
** by dbsql_step().  The use of the "v_x" interfaces is recommended.
*/
int dbsql_step(dbsql_stmt_t*);

/*
** CAPI3REF: Number of columns in a result set
** METHOD: dbsql_stmt_t
**
** ^The dbsql_data_count(P) interface returns the number of columns in the
** current row of the result set of [prepared statement] P.
** ^If prepared statement P does not have results ready to return
** (via calls to the [dbsql_column_int | dbsql_column()] family of
** interfaces) then dbsql_data_count(P) returns 0.
** ^The dbsql_data_count(P) routine also returns 0 if P is a NULL pointer.
** ^The dbsql_data_count(P) routine returns 0 if the previous call to
** [dbsql_step](P) returned [DBSQL_DONE].  ^The dbsql_data_count(P)
** will return non-zero if previous call to [dbsql_step](P) returned
** [DBSQL_ROW], except in the case of the [PRAGMA incremental_vacuum]
** where it always returns zero since each step of that multi-step
** pragma returns 0 columns of data.
**
** See also: [dbsql_column_count()]
*/
int dbsql_data_count(dbsql_stmt_t *stmt);

/*
** CAPI3REF: Fundamental Datatypes
** KEYWORDS: DBSQL_TEXT
**
** ^(Every value in dbsql has one of five fundamental datatypes:
**
** <ul>
** <li> 64-bit signed integer
** <li> 64-bit IEEE floating point number
** <li> string
** <li> BLOB
** <li> NULL
** </ul>)^
**
** These constants are codes for each of those types.
**
** Note that the DBSQL_TEXT constant was also used in dbsql version 2
** for a completely different meaning.  Software that links against both
** dbsql version 2 and dbsql version 3 should use DBSQL_TEXT, not
** DBSQL_TEXT.
*/
#define DBSQL_INTEGER  1
#define DBSQL_FLOAT    2
#define DBSQL_BLOB     4
#define DBSQL_NULL     5
#ifdef DBSQL_TEXT
# undef DBSQL_TEXT
#else
# define DBSQL_TEXT     3
#endif
#define DBSQL_TEXT     3

/*
** CAPI3REF: Result Values From A Query
** KEYWORDS: {column access functions}
** METHOD: dbsql_stmt_t
**
** <b>Summary:</b>
** <blockquote><table border=0 cellpadding=0 cellspacing=0>
** <tr><td><b>dbsql_column_blob</b><td>&rarr;<td>BLOB result
** <tr><td><b>dbsql_column_double</b><td>&rarr;<td>REAL result
** <tr><td><b>dbsql_column_int</b><td>&rarr;<td>32-bit INTEGER result
** <tr><td><b>dbsql_column_int64</b><td>&rarr;<td>64-bit INTEGER result
** <tr><td><b>dbsql_column_text</b><td>&rarr;<td>UTF-8 TEXT result
** <tr><td><b>dbsql_column_text16</b><td>&rarr;<td>UTF-16 TEXT result
** <tr><td><b>dbsql_column_value</b><td>&rarr;<td>The result as an
** [dbsql_value_t|unprotected dbsql_value_t] object.
** <tr><td>&nbsp;<td>&nbsp;<td>&nbsp;
** <tr><td><b>dbsql_column_bytes</b><td>&rarr;<td>Size of a BLOB
** or a UTF-8 TEXT result in bytes
** <tr><td><b>dbsql_column_bytes16&nbsp;&nbsp;</b>
** <td>&rarr;&nbsp;&nbsp;<td>Size of UTF-16
** TEXT in bytes
** <tr><td><b>dbsql_column_type</b><td>&rarr;<td>Default
** datatype of the result
** </table></blockquote>
**
** <b>Details:</b>
**
** ^These routines return information about a single column of the current
** result row of a query.  ^In every case the first argument is a pointer
** to the [prepared statement] that is being evaluated (the [dbsql_stmt_t*]
** that was returned from [dbsql_prepare_v2()] or one of its variants)
** and the second argument is the index of the column for which information
** should be returned. ^The leftmost column of the result set has the index 0.
** ^The number of columns in the result can be determined using
** [dbsql_column_count()].
**
** If the SQL statement does not currently point to a valid row, or if the
** column index is out of range, the result is undefined.
** These routines may only be called when the most recent call to
** [dbsql_step()] has returned [DBSQL_ROW] and neither
** [dbsql_reset()] nor [dbsql_finalize()] have been called subsequently.
** If any of these routines are called after [dbsql_reset()] or
** [dbsql_finalize()] or after [dbsql_step()] has returned
** something other than [DBSQL_ROW], the results are undefined.
** If [dbsql_step()] or [dbsql_reset()] or [dbsql_finalize()]
** are called from a different thread while any of these routines
** are pending, then the results are undefined.
**
** The first six interfaces (_blob, _double, _int, _int64, _text, and _text16)
** each return the value of a result column in a specific data format.  If
** the result column is not initially in the requested format (for example,
** if the query returns an integer but the dbsql_column_text() interface
** is used to extract the value) then an automatic type conversion is performed.
**
** ^The dbsql_column_type() routine returns the
** [DBSQL_INTEGER | datatype code] for the initial data type
** of the result column.  ^The returned value is one of [DBSQL_INTEGER],
** [DBSQL_FLOAT], [DBSQL_TEXT], [DBSQL_BLOB], or [DBSQL_NULL].
** The return value of dbsql_column_type() can be used to decide which
** of the first six interface should be used to extract the column value.
** The value returned by dbsql_column_type() is only meaningful if no
** automatic type conversions have occurred for the value in question. 
** After a type conversion, the result of calling dbsql_column_type()
** is undefined, though harmless.  Future
** versions of dbsql may change the behavior of dbsql_column_type()
** following a type conversion.
**
** If the result is a BLOB or a TEXT string, then the dbsql_column_bytes()
** or dbsql_column_bytes16() interfaces can be used to determine the size
** of that BLOB or string.
**
** ^If the result is a BLOB or UTF-8 string then the dbsql_column_bytes()
** routine returns the number of bytes in that BLOB or string.
** ^If the result is a UTF-16 string, then dbsql_column_bytes() converts
** the string to UTF-8 and then returns the number of bytes.
** ^If the result is a numeric value then dbsql_column_bytes() uses
** [dbsql_snprintf()] to convert that value to a UTF-8 string and returns
** the number of bytes in that string.
** ^If the result is NULL, then dbsql_column_bytes() returns zero.
**
** ^If the result is a BLOB or UTF-16 string then the dbsql_column_bytes16()
** routine returns the number of bytes in that BLOB or string.
** ^If the result is a UTF-8 string, then dbsql_column_bytes16() converts
** the string to UTF-16 and then returns the number of bytes.
** ^If the result is a numeric value then dbsql_column_bytes16() uses
** [dbsql_snprintf()] to convert that value to a UTF-16 string and returns
** the number of bytes in that string.
** ^If the result is NULL, then dbsql_column_bytes16() returns zero.
**
** ^The values returned by [dbsql_column_bytes()] and
** [dbsql_column_bytes16()] do not include the zero terminators at the end
** of the string.  ^For clarity: the values returned by
** [dbsql_column_bytes()] and [dbsql_column_bytes16()] are the number of
** bytes in the string, not the number of characters.
**
** ^Strings returned by dbsql_column_text() and dbsql_column_text16(),
** even empty strings, are always zero-terminated.  ^The return
** value from dbsql_column_blob() for a zero-length BLOB is a NULL pointer.
**
** ^Strings returned by dbsql_column_text16() always have the endianness
** which is native to the platform, regardless of the text encoding set
** for the database.
**
** <b>Warning:</b> ^The object returned by [dbsql_column_value()] is an
** [unprotected dbsql_value_t] object.  In a multithreaded environment,
** an unprotected dbsql_value_t object may only be used safely with
** [dbsql_bind_value()] and [dbsql_result_value()].
** If the [unprotected dbsql_value_t] object returned by
** [dbsql_column_value()] is used in any other way, including calls
** to routines like [dbsql_value_int()], [dbsql_value_text()],
** or [dbsql_value_bytes()], the behavior is not threadsafe.
** Hence, the dbsql_column_value() interface
** is normally only useful within the implementation of
** [application-defined SQL functions] or [virtual tables], not within
** top-level application code.
**
** These routines may attempt to convert the datatype of the result.
** ^For example, if the internal representation is FLOAT and a text result
** is requested, [dbsql_snprintf()] is used internally to perform the
** conversion automatically.  ^(The following table details the conversions
** that are applied:
**
** <blockquote>
** <table border="1">
** <tr><th> Internal<br>Type <th> Requested<br>Type <th>  Conversion
**
** <tr><td>  NULL    <td> INTEGER   <td> Result is 0
** <tr><td>  NULL    <td>  FLOAT    <td> Result is 0.0
** <tr><td>  NULL    <td>   TEXT    <td> Result is a NULL pointer
** <tr><td>  NULL    <td>   BLOB    <td> Result is a NULL pointer
** <tr><td> INTEGER  <td>  FLOAT    <td> Convert from integer to float
** <tr><td> INTEGER  <td>   TEXT    <td> ASCII rendering of the integer
** <tr><td> INTEGER  <td>   BLOB    <td> Same as INTEGER->TEXT
** <tr><td>  FLOAT   <td> INTEGER   <td> [CAST] to INTEGER
** <tr><td>  FLOAT   <td>   TEXT    <td> ASCII rendering of the float
** <tr><td>  FLOAT   <td>   BLOB    <td> [CAST] to BLOB
** <tr><td>  TEXT    <td> INTEGER   <td> [CAST] to INTEGER
** <tr><td>  TEXT    <td>  FLOAT    <td> [CAST] to REAL
** <tr><td>  TEXT    <td>   BLOB    <td> No change
** <tr><td>  BLOB    <td> INTEGER   <td> [CAST] to INTEGER
** <tr><td>  BLOB    <td>  FLOAT    <td> [CAST] to REAL
** <tr><td>  BLOB    <td>   TEXT    <td> [CAST] to TEXT, ensure zero terminator
** </table>
** </blockquote>)^
**
** Note that when type conversions occur, pointers returned by prior
** calls to dbsql_column_blob(), dbsql_column_text(), and/or
** dbsql_column_text16() may be invalidated.
** Type conversions and pointer invalidations might occur
** in the following cases:
**
** <ul>
** <li> The initial content is a BLOB and dbsql_column_text() or
**      dbsql_column_text16() is called.  A zero-terminator might
**      need to be added to the string.</li>
** <li> The initial content is UTF-8 text and dbsql_column_bytes16() or
**      dbsql_column_text16() is called.  The content must be converted
**      to UTF-16.</li>
** <li> The initial content is UTF-16 text and dbsql_column_bytes() or
**      dbsql_column_text() is called.  The content must be converted
**      to UTF-8.</li>
** </ul>
**
** ^Conversions between UTF-16be and UTF-16le are always done in place and do
** not invalidate a prior pointer, though of course the content of the buffer
** that the prior pointer references will have been modified.  Other kinds
** of conversion are done in place when it is possible, but sometimes they
** are not possible and in those cases prior pointers are invalidated.
**
** The safest policy is to invoke these routines
** in one of the following ways:
**
** <ul>
**  <li>dbsql_column_text() followed by dbsql_column_bytes()</li>
**  <li>dbsql_column_blob() followed by dbsql_column_bytes()</li>
**  <li>dbsql_column_text16() followed by dbsql_column_bytes16()</li>
** </ul>
**
** In other words, you should call dbsql_column_text(),
** dbsql_column_blob(), or dbsql_column_text16() first to force the result
** into the desired format, then invoke dbsql_column_bytes() or
** dbsql_column_bytes16() to find the size of the result.  Do not mix calls
** to dbsql_column_text() or dbsql_column_blob() with calls to
** dbsql_column_bytes16(), and do not mix calls to dbsql_column_text16()
** with calls to dbsql_column_bytes().
**
** ^The pointers returned are valid until a type conversion occurs as
** described above, or until [dbsql_step()] or [dbsql_reset()] or
** [dbsql_finalize()] is called.  ^The memory space used to hold strings
** and BLOBs is freed automatically.  Do not pass the pointers returned
** from [dbsql_column_blob()], [dbsql_column_text()], etc. into
** [dbsql_free()].
**
** As long as the input parameters are correct, these routines will only
** fail if an out-of-memory error occurs during a format conversion.
** Only the following subset of interfaces are subject to out-of-memory
** errors:
**
** <ul>
** <li> dbsql_column_blob()
** <li> dbsql_column_text()
** <li> dbsql_column_text16()
** <li> dbsql_column_bytes()
** <li> dbsql_column_bytes16()
** </ul>
**
** If an out-of-memory error occurs, then the return value from these
** routines is the same as if the column had contained an SQL NULL value.
** Valid SQL NULL returns can be distinguished from out-of-memory errors
** by invoking the [dbsql_errcode()] immediately after the suspect
** return value is obtained and before any
** other dbsql interface is called on the same [database connection].
*/
const void *dbsql_column_blob(dbsql_stmt_t*, int i_col);
double dbsql_column_double(dbsql_stmt_t*, int i_col);
int dbsql_column_int(dbsql_stmt_t*, int i_col);
int64_t dbsql_column_int64(dbsql_stmt_t*, int i_col);
const unsigned char *dbsql_column_text(dbsql_stmt_t*, int i_col);
const void *dbsql_column_text16(dbsql_stmt_t*, int i_col);
dbsql_value_t *dbsql_column_value(dbsql_stmt_t*, int i_col);
int dbsql_column_bytes(dbsql_stmt_t*, int i_col);
int dbsql_column_bytes16(dbsql_stmt_t*, int i_col);
int dbsql_column_type(dbsql_stmt_t*, int i_col);

/*
** CAPI3REF: Destroy A Prepared Statement Object
** DESTRUCTOR: dbsql_stmt_t
**
** ^The dbsql_finalize() function is called to delete a [prepared statement].
** ^If the most recent evaluation of the statement encountered no errors
** or if the statement has never been evaluated, then dbsql_finalize() returns
** DBSQL_OK.  ^If the most recent evaluation of statement S failed, then
** dbsql_finalize(S) returns the appropriate [error code] or
** [extended error code].
**
** ^The dbsql_finalize(S) routine can be called at any point during
** the life cycle of [prepared statement] S:
** before statement S is ever evaluated, after
** one or more calls to [dbsql_reset()], or after any call
** to [dbsql_step()] regardless of whether or not the statement has
** completed execution.
**
** ^Invoking dbsql_finalize() on a NULL pointer is a harmless no-op.
**
** The application must finalize every [prepared statement] in order to avoid
** resource leaks.  It is a grievous error for the application to try to use
** a prepared statement after it has been finalized.  Any use of a prepared
** statement after it has been finalized can result in undefined and
** undesirable behavior such as segfaults and heap corruption.
*/
int dbsql_finalize(dbsql_stmt_t *stmt);

/*
** CAPI3REF: Reset A Prepared Statement Object
** METHOD: dbsql_stmt_t
**
** The dbsql_reset() function is called to reset a [prepared statement]
** object back to its initial state, ready to be re-executed.
** ^Any SQL statement variables that had values bound to them using
** the [dbsql_bind_blob | dbsql_bind_*() API] retain their values.
** Use [dbsql_clear_bindings()] to reset the bindings.
**
** ^The [dbsql_reset(S)] interface resets the [prepared statement] S
** back to the beginning of its program.
**
** ^The return code from [dbsql_reset(S)] indicates whether or not
** the previous evaluation of prepared statement S completed successfully.
** ^If [dbsql_step(S)] has never before been called on S or if
** [dbsql_step(S)] has not been called since the previous call
** to [dbsql_reset(S)], then [dbsql_reset(S)] will return
** [DBSQL_OK].
**
** ^If the most recent call to [dbsql_step(S)] for the
** [prepared statement] S indicated an error, then
** [dbsql_reset(S)] returns an appropriate [error code].
** ^The [dbsql_reset(S)] interface might also return an [error code]
** if there were no prior errors but the process of resetting
** the prepared statement caused a new error. ^For example, if an
** [INSERT] statement with a [RETURNING] clause is only stepped one time,
** that one call to [dbsql_step(S)] might return DBSQL_ROW but
** the overall statement might still fail and the [dbsql_reset(S)] call
** might return DBSQL_BUSY if locking constraints prevent the
** database change from committing.  Therefore, it is important that
** applications check the return code from [dbsql_reset(S)] even if
** no prior call to [dbsql_step(S)] indicated a problem.
**
** ^The [dbsql_reset(S)] interface does not change the values
** of any [dbsql_bind_blob|bindings] on the [prepared statement] S.
*/
int dbsql_reset(dbsql_stmt_t *stmt);


/*
** CAPI3REF: Create Or Redefine SQL Functions
** KEYWORDS: {function creation routines}
** METHOD: DBSQL
**
** ^These functions (collectively known as "function creation routines")
** are used to add SQL functions or aggregates or to redefine the behavior
** of existing SQL functions or aggregates. The only differences between
** the three "dbsql_create_function*" routines are the text encoding
** expected for the second parameter (the name of the function being
** created) and the presence or absence of a destructor callback for
** the application data pointer. Function dbsql_create_window_function()
** is similar, but allows the user to supply the extra callback functions
** needed by [aggregate window functions].
**
** ^The first parameter is the [database connection] to which the SQL
** function is to be added.  ^If an application uses more than one database
** connection then application-defined SQL functions must be added
** to each database connection separately.
**
** ^The second parameter is the name of the SQL function to be created or
** redefined.  ^The length of the name is limited to 255 bytes in a UTF-8
** representation, exclusive of the zero-terminator.  ^Note that the name
** length limit is in UTF-8 bytes, not characters nor UTF-16 bytes. 
** ^Any attempt to create a function with a longer name
** will result in [DBSQL_MISUSE] being returned.
**
** ^The third parameter (n_arg)
** is the number of arguments that the SQL function or
** aggregate takes. ^If this parameter is -1, then the SQL function or
** aggregate may take any number of arguments between 0 and the limit
** set by [dbsql_limit]([DBSQL_LIMIT_FUNCTION_ARG]).  If the third
** parameter is less than -1 or greater than 127 then the behavior is
** undefined.
**
** ^The fourth parameter, text_rep, specifies what
** [DBSQL_UTF8 | text encoding] this SQL function prefers for
** its parameters.  The application should set this parameter to
** [DBSQL_UTF16LE] if the function implementation invokes
** [dbsql_value_text16le()] on an input, or [DBSQL_UTF16BE] if the
** implementation invokes [dbsql_value_text16be()] on an input, or
** [DBSQL_UTF16] if [dbsql_value_text16()] is used, or [DBSQL_UTF8]
** otherwise.  ^The same SQL function may be registered multiple times using
** different preferred text encodings, with different implementations for
** each encoding.
** ^When multiple implementations of the same function are available, dbsql
** will pick the one that involves the least amount of data conversion.
**
** ^The fourth parameter may optionally be ORed with [DBSQL_DETERMINISTIC]
** to signal that the function will always return the same result given
** the same inputs within a single SQL statement.  Most SQL functions are
** deterministic.  The built-in [random()] SQL function is an example of a
** function that is not deterministic.  The dbsql query planner is able to
** perform additional optimizations on deterministic functions, so use
** of the [DBSQL_DETERMINISTIC] flag is recommended where possible.
**
** ^The fourth parameter may also optionally include the [DBSQL_DIRECTONLY]
** flag, which if present prevents the function from being invoked from
** within VIEWs, TRIGGERs, CHECK constraints, generated column expressions,
** index expressions, or the WHERE clause of partial indexes.
**
** For best security, the [DBSQL_DIRECTONLY] flag is recommended for
** all application-defined SQL functions that do not need to be
** used inside of triggers, views, CHECK constraints, or other elements of
** the database schema.  This flag is especially recommended for SQL
** functions that have side effects or reveal internal application state.
** Without this flag, an attacker might be able to modify the schema of
** a database file to include invocations of the function with parameters
** chosen by the attacker, which the application will then execute when
** the database file is opened and read.
**
** ^(The fifth parameter is an arbitrary pointer.  The implementation of the
** function can gain access to this pointer using [dbsql_user_data()].)^
**
** ^The sixth, seventh and eighth parameters passed to the three
** "dbsql_create_function*" functions, func, step and final, are
** pointers to C-language functions that implement the SQL function or
** aggregate. ^A scalar SQL function requires an implementation of the func
** callback only; NULL pointers must be passed as the step and final
** parameters. ^An aggregate SQL function requires an implementation of step
** and final and NULL pointer must be passed for func. ^To delete an existing
** SQL function or aggregate, pass NULL pointers for all three function
** callbacks.
**
** ^The sixth, seventh, eighth and ninth parameters (step, final, value
** and inverse) passed to dbsql_create_window_function are pointers to
** C-language callbacks that implement the new function. step and final
** must both be non-NULL. value and inverse may either both be NULL, in
** which case a regular aggregate function is created, or must both be
** non-NULL, in which case the new function may be used as either an aggregate
** or aggregate window function. More details regarding the implementation
** of aggregate window functions are
** [user-defined window functions|available here].
**
** ^(If the final parameter to dbsql_create_function_v2() or
** dbsql_create_window_function() is not NULL, then it is the destructor for
** the application data pointer. The destructor is invoked when the function
** is deleted, either by being overloaded or when the database connection
** closes.)^ ^The destructor is also invoked if the call to
** dbsql_create_function_v2() fails.  ^When the destructor callback is
** invoked, it is passed a single argument which is a copy of the application
** data pointer which was the fifth parameter to dbsql_create_function_v2().
**
** ^It is permitted to register multiple implementations of the same
** functions with the same name but with either differing numbers of
** arguments or differing preferred text encodings.  ^dbsql will use
** the implementation that most closely matches the way in which the
** SQL function is used.  ^A function implementation with a non-negative
** n_arg parameter is a better match than a function implementation with
** a negative n_arg.  ^A function where the preferred text encoding
** matches the database encoding is a better
** match than a function where the encoding is different. 
** ^A function where the encoding difference is between UTF16le and UTF16be
** is a closer match than a function where the encoding difference is
** between UTF8 and UTF16.
**
** ^Built-in functions may be overloaded by new application-defined functions.
**
** ^An application-defined function is permitted to call other
** dbsql interfaces.  However, such calls must not
** close the database connection nor finalize or reset the prepared
** statement in which the function is running.
*/
int dbsql_create_function(
  DBSQL *db,
  const char *function_name,
  int n_arg,
  int text_rep,
  void *app,
  void (*func)(dbsql_func_t*,int,dbsql_value_t**),
  void (*step)(dbsql_func_t*,int,dbsql_value_t**),
  void (*final)(dbsql_func_t*)
);
int dbsql_create_function16(
  DBSQL *db,
  const void *function_name,
  int n_arg,
  int text_rep,
  void *app,
  void (*func)(dbsql_func_t*,int,dbsql_value_t**),
  void (*step)(dbsql_func_t*,int,dbsql_value_t**),
  void (*final)(dbsql_func_t*)
);
int dbsql_create_function_v2(
  DBSQL *db,
  const char *function_name,
  int n_arg,
  int text_rep,
  void *app,
  void (*func)(dbsql_func_t*,int,dbsql_value_t**),
  void (*step)(dbsql_func_t*,int,dbsql_value_t**),
  void (*final)(dbsql_func_t*),
  void(*destroy)(void*)
);
int dbsql_create_window_function(
  DBSQL *db,
  const char *function_name,
  int n_arg,
  int text_rep,
  void *app,
  void (*step)(dbsql_func_t*,int,dbsql_value_t**),
  void (*final)(dbsql_func_t*),
  void (*value)(dbsql_func_t*),
  void (*inverse)(dbsql_func_t*,int,dbsql_value_t**),
  void(*destroy)(void*)
);

/*
** CAPI3REF: Text Encodings
**
** These constants define integer codes that represent the various
** text encodings supported by dbsql.
**
** <dl>
** [[DBSQL_UTF8]] <dt>DBSQL_UTF8</dt><dd>Text is encoding as UTF-8</dd>
**
** [[DBSQL_UTF16LE]] <dt>DBSQL_UTF16LE</dt><dd>Text is encoding as UTF-16
** with each code point being expressed "little endian" - the least significant
** byte first.  This is the usual encoding, for example on Windows.</dd>
**
** [[DBSQL_UTF16BE]] <dt>DBSQL_UTF16BE</dt><dd>Text is encoding as UTF-16
** with each code point being expressed "big endian" - the most significant
** byte first.  This encoding is less common, but is still sometimes seen,
** specially on older systems.
**
** [[DBSQL_UTF16]] <dt>DBSQL_UTF16</dt><dd>Text is encoding as UTF-16
** with each code point being expressed either little endian or as big
** endian, according to the native endianness of the host computer.
**
** [[DBSQL_ANY]] <dt>DBSQL_ANY</dt><dd>This encoding value may only be used
** to declare the preferred text for [application-defined SQL functions]
** created using [dbsql_create_function()] and similar.  If the preferred
** encoding (the 4th parameter to dbsql_create_function() - the text_rep
** parameter) is DBSQL_ANY, that indicates that the function does not have
** a preference regarding the text encoding of its parameters and can take
** any text encoding that the dbsql core find convenient to supply.  This
** option is deprecated.  Please do not use it in new applications.
**
** [[DBSQL_UTF16_ALIGNED]] <dt>DBSQL_UTF16_ALIGNED</dt><dd>This encoding
** value may be used as the 3rd parameter (the text_rep parameter) to
** [dbsql_create_collation()] and similar.  This encoding value means
** that the application-defined collating sequence created expects its
** input strings to be in UTF16 in native byte order, and that the start
** of the strings must be aligned to a 2-byte boundary.
**
** [[DBSQL_UTF8_ZT]] <dt>DBSQL_UTF8_ZT</dt><dd>This option can only be
** used to specify the text encoding to strings input to
** [dbsql_result_text64()] and [dbsql_bind_text64()].
** The DBSQL_UTF8_ZT encoding means that the input string (call it "z")
** is UTF-8 encoded and that it is zero-terminated.  If the length parameter
** (call it "n") is non-negative, this encoding option means that the caller
** guarantees that z array contains at least n+1 bytes and that the z&#91;n&#93;
** byte has a value of zero.
** This option gives the same output as DBSQL_UTF8, but can be more efficient
** by avoiding the need to make a copy of the input string, in some cases.
** However, if z is allocated to hold fewer than n+1 bytes or if the
** z&#91;n&#93; byte is not zero, undefined behavior may result.
** </dl>
*/
#define DBSQL_UTF8           1    /* IMP: R-37514-35566 */
#define DBSQL_UTF16LE        2    /* IMP: R-03371-37637 */
#define DBSQL_UTF16BE        3    /* IMP: R-51971-34154 */
#define DBSQL_UTF16          4    /* Use native byte order */
#define DBSQL_ANY            5    /* Deprecated */
#define DBSQL_UTF16_ALIGNED  8    /* dbsql_create_collation only */
#define DBSQL_UTF8_ZT       16    /* Zero-terminated UTF8 */

/*
** CAPI3REF: Function Flags
**
** These constants may be ORed together with the
** [DBSQL_UTF8 | preferred text encoding] as the fourth argument
** to [dbsql_create_function()], [dbsql_create_function16()], or
** [dbsql_create_function_v2()].
**
** <dl>
** [[DBSQL_DETERMINISTIC]] <dt>DBSQL_DETERMINISTIC</dt><dd>
** The DBSQL_DETERMINISTIC flag means that the new function always gives
** the same output when the input parameters are the same.
** The [abs|abs() function] is deterministic, for example, but
** [randomblob|randomblob()] is not.  Functions must
** be deterministic in order to be used in certain contexts such as
** with the WHERE clause of [partial indexes] or in [generated columns].
** dbsql might also optimize deterministic functions by factoring them
** out of inner loops.
** </dd>
**
** [[DBSQL_DIRECTONLY]] <dt>DBSQL_DIRECTONLY</dt><dd>
** The DBSQL_DIRECTONLY flag means that the function may only be invoked
** from top-level SQL, and cannot be used in VIEWs or TRIGGERs nor in
** schema structures such as [CHECK constraints], [DEFAULT clauses],
** [expression indexes], [partial indexes], or [generated columns].
** <p>
** The DBSQL_DIRECTONLY flag is recommended for any
** [application-defined SQL function]
** that has side-effects or that could potentially leak sensitive information.
** This will prevent attacks in which an application is tricked
** into using a database file that has had its schema surreptitiously
** modified to invoke the application-defined function in ways that are
** harmful.
** <p>
** Some people say it is good practice to set DBSQL_DIRECTONLY on all
** [application-defined SQL functions], regardless of whether or not they
** are security sensitive, as doing so prevents those functions from being used
** inside of the database schema, and thus ensures that the database
** can be inspected and modified using generic tools (such as the [CLI])
** that do not have access to the application-defined functions.
** </dd>
**
** [[DBSQL_INNOCUOUS]] <dt>DBSQL_INNOCUOUS</dt><dd>
** The DBSQL_INNOCUOUS flag means that the function is unlikely
** to cause problems even if misused.  An innocuous function should have
** no side effects and should not depend on any values other than its
** input parameters. The [abs|abs() function] is an example of an
** innocuous function.
** The [load_extension() SQL function] is not innocuous because of its
** side effects.
** <p> DBSQL_INNOCUOUS is similar to DBSQL_DETERMINISTIC, but is not
** exactly the same.  The [random|random() function] is an example of a
** function that is innocuous but not deterministic.
** <p>Some heightened security settings
** ([DBSQL_DBCONFIG_TRUSTED_SCHEMA] and [PRAGMA trusted_schema=OFF])
** disable the use of SQL functions inside views and triggers and in
** schema structures such as [CHECK constraints], [DEFAULT clauses],
** [expression indexes], [partial indexes], and [generated columns] unless
** the function is tagged with DBSQL_INNOCUOUS.  Most built-in functions
** are innocuous.  Developers are advised to avoid using the
** DBSQL_INNOCUOUS flag for application-defined functions unless the
** function has been carefully audited and found to be free of potentially
** security-adverse side-effects and information-leaks.
** </dd>
**
** [[DBSQL_SUBTYPE]] <dt>DBSQL_SUBTYPE</dt><dd>
** The DBSQL_SUBTYPE flag indicates to dbsql that a function might call
** [dbsql_value_subtype()] to inspect the sub-types of its arguments.
** This flag instructs dbsql to omit some corner-case optimizations that
** might disrupt the operation of the [dbsql_value_subtype()] function,
** causing it to return zero rather than the correct subtype().
** All SQL functions that invoke [dbsql_value_subtype()] should have this
** property.  If the DBSQL_SUBTYPE property is omitted, then the return
** value from [dbsql_value_subtype()] might sometimes be zero even though
** a non-zero subtype was specified by the function argument expression.
**
** [[DBSQL_RESULT_SUBTYPE]] <dt>DBSQL_RESULT_SUBTYPE</dt><dd>
** The DBSQL_RESULT_SUBTYPE flag indicates to dbsql that a function might call
** [dbsql_result_subtype()] to cause a sub-type to be associated with its
** result.
** Every function that invokes [dbsql_result_subtype()] should have this
** property.  If it does not, then the call to [dbsql_result_subtype()]
** might become a no-op if the function is used as a term in an
** [expression index].  On the other hand, SQL functions that never invoke
** [dbsql_result_subtype()] should avoid setting this property, as the
** purpose of this property is to disable certain optimizations that are
** incompatible with subtypes.
**
** [[DBSQL_SELFORDER1]] <dt>DBSQL_SELFORDER1</dt><dd>
** The DBSQL_SELFORDER1 flag indicates that the function is an aggregate
** that internally orders the values provided to the first argument.  The
** ordered-set aggregate SQL notation with a single ORDER BY term can be
** used to invoke this function.  If the ordered-set aggregate notation is
** used on a function that lacks this flag, then an error is raised. Note
** that the ordered-set aggregate syntax is only available if dbsql is
** built using the -DSQLITE_ENABLE_ORDERED_SET_AGGREGATES compile-time option.
** </dd>
** </dl>
*/
#define DBSQL_DETERMINISTIC    0x000000800
#define DBSQL_DIRECTONLY       0x000080000
#define DBSQL_SUBTYPE          0x000100000
#define DBSQL_INNOCUOUS        0x000200000
#define DBSQL_RESULT_SUBTYPE   0x001000000
#define DBSQL_SELFORDER1       0x002000000

/*
** CAPI3REF: Deprecated Functions
** DEPRECATED
**
** These functions are [deprecated].  In order to maintain
** backwards compatibility with older code, these functions continue
** to be supported.  However, new applications should avoid
** the use of these functions.  To encourage programmers to avoid
** these functions, we will not explain what they do.
*/
#ifndef DBSQL_OMIT_DEPRECATED
DBSQL_DEPRECATED int dbsql_aggregate_count(dbsql_func_t*);
DBSQL_DEPRECATED int dbsql_expired(dbsql_stmt_t*);
DBSQL_DEPRECATED int dbsql_transfer_bindings(dbsql_stmt_t*, dbsql_stmt_t*);
DBSQL_DEPRECATED int dbsql_global_recover(void);
DBSQL_DEPRECATED void dbsql_thread_cleanup(void);
DBSQL_DEPRECATED int dbsql_memory_alarm(void(*)(void*,int64_t,int),
                      void*,int64_t);
#endif

/*
** CAPI3REF: Obtaining SQL Values
** METHOD: dbsql_value_t
**
** <b>Summary:</b>
** <blockquote><table border=0 cellpadding=0 cellspacing=0>
** <tr><td><b>dbsql_value_blob</b><td>&rarr;<td>BLOB value
** <tr><td><b>dbsql_value_double</b><td>&rarr;<td>REAL value
** <tr><td><b>dbsql_value_int</b><td>&rarr;<td>32-bit INTEGER value
** <tr><td><b>dbsql_value_int64</b><td>&rarr;<td>64-bit INTEGER value
** <tr><td><b>dbsql_value_pointer</b><td>&rarr;<td>Pointer value
** <tr><td><b>dbsql_value_text</b><td>&rarr;<td>UTF-8 TEXT value
** <tr><td><b>dbsql_value_text16</b><td>&rarr;<td>UTF-16 TEXT value in
** the native byteorder
** <tr><td><b>dbsql_value_text16be</b><td>&rarr;<td>UTF-16be TEXT value
** <tr><td><b>dbsql_value_text16le</b><td>&rarr;<td>UTF-16le TEXT value
** <tr><td>&nbsp;<td>&nbsp;<td>&nbsp;
** <tr><td><b>dbsql_value_bytes</b><td>&rarr;<td>Size of a BLOB
** or a UTF-8 TEXT in bytes
** <tr><td><b>dbsql_value_bytes16&nbsp;&nbsp;</b>
** <td>&rarr;&nbsp;&nbsp;<td>Size of UTF-16
** TEXT in bytes
** <tr><td><b>dbsql_value_type</b><td>&rarr;<td>Default
** datatype of the value
** <tr><td><b>dbsql_value_numeric_type&nbsp;&nbsp;</b>
** <td>&rarr;&nbsp;&nbsp;<td>Best numeric datatype of the value
** <tr><td><b>dbsql_value_nochange&nbsp;&nbsp;</b>
** <td>&rarr;&nbsp;&nbsp;<td>True if the column is unchanged in an UPDATE
** against a virtual table.
** <tr><td><b>dbsql_value_frombind&nbsp;&nbsp;</b>
** <td>&rarr;&nbsp;&nbsp;<td>True if value originated from a [bound parameter]
** </table></blockquote>
**
** <b>Details:</b>
**
** These routines extract type, size, and content information from
** [protected dbsql_value_t] objects.  Protected dbsql_value_t objects
** are used to pass parameter information into the functions that
** implement [application-defined SQL functions] and [virtual tables].
**
** These routines work only with [protected dbsql_value_t] objects.
** Any attempt to use these routines on an [unprotected dbsql_value_t]
** is not threadsafe.
**
** ^These routines work just like the corresponding [column access functions]
** except that these routines take a single [protected dbsql_value_t] object
** pointer instead of a [dbsql_stmt_t*] pointer and an integer column number.
**
** ^The dbsql_value_text16() interface extracts a UTF-16 string
** in the native byte-order of the host machine.  ^The
** dbsql_value_text16be() and dbsql_value_text16le() interfaces
** extract UTF-16 strings as big-endian and little-endian respectively.
**
** ^If [dbsql_value_t] object V was initialized
** using [dbsql_bind_pointer(S,I,P,X,D)] or [dbsql_result_pointer(C,P,X,D)]
** and if X and Y are strings that compare equal according to strcmp(X,Y),
** then dbsql_value_pointer(V,Y) will return the pointer P.  ^Otherwise,
** dbsql_value_pointer(V,Y) returns a NULL. The dbsql_bind_pointer()
** routine is part of the [pointer passing interface] added for dbsql 3.20.0.
**
** ^(The dbsql_value_type(V) interface returns the
** [DBSQL_INTEGER | datatype code] for the initial datatype of the
** [dbsql_value_t] object V. The returned value is one of [DBSQL_INTEGER],
** [DBSQL_FLOAT], [DBSQL_TEXT], [DBSQL_BLOB], or [DBSQL_NULL].)^
** Other interfaces might change the datatype for an dbsql_value_t object.
** For example, if the datatype is initially DBSQL_INTEGER and
** dbsql_value_text(V) is called to extract a text value for that
** integer, then subsequent calls to dbsql_value_type(V) might return
** DBSQL_TEXT.  Whether or not a persistent internal datatype conversion
** occurs is undefined and may change from one release of dbsql to the next.
**
** ^(The dbsql_value_numeric_type() interface attempts to apply
** numeric affinity to the value.  This means that an attempt is
** made to convert the value to an integer or floating point.  If
** such a conversion is possible without loss of information (in other
** words, if the value is a string that looks like a number)
** then the conversion is performed.  Otherwise no conversion occurs.
** The [DBSQL_INTEGER | datatype] after conversion is returned.)^
**
** ^Within the [update] method of a [virtual table], the
** dbsql_value_nochange(X) interface returns true if and only if
** the column corresponding to X is unchanged by the UPDATE operation
** that the update method call was invoked to implement and if
** the prior [column] method call that was invoked to extract
** the value for that column returned without setting a result (probably
** because it queried [dbsql_vtab_nochange()] and found that the column
** was unchanging).  ^Within an [update] method, any value for which
** dbsql_value_nochange(X) is true will in all other respects appear
** to be a NULL value.  If dbsql_value_nochange(X) is invoked anywhere other
** than within an [update] method call for an UPDATE statement, then
** the return value is arbitrary and meaningless.
**
** ^The dbsql_value_frombind(X) interface returns non-zero if the
** value X originated from one of the [dbsql_bind_int|dbsql_bind()]
** interfaces.  ^If X comes from an SQL literal value, or a table column,
** or an expression, then dbsql_value_frombind(X) returns zero.
**
** Please pay particular attention to the fact that the pointer returned
** from [dbsql_value_blob()], [dbsql_value_text()], or
** [dbsql_value_text16()] can be invalidated by a subsequent call to
** [dbsql_value_bytes()], [dbsql_value_bytes16()], [dbsql_value_text()],
** or [dbsql_value_text16()].
**
** These routines must be called from the same thread as
** the SQL function that supplied the [dbsql_value_t*] parameters.
**
** As long as the input parameter is correct, these routines can only
** fail if an out-of-memory error occurs while trying to do a 
** UTF8&rarr;UTF16 or UTF16&rarr;UTF8 conversion.
** If an out-of-memory error occurs, then the return value from these
** routines is the same as if the column had contained an SQL NULL value.
** If the input dbsql_value_t was not obtained from [dbsql_value_dup()],
** then valid SQL NULL returns can also be distinguished from
** out-of-memory errors after extracting the value
** by invoking the [dbsql_errcode()] immediately after the suspicious
** return value is obtained and before any
** other dbsql interface is called on the same [database connection].
** If the input dbsql_value_t was obtained from dbsql_value_dup() then
** it is disconnected from the database connection and so dbsql_errcode()
** will not work.
** In that case, the only way to distinguish an out-of-memory
** condition from a true SQL NULL is to invoke dbsql_value_type() on the
** input to see if it is NULL prior to trying to extract the value.
*/
const void *dbsql_value_blob(dbsql_value_t*);
double dbsql_value_double(dbsql_value_t*);
int dbsql_value_int(dbsql_value_t*);
int64_t dbsql_value_int64(dbsql_value_t*);
void *dbsql_value_pointer(dbsql_value_t*, const char*);
const unsigned char *dbsql_value_text(dbsql_value_t*);
const void *dbsql_value_text16(dbsql_value_t*);
const void *dbsql_value_text16le(dbsql_value_t*);
const void *dbsql_value_text16be(dbsql_value_t*);
int dbsql_value_bytes(dbsql_value_t*);
int dbsql_value_bytes16(dbsql_value_t*);
int dbsql_value_type(dbsql_value_t*);
int dbsql_value_numeric_type(dbsql_value_t*);
int dbsql_value_nochange(dbsql_value_t*);
int dbsql_value_frombind(dbsql_value_t*);

/*
** CAPI3REF: Report the internal text encoding state of an dbsql_value_t object
** METHOD: dbsql_value_t
**
** ^(The dbsql_value_encoding(X) interface returns one of [DBSQL_UTF8],
** [DBSQL_UTF16BE], or [DBSQL_UTF16LE] according to the current text encoding
** of the value X, assuming that X has type TEXT.)^  If dbsql_value_type(X)
** returns something other than DBSQL_TEXT, then the return value from
** dbsql_value_encoding(X) is meaningless.  ^Calls to
** [dbsql_value_text(X)], [dbsql_value_text16(X)],
** [dbsql_value_text16be(X)],
** [dbsql_value_text16le(X)], [dbsql_value_bytes(X)], or
** [dbsql_value_bytes16(X)] might change the encoding of the value X and
** thus change the return from subsequent calls to dbsql_value_encoding(X).
**
** This routine is intended for used by applications that test and validate
** the dbsql implementation.  This routine is inquiring about the opaque
** internal state of an [dbsql_value_t] object.  Ordinary applications should
** not need to know what the internal state of an dbsql_value_t object is and
** hence should not need to use this interface.
*/
int dbsql_value_encoding(dbsql_value_t*);

/*
** CAPI3REF: Finding The Subtype Of SQL Values
** METHOD: dbsql_value_t
**
** The dbsql_value_subtype(V) function returns the subtype for
** an [application-defined SQL function] argument V.  The subtype
** information can be used to pass a limited amount of context from
** one SQL function to another.  Use the [dbsql_result_subtype()]
** routine to set the subtype for the return value of an SQL function.
**
** Every [application-defined SQL function] that invokes this interface
** should include the [DBSQL_SUBTYPE] property in the text
** encoding argument when the function is [dbsql_create_function|registered].
** If the [DBSQL_SUBTYPE] property is omitted, then dbsql_value_subtype()
** might return zero instead of the upstream subtype in some corner cases.
*/
unsigned int dbsql_value_subtype(dbsql_value_t*);

/*
** CAPI3REF: Copy And Free SQL Values
** METHOD: dbsql_value_t
**
** ^The dbsql_value_dup(V) interface makes a copy of the [dbsql_value_t]
** object V and returns a pointer to that copy.  ^The [dbsql_value_t] returned
** is a [protected dbsql_value_t] object even if the input is not.
** ^The dbsql_value_dup(V) interface returns NULL if V is NULL or if a
** memory allocation fails. ^If V is a [pointer value], then the result
** of dbsql_value_dup(V) is a NULL value.
**
** ^The dbsql_value_free(V) interface frees an [dbsql_value_t] object
** previously obtained from [dbsql_value_dup()].  ^If V is a NULL pointer
** then dbsql_value_free(V) is a harmless no-op.
*/
dbsql_value_t *dbsql_value_dup(const dbsql_value_t*);
void dbsql_value_free(dbsql_value_t*);

/*
** CAPI3REF: Obtain Aggregate Function Context
** METHOD: dbsql_func_t
**
** Implementations of aggregate SQL functions use this
** routine to allocate memory for storing their state.
**
** ^The first time the dbsql_aggregate_context(C,N) routine is called
** for a particular aggregate function, dbsql allocates
** N bytes of memory, zeroes out that memory, and returns a pointer
** to the new memory. ^On second and subsequent calls to
** dbsql_aggregate_context() for the same aggregate function instance,
** the same buffer is returned.  Sqlite3_aggregate_context() is normally
** called once for each invocation of the step callback and then one
** last time when the final callback is invoked.  ^(When no rows match
** an aggregate query, the step() callback of the aggregate function
** implementation is never called and final() is called exactly once.
** In those cases, dbsql_aggregate_context() might be called for the
** first time from within final().)^
**
** ^The dbsql_aggregate_context(C,N) routine returns a NULL pointer
** when first called if N is less than or equal to zero or if a memory
** allocation error occurs.
**
** ^(The amount of space allocated by dbsql_aggregate_context(C,N) is
** determined by the N parameter on the first successful call.  Changing the
** value of N in any subsequent call to dbsql_aggregate_context() within
** the same aggregate function instance will not resize the memory
** allocation.)^  Within the final callback, it is customary to set
** N=0 in calls to dbsql_aggregate_context(C,N) so that no
** pointless memory allocations occur.
**
** ^dbsql automatically frees the memory allocated by
** dbsql_aggregate_context() when the aggregate query concludes.
**
** The first parameter must be a copy of the
** [dbsql_func_t | SQL function context] that is the first parameter
** to the step or final callback routine that implements the aggregate
** function.
**
** This routine must be called from the same thread in which
** the aggregate SQL function is running.
*/
void *dbsql_aggregate_context(dbsql_func_t*, int n_bytes);

/*
** CAPI3REF: User Data For Functions
** METHOD: dbsql_func_t
**
** ^The dbsql_user_data() interface returns a copy of
** the pointer that was the user_data parameter (the 5th parameter)
** of the [dbsql_create_function()]
** and [dbsql_create_function16()] routines that originally
** registered the application defined function.
**
** This routine must be called from the same thread in which
** the application-defined function is running.
*/
void *dbsql_user_data(dbsql_func_t*);

/*
** CAPI3REF: Database Connection For Functions
** METHOD: dbsql_func_t
**
** ^The dbsql_context_db_handle() interface returns a copy of
** the pointer to the [database connection] (the 1st parameter)
** of the [dbsql_create_function()]
** and [dbsql_create_function16()] routines that originally
** registered the application defined function.
*/
DBSQL *dbsql_context_db_handle(dbsql_func_t*);

/*
** CAPI3REF: Function Auxiliary Data
** METHOD: dbsql_func_t
**
** These functions may be used by (non-aggregate) SQL functions to
** associate auxiliary data with argument values. If the same argument
** value is passed to multiple invocations of the same SQL function during
** query execution, under some circumstances the associated auxiliary data
** might be preserved.  An example of where this might be useful is in a
** regular-expression matching function. The compiled version of the regular
** expression can be stored as auxiliary data associated with the pattern
** string. Then as long as the pattern string remains the same,
** the compiled regular expression can be reused on multiple
** invocations of the same function.
**
** ^The dbsql_get_auxdata(C,N) interface returns a pointer to the auxiliary
** data associated by the dbsql_set_auxdata(C,N,P,X) function with the
** Nth argument value to the application-defined function.  ^N is zero
** for the left-most function argument.  ^If there is no auxiliary data
** associated with the function argument, the dbsql_get_auxdata(C,N)
** interface returns a NULL pointer.
**
** ^The dbsql_set_auxdata(C,N,P,X) interface saves P as auxiliary data for the
** N-th argument of the application-defined function.  ^Subsequent
** calls to dbsql_get_auxdata(C,N) return P from the most recent
** dbsql_set_auxdata(C,N,P,X) call if the auxiliary data is still valid or
** NULL if the auxiliary data has been discarded.
** ^After each call to dbsql_set_auxdata(C,N,P,X) where X is not NULL,
** dbsql will invoke the destructor function X with parameter P exactly
** once, when the auxiliary data is discarded.
** dbsql is free to discard the auxiliary data at any time, including: <ul>
** <li> ^(when the corresponding function parameter changes)^, or
** <li> ^(when [dbsql_reset()] or [dbsql_finalize()] is called for the
**      SQL statement)^, or
** <li> ^(when dbsql_set_auxdata() is invoked again on the same
**       parameter)^, or
** <li> ^(during the original dbsql_set_auxdata() call when a memory
**      allocation error occurs.)^
** <li> ^(during the original dbsql_set_auxdata() call if the function
**      is evaluated during query planning instead of during query execution,
**      as sometimes happens with [DBSQL_ENABLE_STAT4].)^ </ul>
**
** Note the last two bullets in particular.  The destructor X in
** dbsql_set_auxdata(C,N,P,X) might be called immediately, before the
** dbsql_set_auxdata() interface even returns.  Hence dbsql_set_auxdata()
** should be called near the end of the function implementation and the
** function implementation should not make any use of P after
** dbsql_set_auxdata() has been called.  Furthermore, a call to
** dbsql_get_auxdata() that occurs immediately after a corresponding call
** to dbsql_set_auxdata() might still return NULL if an out-of-memory
** condition occurred during the dbsql_set_auxdata() call or if the
** function is being evaluated during query planning rather than during
** query execution.
**
** ^(In practice, auxiliary data is preserved between function calls for
** function parameters that are compile-time constants, including literal
** values and [parameters] and expressions composed from the same.)^
**
** The value of the N parameter to these interfaces should be non-negative.
** Future enhancements may make use of negative N values to define new
** kinds of function caching behavior.
**
** These routines must be called from the same thread in which
** the SQL function is running.
**
** See also: [dbsql_get_clientdata()] and [dbsql_set_clientdata()].
*/
void *dbsql_get_auxdata(dbsql_func_t*, int N);
void dbsql_set_auxdata(dbsql_func_t*, int N, void*, void (*)(void*));

/*
** CAPI3REF: Database Connection Client Data
** METHOD: DBSQL
**
** These functions are used to associate one or more named pointers
** with a [database connection].
** A call to dbsql_set_clientdata(D,N,P,X) causes the pointer P
** to be attached to [database connection] D using name N.  Subsequent
** calls to dbsql_get_clientdata(D,N) will return a copy of pointer P
** or a NULL pointer if there were no prior calls to
** dbsql_set_clientdata() with the same values of D and N.
** Names are compared using strcmp() and are thus case sensitive.
** It returns 0 on success and DBSQL_NOMEM on allocation failure.
**
** If P and X are both non-NULL, then the destructor X is invoked with
** argument P on the first of the following occurrences:
** <ul>
** <li> An out-of-memory error occurs during the call to
**      dbsql_set_clientdata() which attempts to register pointer P.
** <li> A subsequent call to dbsql_set_clientdata(D,N,P,X) is made
**      with the same D and N parameters.
** <li> The database connection closes.  dbsql does not make any guarantees
**      about the order in which destructors are called, only that all
**      destructors will be called exactly once at some point during the
**      database connection closing process.
** </ul>
**
** dbsql does not do anything with client data other than invoke
** destructors on the client data at the appropriate time.  The intended
** use for client data is to provide a mechanism for wrapper libraries
** to store additional information about an dbsql database connection.
**
** There is no limit (other than available memory) on the number of different
** client data pointers (with different names) that can be attached to a
** single database connection.  However, the current implementation stores
** the content on a linked list.  Insert and retrieval performance will
** be proportional to the number of entries.  The design use case, and
** the use case for which the implementation is optimized, is
** that an application will store only small number of client data names,
** typically just one or two.  This interface is not intended to be a
** generalized key/value store for thousands or millions of keys.  It
** will work for that, but performance might be disappointing.
**
** There is no way to enumerate the client data pointers
** associated with a database connection.  The N parameter can be thought
** of as a secret key such that only code that knows the secret key is able
** to access the associated data.
**
** Security Warning:  These interfaces should not be exposed in scripting
** languages or in other circumstances where it might be possible for an
** attacker to invoke them.  Any agent that can invoke these interfaces
** can probably also take control of the process.
**
** Database connection client data is only available for dbsql
** version 3.44.0 ([dateof:3.44.0]) and later.
**
** See also: [dbsql_set_auxdata()] and [dbsql_get_auxdata()].
*/
void *dbsql_get_clientdata(DBSQL*,const char*);
int dbsql_set_clientdata(DBSQL*, const char*, void*, void(*)(void*));

/*
** CAPI3REF: Constants Defining Special Destructor Behavior
**
** These are special values for the destructor that is passed in as the
** final argument to routines like [dbsql_result_blob()].  ^If the destructor
** argument is DBSQL_STATIC, it means that the content pointer is constant
** and will never change.  It does not need to be destroyed.  ^The
** DBSQL_TRANSIENT value means that the content will likely change in
** the near future and that dbsql should make its own private copy of
** the content before returning.
**
** The typedef is necessary to work around problems in certain
** C++ compilers.
*/
typedef void (*dbsql_destructor_type)(void*);
#define DBSQL_STATIC      ((dbsql_destructor_type)0)
#define DBSQL_TRANSIENT   ((dbsql_destructor_type)-1)

/*
** CAPI3REF: Setting The Result Of An SQL Function
** METHOD: dbsql_func_t
**
** These routines are used by the func or final callbacks that
** implement SQL functions and aggregates.  See
** [dbsql_create_function()] and [dbsql_create_function16()]
** for additional information.
**
** These functions work very much like the [parameter binding] family of
** functions used to bind values to host parameters in prepared statements.
** Refer to the [SQL parameter] documentation for additional information.
**
** ^The dbsql_result_blob() interface sets the result from
** an application-defined function to be the BLOB whose content is pointed
** to by the second parameter and which is N bytes long where N is the
** third parameter.
**
** ^The dbsql_result_zeroblob(C,N) and dbsql_result_zeroblob64(C,N)
** interfaces set the result of the application-defined function to be
** a BLOB containing all zero bytes and N bytes in size.
**
** ^The dbsql_result_double() interface sets the result from
** an application-defined function to be a floating point value specified
** by its 2nd argument.
**
** ^The dbsql_result_error() and dbsql_result_error16() functions
** cause the implemented SQL function to throw an exception.
** ^dbsql uses the string pointed to by the
** 2nd parameter of dbsql_result_error() or dbsql_result_error16()
** as the text of an error message.  ^dbsql interprets the error
** message string from dbsql_result_error() as UTF-8. ^dbsql
** interprets the string from dbsql_result_error16() as UTF-16 using
** the same [byte-order determination rules] as [dbsql_bind_text16()].
** ^If the third parameter to dbsql_result_error()
** or dbsql_result_error16() is negative then dbsql takes as the error
** message all text up through the first zero character.
** ^If the third parameter to dbsql_result_error() or
** dbsql_result_error16() is non-negative then dbsql takes that many
** bytes (not characters) from the 2nd parameter as the error message.
** ^The dbsql_result_error() and dbsql_result_error16()
** routines make a private copy of the error message text before
** they return.  Hence, the calling function can deallocate or
** modify the text after they return without harm.
** ^The dbsql_result_error_code() function changes the error code
** returned by dbsql as a result of an error in a function.  ^By default,
** the error code is DBSQL_ERROR.  ^A subsequent call to dbsql_result_error()
** or dbsql_result_error16() resets the error code to DBSQL_ERROR.
**
** ^The dbsql_result_error_toobig() interface causes dbsql to throw an
** error indicating that a string or BLOB is too long to represent.
**
** ^The dbsql_result_error_nomem() interface causes dbsql to throw an
** error indicating that a memory allocation failed.
**
** ^The dbsql_result_int() interface sets the return value
** of the application-defined function to be the 32-bit signed integer
** value given in the 2nd argument.
** ^The dbsql_result_int64() interface sets the return value
** of the application-defined function to be the 64-bit signed integer
** value given in the 2nd argument.
**
** ^The dbsql_result_null() interface sets the return value
** of the application-defined function to be NULL.
**
** ^The dbsql_result_text(), dbsql_result_text16(),
** dbsql_result_text16le(), and dbsql_result_text16be() interfaces
** set the return value of the application-defined function to be
** a text string which is represented as UTF-8, UTF-16 native byte order,
** UTF-16 little endian, or UTF-16 big endian, respectively.
** ^The dbsql_result_text64(C,Z,N,D,E) interface sets the return value of an
** application-defined function to be a text string in an encoding
** specified the E parameter, which must be one
** of [DBSQL_UTF8], [DBSQL_UTF8_ZT], [DBSQL_UTF16], [DBSQL_UTF16BE],
** or [DBSQL_UTF16LE].  ^The special value [DBSQL_UTF8_ZT] means that
** the result text is both UTF-8 and zero-terminated.  In other words,
** DBSQL_UTF8_ZT means that the Z array holds at least N+1 bytes and that
** the Z&#91;N&#93; is zero.
** ^dbsql takes the text result from the application from
** the 2nd parameter of the dbsql_result_text* interfaces.
** ^If the 3rd parameter to any of the dbsql_result_text* interfaces
** other than dbsql_result_text64() is negative, then dbsql computes
** the string length itself by searching the 2nd parameter for the first
** zero character.
** ^If the 3rd parameter to the dbsql_result_text* interfaces
** is non-negative, then as many bytes (not characters) of the text
** pointed to by the 2nd parameter are taken as the application-defined
** function result.  If the 3rd parameter is non-negative, then it
** must be the byte offset into the string where the NUL terminator would
** appear if the string were NUL terminated.  If any NUL characters occur
** in the string at a byte offset that is less than the value of the 3rd
** parameter, then the resulting string will contain embedded NULs and the
** result of expressions operating on strings with embedded NULs is undefined.
** ^If the 4th parameter to the dbsql_result_text* interfaces
** or dbsql_result_blob is a non-NULL pointer, then dbsql calls that
** function as the destructor on the text or BLOB result when it has
** finished using that result.
** ^If the 4th parameter to the dbsql_result_text* interfaces or to
** dbsql_result_blob is the special constant DBSQL_STATIC, then dbsql
** assumes that the text or BLOB result is in constant space and does not
** copy the content of the parameter nor call a destructor on the content
** when it has finished using that result.
** ^If the 4th parameter to the dbsql_result_text* interfaces
** or dbsql_result_blob is the special constant DBSQL_TRANSIENT
** then dbsql makes a copy of the result into space obtained
** from [dbsql_malloc()] before it returns.
**
** ^For the dbsql_result_text16(), dbsql_result_text16le(), and
** dbsql_result_text16be() routines, and for dbsql_result_text64()
** when the encoding is not UTF8, if the input UTF16 begins with a
** byte-order mark (BOM, U+FEFF) then the BOM is removed from the
** string and the rest of the string is interpreted according to the
** byte-order specified by the BOM.  ^The byte-order specified by
** the BOM at the beginning of the text overrides the byte-order
** specified by the interface procedure.  ^So, for example, if
** dbsql_result_text16le() is invoked with text that begins
** with bytes 0xfe, 0xff (a big-endian byte-order mark) then the
** first two bytes of input are skipped and the remaining input
** is interpreted as UTF16BE text.
**
** ^For UTF16 input text to the dbsql_result_text16(),
** dbsql_result_text16be(), dbsql_result_text16le(), and
** dbsql_result_text64() routines, if the text contains invalid
** UTF16 characters, the invalid characters might be converted
** into the unicode replacement character, U+FFFD.
**
** ^The dbsql_result_value() interface sets the result of
** the application-defined function to be a copy of the
** [unprotected dbsql_value_t] object specified by the 2nd parameter.  ^The
** dbsql_result_value() interface makes a copy of the [dbsql_value_t]
** so that the [dbsql_value_t] specified in the parameter may change or
** be deallocated after dbsql_result_value() returns without harm.
** ^A [protected dbsql_value_t] object may always be used where an
** [unprotected dbsql_value_t] object is required, so either
** kind of [dbsql_value_t] object can be used with this interface.
**
** ^The dbsql_result_pointer(C,P,T,D) interface sets the result to an
** SQL NULL value, just like [dbsql_result_null(C)], except that it
** also associates the host-language pointer P or type T with that
** NULL value such that the pointer can be retrieved within an
** [application-defined SQL function] using [dbsql_value_pointer()].
** ^If the D parameter is not NULL, then it is a pointer to a destructor
** for the P parameter.  ^dbsql invokes D with P as its only argument
** when dbsql is finished with P.  The T parameter should be a static
** string and preferably a string literal. The dbsql_result_pointer()
** routine is part of the [pointer passing interface] added for dbsql 3.20.0.
**
** If these routines are called from within a different thread
** than the one containing the application-defined function that received
** the [dbsql_func_t] pointer, the results are undefined.
*/
void dbsql_result_blob(dbsql_func_t*, const void*, int, void(*)(void*));
void dbsql_result_blob64(dbsql_func_t*,const void*,
                           u_int64_t,void(*)(void*));
void dbsql_result_double(dbsql_func_t*, double);
void dbsql_result_error(dbsql_func_t*, const char*, int);
void dbsql_result_error16(dbsql_func_t*, const void*, int);
void dbsql_result_error_toobig(dbsql_func_t*);
void dbsql_result_error_nomem(dbsql_func_t*);
void dbsql_result_error_code(dbsql_func_t*, int);
void dbsql_result_int(dbsql_func_t*, int);
void dbsql_result_int64(dbsql_func_t*, int64_t);
void dbsql_result_null(dbsql_func_t*);
void dbsql_result_text(dbsql_func_t*, const char*, int, void(*)(void*));
void dbsql_result_text64(dbsql_func_t*, const char *z, u_int64_t n,
                           void(*)(void*), unsigned char encoding);
void dbsql_result_text16(dbsql_func_t*, const void*, int, void(*)(void*));
void dbsql_result_text16le(dbsql_func_t*, const void*, int,void(*)(void*));
void dbsql_result_text16be(dbsql_func_t*, const void*, int,void(*)(void*));
void dbsql_result_value(dbsql_func_t*, dbsql_value_t*);
void dbsql_result_pointer(dbsql_func_t*, void*,const char*,void(*)(void*));
void dbsql_result_zeroblob(dbsql_func_t*, int n);
int dbsql_result_zeroblob64(dbsql_func_t*, u_int64_t n);


/*
** CAPI3REF: Setting The Subtype Of An SQL Function
** METHOD: dbsql_func_t
**
** The dbsql_result_subtype(C,T) function causes the subtype of
** the result from the [application-defined SQL function] with
** [dbsql_func_t] C to be the value T.  Only the lower 8 bits
** of the subtype T are preserved in current versions of dbsql;
** higher order bits are discarded.
** The number of subtype bytes preserved by dbsql might increase
** in future releases of dbsql.
**
** Every [application-defined SQL function] that invokes this interface
** should include the [DBSQL_RESULT_SUBTYPE] property in its
** text encoding argument when the SQL function is
** [dbsql_create_function|registered].  If the [DBSQL_RESULT_SUBTYPE]
** property is omitted from the function that invokes dbsql_result_subtype(),
** then in some cases the dbsql_result_subtype() might fail to set
** the result subtype.
**
** If dbsql is compiled with -DSQLITE_STRICT_SUBTYPE=1, then any
** SQL function that invokes the dbsql_result_subtype() interface
** and that does not have the DBSQL_RESULT_SUBTYPE property will raise
** an error.  Future versions of dbsql might enable -DSQLITE_STRICT_SUBTYPE=1
** by default.
*/
void dbsql_result_subtype(dbsql_func_t*,unsigned int);

/*
** CAPI3REF: Define New Collating Sequences
** METHOD: DBSQL
**
** ^These functions add, remove, or modify a [collation] associated
** with the [database connection] specified as the first argument.
**
** ^The name of the collation is a UTF-8 string
** for dbsql_create_collation() and dbsql_create_collation_v2()
** and a UTF-16 string in native byte order for dbsql_create_collation16().
** ^Collation names that compare equal according to [dbsql_strnicmp()] are
** considered to be the same name.
**
** ^(The third argument (text_rep) must be one of the constants:
** <ul>
** <li> [DBSQL_UTF8],
** <li> [DBSQL_UTF16LE],
** <li> [DBSQL_UTF16BE],
** <li> [DBSQL_UTF16], or
** <li> [DBSQL_UTF16_ALIGNED].
** </ul>)^
** ^The text_rep argument determines the encoding of strings passed
** to the collating function callback, compare.
** ^The [DBSQL_UTF16] and [DBSQL_UTF16_ALIGNED] values for text_rep
** force strings to be UTF16 with native byte order.
** ^The [DBSQL_UTF16_ALIGNED] value for text_rep forces strings to begin
** on an even byte address.
**
** ^The fourth argument, arg, is an application data pointer that is passed
** through as the first argument to the collating function callback.
**
** ^The fifth argument, compare, is a pointer to the collating function.
** ^Multiple collating functions can be registered using the same name but
** with different text_rep parameters and dbsql will use whichever
** function requires the least amount of data transformation.
** ^If the compare argument is NULL then the collating function is
** deleted.  ^When all collating functions having the same name are deleted,
** that collation is no longer usable.
**
** ^The collating function callback is invoked with a copy of the arg
** application data pointer and with two strings in the encoding specified
** by the text_rep argument.  The two integer parameters to the collating
** function callback are the length of the two strings, in bytes. The collating
** function must return an integer that is negative, zero, or positive
** if the first string is less than, equal to, or greater than the second,
** respectively.  A collating function must always return the same answer
** given the same inputs.  If two or more collating functions are registered
** to the same collation name (using different text_rep values) then all
** must give an equivalent answer when invoked with equivalent strings.
** The collating function must obey the following properties for all
** strings A, B, and C:
**
** <ol>
** <li> If A==B then B==A.
** <li> If A==B and B==C then A==C.
** <li> If A&lt;B THEN B&gt;A.
** <li> If A&lt;B and B&lt;C then A&lt;C.
** </ol>
**
** If a collating function fails any of the above constraints and that
** collating function is registered and used, then the behavior of dbsql
** is undefined.
**
** ^The dbsql_create_collation_v2() works like dbsql_create_collation()
** with the addition that the destroy callback is invoked on arg when
** the collating function is deleted.
** ^Collating functions are deleted when they are overridden by later
** calls to the collation creation functions or when the
** [database connection] is closed using [dbsql_close()].
**
** ^The destroy callback is <u>not</u> called if the
** dbsql_create_collation_v2() function fails.  Applications that invoke
** dbsql_create_collation_v2() with a non-NULL destroy argument should
** check the return code and dispose of the application data pointer
** themselves rather than expecting dbsql to deal with it for them.
** This is different from every other dbsql interface.  The inconsistency
** is unfortunate but cannot be changed without breaking backwards
** compatibility.
**
** See also:  [dbsql_collation_needed()] and [dbsql_collation_needed16()].
*/
int dbsql_create_collation(
  DBSQL*,
  const char *name,
  int text_rep,
  void *arg,
  int(*compare)(void*,int,const void*,int,const void*)
);
int dbsql_create_collation_v2(
  DBSQL*,
  const char *name,
  int text_rep,
  void *arg,
  int(*compare)(void*,int,const void*,int,const void*),
  void(*destroy)(void*)
);
int dbsql_create_collation16(
  DBSQL*,
  const void *name,
  int text_rep,
  void *arg,
  int(*compare)(void*,int,const void*,int,const void*)
);

/*
** CAPI3REF: Collation Needed Callbacks
** METHOD: DBSQL
**
** ^To avoid having to register all collation sequences before a database
** can be used, a single callback function may be registered with the
** [database connection] to be invoked whenever an undefined collation
** sequence is required.
**
** ^If the function is registered using the dbsql_collation_needed() API,
** then it is passed the names of undefined collation sequences as strings
** encoded in UTF-8. ^If dbsql_collation_needed16() is used,
** the names are passed as UTF-16 in machine native byte order.
** ^A call to either function replaces the existing collation-needed callback.
**
** ^(When the callback is invoked, the first argument passed is a copy
** of the second argument to dbsql_collation_needed() or
** dbsql_collation_needed16().  The second argument is the database
** connection.  The third argument is one of [DBSQL_UTF8], [DBSQL_UTF16BE],
** or [DBSQL_UTF16LE], indicating the most desirable form of the collation
** sequence function required.  The fourth parameter is the name of the
** required collation sequence.)^
**
** The callback function should register the desired collation using
** [dbsql_create_collation()], [dbsql_create_collation16()], or
** [dbsql_create_collation_v2()].
*/
int dbsql_collation_needed(
  DBSQL*,
  void*,
  void(*)(void*,DBSQL*,int text_rep,const char*)
);
int dbsql_collation_needed16(
  DBSQL*,
  void*,
  void(*)(void*,DBSQL*,int text_rep,const void*)
);

#ifdef DBSQL_ENABLE_CEROD
/*
** Specify the activation key for a CEROD database.  Unless
** activated, none of the CEROD routines will work.
*/
void dbsql_activate_cerod(
  const char *pass_phrase        /* Activation phrase */
);
#endif

/*
** CAPI3REF: Suspend Execution For A Short Time
**
** The dbsql_sleep() function causes the current thread to suspend execution
** for at least a number of milliseconds specified in its parameter.
**
** If the operating system does not support sleep requests with
** millisecond time resolution, then the time will be rounded up to
** the nearest second. The number of milliseconds of sleep actually
** requested from the operating system is returned.
**
** ^dbsql implements this interface by calling the x_sleep()
** method of the default [dbsql_vfs_t] object.  If the x_sleep() method
** of the default VFS is not implemented correctly, or not implemented at
** all, then the behavior of dbsql_sleep() may deviate from the description
** in the previous paragraphs.
**
** If a negative argument is passed to dbsql_sleep() the results vary by
** VFS and operating system.  Some system treat a negative argument as an
** instruction to sleep forever.  Others understand it to mean do not sleep
** at all. ^In dbsql version 3.42.0 and later, a negative
** argument passed into dbsql_sleep() is changed to zero before it is relayed
** down into the x_sleep method of the VFS.
*/
int dbsql_sleep(int);

/*
** CAPI3REF: Name Of The Folder Holding Temporary Files
**
** ^(If this global variable is made to point to a string which is
** the name of a folder (a.k.a. directory), then all temporary files
** created by dbsql when using a built-in [dbsql_vfs_t | VFS]
** will be placed in that directory.)^  ^If this variable
** is a NULL pointer, then dbsql performs a search for an appropriate
** temporary file directory.
**
** Applications are strongly discouraged from using this global variable.
** It is required to set a temporary folder on Windows Runtime (__win_rt).
** But for all other platforms, it is highly recommended that applications
** neither read nor write this variable.  This global variable is a relic
** that exists for backwards compatibility of legacy applications and should
** be avoided in new projects.
**
** It is not safe to read or modify this variable in more than one
** thread at a time.  It is not safe to read or modify this variable
** if a [database connection] is being used at the same time in a separate
** thread.
** It is intended that this variable be set once
** as part of process initialization and before any dbsql interface
** routines have been called and that this variable remain unchanged
** thereafter.
**
** ^The [temp_store_directory pragma] may modify this variable and cause
** it to point to memory obtained from [dbsql_malloc].  ^Furthermore,
** the [temp_store_directory pragma] always assumes that any string
** that this variable points to is held in memory obtained from
** [dbsql_malloc] and the pragma may attempt to free that memory
** using [dbsql_free].
** Hence, if this variable is modified directly, either it should be
** made NULL or made to point to memory obtained from [dbsql_malloc]
** or else the use of the [temp_store_directory pragma] should be avoided.
** Except when requested by the [temp_store_directory pragma], dbsql
** does not free the memory that dbsql_temp_directory points to.  If
** the application wants that memory to be freed, it must do
** so itself, taking care to only do so after all [database connection]
** objects have been destroyed.
**
** <b>Note to Windows Runtime users:</b>  The temporary directory must be set
** prior to calling [dbsql_open] or [dbsql_open_v2].  Otherwise, various
** features that require the use of temporary files may fail.  Here is an
** example of how to do this using C++ with the Windows Runtime:
**
** <blockquote><pre>
** LPCWSTR path = Windows::Storage::__application_data::Current->
** &nbsp;     __temporary_folder->Path->Data();
** char path_buf&#91;MAX_PATH + 1&#93;;
** memset(path_buf, 0, sizeof(path_buf));
** __wide_char_to_multi_byte(CP_UTF8, 0, path, -1, path_buf, sizeof(path_buf),
** &nbsp;     NULL, NULL);
** dbsql_temp_directory = dbsql_mprintf("%s", path_buf);
** </pre></blockquote>
*/
DBSQL_EXTERN char *dbsql_temp_directory;

/*
** CAPI3REF: Name Of The Folder Holding Database Files
**
** ^(If this global variable is made to point to a string which is
** the name of a folder (a.k.a. directory), then all database files
** specified with a relative pathname and created or accessed by
** dbsql when using a built-in windows [dbsql_vfs_t | VFS] will be assumed
** to be relative to that directory.)^ ^If this variable is a NULL
** pointer, then dbsql assumes that all database files specified
** with a relative pathname are relative to the current directory
** for the process.  Only the windows VFS makes use of this global
** variable; it is ignored by the unix VFS.
**
** Changing the value of this variable while a database connection is
** open can result in a corrupt database.
**
** It is not safe to read or modify this variable in more than one
** thread at a time.  It is not safe to read or modify this variable
** if a [database connection] is being used at the same time in a separate
** thread.
** It is intended that this variable be set once
** as part of process initialization and before any dbsql interface
** routines have been called and that this variable remain unchanged
** thereafter.
**
** ^The [data_store_directory pragma] may modify this variable and cause
** it to point to memory obtained from [dbsql_malloc].  ^Furthermore,
** the [data_store_directory pragma] always assumes that any string
** that this variable points to is held in memory obtained from
** [dbsql_malloc] and the pragma may attempt to free that memory
** using [dbsql_free].
** Hence, if this variable is modified directly, either it should be
** made NULL or made to point to memory obtained from [dbsql_malloc]
** or else the use of the [data_store_directory pragma] should be avoided.
*/
DBSQL_EXTERN char *dbsql_data_directory;

/*
** CAPI3REF: Win32 Specific Interface
**
** These interfaces are available only on Windows.  The
** [dbsql_win32_set_directory] interface is used to set the value associated
** with the [dbsql_temp_directory] or [dbsql_data_directory] variable, to
** value, depending on the value of the type parameter.  The value parameter
** should be NULL to cause the previous value to be freed via [dbsql_free];
** a non-NULL value will be copied into memory obtained from [dbsql_malloc]
** prior to being used.  The [dbsql_win32_set_directory] interface returns
** [DBSQL_OK] to indicate success, [DBSQL_ERROR] if the type is unsupported,
** or [DBSQL_NOMEM] if memory could not be allocated.  The value of the
** [dbsql_data_directory] variable is intended to act as a replacement for
** the current directory on the sub-platforms of Win32 where that concept is
** not present, e.g. __win_rt and UWP.  The [dbsql_win32_set_directory8] and
** [dbsql_win32_set_directory16] interfaces behave exactly the same as the
** dbsql_win32_set_directory interface except the string parameter must be
** UTF-8 or UTF-16, respectively.
*/
int dbsql_win32_set_directory(
  unsigned long type, /* Identifier for directory being set or reset */
  void *value        /* New value for directory being set or reset */
);
int dbsql_win32_set_directory8(unsigned long type, const char *value);
int dbsql_win32_set_directory16(unsigned long type, const void *value);

/*
** CAPI3REF: Win32 Directory Types
**
** These macros are only available on Windows.  They define the allowed values
** for the type argument to the [dbsql_win32_set_directory] interface.
*/
#define DBSQL_WIN32_DATA_DIRECTORY_TYPE  1
#define DBSQL_WIN32_TEMP_DIRECTORY_TYPE  2

/*
** CAPI3REF: Test For Auto-Commit shell_mode_t
** KEYWORDS: {autocommit mode}
** METHOD: DBSQL
**
** ^The dbsql_get_autocommit() interface returns non-zero or
** zero if the given database connection is or is not in autocommit mode,
** respectively.  ^Autocommit mode is on by default.
** ^Autocommit mode is disabled by a [BEGIN] statement.
** ^Autocommit mode is re-enabled by a [COMMIT] or [ROLLBACK].
**
** If certain kinds of errors occur on a statement within a multi-statement
** transaction (errors including [DBSQL_FULL], [DBSQL_IOERR],
** [DBSQL_NOMEM], [DBSQL_BUSY], and [DBSQL_INTERRUPT]) then the
** transaction might be rolled back automatically.  The only way to
** find out whether dbsql automatically rolled back the transaction after
** an error is to use this function.
**
** If another thread changes the autocommit status of the database
** connection while this routine is running, then the return value
** is undefined.
*/
int dbsql_get_autocommit(DBSQL*);

/*
** CAPI3REF: Find The Database Handle Of A Prepared Statement
** METHOD: dbsql_stmt_t
**
** ^The dbsql_db_handle interface returns the [database connection] handle
** to which a [prepared statement] belongs.  ^The [database connection]
** returned by dbsql_db_handle is the same [database connection]
** that was the first argument
** to the [dbsql_prepare_v2()] call (or its variants) that was used to
** create the statement in the first place.
*/
DBSQL *dbsql_db_handle(dbsql_stmt_t*);

/*
** CAPI3REF: Return The schema_t Name For A Database Connection
** METHOD: DBSQL
**
** ^The dbsql_db_name(D,N) interface returns a pointer to the schema name
** for the N-th database on database connection D, or a NULL pointer if N is
** out of range.  An N value of 0 means the main database file.  An N of 1 is
** the "temp" schema.  Larger values of N correspond to various ATTACH-ed
** databases.
**
** Space to hold the string that is returned by dbsql_db_name() is managed
** by dbsql itself.  The string might be deallocated by any operation that
** changes the schema, including [ATTACH] or [DETACH] or calls to
** [dbsql_serialize()] or [dbsql_deserialize()], even operations that
** occur on a different thread.  Applications that need to
** remember the string long-term should make their own copy.  Applications that
** are accessing the same database connection simultaneously on multiple
** threads should mutex-protect calls to this API and should make their own
** private copy of the result prior to releasing the mutex.
*/
const char *dbsql_db_name(DBSQL *db, int N);

/*
** CAPI3REF: Return The Filename For A Database Connection
** METHOD: DBSQL
**
** ^The dbsql_db_filename(D,N) interface returns a pointer to the filename
** associated with database N of connection D.
** ^If there is no attached database N on the database
** connection D, or if database N is a temporary or in-memory database, then
** this function will return either a NULL pointer or an empty string.
**
** ^The string value returned by this routine is owned and managed by
** the database connection.  ^The value will be valid until the database N
** is [DETACH]-ed or until the database connection closes.
**
** ^The filename returned by this function is the output of the
** full_pathname method of the [VFS].  ^In other words, the filename
** will be an absolute pathname, even if the filename used
** to open the database originally was a URI or relative pathname.
**
** If the filename pointer returned by this routine is not NULL, then it
** can be used as the filename input parameter to these routines:
** <ul>
** <li> [dbsql_uri_parameter()]
** <li> [dbsql_uri_boolean()]
** <li> [dbsql_uri_int64()]
** <li> [dbsql_filename_database()]
** <li> [dbsql_filename_journal()]
** <li> [dbsql_filename_wal()]
** </ul>
*/
dbsql_filename_t dbsql_db_filename(DBSQL *db, const char *db_name);

/*
** CAPI3REF: Determine if a database is read-only
** METHOD: DBSQL
**
** ^The dbsql_db_readonly(D,N) interface returns 1 if the database N
** of connection D is read-only, 0 if it is read/write, or -1 if N is not
** the name of a database on connection D.
*/
int dbsql_db_readonly(DBSQL *db, const char *db_name);

/*
** CAPI3REF: Determine the transaction state of a database
** METHOD: DBSQL
**
** ^The dbsql_txn_state(D,S) interface returns the current
** [transaction state] of schema S in database connection D.  ^If S is NULL,
** then the highest transaction state of any schema on database connection D
** is returned.  Transaction states are (in order of lowest to highest):
** <ol>
** <li value="0"> DBSQL_TXN_NONE
** <li value="1"> DBSQL_TXN_READ
** <li value="2"> DBSQL_TXN_WRITE
** </ol>
** ^If the S argument to dbsql_txn_state(D,S) is not the name of
** a valid schema, then -1 is returned.
*/
int dbsql_txn_state(DBSQL*,const char *schema);

/*
** CAPI3REF: Allowed return values from dbsql_txn_state()
** KEYWORDS: {transaction state}
**
** These constants define the current transaction state of a database file.
** ^The [dbsql_txn_state(D,S)] interface returns one of these
** constants in order to describe the transaction state of schema S
** in [database connection] D.
**
** <dl>
** [[DBSQL_TXN_NONE]] <dt>DBSQL_TXN_NONE</dt>
** <dd>The DBSQL_TXN_NONE state means that no transaction is currently
** pending.</dd>
**
** [[DBSQL_TXN_READ]] <dt>DBSQL_TXN_READ</dt>
** <dd>The DBSQL_TXN_READ state means that the database is currently
** in a read transaction.  Content has been read from the database file
** but nothing in the database file has changed.  The transaction state
** will be advanced to DBSQL_TXN_WRITE if any changes occur and there are
** no other conflicting concurrent write transactions.  The transaction
** state will revert to DBSQL_TXN_NONE following a [ROLLBACK] or
** [COMMIT].</dd>
**
** [[DBSQL_TXN_WRITE]] <dt>DBSQL_TXN_WRITE</dt>
** <dd>The DBSQL_TXN_WRITE state means that the database is currently
** in a write transaction.  Content has been written to the database file
** but has not yet committed.  The transaction state will change to
** DBSQL_TXN_NONE at the next [ROLLBACK] or [COMMIT].</dd>
*/
#define DBSQL_TXN_NONE  0
#define DBSQL_TXN_READ  1
#define DBSQL_TXN_WRITE 2

/*
** CAPI3REF: Find the next prepared statement
** METHOD: DBSQL
**
** ^This interface returns a pointer to the next [prepared statement] after
** stmt associated with the [database connection] db.  ^If stmt is NULL
** then this interface returns a pointer to the first prepared statement
** associated with the database connection db.  ^If no prepared statement
** satisfies the conditions of this routine, it returns NULL.
**
** The [database connection] pointer D in a call to
** [dbsql_next_stmt(D,S)] must refer to an open database
** connection and in particular must not be a NULL pointer.
*/
dbsql_stmt_t *dbsql_next_stmt(DBSQL *db, dbsql_stmt_t *stmt);

/*
** CAPI3REF: Commit And Rollback Notification Callbacks
** METHOD: DBSQL
**
** ^The dbsql_commit_hook() interface registers a callback
** function to be invoked whenever a transaction is [COMMIT | committed].
** ^Any callback set by a previous call to dbsql_commit_hook()
** for the same database connection is overridden.
** ^The dbsql_rollback_hook() interface registers a callback
** function to be invoked whenever a transaction is [ROLLBACK | rolled back].
** ^Any callback set by a previous call to dbsql_rollback_hook()
** for the same database connection is overridden.
** ^The arg argument is passed through to the callback.
** ^If the callback on a commit hook function returns non-zero,
** then the commit is converted into a rollback.
**
** ^The dbsql_commit_hook(D,C,P) and dbsql_rollback_hook(D,C,P) functions
** return the P argument from the previous call of the same function
** on the same [database connection] D, or NULL for
** the first call for each function on D.
**
** The commit and rollback hook callbacks are not reentrant.
** The callback implementation must not do anything that will modify
** the database connection that invoked the callback.  Any actions
** to modify the database connection must be deferred until after the
** completion of the [dbsql_step()] call that triggered the commit
** or rollback hook in the first place.
** Note that running any other SQL statements, including SELECT statements,
** or merely calling [dbsql_prepare_v2()] and [dbsql_step()] will modify
** the database connections for the meaning of "modify" in this paragraph.
**
** ^Registering a NULL function disables the callback.
**
** ^When the commit hook callback routine returns zero, the [COMMIT]
** operation is allowed to continue normally.  ^If the commit hook
** returns non-zero, then the [COMMIT] is converted into a [ROLLBACK].
** ^The rollback hook is invoked on a rollback that results from a commit
** hook returning non-zero, just as it would be with any other rollback.
**
** ^For the purposes of this API, a transaction is said to have been
** rolled back if an explicit "ROLLBACK" statement is executed, or
** an error or constraint causes an implicit rollback to occur.
** ^The rollback callback is not invoked if a transaction is
** automatically rolled back because the database connection is closed.
**
** See also the [dbsql_update_hook()] interface.
*/
void *dbsql_commit_hook(DBSQL*, int(*)(void*), void*);
void *dbsql_rollback_hook(DBSQL*, void(*)(void *), void*);

/*
** CAPI3REF: Autovacuum Compaction Amount Callback
** METHOD: DBSQL
**
** ^The dbsql_autovacuum_pages(D,C,P,X) interface registers a callback
** function C that is invoked prior to each autovacuum of the database
** file.  ^The callback is passed a copy of the generic data pointer (P),
** the schema-name of the attached database that is being autovacuumed,
** the size of the database file in pages, the number of free pages,
** and the number of bytes per page, respectively.  The callback should
** return the number of free pages that should be removed by the
** autovacuum.  ^If the callback returns zero, then no autovacuum happens.
** ^If the value returned is greater than or equal to the number of
** free pages, then a complete autovacuum happens.
**
** <p>^If there are multiple ATTACH-ed database files that are being
** modified as part of a transaction commit, then the autovacuum pages
** callback is invoked separately for each file.
**
** <p><b>The callback is not reentrant.</b> The callback function should
** not attempt to invoke any other dbsql interface.  If it does, bad
** things may happen, including segmentation faults and corrupt database
** files.  The callback function should be a simple function that
** does some arithmetic on its input parameters and returns a result.
**
** ^The X parameter to dbsql_autovacuum_pages(D,C,P,X) is an optional
** destructor for the P parameter.  ^If X is not NULL, then X(P) is
** invoked whenever the database connection closes or when the callback
** is overwritten by another invocation of dbsql_autovacuum_pages().
**
** <p>^There is only one autovacuum pages callback per database connection.
** ^Each call to the dbsql_autovacuum_pages() interface overrides all
** previous invocations for that database connection.  ^If the callback
** argument (C) to dbsql_autovacuum_pages(D,C,P,X) is a NULL pointer,
** then the autovacuum steps callback is canceled.  The return value
** from dbsql_autovacuum_pages() is normally DBSQL_OK, but might
** be some other error code if something goes wrong.  The current
** implementation will only return DBSQL_OK or DBSQL_MISUSE, but other
** return codes might be added in future releases.
**
** <p>If no autovacuum pages callback is specified (the usual case) or
** a NULL pointer is provided for the callback,
** then the default behavior is to vacuum all free pages.  So, in other
** words, the default behavior is the same as if the callback function
** were something like this:
**
** <blockquote><pre>
** &nbsp;   unsigned int demonstration_autovac_pages_callback(
** &nbsp;     void *client_data,
** &nbsp;     const char *schema,
** &nbsp;     unsigned int n_db_page,
** &nbsp;     unsigned int n_free_page,
** &nbsp;     unsigned int n_byte_per_page
** &nbsp;   ){
** &nbsp;     return n_free_page;
** &nbsp;   }
** </pre></blockquote>
*/
int dbsql_autovacuum_pages(
  DBSQL *db,
  unsigned int(*)(void*,const char*,unsigned int,unsigned int,unsigned int),
  void*,
  void(*)(void*)
);


/*
** CAPI3REF: Data Change Notification Callbacks
** METHOD: DBSQL
**
** ^The dbsql_update_hook() interface registers a callback function
** with the [database connection] identified by the first argument
** to be invoked whenever a row is updated, inserted or deleted in
** a [rowid table].
** ^Any callback set by a previous call to this function
** for the same database connection is overridden.
**
** ^The second argument is a pointer to the function to invoke when a
** row is updated, inserted or deleted in a rowid table.
** ^The update hook is disabled by invoking dbsql_update_hook()
** with a NULL pointer as the second parameter.
** ^The first argument to the callback is a copy of the third argument
** to dbsql_update_hook().
** ^The second callback argument is one of [DBSQL_INSERT], [DBSQL_DELETE],
** or [DBSQL_UPDATE], depending on the operation that caused the callback
** to be invoked.
** ^The third and fourth arguments to the callback contain pointers to the
** database and table name containing the affected row.
** ^The final callback parameter is the [rowid] of the row.
** ^In the case of an update, this is the [rowid] after the update takes place.
**
** ^(The update hook is not invoked when internal system tables are
** modified (i.e. dbsql_sequence).)^
** ^The update hook is not invoked when [WITHOUT ROWID] tables are modified.
**
** ^In the current implementation, the update hook
** is not invoked when conflicting rows are deleted because of an
** [ON CONFLICT | ON CONFLICT REPLACE] clause.  ^Nor is the update hook
** invoked when rows are deleted using the [truncate optimization].
** The exceptions defined in this paragraph might change in a future
** release of dbsql.
**
** Whether the update hook is invoked before or after the
** corresponding change is currently unspecified and may differ
** depending on the type of change. Do not rely on the order of the
** hook call with regards to the final result of the operation which
** triggers the hook.
**
** The update hook implementation must not do anything that will modify
** the database connection that invoked the update hook.  Any actions
** to modify the database connection must be deferred until after the
** completion of the [dbsql_step()] call that triggered the update hook.
** Note that [dbsql_prepare_v2()] and [dbsql_step()] both modify their
** database connections for the meaning of "modify" in this paragraph.
**
** ^The dbsql_update_hook(D,C,P) function
** returns the P argument from the previous call
** on the same [database connection] D, or NULL for
** the first call on D.
**
** See also the [dbsql_commit_hook()], [dbsql_rollback_hook()],
** and [dbsql_preupdate_hook()] interfaces.
*/
void *dbsql_update_hook(
  DBSQL*,
  void(*)(void *,int ,char const *,char const *,int64_t),
  void*
);

/*
** CAPI3REF: Enable Or Disable Shared pager_t Cache
**
** ^(This routine enables or disables the sharing of the database cache
** and schema data structures between [database connection | connections]
** to the same database. Sharing is enabled if the argument is true
** and disabled if the argument is false.)^
**
** This interface is omitted if dbsql is compiled with
** [-DSQLITE_OMIT_SHARED_CACHE].  The [-DSQLITE_OMIT_SHARED_CACHE]
** compile-time option is recommended because the
** [use of shared cache mode is discouraged].
**
** ^Cache sharing is enabled and disabled for an entire process.
** This is a change as of dbsql [version 3.5.0] ([dateof:3.5.0]).
** In prior versions of dbsql,
** sharing was enabled or disabled for each thread separately.
**
** ^(The cache sharing mode set by this interface effects all subsequent
** calls to [dbsql_open()], [dbsql_open_v2()], and [dbsql_open16()].
** Existing database connections continue to use the sharing mode
** that was in effect at the time they were opened.)^
**
** ^(This routine returns [DBSQL_OK] if shared cache was enabled or disabled
** successfully.  An [error code] is returned otherwise.)^
**
** ^Shared cache is disabled by default. It is recommended that it stay
** that way.  In other words, do not use this routine.  This interface
** continues to be provided for historical compatibility, but its use is
** discouraged.  Any use of shared cache is discouraged.  If shared cache
** must be used, it is recommended that shared cache only be enabled for
** individual database connections using the [dbsql_open_v2()] interface
** with the [DBSQL_OPEN_SHAREDCACHE] flag.
**
** Note: This method is disabled on __mac_os X 10.7 and i_os version 5.0
** and will always return DBSQL_MISUSE. On those systems,
** shared cache mode should be enabled per-database connection via
** [dbsql_open_v2()] with [DBSQL_OPEN_SHAREDCACHE].
**
** This interface is threadsafe on processors where writing a
** 32-bit integer is atomic.
**
** See Also:  [dbsql Shared-Cache shell_mode_t]
*/
int dbsql_enable_shared_cache(int);

/*
** CAPI3REF: Attempt To Free Heap Memory
**
** ^The dbsql_release_memory() interface attempts to free N bytes
** of heap memory by deallocating non-essential memory allocations
** held by the database library.   Memory used to cache database
** pages to improve performance is an example of non-essential memory.
** ^dbsql_release_memory() returns the number of bytes actually freed,
** which might be more or less than the amount requested.
** ^The dbsql_release_memory() routine is a no-op returning zero
** if dbsql is not compiled with [DBSQL_ENABLE_MEMORY_MANAGEMENT].
**
** See also: [dbsql_db_release_memory()]
*/
int dbsql_release_memory(int);

/*
** CAPI3REF: Free Memory Used By A Database Connection
** METHOD: DBSQL
**
** ^The dbsql_db_release_memory(D) interface attempts to free as much heap
** memory as possible from database connection D. Unlike the
** [dbsql_release_memory()] interface, this interface is in effect even
** when the [DBSQL_ENABLE_MEMORY_MANAGEMENT] compile-time option is
** omitted.
**
** See also: [dbsql_release_memory()]
*/
int dbsql_db_release_memory(DBSQL*);

/*
** CAPI3REF: Impose A Limit On Heap Size
**
** These interfaces impose limits on the amount of heap memory that will be
** used by all database connections within a single process.
**
** ^The dbsql_soft_heap_limit64() interface sets and/or queries the
** soft limit on the amount of heap memory that may be allocated by dbsql.
** ^dbsql strives to keep heap memory utilization below the soft heap
** limit by reducing the number of pages held in the page cache
** as heap memory usages approaches the limit.
** ^The soft heap limit is "soft" because even though dbsql strives to stay
** below the limit, it will exceed the limit rather than generate
** an [DBSQL_NOMEM] error.  In other words, the soft heap limit
** is advisory only.
**
** ^The dbsql_hard_heap_limit64(N) interface sets a hard upper bound of
** N bytes on the amount of memory that will be allocated.  ^The
** dbsql_hard_heap_limit64(N) interface is similar to
** dbsql_soft_heap_limit64(N) except that memory allocations will fail
** when the hard heap limit is reached.
**
** ^The return value from both dbsql_soft_heap_limit64() and
** dbsql_hard_heap_limit64() is the size of
** the heap limit prior to the call, or negative in the case of an
** error.  ^If the argument N is negative
** then no change is made to the heap limit.  Hence, the current
** size of heap limits can be determined by invoking
** dbsql_soft_heap_limit64(-1) or dbsql_hard_heap_limit(-1).
**
** ^Setting the heap limits to zero disables the heap limiter mechanism.
**
** ^The soft heap limit may not be greater than the hard heap limit.
** ^If the hard heap limit is enabled and if dbsql_soft_heap_limit(N)
** is invoked with a value of N that is greater than the hard heap limit,
** the soft heap limit is set to the value of the hard heap limit.
** ^The soft heap limit is automatically enabled whenever the hard heap
** limit is enabled. ^When dbsql_hard_heap_limit64(N) is invoked and
** the soft heap limit is outside the range of 1..N, then the soft heap
** limit is set to N.  ^Invoking dbsql_soft_heap_limit64(0) when the
** hard heap limit is enabled makes the soft heap limit equal to the
** hard heap limit.
**
** The memory allocation limits can also be adjusted using
** [PRAGMA soft_heap_limit] and [PRAGMA hard_heap_limit].
**
** ^(The heap limits are not enforced in the current implementation
** if one or more of following conditions are true:
**
** <ul>
** <li> The limit value is set to zero.
** <li> Memory accounting is disabled using a combination of the
**      [dbsql_config]([DBSQL_CONFIG_MEMSTATUS],...) start-time option and
**      the [DBSQL_DEFAULT_MEMSTATUS] compile-time option.
** <li> An alternative page cache implementation is specified using
**      [dbsql_config]([DBSQL_CONFIG_PCACHE2],...).
** <li> The page cache allocates from its own memory pool supplied
**      by [dbsql_config]([DBSQL_CONFIG_PAGECACHE],...) rather than
**      from the heap.
** </ul>)^
**
** The circumstances under which dbsql will enforce the heap limits may
** change in future releases of dbsql.
*/
int64_t dbsql_soft_heap_limit64(int64_t N);
int64_t dbsql_hard_heap_limit64(int64_t N);

/*
** CAPI3REF: Deprecated Soft Heap Limit Interface
** DEPRECATED
**
** This is a deprecated version of the [dbsql_soft_heap_limit64()]
** interface.  This routine is provided for historical compatibility
** only.  All new applications should use the
** [dbsql_soft_heap_limit64()] interface rather than this one.
*/
DBSQL_DEPRECATED void dbsql_soft_heap_limit(int N);


/*
** CAPI3REF: Extract Metadata About A column_t Of A table_t
** METHOD: DBSQL
**
** ^(The dbsql_table_column_metadata(X,D,T,C,....) routine returns
** information about column C of table T in database D
** on [database connection] X.)^  ^The dbsql_table_column_metadata()
** interface returns DBSQL_OK and fills in the non-NULL pointers in
** the final five arguments with appropriate values if the specified
** column exists.  ^The dbsql_table_column_metadata() interface returns
** DBSQL_ERROR if the specified column does not exist.
** ^If the column-name parameter to dbsql_table_column_metadata() is a
** NULL pointer, then this routine simply checks for the existence of the
** table and returns DBSQL_OK if the table exists and DBSQL_ERROR if it
** does not.  If the table name parameter T in a call to
** dbsql_table_column_metadata(X,D,T,C,...) is NULL then the result is
** undefined behavior.
**
** ^The column is identified by the second, third and fourth parameters to
** this function. ^(The second parameter is either the name of the database
** (i.e. "main", "temp", or an attached database) containing the specified
** table or NULL.)^ ^If it is NULL, then all attached databases are searched
** for the table using the same algorithm used by the database engine to
** resolve unqualified table references.
**
** ^The third and fourth parameters to this function are the table and column
** name of the desired column, respectively.
**
** ^Metadata is returned by writing to the memory locations passed as the 5th
** and subsequent parameters to this function. ^Any of these arguments may be
** NULL, in which case the corresponding element of metadata is omitted.
**
** ^(<blockquote>
** <table border="1">
** <tr><th> Parameter <th> Output<br>Type <th>  Description
**
** <tr><td> 5th <td> const char* <td> Data type
** <tr><td> 6th <td> const char* <td> Name of default collation sequence
** <tr><td> 7th <td> int         <td> True if column has a NOT NULL constraint
** <tr><td> 8th <td> int         <td> True if column is part of the PRIMARY KEY
** <tr><td> 9th <td> int         <td> True if column is [AUTOINCREMENT]
** </table>
** </blockquote>)^
**
** ^The memory pointed to by the character pointers returned for the
** declaration type and collation sequence is valid until the next
** call to any dbsql API function.
**
** ^If the specified table is actually a view, an [error code] is returned.
**
** ^If the specified column is "rowid", "oid" or "_rowid_" and the table
** is not a [WITHOUT ROWID] table and an
** [INTEGER PRIMARY KEY] column has been explicitly declared, then the output
** parameters are set for the explicitly declared column. ^(If there is no
** [INTEGER PRIMARY KEY] column, then the outputs
** for the [rowid] are set as follows:
**
** <pre>
**     data type: "INTEGER"
**     collation sequence: "BINARY"
**     not null: 0
**     primary key: 1
**     auto increment: 0
** </pre>)^
**
** ^This function causes all database schemas to be read from disk and
** parsed, if that has not already been done, and returns an error if
** any errors are encountered while loading the schema.
*/
int dbsql_table_column_metadata(
  DBSQL *db,                /* Connection handle */
  const char *db_name,        /* Database name or NULL */
  const char *table_name,     /* table_t name */
  const char *column_name,    /* column_t name */
  char const **data_type,    /* OUTPUT: Declared data type */
  char const **coll_seq,     /* OUTPUT: Collation sequence name */
  int *not_null,              /* OUTPUT: True if NOT NULL constraint exists */
  int *primary_key,           /* OUTPUT: True if column part of PK */
  int *autoinc               /* OUTPUT: True if column is auto-increment */
);

/*
** CAPI3REF: Load An Extension
** METHOD: DBSQL
**
** ^This interface loads an dbsql extension library from the named file.
**
** ^The dbsql_load_extension() interface attempts to load an
** [dbsql extension] library contained in the file file.  If
** the file cannot be loaded directly, attempts are made to load
** with various operating-system specific filename extensions added.
** So for example, if "samplelib" cannot be loaded, then names like
** "samplelib.so" or "samplelib.dylib" or "samplelib.dll" might
** be tried also.
**
** ^The entry point is proc.
** ^(proc may be 0, in which case dbsql will try to come up with an
** entry point name on its own.  It first tries "dbsql_extension_init".
** If that does not work, it tries names of the form "dbsql_X_init"
** where X consists of the lower-case equivalent of all ASCII alphabetic
** characters or all ASCII alphanumeric characters in the filename from
** the last "/" to the first following "." and omitting any initial "lib".)^
** ^The dbsql_load_extension() interface returns
** [DBSQL_OK] on success and [DBSQL_ERROR] if something goes wrong.
** ^If an error occurs and errmsg_p is not 0, then the
** [dbsql_load_extension()] interface shall attempt to
** fill *errmsg_p with error message text stored in memory
** obtained from [dbsql_malloc()]. The calling function
** should free this memory by calling [dbsql_free()].
**
** ^Extension loading must be enabled using
** [dbsql_enable_load_extension()] or
** [dbsql_db_config](db,[DBSQL_DBCONFIG_ENABLE_LOAD_EXTENSION],1,NULL)
** prior to calling this API,
** otherwise an error will be returned.
**
** <b>Security warning:</b> It is recommended that the
** [DBSQL_DBCONFIG_ENABLE_LOAD_EXTENSION] method be used to enable only this
** interface.  The use of the [dbsql_enable_load_extension()] interface
** should be avoided.  This will keep the SQL function [load_extension()]
** disabled and prevent SQL injections from giving attackers
** access to extension loading capabilities.
**
** See also the [load_extension() SQL function].
*/
int dbsql_load_extension(
  DBSQL *db,          /* Load the extension into this database connection */
  const char *file,    /* Name of the shared library containing extension */
  const char *proc,    /* Entry point.  Derived from file if 0 */
  char **errmsg_p       /* Put error message here if not 0 */
);

/*
** CAPI3REF: Enable Or Disable Extension Loading
** METHOD: DBSQL
**
** ^So as not to open security holes in older applications that are
** unprepared to deal with [extension loading], and as a means of disabling
** [extension loading] while evaluating user-entered SQL, the following API
** is provided to turn the [dbsql_load_extension()] mechanism on and off.
**
** ^Extension loading is off by default.
** ^Call the dbsql_enable_load_extension() routine with onoff==1
** to turn extension loading on and call it with onoff==0 to turn
** it back off again.
**
** ^This interface enables or disables both the C-API
** [dbsql_load_extension()] and the SQL function [load_extension()].
** ^(Use [dbsql_db_config](db,[DBSQL_DBCONFIG_ENABLE_LOAD_EXTENSION],..)
** to enable or disable only the C-API.)^
**
** <b>Security warning:</b> It is recommended that extension loading
** be enabled using the [DBSQL_DBCONFIG_ENABLE_LOAD_EXTENSION] method
** rather than this interface, so the [load_extension()] SQL function
** remains disabled. This will prevent SQL injections from giving attackers
** access to extension loading capabilities.
*/
int dbsql_enable_load_extension(DBSQL *db, int onoff);

/*
** CAPI3REF: Automatically Load Statically Linked Extensions
**
** ^This interface causes the entry_point() function to be invoked for
** each new [database connection] that is created.  The idea here is that
** entry_point() is the entry point for a statically linked [dbsql extension]
** that is to be automatically loaded into all new database connections.
**
** ^(Even though the function prototype shows that entry_point() takes
** no arguments and returns void, dbsql invokes entry_point() with three
** arguments and expects an integer result as if the signature of the
** entry point were as follows:
**
** <blockquote><pre>
** &nbsp;  int entry_point(
** &nbsp;    DBSQL *db,
** &nbsp;    char **errmsg_p,
** &nbsp;    const struct dbsql_api_routines_t *thunk
** &nbsp;  );
** </pre></blockquote>)^
**
** If the entry_point routine encounters an error, it should make *errmsg_p
** point to an appropriate error message (obtained from [dbsql_mprintf()])
** and return an appropriate [error code].  ^dbsql ensures that *errmsg_p
** is NULL before calling the entry_point().  ^dbsql will invoke
** [dbsql_free()] on *errmsg_p after entry_point() returns.  ^If any
** entry_point() returns an error, the [dbsql_open()], [dbsql_open16()],
** or [dbsql_open_v2()] call that provoked the entry_point() will fail.
**
** ^Calling dbsql_auto_extension(X) with an entry point X that is already
** on the list of automatic extensions is a harmless no-op. ^No entry point
** will be called more than once for each database connection that is opened.
**
** See also: [dbsql_reset_auto_extension()]
** and [dbsql_cancel_auto_extension()]
*/
int dbsql_auto_extension(void(*entry_point)(void));

/*
** CAPI3REF: Cancel Automatic Extension Loading
**
** ^The [dbsql_cancel_auto_extension(X)] interface unregisters the
** initialization routine X that was registered using a prior call to
** [dbsql_auto_extension(X)].  ^The [dbsql_cancel_auto_extension(X)]
** routine returns 1 if initialization routine X was successfully
** unregistered and it returns 0 if X was not on the list of initialization
** routines.
*/
int dbsql_cancel_auto_extension(void(*entry_point)(void));

/*
** CAPI3REF: Reset Automatic Extension Loading
**
** ^This interface disables all automatic extensions previously
** registered using [dbsql_auto_extension()].
*/
void dbsql_reset_auto_extension(void);

/*
** Structures used by the virtual table interface
*/
typedef struct dbsql_vtab_t dbsql_vtab_t;
typedef struct dbsql_index_info_t dbsql_index_info_t;
typedef struct dbsql_vtab_cursor_t dbsql_vtab_cursor_t;
typedef struct dbsql_module_t dbsql_module_t;

/*
** CAPI3REF: Virtual table_t Object
** KEYWORDS: dbsql_module_t {virtual table module}
**
** This structure, sometimes called a "virtual table module",
** defines the implementation of a [virtual table]. 
** This structure consists mostly of methods for the module.
**
** ^A virtual table module is created by filling in a persistent
** instance of this structure and passing a pointer to that instance
** to [dbsql_create_module()] or [dbsql_create_module_v2()].
** ^The registration remains valid until it is replaced by a different
** module or until the [database connection] closes.  The content
** of this structure must not change while it is registered with
** any database connection.
*/
struct dbsql_module_t {
  int i_version;
  int (*create)(DBSQL*, void *aux,
               int argc, const char *const*argv,
               dbsql_vtab_t **pp_v_tab, char**);
  int (*connect)(DBSQL*, void *aux,
               int argc, const char *const*argv,
               dbsql_vtab_t **pp_v_tab, char**);
  int (*best_index)(dbsql_vtab_t *v_tab, dbsql_index_info_t*);
  int (*disconnect)(dbsql_vtab_t *v_tab);
  int (*destroy)(dbsql_vtab_t *v_tab);
  int (*x_open)(dbsql_vtab_t *v_tab, dbsql_vtab_cursor_t **cursor);
  int (*x_close)(dbsql_vtab_cursor_t*);
  int (*filter)(dbsql_vtab_cursor_t*, int idx_num, const char *idx_str,
                int argc, dbsql_value_t **argv);
  int (*next)(dbsql_vtab_cursor_t*);
  int (*eof)(dbsql_vtab_cursor_t*);
  int (*column)(dbsql_vtab_cursor_t*, dbsql_func_t*, int);
  int (*rowid)(dbsql_vtab_cursor_t*, int64_t *rowid);
  int (*update)(dbsql_vtab_t *, int, dbsql_value_t **, int64_t *);
  int (*begin)(dbsql_vtab_t *v_tab);
  int (*x_sync)(dbsql_vtab_t *v_tab);
  int (*commit)(dbsql_vtab_t *v_tab);
  int (*rollback)(dbsql_vtab_t *v_tab);
  int (*find_function)(dbsql_vtab_t *vtab, int n_arg, const char *name,
                       void (**px_func)(dbsql_func_t*,int,dbsql_value_t**),
                       void **arg);
  int (*rename)(dbsql_vtab_t *vtab, const char *z_new);
  /* The methods above are in version 1 of the dbsql_module object. Those
  ** below are for version 2 and greater. */
  int (*savepoint)(dbsql_vtab_t *v_tab, int);
  int (*release)(dbsql_vtab_t *v_tab, int);
  int (*rollback_to)(dbsql_vtab_t *v_tab, int);
  /* The methods above are in versions 1 and 2 of the dbsql_module object.
  ** Those below are for version 3 and greater. */
  int (*shadow_name)(const char*);
  /* The methods above are in versions 1 through 3 of the dbsql_module object.
  ** Those below are for version 4 and greater. */
  int (*integrity)(dbsql_vtab_t *v_tab, const char *schema,
                    const char *tab_name, int m_flags, char **err_p);
};

/*
** CAPI3REF: Virtual table_t Indexing Information
** KEYWORDS: dbsql_index_info_t
**
** The dbsql_index_info_t structure and its substructures is used as part
** of the [virtual table] interface to
** pass information into and receive the reply from the [best_index]
** method of a [virtual table module].  The fields under **Inputs** are the
** inputs to best_index and are read-only.  best_index inserts its
** results into the **Outputs** fields.
**
** ^(The constraints[] array records WHERE clause constraints of the form:
**
** <blockquote>column OP expr</blockquote>
**
** where OP is =, &lt;, &lt;=, &gt;, or &gt;=.)^  ^(The particular operator is
** stored in constraints[].op using one of the
** [DBSQL_INDEX_CONSTRAINT_EQ | DBSQL_INDEX_CONSTRAINT_ values].)^
** ^(The index of the column is stored in
** constraints[].i_column.)^  ^(constraints[].usable is TRUE if the
** expr on the right-hand side can be evaluated (and thus the constraint
** is usable) and false if it cannot.)^
**
** ^The optimizer automatically inverts terms of the form "expr OP column"
** and makes other simplifications to the WHERE clause in an attempt to
** get as many WHERE clause terms into the form shown above as possible.
** ^The constraints[] array only reports WHERE clause terms that are
** relevant to the particular virtual table being queried.
**
** ^Information about the ORDER BY clause is stored in order_bies[].
** ^Each term of order_bies records a column of the ORDER BY clause.
**
** The col_used field indicates which columns of the virtual table may be
** required by the current scan. Virtual table columns are numbered from
** zero in the order in which they appear within the CREATE TABLE statement
** passed to dbsql_declare_vtab(). For the first 63 columns (columns 0-62),
** the corresponding bit is set within the col_used mask if the column may be
** required by dbsql. If the table has at least 64 columns and any column
** to the right of the first 63 is required, then bit 63 of col_used is also
** set. In other words, column i_col may be required if the expression
** (col_used & ((u_int64_t)1 << (i_col>=63 ? 63 : i_col))) evaluates to
** non-zero.
**
** The [best_index] method must fill constraint_usages[] with information
** about what parameters to pass to filter.  ^If argv_index>0 then
** the right-hand side of the corresponding constraints[] is evaluated
** and becomes the argv_index-th entry in argv.  ^(If constraint_usages[].omit
** is true, then the constraint is assumed to be fully handled by the
** virtual table and might not be checked again by the byte code.)^ ^(The
** constraint_usages[].omit flag is an optimization hint. When the omit flag
** is left in its default setting of false, the constraint will always be
** checked separately in byte code.  If the omit flag is changed to true, then
** the constraint may or may not be checked in byte code.  In other words,
** when the omit flag is true there is no guarantee that the constraint will
** not be checked again using byte code.)^
**
** ^The idx_num and idx_str values are recorded and passed into the
** [filter] method.
** ^[dbsql_free()] is used to free idx_str if and only if
** need_to_free_idx_str is true.
**
** ^The order_by_consumed means that output from [filter]/[next] will occur in
** the correct order to satisfy the ORDER BY clause so that no separate
** sorting step is required.
**
** ^The estimated_cost value is an estimate of the cost of a particular
** strategy. A cost of N indicates that the cost of the strategy is similar
** to a linear scan of an dbsql table with N rows. A cost of log(N)
** indicates that the expense of the operation is similar to that of a
** binary search on a unique indexed field of an dbsql table with N rows.
**
** ^The estimated_rows value is an estimate of the number of rows that
** will be returned by the strategy.
**
** The best_index method may optionally populate the idx_flags field with a
** mask of DBSQL_INDEX_SCAN_* flags. One such flag is
** [DBSQL_INDEX_SCAN_HEX], which if set causes the [EXPLAIN QUERY PLAN]
** output to show the idx_num as hex instead of as decimal.  Another flag is
** DBSQL_INDEX_SCAN_UNIQUE, which if set indicates that the query plan will
** return at most one row.
**
** Additionally, if best_index sets the DBSQL_INDEX_SCAN_UNIQUE flag, then
** dbsql also assumes that if a call to the update() method is made as
** part of the same statement to delete or update a virtual table row and the
** implementation returns DBSQL_CONSTRAINT, then there is no need to rollback
** any database changes. In other words, if the update() returns
** DBSQL_CONSTRAINT, the database contents must be exactly as they were
** before update was called. By contrast, if DBSQL_INDEX_SCAN_UNIQUE is not
** set and update returns DBSQL_CONSTRAINT, any database changes made by
** the update method are automatically rolled back by dbsql.
**
** IMPORTANT: The estimated_rows field was added to the dbsql_index_info_t
** structure for dbsql [version 3.8.2] ([dateof:3.8.2]).
** If a virtual table extension is
** used with an dbsql version earlier than 3.8.2, the results of attempting
** to read or write the estimated_rows field are undefined (but are likely
** to include crashing the application). The estimated_rows field should
** therefore only be used if [dbsql_libversion_number()] returns a
** value greater than or equal to 3008002. Similarly, the idx_flags field
** was added for [version 3.9.0] ([dateof:3.9.0]).
** It may therefore only be used if
** dbsql_libversion_number() returns a value greater than or equal to
** 3009000.
*/
struct dbsql_index_info_t {
  /* Inputs */
  int n_constraint;           /* Number of entries in constraints */
  struct dbsql_index_constraint_t {
     int i_column;              /* column_t constrained.  -1 for ROWID */
     unsigned char op;         /* Constraint operator */
     unsigned char usable;     /* True if this constraint is usable */
     int i_term_offset;          /* Used internally - best_index should ignore */
  } *constraints;            /* table_t of WHERE clause constraints */
  int n_order_by;              /* Number of terms in the ORDER BY clause */
  struct dbsql_index_orderby_t {
     int i_column;              /* column_t number */
     unsigned char desc;       /* True for DESC.  False for ASC. */
  } *order_bies;               /* The ORDER BY clause */
  /* Outputs */
  struct dbsql_index_constraint_usage_t {
    int argv_index;           /* if >0, constraint is part of argv to filter */
    unsigned char omit;      /* Do not code a test for this constraint */
  } *constraint_usages;
  int idx_num;                /* Number used to identify the index */
  char *idx_str;              /* String, possibly obtained from dbsql_malloc */
  int need_to_free_idx_str;      /* Free idx_str using dbsql_free() if true */
  int order_by_consumed;       /* True if output is already ordered */
  double estimated_cost;           /* Estimated cost of using this index */
  /* Fields below are only available in dbsql 3.8.2 and later */
  int64_t estimated_rows;    /* Estimated number of rows returned */
  /* Fields below are only available in dbsql 3.9.0 and later */
  int idx_flags;              /* Mask of DBSQL_INDEX_SCAN_* flags */
  /* Fields below are only available in dbsql 3.10.0 and later */
  u_int64_t col_used;    /* Input: Mask of columns used by statement */
};

/*
** CAPI3REF: Virtual table_t Scan Flags
**
** Virtual table implementations are allowed to set the
** [dbsql_index_info_t].idx_flags field to some combination of
** these bits.
*/
#define DBSQL_INDEX_SCAN_UNIQUE 0x00000001 /* Scan visits at most 1 row */
#define DBSQL_INDEX_SCAN_HEX    0x00000002 /* Display idx_num as hex */
                                            /* in EXPLAIN QUERY PLAN */

/*
** CAPI3REF: Virtual table_t Constraint Operator Codes
**
** These macros define the allowed values for the
** [dbsql_index_info_t].constraints[].op field.  Each value represents
** an operator that is part of a constraint term in the WHERE clause of
** a query that uses a [virtual table].
**
** ^The left-hand operand of the operator is given by the corresponding
** constraints[].i_column field.  ^An i_column of -1 indicates the left-hand
** operand is the rowid.
** The DBSQL_INDEX_CONSTRAINT_LIMIT and DBSQL_INDEX_CONSTRAINT_OFFSET
** operators have no left-hand operand, and so for those operators the
** corresponding constraints[].i_column is meaningless and should not be
** used.
**
** All operator values from DBSQL_INDEX_CONSTRAINT_FUNCTION through
** value 255 are reserved to represent functions that are overloaded
** by the [find_function|find_function method] of the virtual table
** implementation.
**
** The right-hand operands for each constraint might be accessible using
** the [dbsql_vtab_rhs_value()] interface.  Usually the right-hand
** operand is only available if it appears as a single constant literal
** in the input SQL.  If the right-hand operand is another column or an
** expression (even a constant expression) or a parameter, then the
** dbsql_vtab_rhs_value() probably will not be able to extract it.
** ^The DBSQL_INDEX_CONSTRAINT_ISNULL and
** DBSQL_INDEX_CONSTRAINT_ISNOTNULL operators have no right-hand operand
** and hence calls to dbsql_vtab_rhs_value() for those operators will
** always return DBSQL_NOTFOUND.
**
** The collating sequence to be used for comparison can be found using
** the [dbsql_vtab_collation()] interface.  For most real-world virtual
** tables, the collating sequence of constraints does not matter (for example
** because the constraints are numeric) and so the dbsql_vtab_collation()
** interface is not commonly needed.
*/
#define DBSQL_INDEX_CONSTRAINT_EQ          2
#define DBSQL_INDEX_CONSTRAINT_GT          4
#define DBSQL_INDEX_CONSTRAINT_LE          8
#define DBSQL_INDEX_CONSTRAINT_LT         16
#define DBSQL_INDEX_CONSTRAINT_GE         32
#define DBSQL_INDEX_CONSTRAINT_MATCH      64
#define DBSQL_INDEX_CONSTRAINT_LIKE       65
#define DBSQL_INDEX_CONSTRAINT_GLOB       66
#define DBSQL_INDEX_CONSTRAINT_REGEXP     67
#define DBSQL_INDEX_CONSTRAINT_NE         68
#define DBSQL_INDEX_CONSTRAINT_ISNOT      69
#define DBSQL_INDEX_CONSTRAINT_ISNOTNULL  70
#define DBSQL_INDEX_CONSTRAINT_ISNULL     71
#define DBSQL_INDEX_CONSTRAINT_IS         72
#define DBSQL_INDEX_CONSTRAINT_LIMIT      73
#define DBSQL_INDEX_CONSTRAINT_OFFSET     74
#define DBSQL_INDEX_CONSTRAINT_FUNCTION  150

/*
** CAPI3REF: Register A Virtual table_t Implementation
** METHOD: DBSQL
**
** ^These routines are used to register a new [virtual table module] name.
** ^module_def_t names must be registered before
** creating a new [virtual table] using the module and before using a
** preexisting [virtual table] for the module.
**
** ^The module name is registered on the [database connection] specified
** by the first parameter.  ^The name of the module is given by the
** second parameter.  ^The third parameter is a pointer to
** the implementation of the [virtual table module].   ^The fourth
** parameter is an arbitrary client data pointer that is passed through
** into the [create] and [connect] methods of the virtual table module
** when a new virtual table is being created or reinitialized.
**
** ^The dbsql_create_module_v2() interface has a fifth parameter which
** is a pointer to a destructor for the client_data.  ^dbsql will
** invoke the destructor function (if it is not NULL) when dbsql
** no longer needs the client_data pointer.  ^The destructor will also
** be invoked if the call to dbsql_create_module_v2() fails.
** ^The dbsql_create_module()
** interface is equivalent to dbsql_create_module_v2() with a NULL
** destructor.
**
** ^If the third parameter (the pointer to the dbsql_module_t object) is
** NULL then no new module is created and any existing modules with the
** same name are dropped.
**
** See also: [dbsql_drop_modules()]
*/
int dbsql_create_module(
  DBSQL *db,               /* dbsql connection to register module with */
  const char *name,         /* Name of the module */
  const dbsql_module_t *p,   /* Methods for the module */
  void *client_data          /* Client data for create/connect */
);
int dbsql_create_module_v2(
  DBSQL *db,               /* dbsql connection to register module with */
  const char *name,         /* Name of the module */
  const dbsql_module_t *p,   /* Methods for the module */
  void *client_data,         /* Client data for create/connect */
  void(*destroy)(void*)     /* module_def_t destructor function */
);

/*
** CAPI3REF: Remove Unnecessary Virtual table_t Implementations
** METHOD: DBSQL
**
** ^The dbsql_drop_modules(D,L) interface removes all virtual
** table modules from database connection D except those named on list L.
** The L parameter must be either NULL or a pointer to an array of pointers
** to strings where the array is terminated by a single NULL pointer.
** ^If the L parameter is NULL, then all virtual table modules are removed.
**
** See also: [dbsql_create_module()]
*/
int dbsql_drop_modules(
  DBSQL *db,                /* Remove modules from this connection */
  const char **keeps         /* Except, do not remove the ones named here */
);

/*
** CAPI3REF: Virtual table_t Instance Object
** KEYWORDS: dbsql_vtab_t
**
** Every [virtual table module] implementation uses a subclass
** of this object to describe a particular instance
** of the [virtual table].  Each subclass will
** be tailored to the specific needs of the module implementation.
** The purpose of this superclass is to define certain fields that are
** common to all module implementations.
**
** ^Virtual tables methods can set an error message by assigning a
** string obtained from [dbsql_mprintf()] to errmsg.  The method should
** take care that any prior string is freed by a call to [dbsql_free()]
** prior to assigning a new string to errmsg.  ^After the error message
** is delivered up to the client application, the string will be automatically
** freed by dbsql_free() and the errmsg field will be zeroed.
*/
struct dbsql_vtab_t {
  const dbsql_module_t *module;  /* The module for this virtual table */
  int n_ref;                       /* Number of open cursors */
  char *errmsg;                  /* Error message from dbsql_mprintf() */
  /* Virtual table implementations will typically add additional fields */
};

/*
** CAPI3REF: Virtual table_t Cursor Object
** KEYWORDS: dbsql_vtab_cursor_t {virtual table cursor}
**
** Every [virtual table module] implementation uses a subclass of the
** following structure to describe cursors that point into the
** [virtual table] and are used
** to loop through the virtual table.  Cursors are created using the
** [dbsql_module_t.x_open | x_open] method of the module and are destroyed
** by the [dbsql_module_t.x_close | x_close] method.  Cursors are used
** by the [filter], [next], [eof], [column], and [rowid] methods
** of the module.  Each module implementation will define
** the content of a cursor structure to suit its own needs.
**
** This superclass exists in order to define fields of the cursor that
** are common to all implementations.
*/
struct dbsql_vtab_cursor_t {
  dbsql_vtab_t *vtab;      /* Virtual table of this cursor */
  /* Virtual table implementations will typically add additional fields */
};

/*
** CAPI3REF: Declare The schema_t Of A Virtual table_t
**
** ^The [create] and [connect] methods of a
** [virtual table module] call this interface
** to declare the format (the names and datatypes of the columns) of
** the virtual tables they implement.
*/
int dbsql_declare_vtab(DBSQL*, const char *sql);

/*
** CAPI3REF: Overload A Function For A Virtual table_t
** METHOD: DBSQL
**
** ^(Virtual tables can provide alternative implementations of functions
** using the [find_function] method of the [virtual table module]. 
** But global versions of those functions
** must exist in order to be overloaded.)^
**
** ^(This API makes sure a global version of a function with a particular
** name and number of parameters exists.  If no such function exists
** before this API is called, a new function is created.)^  ^The implementation
** of the new function always causes an exception to be thrown.  So
** the new function is not good for anything by itself.  Its only
** purpose is to be a placeholder function that can be overloaded
** by a [virtual table].
*/
int dbsql_overload_function(DBSQL*, const char *func_name, int n_arg);

/*
** CAPI3REF: A Handle To An Open BLOB
** KEYWORDS: {BLOB handle} {BLOB handles}
**
** An instance of this object represents an open BLOB on which
** [dbsql_blob_open | incremental BLOB I/O] can be performed.
** ^Objects of this type are created by [dbsql_blob_open()]
** and destroyed by [dbsql_blob_close()].
** ^The [dbsql_blob_read()] and [dbsql_blob_write()] interfaces
** can be used to read or write small subsections of the BLOB.
** ^The [dbsql_blob_bytes()] interface returns the size of the BLOB in bytes.
*/
typedef struct dbsql_blob_t dbsql_blob_t;

/*
** CAPI3REF: Open A BLOB For Incremental I/O
** METHOD: DBSQL
** CONSTRUCTOR: dbsql_blob_t
**
** ^(This interfaces opens a [BLOB handle | handle] to the BLOB located
** in row i_row, column column, table table in database db;
** in other words, the same BLOB that would be selected by:
**
** <pre>
**     SELECT column FROM db.table WHERE [rowid] = i_row;
** </pre>)^
**
** ^(Parameter db is not the filename that contains the database, but
** rather the symbolic name of the database. For attached databases, this is
** the name that appears after the AS keyword in the [ATTACH] statement.
** For the main database file, the database name is "main". For TEMP
** tables, the database name is "temp".)^
**
** ^If the flags parameter is non-zero, then the BLOB is opened for read
** and write access. ^If the flags parameter is zero, the BLOB is opened for
** read-only access.
**
** ^(On success, [DBSQL_OK] is returned and the new [BLOB handle] is stored
** in *blob. Otherwise an [error code] is returned and, unless the error
** code is DBSQL_MISUSE, *blob is set to NULL.)^ ^This means that, provided
** the API is not misused, it is always safe to call [dbsql_blob_close()]
** on *blob after this function returns.
**
** This function fails with DBSQL_ERROR if any of the following are true:
** <ul>
**   <li> ^(Database db does not exist)^,
**   <li> ^(table_t table does not exist within database db)^,
**   <li> ^(table_t table is a WITHOUT ROWID table)^,
**   <li> ^(column_t column does not exist)^,
**   <li> ^(Row i_row is not present in the table)^,
**   <li> ^(The specified column of row i_row contains a value that is not
**         a TEXT or BLOB value)^,
**   <li> ^(column_t column is part of an index, PRIMARY KEY or UNIQUE
**         constraint and the blob is being opened for read/write access)^,
**   <li> ^([foreign key constraints | Foreign key constraints] are enabled,
**         column column is part of a [child key] definition and the blob is
**         being opened for read/write access)^.
** </ul>
**
** ^Unless it returns DBSQL_MISUSE, this function sets the
** [database connection] error code and message accessible via
** [dbsql_errcode()] and [dbsql_errmsg()] and related functions.
**
** A BLOB referenced by dbsql_blob_open() may be read using the
** [dbsql_blob_read()] interface and modified by using
** [dbsql_blob_write()].  The [BLOB handle] can be moved to a
** different row of the same table using the [dbsql_blob_reopen()]
** interface.  However, the column, table, or database of a [BLOB handle]
** cannot be changed after the [BLOB handle] is opened.
**
** ^(If the row that a BLOB handle points to is modified by an
** [UPDATE], [DELETE], or by [ON CONFLICT] side-effects
** then the BLOB handle is marked as "expired".
** This is true if any column of the row is changed, even a column
** other than the one the BLOB handle is open on.)^
** ^Calls to [dbsql_blob_read()] and [dbsql_blob_write()] for
** an expired BLOB handle fail with a return code of [DBSQL_ABORT].
** ^(Changes written into a BLOB prior to the BLOB expiring are not
** rolled back by the expiration of the BLOB.  Such changes will eventually
** commit if the transaction continues to completion.)^
**
** ^Use the [dbsql_blob_bytes()] interface to determine the size of
** the opened blob.  ^The size of a blob may not be changed by this
** interface.  Use the [UPDATE] SQL command to change the size of a
** blob.
**
** ^The [dbsql_bind_zeroblob()] and [dbsql_result_zeroblob()] interfaces
** and the built-in [zeroblob] SQL function may be used to create a
** zero-filled blob to read or write using the incremental-blob interface.
**
** To avoid a resource leak, every open [BLOB handle] should eventually
** be released by a call to [dbsql_blob_close()].
**
** See also: [dbsql_blob_close()],
** [dbsql_blob_reopen()], [dbsql_blob_read()],
** [dbsql_blob_bytes()], [dbsql_blob_write()].
*/
int dbsql_blob_open(
  DBSQL*,
  const char *db,
  const char *table,
  const char *column,
  int64_t i_row,
  int flags,
  dbsql_blob_t **blob
);

/*
** CAPI3REF: Move a BLOB Handle to a New Row
** METHOD: dbsql_blob_t
**
** ^This function is used to move an existing [BLOB handle] so that it points
** to a different row of the same database table. ^The new row is identified
** by the rowid value passed as the second argument. Only the row can be
** changed. ^The database, table and column on which the blob handle is open
** remain the same. Moving an existing [BLOB handle] to a new row is
** faster than closing the existing handle and opening a new one.
**
** ^(The new row must meet the same criteria as for [dbsql_blob_open()] -
** it must exist and there must be either a blob or text value stored in
** the nominated column.)^ ^If the new row is not present in the table, or if
** it does not contain a blob or text value, or if another error occurs, an
** dbsql error code is returned and the blob handle is considered aborted.
** ^All subsequent calls to [dbsql_blob_read()], [dbsql_blob_write()] or
** [dbsql_blob_reopen()] on an aborted blob handle immediately return
** DBSQL_ABORT. ^Calling [dbsql_blob_bytes()] on an aborted blob handle
** always returns zero.
**
** ^This function sets the database handle error code and message.
*/
int dbsql_blob_reopen(dbsql_blob_t *, int64_t);

/*
** CAPI3REF: Close A BLOB Handle
** DESTRUCTOR: dbsql_blob_t
**
** ^This function closes an open [BLOB handle]. ^(The BLOB handle is closed
** unconditionally.  Even if this routine returns an error code, the
** handle is still closed.)^
**
** ^If the blob handle being closed was opened for read-write access, and if
** the database is in auto-commit mode and there are no other open read-write
** blob handles or active write statements, the current transaction is
** committed. ^If an error occurs while committing the transaction, an error
** code is returned and the transaction rolled back.
**
** Calling this function with an argument that is not a NULL pointer or an
** open blob handle results in undefined behavior. ^Calling this routine
** with a null pointer (such as would be returned by a failed call to
** [dbsql_blob_open()]) is a harmless no-op. ^Otherwise, if this function
** is passed a valid open blob handle, the values returned by the
** dbsql_errcode() and dbsql_errmsg() functions are set before returning.
*/
int dbsql_blob_close(dbsql_blob_t *);

/*
** CAPI3REF: Return The Size Of An Open BLOB
** METHOD: dbsql_blob_t
**
** ^Returns the size in bytes of the BLOB accessible via the
** successfully opened [BLOB handle] in its only argument.  ^The
** incremental blob I/O routines can only read or overwrite existing
** blob content; they cannot change the size of a blob.
**
** This routine only works on a [BLOB handle] which has been created
** by a prior successful call to [dbsql_blob_open()] and which has not
** been closed by [dbsql_blob_close()].  Passing any other pointer in
** to this routine results in undefined and probably undesirable behavior.
*/
int dbsql_blob_bytes(dbsql_blob_t *);

/*
** CAPI3REF: Read Data From A BLOB Incrementally
** METHOD: dbsql_blob_t
**
** ^(This function is used to read data from an open [BLOB handle] into a
** caller-supplied buffer. N bytes of data are copied into buffer Z
** from the open BLOB, starting at offset i_offset.)^
**
** ^If offset i_offset is less than N bytes from the end of the BLOB,
** [DBSQL_ERROR] is returned and no data is read.  ^If N or i_offset is
** less than zero, [DBSQL_ERROR] is returned and no data is read.
** ^The size of the blob (and hence the maximum value of N+i_offset)
** can be determined using the [dbsql_blob_bytes()] interface.
**
** ^An attempt to read from an expired [BLOB handle] fails with an
** error code of [DBSQL_ABORT].
**
** ^(On success, dbsql_blob_read() returns DBSQL_OK.
** Otherwise, an [error code] or an [extended error code] is returned.)^
**
** This routine only works on a [BLOB handle] which has been created
** by a prior successful call to [dbsql_blob_open()] and which has not
** been closed by [dbsql_blob_close()].  Passing any other pointer in
** to this routine results in undefined and probably undesirable behavior.
**
** See also: [dbsql_blob_write()].
*/
int dbsql_blob_read(dbsql_blob_t *, void *Z, int N, int i_offset);

/*
** CAPI3REF: Write Data Into A BLOB Incrementally
** METHOD: dbsql_blob_t
**
** ^(This function is used to write data into an open [BLOB handle] from a
** caller-supplied buffer. N bytes of data are copied from the buffer Z
** into the open BLOB, starting at offset i_offset.)^
**
** ^(On success, dbsql_blob_write() returns DBSQL_OK.
** Otherwise, an  [error code] or an [extended error code] is returned.)^
** ^Unless DBSQL_MISUSE is returned, this function sets the
** [database connection] error code and message accessible via
** [dbsql_errcode()] and [dbsql_errmsg()] and related functions.
**
** ^If the [BLOB handle] passed as the first argument was not opened for
** writing (the flags parameter to [dbsql_blob_open()] was zero),
** this function returns [DBSQL_READONLY].
**
** This function may only modify the contents of the BLOB; it is
** not possible to increase the size of a BLOB using this API.
** ^If offset i_offset is less than N bytes from the end of the BLOB,
** [DBSQL_ERROR] is returned and no data is written. The size of the
** BLOB (and hence the maximum value of N+i_offset) can be determined
** using the [dbsql_blob_bytes()] interface. ^If N or i_offset are less
** than zero [DBSQL_ERROR] is returned and no data is written.
**
** ^An attempt to write to an expired [BLOB handle] fails with an
** error code of [DBSQL_ABORT].  ^Writes to the BLOB that occurred
** before the [BLOB handle] expired are not rolled back by the
** expiration of the handle, though of course those changes might
** have been overwritten by the statement that expired the BLOB handle
** or by other independent statements.
**
** This routine only works on a [BLOB handle] which has been created
** by a prior successful call to [dbsql_blob_open()] and which has not
** been closed by [dbsql_blob_close()].  Passing any other pointer in
** to this routine results in undefined and probably undesirable behavior.
**
** See also: [dbsql_blob_read()].
*/
int dbsql_blob_write(dbsql_blob_t *, const void *z, int n, int i_offset);

/*
** CAPI3REF: Virtual File System Objects
**
** A virtual filesystem (VFS) is an [dbsql_vfs_t] object
** that dbsql uses to interact
** with the underlying operating system.  Most dbsql builds come with a
** single default VFS that is appropriate for the host computer.
** New VFSes can be registered and existing VFSes can be unregistered.
** The following interfaces are provided.
**
** ^The dbsql_vfs_find() interface returns a pointer to a VFS given its name.
** ^Names are case sensitive.
** ^Names are zero-terminated UTF-8 strings.
** ^If there is no match, a NULL pointer is returned.
** ^If vfs_name is NULL then the default VFS is returned.
**
** ^New VFSes are registered with dbsql_vfs_register().
** ^Each new VFS becomes the default VFS if the make_dflt flag is set.
** ^The same VFS can be registered multiple times without injury.
** ^To make an existing VFS into the default VFS, register it again
** with the make_dflt flag set.  If two different VFSes with the
** same name are registered, the behavior is undefined.  If a
** VFS is registered with a name that is NULL or an empty string,
** then the behavior is undefined.
**
** ^Unregister a VFS with the dbsql_vfs_unregister() interface.
** ^(If the default VFS is unregistered, another VFS is chosen as
** the default.  The choice for the new VFS is arbitrary.)^
*/
dbsql_vfs_t *dbsql_vfs_find(const char *vfs_name);
int dbsql_vfs_register(dbsql_vfs_t*, int make_dflt);
int dbsql_vfs_unregister(dbsql_vfs_t*);

/*
** CAPI3REF: Mutexes
**
** The dbsql core uses these routines for thread
** synchronization. Though they are intended for internal
** use by dbsql, code that links against dbsql is
** permitted to use any of these routines.
**
** The dbsql source code contains multiple implementations
** of these mutex routines.  An appropriate implementation
** is selected automatically at compile-time.  The following
** implementations are available in the dbsql core:
**
** <ul>
** <li>   DBSQL_MUTEX_PTHREADS
** <li>   DBSQL_MUTEX_W32
** <li>   DBSQL_MUTEX_NOOP
** </ul>
**
** The DBSQL_MUTEX_NOOP implementation is a set of routines
** that does no real locking and is appropriate for use in
** a single-threaded application.  The DBSQL_MUTEX_PTHREADS and
** DBSQL_MUTEX_W32 implementations are appropriate for use on Unix
** and Windows.
**
**
** ^The dbsql_mutex_alloc() routine allocates a new
** mutex and returns a pointer to it. ^The dbsql_mutex_alloc()
** routine returns NULL if it is unable to allocate the requested
** mutex.  The argument to dbsql_mutex_alloc() must be one of these
** integer constants:
**
** <ul>
** <li>  DBSQL_MUTEX_FAST
** <li>  DBSQL_MUTEX_RECURSIVE
** <li>  DBSQL_MUTEX_STATIC_MAIN
** <li>  DBSQL_MUTEX_STATIC_MEM
** <li>  DBSQL_MUTEX_STATIC_OPEN
** <li>  DBSQL_MUTEX_STATIC_PRNG
** <li>  DBSQL_MUTEX_STATIC_LRU
** <li>  DBSQL_MUTEX_STATIC_PMEM
** <li>  DBSQL_MUTEX_STATIC_APP1
** <li>  DBSQL_MUTEX_STATIC_APP2
** <li>  DBSQL_MUTEX_STATIC_APP3
** <li>  DBSQL_MUTEX_STATIC_VFS1
** <li>  DBSQL_MUTEX_STATIC_VFS2
** <li>  DBSQL_MUTEX_STATIC_VFS3
** </ul>
**
** ^The first two constants (DBSQL_MUTEX_FAST and DBSQL_MUTEX_RECURSIVE)
** cause dbsql_mutex_alloc() to create
** a new mutex.  ^The new mutex is recursive when DBSQL_MUTEX_RECURSIVE
** is used but not necessarily so when DBSQL_MUTEX_FAST is used.
** The mutex implementation does not need to make a distinction
** between DBSQL_MUTEX_RECURSIVE and DBSQL_MUTEX_FAST if it does
** not want to.  dbsql will only request a recursive mutex in
** cases where it really needs one.  If a faster non-recursive mutex
** implementation is available on the host platform, the mutex subsystem
** might return such a mutex in response to DBSQL_MUTEX_FAST.
**
** ^The other allowed parameters to dbsql_mutex_alloc() (anything other
** than DBSQL_MUTEX_FAST and DBSQL_MUTEX_RECURSIVE) each return
** a pointer to a static preexisting mutex.  ^Nine static mutexes are
** used by the current version of dbsql.  Future versions of dbsql
** may add additional static mutexes.  Static mutexes are for internal
** use by dbsql only.  Applications that use dbsql mutexes should
** use only the dynamic mutexes returned by DBSQL_MUTEX_FAST or
** DBSQL_MUTEX_RECURSIVE.
**
** ^Note that if one of the dynamic mutex parameters (DBSQL_MUTEX_FAST
** or DBSQL_MUTEX_RECURSIVE) is used then dbsql_mutex_alloc()
** returns a different mutex on every call.  ^For the static
** mutex types, the same mutex is returned on every call that has
** the same type number.
**
** ^The dbsql_mutex_free() routine deallocates a previously
** allocated dynamic mutex.  Attempting to deallocate a static
** mutex results in undefined behavior.
**
** ^The dbsql_mutex_enter() and dbsql_mutex_try() routines attempt
** to enter a mutex.  ^If another thread is already within the mutex,
** dbsql_mutex_enter() will block and dbsql_mutex_try() will return
** DBSQL_BUSY.  ^The dbsql_mutex_try() interface returns [DBSQL_OK]
** upon successful entry.  ^(Mutexes created using
** DBSQL_MUTEX_RECURSIVE can be entered multiple times by the same thread.
** In such cases, the
** mutex must be exited an equal number of times before another thread
** can enter.)^  If the same thread tries to enter any mutex other
** than an DBSQL_MUTEX_RECURSIVE more than once, the behavior is undefined.
**
** ^(Some systems (for example, Windows 95) do not support the operation
** implemented by dbsql_mutex_try().  On those systems, dbsql_mutex_try()
** will always return DBSQL_BUSY. In most cases the dbsql core only uses
** dbsql_mutex_try() as an optimization, so this is acceptable
** behavior. The exceptions are unix builds that set the 
** DBSQL_ENABLE_SETLK_TIMEOUT build option. In that case a working
** dbsql_mutex_try() is required.)^
**
** ^The dbsql_mutex_leave() routine exits a mutex that was
** previously entered by the same thread.   The behavior
** is undefined if the mutex is not currently entered by the
** calling thread or is not currently allocated.
**
** ^If the argument to dbsql_mutex_enter(), dbsql_mutex_try(),
** dbsql_mutex_leave(), or dbsql_mutex_free() is a NULL pointer,
** then any of the four routines behaves as a no-op.
**
** See also: [dbsql_mutex_held()] and [dbsql_mutex_notheld()].
*/
dbsql_mutex_t *dbsql_mutex_alloc(int);
void dbsql_mutex_free(dbsql_mutex_t*);
void dbsql_mutex_enter(dbsql_mutex_t*);
int dbsql_mutex_try(dbsql_mutex_t*);
void dbsql_mutex_leave(dbsql_mutex_t*);

/*
** CAPI3REF: Mutex Methods Object
**
** An instance of this structure defines the low-level routines
** used to allocate and use mutexes.
**
** Usually, the default mutex implementations provided by dbsql are
** sufficient, however the application has the option of substituting a custom
** implementation for specialized deployments or systems for which dbsql
** does not provide a suitable implementation. In this case, the application
** creates and populates an instance of this structure to pass
** to dbsql_config() along with the [DBSQL_CONFIG_MUTEX] option.
** Additionally, an instance of this structure can be used as an
** output variable when querying the system for the current mutex
** implementation, using the [DBSQL_CONFIG_GETMUTEX] option.
**
** ^The mutex_init method defined by this structure is invoked as
** part of system initialization by the dbsql_initialize() function.
** ^The mutex_init routine is called by dbsql exactly once for each
** effective call to [dbsql_initialize()].
**
** ^The mutex_end method defined by this structure is invoked as
** part of system shutdown by the dbsql_shutdown() function. The
** implementation of this method is expected to release all outstanding
** resources obtained by the mutex methods implementation, especially
** those obtained by the mutex_init method.  ^The mutex_end()
** interface is invoked exactly once for each call to [dbsql_shutdown()].
**
** ^(The remaining seven methods defined by this structure (mutex_alloc,
** mutex_free, mutex_enter, mutex_try, mutex_leave, mutex_held and
** mutex_notheld) implement the following interfaces (respectively):
**
** <ul>
**   <li>  [dbsql_mutex_alloc()] </li>
**   <li>  [dbsql_mutex_free()] </li>
**   <li>  [dbsql_mutex_enter()] </li>
**   <li>  [dbsql_mutex_try()] </li>
**   <li>  [dbsql_mutex_leave()] </li>
**   <li>  [dbsql_mutex_held()] </li>
**   <li>  [dbsql_mutex_notheld()] </li>
** </ul>)^
**
** The only difference is that the public dbsql_XXX functions enumerated
** above silently ignore any invocations that pass a NULL pointer instead
** of a valid mutex handle. The implementations of the methods defined
** by this structure are not required to handle this case. The results
** of passing a NULL pointer instead of a valid mutex handle are undefined
** (i.e. it is acceptable to provide an implementation that segfaults if
** it is passed a NULL pointer).
**
** The mutex_init() method must be threadsafe.  It must be harmless to
** invoke mutex_init() multiple times within the same process and without
** intervening calls to mutex_end().  Second and subsequent calls to
** mutex_init() must be no-ops.
**
** mutex_init() must not use dbsql memory allocation ([dbsql_malloc()]
** and its associates).  Similarly, mutex_alloc() must not use dbsql memory
** allocation for a static mutex.  ^However mutex_alloc() may use dbsql
** memory allocation for a fast or recursive mutex.
**
** ^dbsql will invoke the mutex_end() method when [dbsql_shutdown()] is
** called, but only if the prior call to mutex_init returned DBSQL_OK.
** If mutex_init fails in any way, it is expected to clean up after itself
** prior to returning.
*/
typedef struct dbsql_mutex_methods_t dbsql_mutex_methods_t;
struct dbsql_mutex_methods_t {
  int (*mutex_init)(void);
  int (*mutex_end)(void);
  dbsql_mutex_t *(*mutex_alloc)(int);
  void (*mutex_free)(dbsql_mutex_t *);
  void (*mutex_enter)(dbsql_mutex_t *);
  int (*mutex_try)(dbsql_mutex_t *);
  void (*mutex_leave)(dbsql_mutex_t *);
  int (*mutex_held)(dbsql_mutex_t *);
  int (*mutex_notheld)(dbsql_mutex_t *);
};

/*
** CAPI3REF: Mutex Verification Routines
**
** The dbsql_mutex_held() and dbsql_mutex_notheld() routines
** are intended for use inside assert() statements.  The dbsql core
** never uses these routines except inside an assert() and applications
** are advised to follow the lead of the core.  The dbsql core only
** provides implementations for these routines when it is compiled
** with the DBSQL_DEBUG flag.  External mutex implementations
** are only required to provide these routines if DBSQL_DEBUG is
** defined and if NDEBUG is not defined.
**
** These routines should return true if the mutex in their argument
** is held or not held, respectively, by the calling thread.
**
** The implementation is not required to provide versions of these
** routines that actually work. If the implementation does not provide working
** versions of these routines, it should at least provide stubs that always
** return true so that one does not get spurious assertion failures.
**
** If the argument to dbsql_mutex_held() is a NULL pointer then
** the routine should return 1.   This seems counter-intuitive since
** clearly the mutex cannot be held if it does not exist.  But
** the reason the mutex does not exist is because the build is not
** using mutexes.  And we do not want the assert() containing the
** call to dbsql_mutex_held() to fail, so a non-zero return is
** the appropriate thing to do.  The dbsql_mutex_notheld()
** interface should also return 1 when given a NULL pointer.
*/
#ifndef NDEBUG
int dbsql_mutex_held(dbsql_mutex_t*);
int dbsql_mutex_notheld(dbsql_mutex_t*);
#endif

/*
** CAPI3REF: Mutex Types
**
** The [dbsql_mutex_alloc()] interface takes a single argument
** which is one of these integer constants.
**
** The set of static mutexes may change from one dbsql release to the
** next.  Applications that override the built-in mutex logic must be
** prepared to accommodate additional static mutexes.
*/
#define DBSQL_MUTEX_FAST             0
#define DBSQL_MUTEX_RECURSIVE        1
#define DBSQL_MUTEX_STATIC_MAIN      2
#define DBSQL_MUTEX_STATIC_MEM       3  /* dbsql_malloc() */
#define DBSQL_MUTEX_STATIC_MEM2      4  /* NOT USED */
#define DBSQL_MUTEX_STATIC_OPEN      4  /* __sm_open() */
#define DBSQL_MUTEX_STATIC_PRNG      5  /* dbsql_randomness() */
#define DBSQL_MUTEX_STATIC_LRU       6  /* lru page list */
#define DBSQL_MUTEX_STATIC_LRU2      7  /* NOT USED */
#define DBSQL_MUTEX_STATIC_PMEM      7  /* __page_malloc() */
#define DBSQL_MUTEX_STATIC_APP1      8  /* For use by application */
#define DBSQL_MUTEX_STATIC_APP2      9  /* For use by application */
#define DBSQL_MUTEX_STATIC_APP3     10  /* For use by application */
#define DBSQL_MUTEX_STATIC_VFS1     11  /* For use by built-in VFS */
#define DBSQL_MUTEX_STATIC_VFS2     12  /* For use by extension VFS */
#define DBSQL_MUTEX_STATIC_VFS3     13  /* For use by application VFS */

/* Legacy compatibility: */
#define DBSQL_MUTEX_STATIC_MASTER    2


/*
** CAPI3REF: Retrieve the mutex for a database connection
** METHOD: DBSQL
**
** ^This interface returns a pointer to the [dbsql_mutex_t] object that
** serializes access to the [database connection] given in the argument
** when the [threading mode] is Serialized.
** ^If the [threading mode] is Single-thread or Multi-thread then this
** routine returns a NULL pointer.
*/
dbsql_mutex_t *dbsql_db_mutex(DBSQL*);

/*
** CAPI3REF: Low-Level Control Of Database Files
** METHOD: DBSQL
** KEYWORDS: {file control}
**
** ^The [dbsql_file_control()] interface makes a direct call to the
** file_control method for the [dbsql_io_methods_t] object associated
** with a particular database identified by the second argument. ^The
** name of the database is "main" for the main database or "temp" for the
** TEMP database, or the name that appears after the AS keyword for
** databases that are added using the [ATTACH] SQL command.
** ^A NULL pointer can be used in place of "main" to refer to the
** main database file.
** ^The third and fourth parameters to this routine
** are passed directly through to the second and third parameters of
** the file_control method.  ^The return value of the file_control
** method becomes the return value of this routine.
**
** A few opcodes for [dbsql_file_control()] are handled directly
** by the dbsql core and never invoke the
** dbsql_io_methods_t.file_control method.
** ^The [DBSQL_FCNTL_FILE_POINTER] value for the op parameter causes
** a pointer to the underlying [dbsql_file_t] object to be written into
** the space pointed to by the 4th parameter.  The
** [DBSQL_FCNTL_JOURNAL_POINTER] works similarly except that it returns
** the [dbsql_file_t] object associated with the journal file instead of
** the main database.  The [DBSQL_FCNTL_VFS_POINTER] opcode returns
** a pointer to the underlying [dbsql_vfs_t] object for the file.
** The [DBSQL_FCNTL_DATA_VERSION] returns the data version counter
** from the pager.
**
** ^If the second parameter (db_name) does not match the name of any
** open database file, then DBSQL_ERROR is returned.  ^This error
** code is not remembered and will not be recalled by [dbsql_errcode()]
** or [dbsql_errmsg()].  The underlying file_control method might
** also return DBSQL_ERROR.  There is no way to distinguish between
** an incorrect db_name and an DBSQL_ERROR return from the underlying
** file_control method.
**
** See also: [file control opcodes]
*/
int dbsql_file_control(DBSQL*, const char *db_name, int op, void*);

/*
** CAPI3REF: Testing Interface
**
** ^The dbsql_test_control() interface is used to read out internal
** state of dbsql and to inject faults into dbsql for testing
** purposes.  ^The first parameter is an operation code that determines
** the number, meaning, and operation of all subsequent parameters.
**
** This interface is not for use by applications.  It exists solely
** for verifying the correct operation of the dbsql library.  Depending
** on how the dbsql library is compiled, this interface might not exist.
**
** The details of the operation codes, their meanings, the parameters
** they take, and what they do are all subject to change without notice.
** Unlike most of the dbsql API, this function is not guaranteed to
** operate consistently from one release to the next.
*/
int dbsql_test_control(int op, ...);

/*
** CAPI3REF: Testing Interface Operation Codes
**
** These constants are the valid operation code parameters used
** as the first argument to [dbsql_test_control()].
**
** These parameters and their meanings are subject to change
** without notice.  These values are for testing purposes only.
** Applications should not use any of these parameters or the
** [dbsql_test_control()] interface.
*/
#define DBSQL_TESTCTRL_FIRST                    5
#define DBSQL_TESTCTRL_PRNG_SAVE                5
#define DBSQL_TESTCTRL_PRNG_RESTORE             6
#define DBSQL_TESTCTRL_PRNG_RESET               7  /* NOT USED */
#define DBSQL_TESTCTRL_FK_NO_ACTION             7
#define DBSQL_TESTCTRL_BITVEC_TEST              8
#define DBSQL_TESTCTRL_FAULT_INSTALL            9
#define DBSQL_TESTCTRL_BENIGN_MALLOC_HOOKS     10
#define DBSQL_TESTCTRL_PENDING_BYTE            11
#define DBSQL_TESTCTRL_ASSERT                  12
#define DBSQL_TESTCTRL_ALWAYS                  13
#define DBSQL_TESTCTRL_RESERVE                 14  /* NOT USED */
#define DBSQL_TESTCTRL_JSON_SELFCHECK          14
#define DBSQL_TESTCTRL_OPTIMIZATIONS           15
#define DBSQL_TESTCTRL_ISKEYWORD               16  /* NOT USED */
#define DBSQL_TESTCTRL_GETOPT                  16
#define DBSQL_TESTCTRL_SCRATCHMALLOC           17  /* NOT USED */
#define DBSQL_TESTCTRL_INTERNAL_FUNCTIONS      17
#define DBSQL_TESTCTRL_LOCALTIME_FAULT         18
#define DBSQL_TESTCTRL_EXPLAIN_STMT            19  /* NOT USED */
#define DBSQL_TESTCTRL_ONCE_RESET_THRESHOLD    19
#define DBSQL_TESTCTRL_NEVER_CORRUPT           20
#define DBSQL_TESTCTRL_VDBE_COVERAGE           21
#define DBSQL_TESTCTRL_BYTEORDER               22
#define DBSQL_TESTCTRL_ISINIT                  23
#define DBSQL_TESTCTRL_SORTER_MMAP             24
#define DBSQL_TESTCTRL_IMPOSTER                25
#define DBSQL_TESTCTRL_PARSER_COVERAGE         26
#define DBSQL_TESTCTRL_RESULT_INTREAL          27
#define DBSQL_TESTCTRL_PRNG_SEED               28
#define DBSQL_TESTCTRL_EXTRA_SCHEMA_CHECKS     29
#define DBSQL_TESTCTRL_SEEK_COUNT              30
#define DBSQL_TESTCTRL_TRACEFLAGS              31
#define DBSQL_TESTCTRL_TUNE                    32
#define DBSQL_TESTCTRL_LOGEST                  33
#define DBSQL_TESTCTRL_USELONGDOUBLE           34  /* NOT USED */
#define DBSQL_TESTCTRL_ATOF                    34
#define DBSQL_TESTCTRL_LAST                    34  /* Largest TESTCTRL */

/*
** CAPI3REF: SQL Keyword Checking
**
** These routines provide access to the set of SQL language keywords
** recognized by dbsql.  Applications can use these routines to determine
** whether or not a specific identifier needs to be escaped (for example,
** by enclosing in double-quotes) so as not to confuse the parser.
**
** The dbsql_keyword_count() interface returns the number of distinct
** keywords understood by dbsql.
**
** The dbsql_keyword_name(N,Z,L) interface finds the 0-based N-th keyword and
** makes *Z point to that keyword expressed as UTF8 and writes the number
** of bytes in the keyword into *L.  The string that *Z points to is not
** zero-terminated.  The dbsql_keyword_name(N,Z,L) routine returns
** DBSQL_OK if N is within bounds and DBSQL_ERROR if not. If either Z
** or L are NULL or invalid pointers then calls to
** dbsql_keyword_name(N,Z,L) result in undefined behavior.
**
** The dbsql_keyword_check(Z,L) interface checks to see whether or not
** the L-byte UTF8 identifier that Z points to is a keyword, returning non-zero
** if it is and zero if not.
**
** The parser used by dbsql is forgiving.  It is often possible to use
** a keyword as an identifier as long as such use does not result in a
** parsing ambiguity.  For example, the statement
** "CREATE TABLE BEGIN(REPLACE,PRAGMA,END);" is accepted by dbsql, and
** creates a new table named "BEGIN" with three columns named
** "REPLACE", "PRAGMA", and "END".  Nevertheless, best practice is to avoid
** using keywords as identifiers.  Common techniques used to avoid keyword
** name collisions include:
** <ul>
** <li> Put all identifier names inside double-quotes.  This is the official
**      SQL way to escape identifier names.
** <li> Put identifier names inside &#91;...&#93;.  This is not standard SQL,
**      but it is what SQL Server does and so lots of programmers use this
**      technique.
** <li> Begin every identifier with the letter "Z" as no SQL keywords start
**      with "Z".
** <li> Include a digit somewhere in every identifier name.
** </ul>
**
** Note that the number of keywords understood by dbsql can depend on
** compile-time options.  For example, "VACUUM" is not a keyword if
** dbsql is compiled with the [-DSQLITE_OMIT_VACUUM] option.  Also,
** new keywords may be added to future releases of dbsql.
*/
int dbsql_keyword_count(void);
int dbsql_keyword_name(int,const char**,int*);
int dbsql_keyword_check(const char*,int);

/*
** CAPI3REF: Dynamic String Object
** KEYWORDS: {dynamic string}
**
** An instance of the dbsql_str_t object contains a dynamically-sized
** string under construction.
**
** The lifecycle of an dbsql_str_t object is as follows:
** <ol>
** <li> ^The dbsql_str_t object is created using [dbsql_str_new()].
** <li> ^Text is appended to the dbsql_str_t object using various
** methods, such as [dbsql_str_appendf()].
** <li> ^The dbsql_str_t object is destroyed and the string it created
** is returned using the [dbsql_str_finish()] interface.
** </ol>
*/
typedef struct dbsql_str_t dbsql_str_t;

/*
** CAPI3REF: Create A New Dynamic String Object
** CONSTRUCTOR: dbsql_str_t
**
** ^The [dbsql_str_new(D)] interface allocates and initializes
** a new [dbsql_str_t] object.  To avoid memory leaks, the object returned by
** [dbsql_str_new()] must be freed by a subsequent call to
** [dbsql_str_finish(X)].
**
** ^The [dbsql_str_new(D)] interface always returns a pointer to a
** valid [dbsql_str_t] object, though in the event of an out-of-memory
** error the returned object might be a special singleton that will
** silently reject new text, always return DBSQL_NOMEM from
** [dbsql_str_errcode()], always return 0 for
** [dbsql_str_length()], and always return NULL from
** [dbsql_str_finish(X)].  It is always safe to use the value
** returned by [dbsql_str_new(D)] as the dbsql_str_t parameter
** to any of the other [dbsql_str_t] methods.
**
** The D parameter to [dbsql_str_new(D)] may be NULL.  If the
** D parameter in [dbsql_str_new(D)] is not NULL, then the maximum
** length of the string contained in the [dbsql_str_t] object will be
** the value set for [dbsql_limit](D,[DBSQL_LIMIT_LENGTH]) instead
** of [DBSQL_MAX_LENGTH].
*/
dbsql_str_t *dbsql_str_new(DBSQL*);

/*
** CAPI3REF: Finalize A Dynamic String
** DESTRUCTOR: dbsql_str_t
**
** ^The [dbsql_str_finish(X)] interface destroys the dbsql_str_t object X
** and returns a pointer to a memory buffer obtained from [dbsql_malloc64()]
** that contains the constructed string.  The calling application should
** pass the returned value to [dbsql_free()] to avoid a memory leak.
** ^The [dbsql_str_finish(X)] interface may return a NULL pointer if any
** errors were encountered during construction of the string.  ^The
** [dbsql_str_finish(X)] interface might also return a NULL pointer if the
** string in [dbsql_str_t] object X is zero bytes long.
**
** ^The [dbsql_str_free(X)] interface destroys both the dbsql_str_t object
** X and the string content it contains.  Calling dbsql_str_free(X) is
** the equivalent of calling [dbsql_free](dbsql_str_finish(X)).
*/
char *dbsql_str_finish(dbsql_str_t*);
void dbsql_str_free(dbsql_str_t*);

/*
** CAPI3REF: Add Content To A Dynamic String
** METHOD: dbsql_str_t
**
** These interfaces add or remove content to an dbsql_str_t object
** previously obtained from [dbsql_str_new()].
**
** ^The [dbsql_str_appendf(X,F,...)] and
** [dbsql_str_vappendf(X,F,V)] interfaces uses the [built-in printf]
** functionality of dbsql to append formatted text onto the end of
** [dbsql_str_t] object X.
**
** ^The [dbsql_str_append(X,S,N)] method appends exactly N bytes from string S
** onto the end of the [dbsql_str_t] object X.  N must be non-negative.
** S must contain at least N non-zero bytes of content.  To append a
** zero-terminated string in its entirety, use the [dbsql_str_appendall()]
** method instead.
**
** ^The [dbsql_str_appendall(X,S)] method appends the complete content of
** zero-terminated string S onto the end of [dbsql_str_t] object X.
**
** ^The [dbsql_str_appendchar(X,N,C)] method appends N copies of the
** single-byte character C onto the end of [dbsql_str_t] object X.
** ^This method can be used, for example, to add whitespace indentation.
**
** ^The [dbsql_str_reset(X)] method resets the string under construction
** inside [dbsql_str_t] object X back to zero bytes in length.
**
** ^The [dbsql_str_truncate(X,N)] method changes the length of the string
** under construction to be N bytes or less.  This routine is a no-op if
** N is negative or if the string is already N bytes or smaller in size.
**
** These methods do not return a result code.  ^If an error occurs, that fact
** is recorded in the [dbsql_str_t] object and can be recovered by a
** subsequent call to [dbsql_str_errcode(X)].
*/
void dbsql_str_appendf(dbsql_str_t*, const char *format, ...);
void dbsql_str_vappendf(dbsql_str_t*, const char *format, va_list);
void dbsql_str_append(dbsql_str_t*, const char *in, int N);
void dbsql_str_appendall(dbsql_str_t*, const char *in);
void dbsql_str_appendchar(dbsql_str_t*, int N, char C);
void dbsql_str_reset(dbsql_str_t*);
void dbsql_str_truncate(dbsql_str_t*,int N);

/*
** CAPI3REF: Status Of A Dynamic String
** METHOD: dbsql_str_t
**
** These interfaces return the current status of an [dbsql_str_t] object.
**
** ^If any prior errors have occurred while constructing the dynamic string
** in dbsql_str_t X, then the [dbsql_str_errcode(X)] method will return
** an appropriate error code.  ^The [dbsql_str_errcode(X)] method returns
** [DBSQL_NOMEM] following any out-of-memory error, or
** [DBSQL_TOOBIG] if the size of the dynamic string exceeds
** [DBSQL_MAX_LENGTH], or [DBSQL_OK] if there have been no errors.
**
** ^The [dbsql_str_length(X)] method returns the current length, in bytes,
** of the dynamic string under construction in [dbsql_str_t] object X.
** ^The length returned by [dbsql_str_length(X)] does not include the
** zero-termination byte.
**
** ^The [dbsql_str_value(X)] method returns a pointer to the current
** content of the dynamic string under construction in X.  The value
** returned by [dbsql_str_value(X)] is managed by the dbsql_str_t object X
** and might be freed or altered by any subsequent method on the same
** [dbsql_str_t] object.  Applications must not use the pointer returned by
** [dbsql_str_value(X)] after any subsequent method call on the same
** object.  ^Applications may change the content of the string returned
** by [dbsql_str_value(X)] as long as they do not write into any bytes
** outside the range of 0 to [dbsql_str_length(X)] and do not read or
** write any byte after any subsequent dbsql_str_t method call.
*/
int dbsql_str_errcode(dbsql_str_t*);
int dbsql_str_length(dbsql_str_t*);
char *dbsql_str_value(dbsql_str_t*);

/*
** CAPI3REF: dbsql Runtime Status
**
** ^These interfaces are used to retrieve runtime status information
** about the performance of dbsql, and optionally to reset various
** highwater marks.  ^The first argument is an integer code for
** the specific parameter to measure.  ^(Recognized integer codes
** are of the form [status parameters | DBSQL_STATUS_...].)^
** ^The current value of the parameter is returned into *current.
** ^The highest recorded value is returned in *highwater.  ^If the
** reset_flag is true, then the highest record value is reset after
** *highwater is written.  ^(Some parameters do not record the highest
** value.  For those parameters
** nothing is written into *highwater and the reset_flag is ignored.)^
** ^(Other parameters record only the highwater mark and not the current
** value.  For these latter parameters nothing is written into *current.)^
**
** ^The dbsql_status() and dbsql_status64() routines return
** DBSQL_OK on success and a non-zero [error code] on failure.
**
** If either the current value or the highwater mark is too large to
** be represented by a 32-bit integer, then the values returned by
** dbsql_status() are undefined.
**
** See also: [dbsql_db_status()]
*/
int dbsql_status(int op, int *current, int *highwater, int reset_flag);
int dbsql_status64(
  int op,
  int64_t *current,
  int64_t *highwater,
  int reset_flag
);


/*
** CAPI3REF: Status Parameters
** KEYWORDS: {status parameters}
**
** These integer constants designate various run-time status parameters
** that can be returned by [dbsql_status()].
**
** <dl>
** [[DBSQL_STATUS_MEMORY_USED]] ^(<dt>DBSQL_STATUS_MEMORY_USED</dt>
** <dd>This parameter is the current amount of memory checked out
** using [dbsql_malloc()], either directly or indirectly.  The
** figure includes calls made to [dbsql_malloc()] by the application
** and internal memory usage by the dbsql library.  Auxiliary page-cache
** memory controlled by [DBSQL_CONFIG_PAGECACHE] is not included in
** this parameter.  The amount returned is the sum of the allocation
** sizes as reported by the size method in [dbsql_mem_methods_t].</dd>)^
**
** [[DBSQL_STATUS_MALLOC_SIZE]] ^(<dt>DBSQL_STATUS_MALLOC_SIZE</dt>
** <dd>This parameter records the largest memory allocation request
** handed to [dbsql_malloc()] or [dbsql_realloc()] (or their
** internal equivalents).  Only the value returned in the
** *highwater parameter to [dbsql_status()] is of interest. 
** The value written into the *current parameter is undefined.</dd>)^
**
** [[DBSQL_STATUS_MALLOC_COUNT]] ^(<dt>DBSQL_STATUS_MALLOC_COUNT</dt>
** <dd>This parameter records the number of separate memory allocations
** currently checked out.</dd>)^
**
** [[DBSQL_STATUS_PAGECACHE_USED]] ^(<dt>DBSQL_STATUS_PAGECACHE_USED</dt>
** <dd>This parameter returns the number of pages used out of the
** [pagecache memory allocator] that was configured using
** [DBSQL_CONFIG_PAGECACHE].  The
** value returned is in pages, not in bytes.</dd>)^
**
** [[DBSQL_STATUS_PAGECACHE_OVERFLOW]]
** ^(<dt>DBSQL_STATUS_PAGECACHE_OVERFLOW</dt>
** <dd>This parameter returns the number of bytes of page cache
** allocation which could not be satisfied by the [DBSQL_CONFIG_PAGECACHE]
** buffer and where forced to overflow to [dbsql_malloc()].  The
** returned value includes allocations that overflowed because they
** were too large (they were larger than the "sz" parameter to
** [DBSQL_CONFIG_PAGECACHE]) and allocations that overflowed because
** no space was left in the page cache.</dd>)^
**
** [[DBSQL_STATUS_PAGECACHE_SIZE]] ^(<dt>DBSQL_STATUS_PAGECACHE_SIZE</dt>
** <dd>This parameter records the largest memory allocation request
** handed to the [pagecache memory allocator].  Only the value returned in the
** *highwater parameter to [dbsql_status()] is of interest. 
** The value written into the *current parameter is undefined.</dd>)^
**
** [[DBSQL_STATUS_SCRATCH_USED]] <dt>DBSQL_STATUS_SCRATCH_USED</dt>
** <dd>No longer used.</dd>
**
** [[DBSQL_STATUS_SCRATCH_OVERFLOW]] ^(<dt>DBSQL_STATUS_SCRATCH_OVERFLOW</dt>
** <dd>No longer used.</dd>
**
** [[DBSQL_STATUS_SCRATCH_SIZE]] <dt>DBSQL_STATUS_SCRATCH_SIZE</dt>
** <dd>No longer used.</dd>
**
** [[DBSQL_STATUS_PARSER_STACK]] ^(<dt>DBSQL_STATUS_PARSER_STACK</dt>
** <dd>The *highwater parameter records the deepest parser stack.
** The *current value is undefined.  The *highwater value is only
** meaningful if dbsql is compiled with [YYTRACKMAXSTACKDEPTH].</dd>)^
** </dl>
**
** New status parameters may be added from time to time.
*/
#define DBSQL_STATUS_MEMORY_USED          0
#define DBSQL_STATUS_PAGECACHE_USED       1
#define DBSQL_STATUS_PAGECACHE_OVERFLOW   2
#define DBSQL_STATUS_SCRATCH_USED         3  /* NOT USED */
#define DBSQL_STATUS_SCRATCH_OVERFLOW     4  /* NOT USED */
#define DBSQL_STATUS_MALLOC_SIZE          5
#define DBSQL_STATUS_PARSER_STACK         6
#define DBSQL_STATUS_PAGECACHE_SIZE       7
#define DBSQL_STATUS_SCRATCH_SIZE         8  /* NOT USED */
#define DBSQL_STATUS_MALLOC_COUNT         9

/*
** CAPI3REF: Database Connection Status
** METHOD: DBSQL
**
** ^This interface is used to retrieve runtime status information
** about a single [database connection].  ^The first argument is the
** database connection object to be interrogated.  ^The second argument
** is an integer constant, taken from the set of
** [DBSQL_DBSTATUS options], that
** determines the parameter to interrogate.  The set of
** [DBSQL_DBSTATUS options] is likely
** to grow in future releases of dbsql.
**
** ^The current value of the requested parameter is written into *cur
** and the highest instantaneous value is written into *hiwtr.  ^If
** the reset_flg is true, then the highest instantaneous value is
** reset back down to the current value.
**
** ^The dbsql_db_status() routine returns DBSQL_OK on success and a
** non-zero [error code] on failure.
**
** ^The dbsql_db_status64(D,O,C,H,R) routine works exactly the same
** way as dbsql_db_status(D,O,C,H,R) routine except that the C and H
** parameters are pointer to 64-bit integers (type: int64_t) instead
** of pointers to 32-bit integers, which allows larger status values
** to be returned.  If a status value exceeds 2,147,483,647 then
** dbsql_db_status() will truncate the value whereas dbsql_db_status64()
** will return the full value.
**
** See also: [dbsql_status()] and [dbsql_stmt_status()].
*/
int dbsql_db_status(DBSQL*, int op, int *cur, int *hiwtr, int reset_flg);
int dbsql_db_status64(DBSQL*,int,int64_t*,int64_t*,int);

/*
** CAPI3REF: Status Parameters for database connections
** KEYWORDS: {DBSQL_DBSTATUS options}
**
** These constants are the available integer "verbs" that can be passed as
** the second argument to the [dbsql_db_status()] interface.
**
** New verbs may be added in future releases of dbsql. Existing verbs
** might be discontinued. Applications should check the return code from
** [dbsql_db_status()] to make sure that the call worked.
** The [dbsql_db_status()] interface will return a non-zero error code
** if a discontinued or unsupported verb is invoked.
**
** <dl>
** [[DBSQL_DBSTATUS_LOOKASIDE_USED]] ^(<dt>DBSQL_DBSTATUS_LOOKASIDE_USED</dt>
** <dd>This parameter returns the number of lookaside memory slots currently
** checked out.</dd>)^
**
** [[DBSQL_DBSTATUS_LOOKASIDE_HIT]] ^(<dt>DBSQL_DBSTATUS_LOOKASIDE_HIT</dt>
** <dd>This parameter returns the number of malloc attempts that were
** satisfied using lookaside memory. Only the high-water value is meaningful;
** the current value is always zero.</dd>)^
**
** [[DBSQL_DBSTATUS_LOOKASIDE_MISS_SIZE]]
** ^(<dt>DBSQL_DBSTATUS_LOOKASIDE_MISS_SIZE</dt>
** <dd>This parameter returns the number of malloc attempts that might have
** been satisfied using lookaside memory but failed due to the amount of
** memory requested being larger than the lookaside slot size.
** Only the high-water value is meaningful;
** the current value is always zero.</dd>)^
**
** [[DBSQL_DBSTATUS_LOOKASIDE_MISS_FULL]]
** ^(<dt>DBSQL_DBSTATUS_LOOKASIDE_MISS_FULL</dt>
** <dd>This parameter returns the number of malloc attempts that might have
** been satisfied using lookaside memory but failed due to all lookaside
** memory already being in use.
** Only the high-water value is meaningful;
** the current value is always zero.</dd>)^
**
** [[DBSQL_DBSTATUS_CACHE_USED]] ^(<dt>DBSQL_DBSTATUS_CACHE_USED</dt>
** <dd>This parameter returns the approximate number of bytes of heap
** memory used by all pager caches associated with the database connection.)^
** ^The highwater mark associated with DBSQL_DBSTATUS_CACHE_USED is always 0.
** </dd>
**
** [[DBSQL_DBSTATUS_CACHE_USED_SHARED]]
** ^(<dt>DBSQL_DBSTATUS_CACHE_USED_SHARED</dt>
** <dd>This parameter is similar to DBSTATUS_CACHE_USED, except that if a
** pager cache is shared between two or more connections the bytes of heap
** memory used by that pager cache is divided evenly between the attached
** connections.)^  In other words, if none of the pager caches associated
** with the database connection are shared, this request returns the same
** value as DBSTATUS_CACHE_USED. Or, if one or more of the pager caches are
** shared, the value returned by this call will be smaller than that returned
** by DBSTATUS_CACHE_USED. ^The highwater mark associated with
** DBSQL_DBSTATUS_CACHE_USED_SHARED is always 0.</dd>
**
** [[DBSQL_DBSTATUS_SCHEMA_USED]] ^(<dt>DBSQL_DBSTATUS_SCHEMA_USED</dt>
** <dd>This parameter returns the approximate number of bytes of heap
** memory used to store the schema for all databases associated
** with the connection - main, temp, and any [ATTACH]-ed databases.)^
** ^The full amount of memory used by the schemas is reported, even if the
** schema memory is shared with other database connections due to
** [shared cache mode] being enabled.
** ^The highwater mark associated with DBSQL_DBSTATUS_SCHEMA_USED is always 0.
** </dd>
**
** [[DBSQL_DBSTATUS_STMT_USED]] ^(<dt>DBSQL_DBSTATUS_STMT_USED</dt>
** <dd>This parameter returns the approximate number of bytes of heap
** and lookaside memory used by all prepared statements associated with
** the database connection.)^
** ^The highwater mark associated with DBSQL_DBSTATUS_STMT_USED is always 0.
** </dd>
**
** [[DBSQL_DBSTATUS_CACHE_HIT]] ^(<dt>DBSQL_DBSTATUS_CACHE_HIT</dt>
** <dd>This parameter returns the number of pager cache hits that have
** occurred.)^ ^The highwater mark associated with DBSQL_DBSTATUS_CACHE_HIT
** is always 0.
** </dd>
**
** [[DBSQL_DBSTATUS_CACHE_MISS]] ^(<dt>DBSQL_DBSTATUS_CACHE_MISS</dt>
** <dd>This parameter returns the number of pager cache misses that have
** occurred.)^ ^The highwater mark associated with DBSQL_DBSTATUS_CACHE_MISS
** is always 0.
** </dd>
**
** [[DBSQL_DBSTATUS_CACHE_WRITE]] ^(<dt>DBSQL_DBSTATUS_CACHE_WRITE</dt>
** <dd>This parameter returns the number of dirty cache entries that have
** been written to disk. Specifically, the number of pages written to the
** wal file in wal mode databases, or the number of pages written to the
** database file in rollback mode databases. Any pages written as part of
** transaction rollback or database recovery operations are not included.
** If an IO or other error occurs while writing a page to disk, the effect
** on subsequent DBSQL_DBSTATUS_CACHE_WRITE requests is undefined.)^ ^The
** highwater mark associated with DBSQL_DBSTATUS_CACHE_WRITE is always 0.
** <p>
** ^(There is overlap between the quantities measured by this parameter
** (DBSQL_DBSTATUS_CACHE_WRITE) and DBSQL_DBSTATUS_TEMPBUF_SPILL.
** Resetting one will reduce the other.)^
** </dd>
**
** [[DBSQL_DBSTATUS_CACHE_SPILL]] ^(<dt>DBSQL_DBSTATUS_CACHE_SPILL</dt>
** <dd>This parameter returns the number of dirty cache entries that have
** been written to disk in the middle of a transaction due to the page
** cache overflowing. Transactions are more efficient if they are written
** to disk all at once. When pages spill mid-transaction, that introduces
** additional overhead. This parameter can be used to help identify
** inefficiencies that can be resolved by increasing the cache size.
** </dd>
**
** [[DBSQL_DBSTATUS_DEFERRED_FKS]] ^(<dt>DBSQL_DBSTATUS_DEFERRED_FKS</dt>
** <dd>This parameter returns zero for the current value if and only if
** all foreign key constraints (deferred or immediate) have been
** resolved.)^  ^The highwater mark is always 0.
**
** [[DBSQL_DBSTATUS_TEMPBUF_SPILL] ^(<dt>DBSQL_DBSTATUS_TEMPBUF_SPILL</dt>
** <dd>^(This parameter returns the number of bytes written to temporary
** files on disk that could have been kept in memory had sufficient memory
** been available.  This value includes writes to intermediate tables that
** are part of complex queries, external sorts that spill to disk, and
** writes to TEMP tables.)^
** ^The highwater mark is always 0.
** <p>
** ^(There is overlap between the quantities measured by this parameter
** (DBSQL_DBSTATUS_TEMPBUF_SPILL) and DBSQL_DBSTATUS_CACHE_WRITE.
** Resetting one will reduce the other.)^
** </dd>
** </dl>
*/
#define DBSQL_DBSTATUS_LOOKASIDE_USED       0
#define DBSQL_DBSTATUS_CACHE_USED           1
#define DBSQL_DBSTATUS_SCHEMA_USED          2
#define DBSQL_DBSTATUS_STMT_USED            3
#define DBSQL_DBSTATUS_LOOKASIDE_HIT        4
#define DBSQL_DBSTATUS_LOOKASIDE_MISS_SIZE  5
#define DBSQL_DBSTATUS_LOOKASIDE_MISS_FULL  6
#define DBSQL_DBSTATUS_CACHE_HIT            7
#define DBSQL_DBSTATUS_CACHE_MISS           8
#define DBSQL_DBSTATUS_CACHE_WRITE          9
#define DBSQL_DBSTATUS_DEFERRED_FKS        10
#define DBSQL_DBSTATUS_CACHE_USED_SHARED   11
#define DBSQL_DBSTATUS_CACHE_SPILL         12
#define DBSQL_DBSTATUS_TEMPBUF_SPILL       13
#define DBSQL_DBSTATUS_MAX                 13   /* Largest defined DBSTATUS */


/*
** CAPI3REF: Prepared Statement Status
** METHOD: dbsql_stmt_t
**
** ^(Each prepared statement maintains various
** [DBSQL_STMTSTATUS counters] that measure the number
** of times it has performed specific operations.)^  These counters can
** be used to monitor the performance characteristics of the prepared
** statements.  For example, if the number of table steps greatly exceeds
** the number of table searches or result rows, that would tend to indicate
** that the prepared statement is using a full table scan rather than
** an index. 
**
** ^(This interface is used to retrieve and reset counter values from
** a [prepared statement].  The first argument is the prepared statement
** object to be interrogated.  The second argument
** is an integer code for a specific [DBSQL_STMTSTATUS counter]
** to be interrogated.)^
** ^The current value of the requested counter is returned.
** ^If the reset_flg is true, then the counter is reset to zero after this
** interface call returns.
**
** See also: [dbsql_status()] and [dbsql_db_status()].
*/
int dbsql_stmt_status(dbsql_stmt_t*, int op,int reset_flg);

/*
** CAPI3REF: Status Parameters for prepared statements
** KEYWORDS: {DBSQL_STMTSTATUS counter} {DBSQL_STMTSTATUS counters}
**
** These preprocessor macros define integer codes that name counter
** values associated with the [dbsql_stmt_status()] interface.
** The meanings of the various counters are as follows:
**
** <dl>
** [[DBSQL_STMTSTATUS_FULLSCAN_STEP]] <dt>DBSQL_STMTSTATUS_FULLSCAN_STEP</dt>
** <dd>^This is the number of times that dbsql has stepped forward in
** a table as part of a full table scan.  Large numbers for this counter
** may indicate opportunities for performance improvement through
** careful use of indices.</dd>
**
** [[DBSQL_STMTSTATUS_SORT]] <dt>DBSQL_STMTSTATUS_SORT</dt>
** <dd>^This is the number of sort operations that have occurred.
** A non-zero value in this counter may indicate an opportunity to
** improve performance through careful use of indices.</dd>
**
** [[DBSQL_STMTSTATUS_AUTOINDEX]] <dt>DBSQL_STMTSTATUS_AUTOINDEX</dt>
** <dd>^This is the number of rows inserted into transient indices that
** were created automatically in order to help joins run faster.
** A non-zero value in this counter may indicate an opportunity to
** improve performance by adding permanent indices that do not
** need to be reinitialized each time the statement is run.</dd>
**
** [[DBSQL_STMTSTATUS_VM_STEP]] <dt>DBSQL_STMTSTATUS_VM_STEP</dt>
** <dd>^This is the number of virtual machine operations executed
** by the prepared statement if that number is less than or equal
** to 2147483647.  The number of virtual machine operations can be
** used as a proxy for the total work done by the prepared statement.
** If the number of virtual machine operations exceeds 2147483647
** then the value returned by this statement status code is undefined.</dd>
**
** [[DBSQL_STMTSTATUS_REPREPARE]] <dt>DBSQL_STMTSTATUS_REPREPARE</dt>
** <dd>^This is the number of times that the prepare statement has been
** automatically regenerated due to schema changes or changes to
** [bound parameters] that might affect the query plan.</dd>
**
** [[DBSQL_STMTSTATUS_RUN]] <dt>DBSQL_STMTSTATUS_RUN</dt>
** <dd>^This is the number of times that the prepared statement has
** been run.  A single "run" for the purposes of this counter is one
** or more calls to [dbsql_step()] followed by a call to [dbsql_reset()].
** The counter is incremented on the first [dbsql_step()] call of each
** cycle.</dd>
**
** [[DBSQL_STMTSTATUS_FILTER_MISS]]
** [[DBSQL_STMTSTATUS_FILTER HIT]]
** <dt>DBSQL_STMTSTATUS_FILTER_HIT<br>
** DBSQL_STMTSTATUS_FILTER_MISS</dt>
** <dd>^DBSQL_STMTSTATUS_FILTER_HIT is the number of times that a join
** step was bypassed because a Bloom filter returned not-found.  The
** corresponding DBSQL_STMTSTATUS_FILTER_MISS value is the number of
** times that the Bloom filter returned a find, and thus the join step
** had to be processed as normal.</dd>
**
** [[DBSQL_STMTSTATUS_MEMUSED]] <dt>DBSQL_STMTSTATUS_MEMUSED</dt>
** <dd>^This is the approximate number of bytes of heap memory
** used to store the prepared statement.  ^This value is not actually
** a counter, and so the reset_flg parameter to dbsql_stmt_status()
** is ignored when the opcode is DBSQL_STMTSTATUS_MEMUSED.
** </dd>
** </dl>
*/
#define DBSQL_STMTSTATUS_FULLSCAN_STEP     1
#define DBSQL_STMTSTATUS_SORT              2
#define DBSQL_STMTSTATUS_AUTOINDEX         3
#define DBSQL_STMTSTATUS_VM_STEP           4
#define DBSQL_STMTSTATUS_REPREPARE         5
#define DBSQL_STMTSTATUS_RUN               6
#define DBSQL_STMTSTATUS_FILTER_MISS       7
#define DBSQL_STMTSTATUS_FILTER_HIT        8
#define DBSQL_STMTSTATUS_MEMUSED           99

/*
** CAPI3REF: Custom Page Cache Object
**
** The dbsql_pcache_t type is opaque.  It is implemented by
** the pluggable module.  The dbsql core has no knowledge of
** its size or internal structure and never deals with the
** dbsql_pcache_t object except by holding and passing pointers
** to the object.
**
** See [dbsql_pcache_methods2_t] for additional information.
*/
typedef struct dbsql_pcache_t dbsql_pcache_t;

/*
** CAPI3REF: Custom Page Cache Object
**
** The dbsql_pcache_page_t object represents a single page in the
** page cache.  The page cache will allocate instances of this
** object.  Various methods of the page cache use pointers to instances
** of this object as parameters or as their return value.
**
** See [dbsql_pcache_methods2_t] for additional information.
*/
typedef struct dbsql_pcache_page_t dbsql_pcache_page_t;
struct dbsql_pcache_page_t {
  void *buf;        /* The content of the page */
  void *extra;      /* Extra information associated with the page */
};

/*
** CAPI3REF: Application Defined Page Cache.
** KEYWORDS: {page cache}
**
** ^(The [dbsql_config]([DBSQL_CONFIG_PCACHE2], ...) interface can
** register an alternative page cache implementation by passing in an
** instance of the dbsql_pcache_methods2_t structure.)^
** In many applications, most of the heap memory allocated by
** dbsql is used for the page cache.
** By implementing a
** custom page cache using this API, an application can better control
** the amount of memory consumed by dbsql, the way in which
** that memory is allocated and released, and the policies used to
** determine exactly which parts of a database file are cached and for
** how long.
**
** The alternative page cache mechanism is an
** extreme measure that is only needed by the most demanding applications.
** The built-in page cache is recommended for most uses.
**
** ^(The contents of the dbsql_pcache_methods2_t structure are copied to an
** internal buffer by dbsql within the call to [dbsql_config].  Hence
** the application may discard the parameter after the call to
** [dbsql_config()] returns.)^
**
** [[the init() page cache method]]
** ^(The init() method is called once for each effective
** call to [dbsql_initialize()])^
** (usually only once during the lifetime of the process). ^(The init()
** method is passed a copy of the dbsql_pcache_methods2_t.arg value.)^
** The intent of the init() method is to set up global data structures
** required by the custom page cache implementation.
** ^(If the init() method is NULL, then the
** built-in default page cache is used instead of the application defined
** page cache.)^
**
** [[the shutdown() page cache method]]
** ^The shutdown() method is called by [dbsql_shutdown()].
** It can be used to clean up
** any outstanding resources before process shutdown, if required.
** ^The shutdown() method may be NULL.
**
** ^dbsql automatically serializes calls to the init method,
** so the init method need not be threadsafe.  ^The
** shutdown method is only called from [dbsql_shutdown()] so it does
** not need to be threadsafe either.  All other methods must be threadsafe
** in multithreaded applications.
**
** ^dbsql will never invoke init() more than once without an intervening
** call to shutdown().
**
** [[the create() page cache methods]]
** ^dbsql invokes the create() method to construct a new cache instance.
** dbsql will typically create one cache instance for each open database file,
** though this is not guaranteed. ^The
** first parameter, sz_page, is the size in bytes of the pages that must
** be allocated by the cache.  ^sz_page will always be a power of two.  ^The
** second parameter sz_extra is a number of bytes of extra storage
** associated with each page cache entry.  ^The sz_extra parameter will be
** a number less than 250.  dbsql will use the
** extra sz_extra bytes on each page to store metadata about the underlying
** database page on disk.  The value passed into sz_extra depends
** on the dbsql version, the target platform, and how dbsql was compiled.
** ^The third argument to create(), purgeable, is true if the cache being
** created will be used to cache database pages of a file stored on disk, or
** false if it is used for an in-memory database. The cache implementation
** does not have to do anything special based upon the value of purgeable;
** it is purely advisory.  ^On a cache where purgeable is false, dbsql will
** never invoke unpin() except to deliberately delete a page.
** ^In other words, calls to unpin() on a cache with purgeable set to
** false will always have the "discard" flag set to true. 
** ^Hence, a cache created with purgeable set to false will
** never contain any unpinned pages.
**
** [[the cachesize() page cache method]]
** ^(The cachesize() method may be called at any time by dbsql to set the
** suggested maximum cache-size (number of pages stored) for the cache
** instance passed as the first argument. This is the value configured using
** the dbsql "[PRAGMA cache_size]" command.)^  As with the purgeable
** parameter, the implementation is not required to do anything with this
** value; it is advisory only.
**
** [[the pagecount() page cache methods]]
** The pagecount() method must return the number of pages currently
** stored in the cache, both pinned and unpinned.
**
** [[the fetch() page cache methods]]
** The fetch() method locates a page in the cache and returns a pointer to
** an dbsql_pcache_page_t object associated with that page, or a NULL pointer.
** The buf element of the returned dbsql_pcache_page_t object will be a
** pointer to a buffer of sz_page bytes used to store the content of a
** single database page.  The extra element of dbsql_pcache_page_t will be
** a pointer to the sz_extra bytes of extra storage that dbsql has requested
** for each entry in the page cache.
**
** The page to be fetched is determined by the key. ^The minimum key value
** is 1.  After it has been retrieved using fetch, the page is considered
** to be "pinned".
**
** If the requested page is already in the page cache, then the page cache
** implementation must return a pointer to the page buffer with its content
** intact.  If the requested page is not already in the cache, then the
** cache implementation should use the value of the create_flag
** parameter to help it determine what action to take:
**
** <table border=1 width=85% align=center>
** <tr><th> create_flag <th> Behavior when page is not already in cache
** <tr><td> 0 <td> Do not allocate a new page.  Return NULL.
** <tr><td> 1 <td> Allocate a new page if it is easy and convenient to do so.
**                 Otherwise return NULL.
** <tr><td> 2 <td> Make every effort to allocate a new page.  Only return
**                 NULL if allocating a new page is effectively impossible.
** </table>
**
** ^(dbsql will normally invoke fetch() with a create_flag of 0 or 1.  dbsql
** will only use a create_flag of 2 after a prior call with a create_flag of 1
** failed.)^  In between the fetch() calls, dbsql may
** attempt to unpin one or more cache pages by spilling the content of
** pinned pages to disk and synching the operating system disk cache.
**
** [[the unpin() page cache method]]
** ^unpin() is called by dbsql with a pointer to a currently pinned page
** as its second argument.  If the third parameter, discard, is non-zero,
** then the page must be evicted from the cache.
** ^If the discard parameter is
** zero, then the page may be discarded or retained at the discretion of the
** page cache implementation. ^The page cache implementation
** may choose to evict unpinned pages at any time.
**
** The cache must not perform any reference counting. A single
** call to unpin() unpins the page regardless of the number of prior calls
** to fetch().
**
** [[the rekey() page cache methods]]
** The rekey() method is used to change the key value associated with the
** page passed as the second argument. If the cache
** previously contains an entry associated with new_key, it must be
** discarded. ^Any prior cache entry associated with new_key is guaranteed not
** to be pinned.
**
** When dbsql calls the truncate() method, the cache must discard all
** existing cache entries with page numbers (keys) greater than or equal
** to the value of the i_limit parameter passed to truncate(). If any
** of these pages are pinned, they become implicitly unpinned, meaning that
** they can be safely discarded.
**
** [[the destroy() page cache method]]
** ^The destroy() method is used to delete a cache allocated by create().
** All resources associated with the specified cache should be freed. ^After
** calling the destroy() method, dbsql considers the [dbsql_pcache_t*]
** handle invalid, and will not use it with any other dbsql_pcache_methods2_t
** functions.
**
** [[the shrink() page cache method]]
** ^dbsql invokes the shrink() method when it wants the page cache to
** free up as much of heap memory as possible.  The page cache implementation
** is not obligated to free any memory, but well-behaved implementations should
** do their best.
*/
typedef struct dbsql_pcache_methods2_t dbsql_pcache_methods2_t;
struct dbsql_pcache_methods2_t {
  int i_version;
  void *arg;
  int (*init)(void*);
  void (*shutdown)(void*);
  dbsql_pcache_t *(*create)(int sz_page, int sz_extra, int purgeable);
  void (*cachesize)(dbsql_pcache_t*, int n_cachesize);
  int (*pagecount)(dbsql_pcache_t*);
  dbsql_pcache_page_t *(*fetch)(dbsql_pcache_t*, unsigned key, int create_flag);
  void (*unpin)(dbsql_pcache_t*, dbsql_pcache_page_t*, int discard);
  void (*rekey)(dbsql_pcache_t*, dbsql_pcache_page_t*,
      unsigned old_key, unsigned new_key);
  void (*truncate)(dbsql_pcache_t*, unsigned i_limit);
  void (*destroy)(dbsql_pcache_t*);
  void (*shrink)(dbsql_pcache_t*);
};

/*
** This is the obsolete pcache_methods object that has now been replaced
** by dbsql_pcache_methods2_t.  This object is not used by dbsql.  It is
** retained in the header file for backwards compatibility only.
*/
typedef struct dbsql_pcache_methods_t dbsql_pcache_methods_t;
struct dbsql_pcache_methods_t {
  void *arg;
  int (*init)(void*);
  void (*shutdown)(void*);
  dbsql_pcache_t *(*create)(int sz_page, int purgeable);
  void (*cachesize)(dbsql_pcache_t*, int n_cachesize);
  int (*pagecount)(dbsql_pcache_t*);
  void *(*fetch)(dbsql_pcache_t*, unsigned key, int create_flag);
  void (*unpin)(dbsql_pcache_t*, void*, int discard);
  void (*rekey)(dbsql_pcache_t*, void*, unsigned old_key, unsigned new_key);
  void (*truncate)(dbsql_pcache_t*, unsigned i_limit);
  void (*destroy)(dbsql_pcache_t*);
};


/*
** CAPI3REF: Online Backup Object
**
** The dbsql_backup_t object records state information about an ongoing
** online backup operation.  ^The dbsql_backup_t object is created by
** a call to [dbsql_backup_init()] and is destroyed by a call to
** [dbsql_backup_finish()].
**
** See Also: [Using the dbsql Online Backup API]
*/
typedef struct dbsql_backup_t dbsql_backup_t;

/*
** CAPI3REF: Online Backup API.
**
** The backup API copies the content of one database into another.
** It is useful either for creating backups of databases or
** for copying in-memory databases to or from persistent files.
**
** See Also: [Using the dbsql Online Backup API]
**
** ^dbsql holds a write transaction open on the destination database file
** for the duration of the backup operation.
** ^The source database is read-locked only while it is being read;
** it is not locked continuously for the entire backup operation.
** ^Thus, the backup may be performed on a live source database without
** preventing other database connections from
** reading or writing to the source database while the backup is underway.
**
** ^(To perform a backup operation:
**   <ol>
**     <li><b>dbsql_backup_init()</b> is called once to initialize the
**         backup,
**     <li><b>dbsql_backup_step()</b> is called one or more times to transfer
**         the data between the two databases, and finally
**     <li><b>dbsql_backup_finish()</b> is called to release all resources
**         associated with the backup operation.
**   </ol>)^
** There should be exactly one call to dbsql_backup_finish() for each
** successful call to dbsql_backup_init().
**
** [[dbsql_backup_init()]] <b>dbsql_backup_init()</b>
**
** ^The D and N arguments to dbsql_backup_init(D,N,S,M) are the
** [database connection] associated with the destination database
** and the database name, respectively.
** ^The database name is "main" for the main database, "temp" for the
** temporary database, or the name specified after the AS keyword in
** an [ATTACH] statement for an attached database.
** ^The S and M arguments passed to
** dbsql_backup_init(D,N,S,M) identify the [database connection]
** and database name of the source database, respectively.
** ^The source and destination [database connections] (parameters S and D)
** must be different or else dbsql_backup_init(D,N,S,M) will fail with
** an error.
**
** ^A call to dbsql_backup_init() will fail, returning NULL, if
** there is already a read or read-write transaction open on the
** destination database.
**
** ^If an error occurs within dbsql_backup_init(D,N,S,M), then NULL is
** returned and an error code and error message are stored in the
** destination [database connection] D.
** ^The error code and message for the failed call to dbsql_backup_init()
** can be retrieved using the [dbsql_errcode()], [dbsql_errmsg()], and/or
** [dbsql_errmsg16()] functions.
** ^A successful call to dbsql_backup_init() returns a pointer to an
** [dbsql_backup_t] object.
** ^The [dbsql_backup_t] object may be used with the dbsql_backup_step() and
** dbsql_backup_finish() functions to perform the specified backup
** operation.
**
** [[dbsql_backup_step()]] <b>dbsql_backup_step()</b>
**
** ^Function dbsql_backup_step(B,N) will copy up to N pages between
** the source and destination databases specified by [dbsql_backup_t] object B.
** ^If N is negative, all remaining source pages are copied.
** ^If dbsql_backup_step(B,N) successfully copies N pages and there
** are still more pages to be copied, then the function returns [DBSQL_OK].
** ^If dbsql_backup_step(B,N) successfully finishes copying all pages
** from source to destination, then it returns [DBSQL_DONE].
** ^If an error occurs while running dbsql_backup_step(B,N),
** then an [error code] is returned. ^As well as [DBSQL_OK] and
** [DBSQL_DONE], a call to dbsql_backup_step() may return [DBSQL_READONLY],
** [DBSQL_NOMEM], [DBSQL_BUSY], [DBSQL_LOCKED], or an
** [DBSQL_IOERR_ACCESS | DBSQL_IOERR_XXX] extended error code.
**
** ^(The dbsql_backup_step() might return [DBSQL_READONLY] if
** <ol>
** <li> the destination database was opened read-only, or
** <li> the destination database is using write-ahead-log journaling
** and the destination and source page sizes differ, or
** <li> the destination database is an in-memory database and the
** destination and source page sizes differ.
** </ol>)^
**
** ^If dbsql_backup_step() cannot obtain a required file-system lock, then
** the [dbsql_busy_handler | busy-handler function]
** is invoked (if one is specified). ^If the
** busy-handler returns non-zero before the lock is available, then
** [DBSQL_BUSY] is returned to the caller. ^In this case the call to
** dbsql_backup_step() can be retried later. ^If the source
** [database connection]
** is being used to write to the source database when dbsql_backup_step()
** is called, then [DBSQL_LOCKED] is returned immediately. ^Again, in this
** case the call to dbsql_backup_step() can be retried later on. ^(If
** [DBSQL_IOERR_ACCESS | DBSQL_IOERR_XXX], [DBSQL_NOMEM], or
** [DBSQL_READONLY] is returned, then
** there is no point in retrying the call to dbsql_backup_step(). These
** errors are considered fatal.)^  The application must accept
** that the backup operation has failed and pass the backup operation handle
** to the dbsql_backup_finish() to release associated resources.
**
** ^The first call to dbsql_backup_step() obtains an exclusive lock
** on the destination file. ^The exclusive lock is not released until either
** dbsql_backup_finish() is called or the backup operation is complete
** and dbsql_backup_step() returns [DBSQL_DONE].  ^Every call to
** dbsql_backup_step() obtains a [shared lock] on the source database that
** lasts for the duration of the dbsql_backup_step() call.
** ^Because the source database is not locked between calls to
** dbsql_backup_step(), the source database may be modified mid-way
** through the backup process.  ^If the source database is modified by an
** external process or via a database connection other than the one being
** used by the backup operation, then the backup will be automatically
** restarted by the next call to dbsql_backup_step(). ^If the source
** database is modified by using the same database connection as is used
** by the backup operation, then the backup database is automatically
** updated at the same time.
**
** [[dbsql_backup_finish()]] <b>dbsql_backup_finish()</b>
**
** When dbsql_backup_step() has returned [DBSQL_DONE], or when the
** application wishes to abandon the backup operation, the application
** should destroy the [dbsql_backup_t] by passing it to dbsql_backup_finish().
** ^The dbsql_backup_finish() interfaces releases all
** resources associated with the [dbsql_backup_t] object.
** ^If dbsql_backup_step() has not yet returned [DBSQL_DONE], then any
** active write-transaction on the destination database is rolled back.
** The [dbsql_backup_t] object is invalid
** and may not be used following a call to dbsql_backup_finish().
**
** ^The value returned by dbsql_backup_finish is [DBSQL_OK] if no
** dbsql_backup_step() errors occurred, regardless of whether or not
** dbsql_backup_step() completed.
** ^If an out-of-memory condition or IO error occurred during any prior
** dbsql_backup_step() call on the same [dbsql_backup_t] object, then
** dbsql_backup_finish() returns the corresponding [error code].
**
** ^A return of [DBSQL_BUSY] or [DBSQL_LOCKED] from dbsql_backup_step()
** is not a permanent error and does not affect the return value of
** dbsql_backup_finish().
**
** [[dbsql_backup_remaining()]] [[dbsql_backup_pagecount()]]
** <b>dbsql_backup_remaining() and dbsql_backup_pagecount()</b>
**
** ^The dbsql_backup_remaining() routine returns the number of pages still
** to be backed up at the conclusion of the most recent dbsql_backup_step().
** ^The dbsql_backup_pagecount() routine returns the total number of pages
** in the source database at the conclusion of the most recent
** dbsql_backup_step().
** ^(The values returned by these functions are only updated by
** dbsql_backup_step(). If the source database is modified in a way that
** changes the size of the source database or the number of pages remaining,
** those changes are not reflected in the output of dbsql_backup_pagecount()
** and dbsql_backup_remaining() until after the next
** dbsql_backup_step().)^
**
** <b>Concurrent Usage of Database Handles</b>
**
** ^The source [database connection] may be used by the application for other
** purposes while a backup operation is underway or being initialized.
** ^If dbsql is compiled and configured to support threadsafe database
** connections, then the source database connection may be used concurrently
** from within other threads.
**
** However, the application must guarantee that the destination
** [database connection] is not passed to any other API (by any thread) after
** dbsql_backup_init() is called and before the corresponding call to
** dbsql_backup_finish().  dbsql does not currently check to see
** if the application incorrectly accesses the destination [database connection]
** and so no error code is reported, but the operations may malfunction
** nevertheless.  Use of the destination database connection while a
** backup is in progress might also cause a mutex deadlock.
**
** If running in [shared cache mode], the application must
** guarantee that the shared cache used by the destination database
** is not accessed while the backup is running. In practice this means
** that the application must guarantee that the disk file being
** backed up to is not accessed by any connection within the process,
** not just the specific connection that was passed to dbsql_backup_init().
**
** The [dbsql_backup_t] object itself is partially threadsafe. Multiple
** threads may safely make multiple concurrent calls to dbsql_backup_step().
** However, the dbsql_backup_remaining() and dbsql_backup_pagecount()
** APIs are not strictly speaking threadsafe. If they are invoked at the
** same time as another thread is invoking dbsql_backup_step() it is
** possible that they return invalid values.
**
** <b>Alternatives To Using The Backup API</b>
**
** Other techniques for safely creating a consistent backup of an dbsql
** database include:
**
** <ul>
** <li> The [VACUUM INTO] command.
** <li> The [dbsql_rsync] utility program.
** </ul>
*/
dbsql_backup_t *dbsql_backup_init(
  DBSQL *dest,                        /* Destination database handle */
  const char *dest_name,                 /* Destination database name */
  DBSQL *source,                      /* Source database handle */
  const char *source_name                /* Source database name */
);
int dbsql_backup_step(dbsql_backup_t *p, int n_page);
int dbsql_backup_finish(dbsql_backup_t *p);
int dbsql_backup_remaining(dbsql_backup_t *p);
int dbsql_backup_pagecount(dbsql_backup_t *p);

/*
** CAPI3REF: Unlock Notification
** METHOD: DBSQL
**
** ^When running in shared-cache mode, a database operation may fail with
** an [DBSQL_LOCKED] error if the required locks on the shared-cache or
** individual tables within the shared-cache cannot be obtained. See
** [dbsql Shared-Cache shell_mode_t] for a description of shared-cache locking.
** ^This API may be used to register a callback that dbsql will invoke
** when the connection currently holding the required lock relinquishes it.
** ^This API is only available if the library was compiled with the
** [DBSQL_ENABLE_UNLOCK_NOTIFY] C-preprocessor symbol defined.
**
** See Also: [Using the dbsql Unlock Notification Feature].
**
** ^Shared-cache locks are released when a database connection concludes
** its current transaction, either by committing it or rolling it back.
**
** ^When a connection (known as the blocked connection) fails to obtain a
** shared-cache lock and DBSQL_LOCKED is returned to the caller, the
** identity of the database connection (the blocking connection) that
** has locked the required resource is stored internally. ^After an
** application receives an DBSQL_LOCKED error, it may call the
** dbsql_unlock_notify() method with the blocked connection handle as
** the first argument to register for a callback that will be invoked
** when the blocking connection's current transaction is concluded. ^The
** callback is invoked from within the [dbsql_step] or [dbsql_close]
** call that concludes the blocking connection's transaction.
**
** ^(If dbsql_unlock_notify() is called in a multi-threaded application,
** there is a chance that the blocking connection will have already
** concluded its transaction by the time dbsql_unlock_notify() is invoked.
** If this happens, then the specified callback is invoked immediately,
** from within the call to dbsql_unlock_notify().)^
**
** ^If the blocked connection is attempting to obtain a write-lock on a
** shared-cache table, and more than one other connection currently holds
** a read-lock on the same table, then dbsql arbitrarily selects one of
** the other connections to use as the blocking connection.
**
** ^(There may be at most one unlock-notify callback registered by a
** blocked connection. If dbsql_unlock_notify() is called when the
** blocked connection already has a registered unlock-notify callback,
** then the new callback replaces the old.)^ ^If dbsql_unlock_notify() is
** called with a NULL pointer as its second argument, then any existing
** unlock-notify callback is canceled. ^The blocked connection's
** unlock-notify callback may also be canceled by closing the blocked
** connection using [dbsql_close()].
**
** The unlock-notify callback is not reentrant. If an application invokes
** any dbsql_xxx API functions from within an unlock-notify callback, a
** crash or deadlock may be the result.
**
** ^Unless deadlock is detected (see below), dbsql_unlock_notify() always
** returns DBSQL_OK.
**
** <b>Callback Invocation Details</b>
**
** When an unlock-notify callback is registered, the application provides a
** single void* pointer that is passed to the callback when it is invoked.
** However, the signature of the callback function allows dbsql to pass
** it an array of void* context pointers. The first argument passed to
** an unlock-notify callback is a pointer to an array of void* pointers,
** and the second is the number of entries in the array.
**
** When a blocking connection's transaction is concluded, there may be
** more than one blocked connection that has registered for an unlock-notify
** callback. ^If two or more such blocked connections have specified the
** same callback function, then instead of invoking the callback function
** multiple times, it is invoked once with the set of void* context pointers
** specified by the blocked connections bundled together into an array.
** This gives the application an opportunity to prioritize any actions
** related to the set of unblocked database connections.
**
** <b>Deadlock Detection</b>
**
** Assuming that after registering for an unlock-notify callback a
** database waits for the callback to be issued before taking any further
** action (a reasonable assumption), then using this API may cause the
** application to deadlock. For example, if connection X is waiting for
** connection Y's transaction to be concluded, and similarly connection
** Y is waiting on connection X's transaction, then neither connection
** will proceed and the system may remain deadlocked indefinitely.
**
** To avoid this scenario, the dbsql_unlock_notify() performs deadlock
** detection. ^If a given call to dbsql_unlock_notify() would put the
** system in a deadlocked state, then DBSQL_LOCKED is returned and no
** unlock-notify callback is registered. The system is said to be in
** a deadlocked state if connection A has registered for an unlock-notify
** callback on the conclusion of connection B's transaction, and connection
** B has itself registered for an unlock-notify callback when connection
** A's transaction is concluded. ^Indirect deadlock is also detected, so
** the system is also considered to be deadlocked if connection B has
** registered for an unlock-notify callback on the conclusion of connection
** C's transaction, where connection C is waiting on connection A. ^Any
** number of levels of indirection are allowed.
**
** <b>The "DROP TABLE" Exception</b>
**
** When a call to [dbsql_step()] returns DBSQL_LOCKED, it is almost
** always appropriate to call dbsql_unlock_notify(). There is however,
** one exception. When executing a "DROP TABLE" or "DROP INDEX" statement,
** dbsql checks if there are any currently executing SELECT statements
** that belong to the same connection. If there are, DBSQL_LOCKED is
** returned. In this case there is no "blocking connection", so invoking
** dbsql_unlock_notify() results in the unlock-notify callback being
** invoked immediately. If the application then re-attempts the "DROP TABLE"
** or "DROP INDEX" query, an infinite loop might be the result.
**
** One way around this problem is to check the extended error code returned
** by an dbsql_step() call. ^(If there is a blocking connection, then the
** extended error code is set to DBSQL_LOCKED_SHAREDCACHE. Otherwise, in
** the special "DROP TABLE/INDEX" case, the extended error code is just
** DBSQL_LOCKED.)^
*/
int dbsql_unlock_notify(
  DBSQL *blocked,                          /* Waiting connection */
  void (*notify)(void **args, int n_arg),    /* Callback function to invoke */
  void *notify_arg                            /* Argument to pass to notify */
);


/*
** CAPI3REF: String Comparison
**
** ^The [dbsql_stricmp()] and [dbsql_strnicmp()] APIs allow applications
** and extensions to compare the contents of two buffers containing UTF-8
** strings in a case-independent fashion, using the same definition of "case
** independence" that dbsql uses internally when comparing identifiers.
*/
int dbsql_stricmp(const char *, const char *);
int dbsql_strnicmp(const char *, const char *, int);

/*
** CAPI3REF: String Globbing
*
** ^The [dbsql_strglob(P,X)] interface returns zero if and only if
** string X matches the [GLOB] pattern P.
** ^The definition of [GLOB] pattern matching used in
** [dbsql_strglob(P,X)] is the same as for the "X GLOB P" operator in the
** SQL dialect understood by dbsql.  ^The [dbsql_strglob(P,X)] function
** is case sensitive.
**
** Note that this routine returns zero on a match and non-zero if the strings
** do not match, the same as [dbsql_stricmp()] and [dbsql_strnicmp()].
**
** See also: [dbsql_strlike()].
*/
int dbsql_strglob(const char *glob, const char *str);

/*
** CAPI3REF: String LIKE Matching
*
** ^The [dbsql_strlike(P,X,E)] interface returns zero if and only if
** string X matches the [LIKE] pattern P with escape character E.
** ^The definition of [LIKE] pattern matching used in
** [dbsql_strlike(P,X,E)] is the same as for the "X LIKE P ESCAPE E"
** operator in the SQL dialect understood by dbsql.  ^For "X LIKE P" without
** the ESCAPE clause, set the E parameter of [dbsql_strlike(P,X,E)] to 0.
** ^As with the LIKE operator, the [dbsql_strlike(P,X,E)] function is case
** insensitive - equivalent upper and lower case ASCII characters match
** one another.
**
** ^The [dbsql_strlike(P,X,E)] function matches Unicode characters, though
** only ASCII characters are case folded.
**
** Note that this routine returns zero on a match and non-zero if the strings
** do not match, the same as [dbsql_stricmp()] and [dbsql_strnicmp()].
**
** See also: [dbsql_strglob()].
*/
int dbsql_strlike(const char *glob, const char *str, unsigned int c_esc);

/*
** CAPI3REF: Error Logging Interface
**
** ^The [dbsql_log()] interface writes a message into the [error log]
** established by the [DBSQL_CONFIG_LOG] option to [dbsql_config()].
** ^If logging is enabled, the format string and subsequent arguments are
** used with [dbsql_snprintf()] to generate the final output string.
**
** The dbsql_log() interface is intended for use by extensions such as
** virtual tables, collating functions, and SQL functions.  While there is
** nothing to prevent an application from calling dbsql_log(), doing so
** is considered bad form.
**
** The format string must not be NULL.
**
** To avoid deadlocks and other threading problems, the dbsql_log() routine
** will not use dynamically allocated memory.  The log message is stored in
** a fixed-length buffer on the stack.  If the log message is longer than
** a few hundred characters, it will be truncated to the length of the
** buffer.
*/
void dbsql_log(int i_err_code, const char *format, ...);

/*
** CAPI3REF: Write-Ahead Log Commit Hook
** METHOD: DBSQL
**
** ^The [dbsql_wal_hook()] function is used to register a callback that
** is invoked each time data is committed to a database in wal mode.
**
** ^(The callback is invoked by dbsql after the commit has taken place and
** the associated write-lock on the database released)^, so the implementation
** may read, write or [checkpoint] the database as required.
**
** ^The first parameter passed to the callback function when it is invoked
** is a copy of the third parameter passed to dbsql_wal_hook() when
** registering the callback. ^The second is a copy of the database handle.
** ^The third parameter is the name of the database that was written to -
** either "main" or the name of an [ATTACH]-ed database. ^The fourth parameter
** is the number of pages currently in the write-ahead log file,
** including those that were just committed.
**
** ^The callback function should normally return [DBSQL_OK].  ^If an error
** code is returned, that error will propagate back up through the
** dbsql code base to cause the statement that provoked the callback
** to report an error, though the commit will have still occurred. If the
** callback returns [DBSQL_ROW] or [DBSQL_DONE], or if it returns a value
** that does not correspond to any valid dbsql error code, the results
** are undefined.
**
** ^A single database handle may have at most a single write-ahead log
** callback registered at one time. ^Calling [dbsql_wal_hook()]
** replaces the default behavior or previously registered write-ahead
** log callback.
**
** ^The return value is a copy of the third parameter from the
** previous call, if any, or 0.
**
** ^The [dbsql_wal_autocheckpoint()] interface and the
** [wal_autocheckpoint pragma] both invoke [dbsql_wal_hook()] and
** will overwrite any prior [dbsql_wal_hook()] settings.
**
** ^If a write-ahead log callback is set using this function then
** [dbsql_wal_checkpoint_v2()] or [PRAGMA wal_checkpoint]
** should be invoked periodically to keep the write-ahead log file
** from growing without bound.
**
** ^Passing a NULL pointer for the callback disables automatic
** checkpointing entirely. To re-enable the default behavior, call
** dbsql_wal_autocheckpoint(db,1000) or use [PRAGMA wal_checkpoint].
*/
void *dbsql_wal_hook(
  DBSQL*,
  int(*)(void *,DBSQL*,const char*,int),
  void*
);

/*
** CAPI3REF: Configure an auto-checkpoint
** METHOD: DBSQL
**
** ^The [dbsql_wal_autocheckpoint(D,N)] is a wrapper around
** [dbsql_wal_hook()] that causes any database on [database connection] D
** to automatically [checkpoint]
** after committing a transaction if there are N or
** more frames in the [write-ahead log] file.  ^Passing zero or
** a negative value as the N parameter disables automatic
** checkpoints entirely.
**
** ^The callback registered by this function replaces any existing callback
** registered using [dbsql_wal_hook()].  ^Likewise, registering a callback
** using [dbsql_wal_hook()] disables the automatic checkpoint mechanism
** configured by this function.
**
** ^The [wal_autocheckpoint pragma] can be used to invoke this interface
** from SQL.
**
** ^Checkpoints initiated by this mechanism are
** [dbsql_wal_checkpoint_v2|PASSIVE].
**
** ^Every new [database connection] defaults to having the auto-checkpoint
** enabled with a threshold of 1000 or [DBSQL_DEFAULT_WAL_AUTOCHECKPOINT]
** pages.
**
** ^The use of this interface is only necessary if the default setting
** is found to be suboptimal for a particular application.
*/
int dbsql_wal_autocheckpoint(DBSQL *db, int N);

/*
** CAPI3REF: Checkpoint a database
** METHOD: DBSQL
**
** ^(The dbsql_wal_checkpoint(D,X) is equivalent to
** [dbsql_wal_checkpoint_v2](D,X,[DBSQL_CHECKPOINT_PASSIVE],0,0).)^
**
** In brief, dbsql_wal_checkpoint(D,X) causes the content in the
** [write-ahead log] for database X on [database connection] D to be
** transferred into the database file and for the write-ahead log to
** be reset.  See the [checkpointing] documentation for addition
** information.
**
** This interface used to be the only way to cause a checkpoint to
** occur.  But then the newer and more powerful [dbsql_wal_checkpoint_v2()]
** interface was added.  This interface is retained for backwards
** compatibility and as a convenience for applications that need to manually
** start a callback but which do not need the full power (and corresponding
** complication) of [dbsql_wal_checkpoint_v2()].
*/
int dbsql_wal_checkpoint(DBSQL *db, const char *z_db);

/*
** CAPI3REF: Checkpoint a database
** METHOD: DBSQL
**
** ^(The dbsql_wal_checkpoint_v2(D,X,M,L,C) interface runs a checkpoint
** operation on database X of [database connection] D in mode M.  Status
** information is written back into integers pointed to by L and C.)^
** ^(The M parameter must be a valid [checkpoint mode]:)^
**
** <dl>
** <dt>DBSQL_CHECKPOINT_PASSIVE<dd>
**   ^Checkpoint as many frames as possible without waiting for any database
**   readers or writers to finish, then sync the database file if all frames
**   in the log were checkpointed. ^The [busy-handler callback]
**   is never invoked in the DBSQL_CHECKPOINT_PASSIVE mode. 
**   ^On the other hand, passive mode might leave the checkpoint unfinished
**   if there are concurrent readers or writers.
**
** <dt>DBSQL_CHECKPOINT_FULL<dd>
**   ^This mode blocks (it invokes the
**   [dbsql_busy_handler|busy-handler callback]) until there is no
**   database writer and all readers are reading from the most recent database
**   snapshot. ^It then checkpoints all frames in the log file and syncs the
**   database file. ^This mode blocks new database writers while it is pending,
**   but new database readers are allowed to continue unimpeded.
**
** <dt>DBSQL_CHECKPOINT_RESTART<dd>
**   ^This mode works the same way as DBSQL_CHECKPOINT_FULL with the addition
**   that after checkpointing the log file it blocks (calls the
**   [busy-handler callback])
**   until all readers are reading from the database file only. ^This ensures
**   that the next writer will restart the log file from the beginning.
**   ^Like DBSQL_CHECKPOINT_FULL, this mode blocks new
**   database writer attempts while it is pending, but does not impede readers.
**
** <dt>DBSQL_CHECKPOINT_TRUNCATE<dd>
**   ^This mode works the same way as DBSQL_CHECKPOINT_RESTART with the
**   addition that it also truncates the log file to zero bytes just prior
**   to a successful return.
**
** <dt>DBSQL_CHECKPOINT_NOOP<dd>
**   ^This mode always checkpoints zero frames. The only reason to invoke
**   a NOOP checkpoint is to access the values returned by
**   dbsql_wal_checkpoint_v2() via output parameters *pn_log and *pn_ckpt.
** </dl>
**
** ^If pn_log is not NULL, then *pn_log is set to the total number of frames in
** the log file or to -1 if the checkpoint could not run because
** of an error or because the database is not in [WAL mode]. ^If pn_ckpt is not
** NULL,then *pn_ckpt is set to the total number of checkpointed frames in the
** log file (including any that were already checkpointed before the function
** was called) or to -1 if the checkpoint could not run due to an error or
** because the database is not in WAL mode. ^Note that upon successful
** completion of an DBSQL_CHECKPOINT_TRUNCATE, the log file will have been
** truncated to zero bytes and so both *pn_log and *pn_ckpt will be set to zero.
**
** ^All calls obtain an exclusive "checkpoint" lock on the database file. ^If
** any other process is running a checkpoint operation at the same time, the
** lock cannot be obtained and DBSQL_BUSY is returned. ^Even if there is a
** busy-handler configured, it will not be invoked in this case.
**
** ^The DBSQL_CHECKPOINT_FULL, RESTART and TRUNCATE modes also obtain the
** exclusive "writer" lock on the database file. ^If the writer lock cannot be
** obtained immediately, and a busy-handler is configured, it is invoked and
** the writer lock retried until either the busy-handler returns 0 or the lock
** is successfully obtained. ^The busy-handler is also invoked while waiting for
** database readers as described above. ^If the busy-handler returns 0 before
** the writer lock is obtained or while waiting for database readers, the
** checkpoint operation proceeds from that point in the same way as
** DBSQL_CHECKPOINT_PASSIVE - checkpointing as many frames as possible
** without blocking any further. ^DBSQL_BUSY is returned in this case.
**
** ^If parameter db is NULL or points to a zero length string, then the
** specified operation is attempted on all WAL databases [attached] to
** [database connection] db.  In this case the
** values written to output parameters *pn_log and *pn_ckpt are undefined. ^If
** an DBSQL_BUSY error is encountered when processing one or more of the
** attached WAL databases, the operation is still attempted on any remaining
** attached databases and DBSQL_BUSY is returned at the end. ^If any other
** error occurs while processing an attached database, processing is abandoned
** and the error code is returned to the caller immediately. ^If no error
** (DBSQL_BUSY or otherwise) is encountered while processing the attached
** databases, DBSQL_OK is returned.
**
** ^If database db is the name of an attached database that is not in WAL
** mode, DBSQL_OK is returned and both *pn_log and *pn_ckpt set to -1. ^If
** db is not NULL (or a zero length string) and is not the name of any
** attached database, DBSQL_ERROR is returned to the caller.
**
** ^Unless it returns DBSQL_MISUSE,
** the dbsql_wal_checkpoint_v2() interface
** sets the error information that is queried by
** [dbsql_errcode()] and [dbsql_errmsg()].
**
** ^The [PRAGMA wal_checkpoint] command can be used to invoke this interface
** from SQL.
*/
int dbsql_wal_checkpoint_v2(
  DBSQL *db,                    /* Database handle */
  const char *z_db,                /* Name of attached database (or NULL) */
  int mode,                      /* DBSQL_CHECKPOINT_* value */
  int *pn_log,                     /* OUT: Size of WAL log in frames */
  int *pn_ckpt                     /* OUT: Total number of frames checkpointed */
);

/*
** CAPI3REF: Checkpoint shell_mode_t Values
** KEYWORDS: {checkpoint mode}
**
** These constants define all valid values for the "checkpoint mode" passed
** as the third parameter to the [dbsql_wal_checkpoint_v2()] interface.
** See the [dbsql_wal_checkpoint_v2()] documentation for details on the
** meaning of each of these checkpoint modes.
*/
#define DBSQL_CHECKPOINT_NOOP    -1  /* Do no work at all */
#define DBSQL_CHECKPOINT_PASSIVE  0  /* Do as much as possible w/o blocking */
#define DBSQL_CHECKPOINT_FULL     1  /* Wait for writers, then checkpoint */
#define DBSQL_CHECKPOINT_RESTART  2  /* Like FULL but wait for readers */
#define DBSQL_CHECKPOINT_TRUNCATE 3  /* Like RESTART but also truncate WAL */

/*
** CAPI3REF: Virtual table_t Interface Configuration
**
** This function may be called by either the [connect] or [create] method
** of a [virtual table] implementation to configure
** various facets of the virtual table interface.
**
** If this interface is invoked outside the context of an connect or
** create virtual table method then the behavior is undefined.
**
** In the call dbsql_vtab_config(D,C,...) the D parameter is the
** [database connection] in which the virtual table is being created and
** which is passed in as the first argument to the [connect] or [create]
** method that is invoking dbsql_vtab_config().  The C parameter is one
** of the [virtual table configuration options].  The presence and meaning
** of parameters after C depend on which [virtual table configuration option]
** is used.
*/
int dbsql_vtab_config(DBSQL*, int op, ...);

/*
** CAPI3REF: Virtual table_t Configuration Options
** KEYWORDS: {virtual table configuration options}
** KEYWORDS: {virtual table configuration option}
**
** These macros define the various options to the
** [dbsql_vtab_config()] interface that [virtual table] implementations
** can use to customize and optimize their behavior.
**
** <dl>
** [[DBSQL_VTAB_CONSTRAINT_SUPPORT]]
** <dt>DBSQL_VTAB_CONSTRAINT_SUPPORT</dt>
** <dd>Calls of the form
** [dbsql_vtab_config](db,DBSQL_VTAB_CONSTRAINT_SUPPORT,X) are supported,
** where X is an integer.  If X is zero, then the [virtual table] whose
** [create] or [connect] method invoked [dbsql_vtab_config()] does not
** support constraints.  In this configuration (which is the default) if
** a call to the [update] method returns [DBSQL_CONSTRAINT], then the entire
** statement is rolled back as if [ON CONFLICT | OR ABORT] had been
** specified as part of the user's SQL statement, regardless of the actual
** ON CONFLICT mode specified.
**
** If X is non-zero, then the virtual table implementation guarantees
** that if [update] returns [DBSQL_CONSTRAINT], it will do so before
** any modifications to internal or persistent data structures have been made.
** If the [ON CONFLICT] mode is ABORT, FAIL, IGNORE or ROLLBACK, dbsql
** is able to roll back a statement or database transaction, and abandon
** or continue processing the current SQL statement as appropriate.
** If the ON CONFLICT mode is REPLACE and the [update] method returns
** [DBSQL_CONSTRAINT], dbsql handles this as if the ON CONFLICT mode
** had been ABORT.
**
** Virtual table implementations that are required to handle OR REPLACE
** must do so within the [update] method. If a call to the
** [dbsql_vtab_on_conflict()] function indicates that the current ON
** CONFLICT policy is REPLACE, the virtual table implementation should
** silently replace the appropriate rows within the update callback and
** return DBSQL_OK. Or, if this is not possible, it may return
** DBSQL_CONSTRAINT, in which case dbsql falls back to OR ABORT
** constraint handling.
** </dd>
**
** [[DBSQL_VTAB_DIRECTONLY]]<dt>DBSQL_VTAB_DIRECTONLY</dt>
** <dd>Calls of the form
** [dbsql_vtab_config](db,DBSQL_VTAB_DIRECTONLY) from within the
** the [connect] or [create] methods of a [virtual table] implementation
** prohibits that virtual table from being used from within triggers and
** views.
** </dd>
**
** [[DBSQL_VTAB_INNOCUOUS]]<dt>DBSQL_VTAB_INNOCUOUS</dt>
** <dd>Calls of the form
** [dbsql_vtab_config](db,DBSQL_VTAB_INNOCUOUS) from within the
** [connect] or [create] methods of a [virtual table] implementation
** identify that virtual table as being safe to use from within triggers
** and views.  Conceptually, the DBSQL_VTAB_INNOCUOUS tag means that the
** virtual table can do no serious harm even if it is controlled by a
** malicious hacker.  Developers should avoid setting the DBSQL_VTAB_INNOCUOUS
** flag unless absolutely necessary.
** </dd>
**
** [[DBSQL_VTAB_USES_ALL_SCHEMAS]]<dt>DBSQL_VTAB_USES_ALL_SCHEMAS</dt>
** <dd>Calls of the form
** [dbsql_vtab_config](db,DBSQL_VTAB_USES_ALL_SCHEMA) from within the
** the [connect] or [create] methods of a [virtual table] implementation
** instruct the query planner to begin at least a read transaction on
** all schemas ("main", "temp", and any ATTACH-ed databases) whenever the
** virtual table is used.
** </dd>
** </dl>
*/
#define DBSQL_VTAB_CONSTRAINT_SUPPORT 1
#define DBSQL_VTAB_INNOCUOUS          2
#define DBSQL_VTAB_DIRECTONLY         3
#define DBSQL_VTAB_USES_ALL_SCHEMAS   4

/*
** CAPI3REF: Determine The Virtual table_t Conflict Policy
**
** This function may only be called from within a call to the [update] method
** of a [virtual table] implementation for an INSERT or UPDATE operation. ^The
** value returned is one of [DBSQL_ROLLBACK], [DBSQL_IGNORE], [DBSQL_FAIL],
** [DBSQL_ABORT], or [DBSQL_REPLACE], according to the [ON CONFLICT] mode
** of the SQL statement that triggered the call to the [update] method of the
** [virtual table].
*/
int dbsql_vtab_on_conflict(DBSQL *);

/*
** CAPI3REF: Determine If Virtual table_t column_t Access Is For UPDATE
**
** If the dbsql_vtab_nochange(X) routine is called within the [column]
** method of a [virtual table], then it might return true if the
** column is being fetched as part of an UPDATE operation during which the
** column value will not change.  The virtual table implementation can use
** this hint as permission to substitute a return value that is less
** expensive to compute and that the corresponding
** [update] method understands as a "no-change" value.
**
** If the [column] method calls dbsql_vtab_nochange() and finds that
** the column is not changed by the UPDATE statement, then the column
** method can optionally return without setting a result, without calling
** any of the [dbsql_result_int|dbsql_result_xxxxx() interfaces].
** In that case, [dbsql_value_nochange(X)] will return true for the
** same column in the [update] method.
**
** The dbsql_vtab_nochange() routine is an optimization.  Virtual table
** implementations should continue to give a correct answer even if the
** dbsql_vtab_nochange() interface were to always return false.  In the
** current implementation, the dbsql_vtab_nochange() interface does always
** returns false for the enhanced [UPDATE FROM] statement.
*/
int dbsql_vtab_nochange(dbsql_func_t*);

/*
** CAPI3REF: Determine The Collation For a Virtual table_t Constraint
** METHOD: dbsql_index_info_t
**
** This function may only be called from within a call to the [best_index]
** method of a [virtual table].  This function returns a pointer to a string
** that is the name of the appropriate collation sequence to use for text
** comparisons on the constraint identified by its arguments.
**
** The first argument must be the pointer to the [dbsql_index_info_t] object
** that is the first parameter to the best_index() method. The second argument
** must be an index into the constraints[] array belonging to the
** dbsql_index_info_t structure passed to best_index.
**
** Important:
** The first parameter must be the same pointer that is passed into the
** best_method() method.  The first parameter may not be a pointer to a
** different [dbsql_index_info_t] object, even an exact copy.
**
** The return value is computed as follows:
**
** <ol>
** <li><p> If the constraint comes from a WHERE clause expression that contains
**         a [COLLATE operator], then the name of the collation specified by
**         that COLLATE operator is returned.
** <li><p> If there is no COLLATE operator, but the column that is the subject
**         of the constraint specifies an alternative collating sequence via
**         a [COLLATE clause] on the column definition within the CREATE TABLE
**         statement that was passed into [dbsql_declare_vtab()], then the
**         name of that alternative collating sequence is returned.
** <li><p> Otherwise, "BINARY" is returned.
** </ol>
*/
const char *dbsql_vtab_collation(dbsql_index_info_t*,int);

/*
** CAPI3REF: Determine if a virtual table query is DISTINCT
** METHOD: dbsql_index_info_t
**
** This API may only be used from within an [best_index|best_index method]
** of a [virtual table] implementation. The result of calling this
** interface from outside of best_index() is undefined and probably harmful.
**
** ^The dbsql_vtab_distinct() interface returns an integer between 0 and
** 3.  The integer returned by dbsql_vtab_distinct()
** gives the virtual table additional information about how the query
** planner wants the output to be ordered. As long as the virtual table
** can meet the ordering requirements of the query planner, it may set
** the "order_by_consumed" flag.
**
** <ol><li value="0"><p>
** ^If the dbsql_vtab_distinct() interface returns 0, that means
** that the query planner needs the virtual table to return all rows in the
** sort order defined by the "n_order_by" and "order_bies" fields of the
** [dbsql_index_info_t] object.  This is the default expectation.  If the
** virtual table outputs all rows in sorted order, then it is always safe for
** the best_index method to set the "order_by_consumed" flag, regardless of
** the return value from dbsql_vtab_distinct().
** <li value="1"><p>
** ^(If the dbsql_vtab_distinct() interface returns 1, that means
** that the query planner does not need the rows to be returned in sorted order
** as long as all rows with the same values in all columns identified by the
** "order_bies" field are adjacent.)^  This mode is used when the query planner
** is doing a GROUP BY.
** <li value="2"><p>
** ^(If the dbsql_vtab_distinct() interface returns 2, that means
** that the query planner does not need the rows returned in any particular
** order, as long as rows with the same values in all columns identified
** by "order_bies" are adjacent.)^  ^(Furthermore, when two or more rows 
** contain the same values for all columns identified by "col_used", all but
** one such row may optionally be omitted from the result.)^
** The virtual table is not required to omit rows that are duplicates
** over the "col_used" columns, but if the virtual table can do that without
** too much extra effort, it could potentially help the query to run faster.
** This mode is used for a DISTINCT query.
** <li value="3"><p>
** ^(If the dbsql_vtab_distinct() interface returns 3, that means the
** virtual table must return rows in the order defined by "order_bies" as
** if the dbsql_vtab_distinct() interface had returned 0.  However if
** two or more rows in the result have the same values for all columns
** identified by "col_used", then all but one such row may optionally be
** omitted.)^  Like when the return value is 2, the virtual table
** is not required to omit rows that are duplicates over the "col_used"
** columns, but if the virtual table can do that without
** too much extra effort, it could potentially help the query to run faster.
** This mode is used for queries
** that have both DISTINCT and ORDER BY clauses.
** </ol>
**
** <p>The following table summarizes the conditions under which the
** virtual table is allowed to set the "order_by_consumed" flag based on
** the value returned by dbsql_vtab_distinct().  This table is a
** restatement of the previous four paragraphs:
**
** <table border=1 cellspacing=0 cellpadding=10 width="90%">
** <tr>
** <td valign="top">dbsql_vtab_distinct() return value
** <td valign="top">Rows are returned in order_bies order
** <td valign="top">Rows with the same value in all order_bies columns are
**                  adjacent
** <td valign="top">Duplicates over all col_used columns may be omitted
** <tr><td>0<td>yes<td>yes<td>no
** <tr><td>1<td>no<td>yes<td>no
** <tr><td>2<td>no<td>yes<td>yes
** <tr><td>3<td>yes<td>yes<td>yes
** </table>
**
** ^For the purposes of comparing virtual table output values to see if the
** values are the same value for sorting purposes, two NULL values are
** considered to be the same.  In other words, the comparison operator is "IS"
** (or "IS NOT DISTINCT FROM") and not "==".
**
** If a virtual table implementation is unable to meet the requirements
** specified above, then it must not set the "order_by_consumed" flag in the
** [dbsql_index_info_t] object or an incorrect answer may result.
**
** ^A virtual table implementation is always free to return rows in any order
** it wants, as long as the "order_by_consumed" flag is not set.  ^When the
** "order_by_consumed" flag is unset, the query planner will add extra
** [bytecode] to ensure that the final results returned by the SQL query are
** ordered correctly.  The use of the "order_by_consumed" flag and the
** dbsql_vtab_distinct() interface is merely an optimization.  ^Careful
** use of the dbsql_vtab_distinct() interface and the "order_by_consumed"
** flag might help queries against a virtual table to run faster.  Being
** overly aggressive and setting the "order_by_consumed" flag when it is not
** valid to do so, on the other hand, might cause dbsql to return incorrect
** results.
*/
int dbsql_vtab_distinct(dbsql_index_info_t*);

/*
** CAPI3REF: Identify and handle IN constraints in best_index
**
** This interface may only be used from within an
** [best_index|best_index() method] of a [virtual table] implementation.
** The result of invoking this interface from any other context is
** undefined and probably harmful.
**
** ^(A constraint on a virtual table of the form
** "[IN operator|column IN (...)]" is
** communicated to the best_index method as a
** [DBSQL_INDEX_CONSTRAINT_EQ] constraint.)^  If best_index wants to use
** this constraint, it must set the corresponding
** constraint_usages[].argv_index to a positive integer.  ^(Then, under
** the usual mode of handling IN operators, dbsql generates [bytecode]
** that invokes the [filter|filter() method] once for each value
** on the right-hand side of the IN operator.)^  Thus the virtual table
** only sees a single value from the right-hand side of the IN operator
** at a time.
**
** In some cases, however, it would be advantageous for the virtual
** table to see all values on the right-hand of the IN operator all at
** once.  The dbsql_vtab_in() interfaces facilitates this in two ways:
**
** <ol>
** <li><p>
**   ^A call to dbsql_vtab_in(P,N,-1) will return true (non-zero)
**   if and only if the [dbsql_index_info_t|P->constraints][N] constraint
**   is an [IN operator] that can be processed all at once.  ^In other words,
**   dbsql_vtab_in() with -1 in the third argument is a mechanism
**   by which the virtual table can ask dbsql if all-at-once processing
**   of the IN operator is even possible.
**
** <li><p>
**   ^A call to dbsql_vtab_in(P,N,F) with F==1 or F==0 indicates
**   to dbsql that the virtual table does or does not want to process
**   the IN operator all-at-once, respectively.  ^Thus when the third
**   parameter (F) is non-negative, this interface is the mechanism by
**   which the virtual table tells dbsql how it wants to process the
**   IN operator.
** </ol>
**
** ^The dbsql_vtab_in(P,N,F) interface can be invoked multiple times
** within the same best_index method call.  ^For any given P,N pair,
** the return value from dbsql_vtab_in(P,N,F) will always be the same
** within the same best_index call.  ^If the interface returns true
** (non-zero), that means that the constraint is an IN operator
** that can be processed all-at-once.  ^If the constraint is not an IN
** operator or cannot be processed all-at-once, then the interface returns
** false.
**
** ^(All-at-once processing of the IN operator is selected if both of the
** following conditions are met:
**
** <ol>
** <li><p> The P->constraint_usages[N].argv_index value is set to a positive
** integer.  This is how the virtual table tells dbsql that it wants to
** use the N-th constraint.
**
** <li><p> The last call to dbsql_vtab_in(P,N,F) for which F was
** non-negative had F>=1.
** </ol>)^
**
** ^If either or both of the conditions above are false, then dbsql uses
** the traditional one-at-a-time processing strategy for the IN constraint.
** ^If both conditions are true, then the argv_index-th parameter to the
** filter method will be an [dbsql_value_t] that appears to be NULL,
** but which can be passed to [dbsql_vtab_in_first()] and
** [dbsql_vtab_in_next()] to find all values on the right-hand side
** of the IN constraint.
*/
int dbsql_vtab_in(dbsql_index_info_t*, int i_cons, int handle);

/*
** CAPI3REF: Find all elements on the right-hand side of an IN constraint.
**
** These interfaces are only useful from within the
** [filter|filter() method] of a [virtual table] implementation.
** The result of invoking these interfaces from any other context
** is undefined and probably harmful.
**
** The X parameter in a call to dbsql_vtab_in_first(X,P) or
** dbsql_vtab_in_next(X,P) should be one of the parameters to the
** filter method which invokes these routines, and specifically
** a parameter that was previously selected for all-at-once IN constraint
** processing using the [dbsql_vtab_in()] interface in the
** [best_index|best_index method].  ^(If the X parameter is not
** an filter argument that was selected for all-at-once IN constraint
** processing, then these routines return [DBSQL_ERROR].)^
**
** ^(Use these routines to access all values on the right-hand side
** of the IN constraint using code like the following:
**
** <blockquote><pre>
** &nbsp;  for(rc=dbsql_vtab_in_first(list, &val);
** &nbsp;      rc==DBSQL_OK && val;
** &nbsp;      rc=dbsql_vtab_in_next(list, &val)
** &nbsp;  ){
** &nbsp;    // do something with val
** &nbsp;  }
** &nbsp;  if( rc!=DBSQL_DONE ){
** &nbsp;    // an error has occurred
** &nbsp;  }
** </pre></blockquote>)^
**
** ^On success, the dbsql_vtab_in_first(X,P) and dbsql_vtab_in_next(X,P)
** routines return DBSQL_OK and set *P to point to the first or next value
** on the RHS of the IN constraint.  ^If there are no more values on the
** right hand side of the IN constraint, then *P is set to NULL and these
** routines return [DBSQL_DONE].  ^The return value might be
** some other value, such as DBSQL_NOMEM, in the event of a malfunction.
**
** The *out values returned by these routines are only valid until the
** next call to either of these routines or until the end of the filter
** method from which these routines were called.  If the virtual table
** implementation needs to retain the *out values for longer, it must make
** copies.  The *out values are [protected dbsql_value_t|protected].
*/
int dbsql_vtab_in_first(dbsql_value_t *val, dbsql_value_t **out);
int dbsql_vtab_in_next(dbsql_value_t *val, dbsql_value_t **out);

/*
** CAPI3REF: Constraint values in best_index()
** METHOD: dbsql_index_info_t
**
** This API may only be used from within the [best_index|best_index method]
** of a [virtual table] implementation. The result of calling this interface
** from outside of an best_index method are undefined and probably harmful.
**
** ^When the dbsql_vtab_rhs_value(P,J,V) interface is invoked from within
** the [best_index] method of a [virtual table] implementation, with P being
** a copy of the [dbsql_index_info_t] object pointer passed into best_index and
** J being a 0-based index into P->constraints[], then this routine
** attempts to set *V to the value of the right-hand operand of
** that constraint if the right-hand operand is known.  ^If the
** right-hand operand is not known, then *V is set to a NULL pointer.
** ^The dbsql_vtab_rhs_value(P,J,V) interface returns DBSQL_OK if
** and only if *V is set to a value.  ^The dbsql_vtab_rhs_value(P,J,V)
** inteface returns DBSQL_NOTFOUND if the right-hand side of the J-th
** constraint is not available.  ^The dbsql_vtab_rhs_value() interface
** can return a result code other than DBSQL_OK or DBSQL_NOTFOUND if
** something goes wrong.
**
** The dbsql_vtab_rhs_value() interface is usually only successful if
** the right-hand operand of a constraint is a literal value in the original
** SQL statement.  If the right-hand operand is an expression or a reference
** to some other column or a [host parameter], then dbsql_vtab_rhs_value()
** will probably return [DBSQL_NOTFOUND].
**
** ^(Some constraints, such as [DBSQL_INDEX_CONSTRAINT_ISNULL] and
** [DBSQL_INDEX_CONSTRAINT_ISNOTNULL], have no right-hand operand.  For such
** constraints, dbsql_vtab_rhs_value() always returns DBSQL_NOTFOUND.)^
**
** ^The [dbsql_value_t] object returned in *V is a protected dbsql_value_t
** and remains valid for the duration of the best_index method call.
** ^When best_index returns, the dbsql_value_t object returned by
** dbsql_vtab_rhs_value() is automatically deallocated.
**
** The "_rhs_" in the name of this routine is an abbreviation for
** "Right-Hand Side".
*/
int dbsql_vtab_rhs_value(dbsql_index_info_t*, int, dbsql_value_t **val);

/*
** CAPI3REF: Conflict resolution modes
** KEYWORDS: {conflict resolution mode}
**
** These constants are returned by [dbsql_vtab_on_conflict()] to
** inform a [virtual table] implementation of the [ON CONFLICT] mode
** for the SQL statement being evaluated.
**
** Note that the [DBSQL_IGNORE] constant is also used as a potential
** return value from the [dbsql_set_authorizer()] callback and that
** [DBSQL_ABORT] is also a [result code].
*/
#define DBSQL_ROLLBACK 1
/* #define DBSQL_IGNORE 2 // Also used by dbsql_authorizer() callback */
#define DBSQL_FAIL     3
/* #define DBSQL_ABORT 4  // Also an error code */
#define DBSQL_REPLACE  5

/*
** CAPI3REF: Prepared Statement Scan Status Opcodes
** KEYWORDS: {scanstatus options}
**
** The following constants can be used for the T parameter to the
** [dbsql_stmt_scanstatus(S,X,T,V)] interface.  Each constant designates a
** different metric for dbsql_stmt_scanstatus() to return.
**
** When the value returned to V is a string, space to hold that string is
** managed by the prepared statement S and will be automatically freed when
** S is finalized.
**
** Not all values are available for all query elements. When a value is
** not available, the output variable is set to -1 if the value is numeric,
** or to NULL if it is a string (DBSQL_SCANSTAT_NAME).
**
** <dl>
** [[DBSQL_SCANSTAT_NLOOP]] <dt>DBSQL_SCANSTAT_NLOOP</dt>
** <dd>^The [int64_t] variable pointed to by the V parameter will be
** set to the total number of times that the X-th loop has run.</dd>
**
** [[DBSQL_SCANSTAT_NVISIT]] <dt>DBSQL_SCANSTAT_NVISIT</dt>
** <dd>^The [int64_t] variable pointed to by the V parameter will be set
** to the total number of rows examined by all iterations of the X-th loop.</dd>
**
** [[DBSQL_SCANSTAT_EST]] <dt>DBSQL_SCANSTAT_EST</dt>
** <dd>^The "double" variable pointed to by the V parameter will be set to the
** query planner's estimate for the average number of rows output from each
** iteration of the X-th loop.  If the query planner's estimate was accurate,
** then this value will approximate the quotient NVISIT/NLOOP and the
** product of this value for all prior loops with the same SELECTID will
** be the NLOOP value for the current loop.</dd>
**
** [[DBSQL_SCANSTAT_NAME]] <dt>DBSQL_SCANSTAT_NAME</dt>
** <dd>^The "const char *" variable pointed to by the V parameter will be set
** to a zero-terminated UTF-8 string containing the name of the index or table
** used for the X-th loop.</dd>
**
** [[DBSQL_SCANSTAT_EXPLAIN]] <dt>DBSQL_SCANSTAT_EXPLAIN</dt>
** <dd>^The "const char *" variable pointed to by the V parameter will be set
** to a zero-terminated UTF-8 string containing the [EXPLAIN QUERY PLAN]
** description for the X-th loop.</dd>
**
** [[DBSQL_SCANSTAT_SELECTID]] <dt>DBSQL_SCANSTAT_SELECTID</dt>
** <dd>^The "int" variable pointed to by the V parameter will be set to the
** id for the X-th query plan element. The id value is unique within the
** statement. The select-id is the same value as is output in the first
** column of an [EXPLAIN QUERY PLAN] query.</dd>
**
** [[DBSQL_SCANSTAT_PARENTID]] <dt>DBSQL_SCANSTAT_PARENTID</dt>
** <dd>The "int" variable pointed to by the V parameter will be set to the
** id of the parent of the current query element, if applicable, or
** to zero if the query element has no parent. This is the same value as
** returned in the second column of an [EXPLAIN QUERY PLAN] query.</dd>
**
** [[DBSQL_SCANSTAT_NCYCLE]] <dt>DBSQL_SCANSTAT_NCYCLE</dt>
** <dd>The int64_t output value is set to the number of cycles,
** according to the processor time-stamp counter, that elapsed while the
** query element was being processed. This value is not available for
** all query elements - if it is unavailable the output variable is
** set to -1.</dd>
** </dl>
*/
#define DBSQL_SCANSTAT_NLOOP    0
#define DBSQL_SCANSTAT_NVISIT   1
#define DBSQL_SCANSTAT_EST      2
#define DBSQL_SCANSTAT_NAME     3
#define DBSQL_SCANSTAT_EXPLAIN  4
#define DBSQL_SCANSTAT_SELECTID 5
#define DBSQL_SCANSTAT_PARENTID 6
#define DBSQL_SCANSTAT_NCYCLE   7

/*
** CAPI3REF: Prepared Statement Scan Status
** METHOD: dbsql_stmt_t
**
** These interfaces return information about the predicted and measured
** performance for stmt.  Advanced applications can use this
** interface to compare the predicted and the measured performance and
** issue warnings and/or rerun [ANALYZE] if discrepancies are found.
**
** Since this interface is expected to be rarely used, it is only
** available if dbsql is compiled using the [DBSQL_ENABLE_STMT_SCANSTATUS]
** compile-time option.
**
** The "i_scan_status_op" parameter determines which status information to return.
** The "i_scan_status_op" must be one of the [scanstatus options] or the behavior
** of this interface is undefined. ^The requested measurement is written into
** a variable pointed to by the "out" parameter.
**
** The "flags" parameter must be passed a mask of flags. At present only
** one flag is defined - [DBSQL_SCANSTAT_COMPLEX]. If DBSQL_SCANSTAT_COMPLEX
** is specified, then status information is available for all elements
** of a query plan that are reported by "[EXPLAIN QUERY PLAN]" output. If
** DBSQL_SCANSTAT_COMPLEX is not specified, then only query plan elements
** that correspond to query loops (the "SCAN..." and "SEARCH..." elements of
** the EXPLAIN QUERY PLAN output) are available. Invoking API
** dbsql_stmt_scanstatus() is equivalent to calling
** dbsql_stmt_scanstatus_v2() with a zeroed flags parameter.
**
** Parameter "idx" identifies the specific query element to retrieve statistics
** for. Query elements are numbered starting from zero. A value of -1 may
** retrieve statistics for the entire query. ^If idx is out of range
** - less than -1 or greater than or equal to the total number of query
** elements used to implement the statement - a non-zero value is returned and
** the variable that out points to is unchanged.
**
** See also: [dbsql_stmt_scanstatus_reset()] and the
** [nexec and ncycle] columns of the [bytecode virtual table].
*/
int dbsql_stmt_scanstatus(
  dbsql_stmt_t *stmt,      /* Prepared statement for which info desired */
  int idx,                  /* index_t of loop to report on */
  int i_scan_status_op,        /* Information desired.  DBSQL_SCANSTAT_* */
  void *out                /* Result written here */
);
int dbsql_stmt_scanstatus_v2(
  dbsql_stmt_t *stmt,      /* Prepared statement for which info desired */
  int idx,                  /* index_t of loop to report on */
  int i_scan_status_op,        /* Information desired.  DBSQL_SCANSTAT_* */
  int flags,                /* Mask of flags defined below */
  void *out                /* Result written here */
);

/*
** CAPI3REF: Prepared Statement Scan Status
** KEYWORDS: {scan status flags}
*/
#define DBSQL_SCANSTAT_COMPLEX 0x0001

/*
** CAPI3REF: Zero Scan-Status Counters
** METHOD: dbsql_stmt_t
**
** ^Zero all [dbsql_stmt_scanstatus()] related event counters.
**
** This API is only available if the library is built with pre-processor
** symbol [DBSQL_ENABLE_STMT_SCANSTATUS] defined.
*/
void dbsql_stmt_scanstatus_reset(dbsql_stmt_t*);

/*
** CAPI3REF: Flush caches to disk mid-transaction
** METHOD: DBSQL
**
** ^If a write-transaction is open on [database connection] D when the
** [dbsql_db_cacheflush(D)] interface is invoked, any dirty
** pages in the pager-cache that are not currently in use are written out
** to disk. A dirty page may be in use if a database cursor created by an
** active SQL statement is reading from it, or if it is page 1 of a database
** file (page 1 is always "in use").  ^The [dbsql_db_cacheflush(D)]
** interface flushes caches for all schemas - "main", "temp", and
** any [attached] databases.
**
** ^If this function needs to obtain extra database locks before dirty pages
** can be flushed to disk, it does so. ^If those locks cannot be obtained
** immediately and there is a busy-handler callback configured, it is invoked
** in the usual manner. ^If the required lock still cannot be obtained, then
** the database is skipped and an attempt made to flush any dirty pages
** belonging to the next (if any) database. ^If any databases are skipped
** because locks cannot be obtained, but no other error occurs, this
** function returns DBSQL_BUSY.
**
** ^If any other error occurs while flushing dirty pages to disk (for
** example an IO error or out-of-memory condition), then processing is
** abandoned and an dbsql [error code] is returned to the caller immediately.
**
** ^Otherwise, if no error occurs, [dbsql_db_cacheflush()] returns DBSQL_OK.
**
** ^This function does not set the database handle error code or message
** returned by the [dbsql_errcode()] and [dbsql_errmsg()] functions.
*/
int dbsql_db_cacheflush(DBSQL*);

/*
** CAPI3REF: The pre-update hook.
** METHOD: DBSQL
**
** ^These interfaces are only available if dbsql is compiled using the
** [DBSQL_ENABLE_PREUPDATE_HOOK] compile-time option.
**
** ^The [dbsql_preupdate_hook()] interface registers a callback function
** that is invoked prior to each [INSERT], [UPDATE], and [DELETE] operation
** on a database table.
** ^At most one preupdate hook may be registered at a time on a single
** [database connection]; each call to [dbsql_preupdate_hook()] overrides
** the previous setting.
** ^The preupdate hook is disabled by invoking [dbsql_preupdate_hook()]
** with a NULL pointer as the second parameter.
** ^The third parameter to [dbsql_preupdate_hook()] is passed through as
** the first parameter to callbacks.
**
** ^The preupdate hook only fires for changes to real database tables; the
** preupdate hook is not invoked for changes to [virtual tables] or to
** system tables like dbsql_sequence or dbsql_stat1.
**
** ^The second parameter to the preupdate callback is a pointer to
** the [database connection] that registered the preupdate hook.
** ^The third parameter to the preupdate callback is one of the constants
** [DBSQL_INSERT], [DBSQL_DELETE], or [DBSQL_UPDATE] to identify the
** kind of update operation that is about to occur.
** ^(The fourth parameter to the preupdate callback is the name of the
** database within the database connection that is being modified.  This
** will be "main" for the main database or "temp" for TEMP tables or
** the name given after the AS keyword in the [ATTACH] statement for attached
** databases.)^
** ^The fifth parameter to the preupdate callback is the name of the
** table that is being modified.
**
** For an UPDATE or DELETE operation on a [rowid table], the sixth
** parameter passed to the preupdate callback is the initial [rowid] of the
** row being modified or deleted. For an INSERT operation on a rowid table,
** or any operation on a WITHOUT ROWID table, the value of the sixth
** parameter is undefined. For an INSERT or UPDATE on a rowid table the
** seventh parameter is the final rowid value of the row being inserted
** or updated. The value of the seventh parameter passed to the callback
** function is not defined for operations on WITHOUT ROWID tables, or for
** DELETE operations on rowid tables.
**
** ^The dbsql_preupdate_hook(D,C,P) function returns the P argument from
** the previous call on the same [database connection] D, or NULL for
** the first call on D.
**
** The [dbsql_preupdate_old()], [dbsql_preupdate_new()],
** [dbsql_preupdate_count()], and [dbsql_preupdate_depth()] interfaces
** provide additional information about a preupdate event. These routines
** may only be called from within a preupdate callback.  Invoking any of
** these routines from outside of a preupdate callback or with a
** [database connection] pointer that is different from the one supplied
** to the preupdate callback results in undefined and probably undesirable
** behavior.
**
** ^The [dbsql_preupdate_count(D)] interface returns the number of columns
** in the row that is being inserted, updated, or deleted.
**
** ^The [dbsql_preupdate_old(D,N,P)] interface writes into P a pointer to
** a [protected dbsql_value_t] that contains the value of the Nth column of
** the table row before it is updated.  The N parameter must be between 0
** and one less than the number of columns or the behavior will be
** undefined. This must only be used within DBSQL_UPDATE and DBSQL_DELETE
** preupdate callbacks; if it is used by an DBSQL_INSERT callback then the
** behavior is undefined.  The [dbsql_value_t] that P points to
** will be destroyed when the preupdate callback returns.
**
** ^The [dbsql_preupdate_new(D,N,P)] interface writes into P a pointer to
** a [protected dbsql_value_t] that contains the value of the Nth column of
** the table row after it is updated.  The N parameter must be between 0
** and one less than the number of columns or the behavior will be
** undefined. This must only be used within DBSQL_INSERT and DBSQL_UPDATE
** preupdate callbacks; if it is used by an DBSQL_DELETE callback then the
** behavior is undefined.  The [dbsql_value_t] that P points to
** will be destroyed when the preupdate callback returns.
**
** ^The [dbsql_preupdate_depth(D)] interface returns 0 if the preupdate
** callback was invoked as a result of a direct insert, update, or delete
** operation; or 1 for inserts, updates, or deletes invoked by top-level
** triggers; or 2 for changes resulting from triggers called by top-level
** triggers; and so forth.
**
** When the [dbsql_blob_write()] API is used to update a blob column,
** the pre-update hook is invoked with DBSQL_DELETE, because
** the new values are not yet available. In this case, when a
** callback made with op==DBSQL_DELETE is actually a write using the
** dbsql_blob_write() API, the [dbsql_preupdate_blobwrite()] returns
** the index of the column being written. In other cases, where the
** pre-update hook is being invoked for some other reason, including a
** regular DELETE, dbsql_preupdate_blobwrite() returns -1.
**
** See also:  [dbsql_update_hook()]
*/
#if defined(DBSQL_ENABLE_PREUPDATE_HOOK)
void *dbsql_preupdate_hook(
  DBSQL *db,
  void(*pre_update)(
    void *ctx,                   /* Copy of third arg to preupdate_hook() */
    DBSQL *db,                  /* Database handle */
    int op,                       /* DBSQL_UPDATE, DELETE or INSERT */
    char const *z_db,              /* Database name */
    char const *name,            /* table_t name */
    int64_t i_key1,          /* Rowid of row about to be deleted/updated */
    int64_t i_key2           /* New rowid value (for a rowid UPDATE) */
  ),
  void*
);
int dbsql_preupdate_old(DBSQL *, int, dbsql_value_t **);
int dbsql_preupdate_count(DBSQL *);
int dbsql_preupdate_depth(DBSQL *);
int dbsql_preupdate_new(DBSQL *, int, dbsql_value_t **);
int dbsql_preupdate_blobwrite(DBSQL *);
#endif

/*
** CAPI3REF: Low-level system error code
** METHOD: DBSQL
**
** ^Attempt to return the underlying operating system error code or error
** number that caused the most recent I/O error or failure to open a file.
** The return value is OS-dependent.  For example, on unix systems, after
** [dbsql_open_v2()] returns [DBSQL_CANTOPEN], this interface could be
** called to get back the underlying "errno" that caused the problem, such
** as ENOSPC, EAUTH, EISDIR, and so forth. 
*/
int dbsql_system_errno(DBSQL*);

/*
** CAPI3REF: Database Snapshot
** KEYWORDS: {snapshot} {dbsql_snapshot_t}
**
** An instance of the snapshot object records the state of a [WAL mode]
** database for some specific point in history.
**
** In [WAL mode], multiple [database connections] that are open on the
** same database file can each be reading a different historical version
** of the database file.  When a [database connection] begins a read
** transaction, that connection sees an unchanging copy of the database
** as it existed for the point in time when the transaction first started.
** Subsequent changes to the database from other connections are not seen
** by the reader until a new read transaction is started.
**
** The dbsql_snapshot_t object records state information about an historical
** version of the database file so that it is possible to later open a new read
** transaction that sees that historical version of the database rather than
** the most recent version.
*/
typedef struct dbsql_snapshot_t {
  unsigned char hidden[48];
} dbsql_snapshot_t;

/*
** CAPI3REF: Record A Database Snapshot
** CONSTRUCTOR: dbsql_snapshot_t
**
** ^The [dbsql_snapshot_get(D,S,P)] interface attempts to make a
** new [dbsql_snapshot_t] object that records the current state of
** schema S in database connection D.  ^On success, the
** [dbsql_snapshot_get(D,S,P)] interface writes a pointer to the newly
** created [dbsql_snapshot_t] object into *P and returns DBSQL_OK.
** If there is not already a read-transaction open on schema S when
** this function is called, one is opened automatically.
**
** If a read-transaction is opened by this function, then it is guaranteed 
** that the returned snapshot object may not be invalidated by a database 
** writer or checkpointer until after the read-transaction is closed. This 
** is not guaranteed if a read-transaction is already open when this 
** function is called. In that case, any subsequent write or checkpoint 
** operation on the database may invalidate the returned snapshot handle, 
** even while the read-transaction remains open.
**
** The following must be true for this function to succeed. If any of
** the following statements are false when dbsql_snapshot_get() is
** called, DBSQL_ERROR is returned. The final value of *P is undefined
** in this case.
**
** <ul>
**   <li> The database handle must not be in [autocommit mode].
**
**   <li> schema_t S of [database connection] D must be a [WAL mode] database.
**
**   <li> There must not be a write transaction open on schema S of database
**        connection D.
**
**   <li> One or more transactions must have been written to the current wal
**        file since it was created on disk (by any connection). This means
**        that a snapshot cannot be taken on a wal mode database with no wal
**        file immediately after it is first opened. At least one transaction
**        must be written to it first.
** </ul>
**
** This function may also return DBSQL_NOMEM.  If it is called with the
** database handle in autocommit mode but fails for some other reason,
** whether or not a read transaction is opened on schema S is undefined.
**
** The [dbsql_snapshot_t] object returned from a successful call to
** [dbsql_snapshot_get()] must be freed using [dbsql_snapshot_free()]
** to avoid a memory leak.
**
** The [dbsql_snapshot_get()] interface is only available when the
** [DBSQL_ENABLE_SNAPSHOT] compile-time option is used.
*/
int dbsql_snapshot_get(
  DBSQL *db,
  const char *schema,
  dbsql_snapshot_t **snapshot
);

/*
** CAPI3REF: Start a read transaction on an historical snapshot
** METHOD: dbsql_snapshot_t
**
** ^The [dbsql_snapshot_open(D,S,P)] interface either starts a new read
** transaction or upgrades an existing one for schema S of
** [database connection] D such that the read transaction refers to
** historical [snapshot] P, rather than the most recent change to the
** database. ^The [dbsql_snapshot_open()] interface returns DBSQL_OK
** on success or an appropriate [error code] if it fails.
**
** ^In order to succeed, the database connection must not be in
** [autocommit mode] when [dbsql_snapshot_open(D,S,P)] is called. If there
** is already a read transaction open on schema S, then the database handle
** must have no active statements (SELECT statements that have been passed
** to dbsql_step() but not dbsql_reset() or dbsql_finalize()).
** DBSQL_ERROR is returned if either of these conditions is violated, or
** if schema S does not exist, or if the snapshot object is invalid.
**
** ^A call to dbsql_snapshot_open() will fail to open if the specified
** snapshot has been overwritten by a [checkpoint]. In this case
** DBSQL_ERROR_SNAPSHOT is returned.
**
** If there is already a read transaction open when this function is
** invoked, then the same read transaction remains open (on the same
** database snapshot) if DBSQL_ERROR, DBSQL_BUSY or DBSQL_ERROR_SNAPSHOT
** is returned. If another error code - for example DBSQL_PROTOCOL or an
** DBSQL_IOERR error code - is returned, then the final state of the
** read transaction is undefined. If DBSQL_OK is returned, then the
** read transaction is now open on database snapshot P.
**
** ^(A call to [dbsql_snapshot_open(D,S,P)] will fail if the
** database connection D does not know that the database file for
** schema S is in [WAL mode].  A database connection might not know
** that the database file is in [WAL mode] if there has been no prior
** I/O on that database connection, or if the database entered [WAL mode]
** after the most recent I/O on the database connection.)^
** (Hint: Run "[PRAGMA application_id]" against a newly opened
** database connection in order to make it ready to use snapshots.)
**
** The [dbsql_snapshot_open()] interface is only available when the
** [DBSQL_ENABLE_SNAPSHOT] compile-time option is used.
*/
int dbsql_snapshot_open(
  DBSQL *db,
  const char *schema,
  dbsql_snapshot_t *snapshot
);

/*
** CAPI3REF: Destroy a snapshot
** DESTRUCTOR: dbsql_snapshot_t
**
** ^The [dbsql_snapshot_free(P)] interface destroys [dbsql_snapshot_t] P.
** The application must eventually free every [dbsql_snapshot_t] object
** using this routine to avoid a memory leak.
**
** The [dbsql_snapshot_free()] interface is only available when the
** [DBSQL_ENABLE_SNAPSHOT] compile-time option is used.
*/
void dbsql_snapshot_free(dbsql_snapshot_t*);

/*
** CAPI3REF: Compare the ages of two snapshot handles.
** METHOD: dbsql_snapshot_t
**
** The dbsql_snapshot_cmp(P1, P2) interface is used to compare the ages
** of two valid snapshot handles.
**
** If the two snapshot handles are not associated with the same database
** file, the result of the comparison is undefined.
**
** Additionally, the result of the comparison is only valid if both of the
** snapshot handles were obtained by calling dbsql_snapshot_get() since the
** last time the wal file was deleted. The wal file is deleted when the
** database is changed back to rollback mode or when the number of database
** clients drops to zero. If either snapshot handle was obtained before the
** wal file was last deleted, the value returned by this function
** is undefined.
**
** Otherwise, this API returns a negative value if P1 refers to an older
** snapshot than P2, zero if the two handles refer to the same database
** snapshot, and a positive value if P1 is a newer snapshot than P2.
**
** This interface is only available if dbsql is compiled with the
** [DBSQL_ENABLE_SNAPSHOT] option.
*/
int dbsql_snapshot_cmp(
  dbsql_snapshot_t *p1,
  dbsql_snapshot_t *p2
);

/*
** CAPI3REF: Recover snapshots from a wal file
** METHOD: dbsql_snapshot_t
**
** If a [WAL file] remains on disk after all database connections close
** (either through the use of the [DBSQL_FCNTL_PERSIST_WAL] [file control]
** or because the last process to have the database opened exited without
** calling [dbsql_close()]) and a new connection is subsequently opened
** on that database and [WAL file], the [dbsql_snapshot_open()] interface
** will only be able to open the last transaction added to the WAL file
** even though the WAL file contains other valid transactions.
**
** This function attempts to scan the WAL file associated with database db
** of database handle db and make all valid snapshots available to
** dbsql_snapshot_open(). It is an error if there is already a read
** transaction open on the database, or if the database is not a WAL mode
** database.
**
** DBSQL_OK is returned if successful, or an dbsql error code otherwise.
**
** This interface is only available if dbsql is compiled with the
** [DBSQL_ENABLE_SNAPSHOT] option.
*/
int dbsql_snapshot_recover(DBSQL *db, const char *z_db);

/*
** CAPI3REF: Serialize a database
**
** The dbsql_serialize(D,S,P,F) interface returns a pointer to
** memory that is a serialization of the S database on
** [database connection] D.  If S is a NULL pointer, the main database is used.
** If P is not a NULL pointer, then the size of the database in bytes
** is written into *P.
**
** For an ordinary on-disk database file, the serialization is just a
** copy of the disk file.  For an in-memory database or a "TEMP" database,
** the serialization is the same sequence of bytes which would be written
** to disk if that database were backed up to disk.
**
** The usual case is that dbsql_serialize() copies the serialization of
** the database into memory obtained from [dbsql_malloc64()] and returns
** a pointer to that memory.  The caller is responsible for freeing the
** returned value to avoid a memory leak.  However, if the F argument
** contains the DBSQL_SERIALIZE_NOCOPY bit, then no memory allocations
** are made, and the dbsql_serialize() function will return a pointer
** to the contiguous memory representation of the database that dbsql
** is currently using for that database, or NULL if no such contiguous
** memory representation of the database exists.  A contiguous memory
** representation of the database will usually only exist if there has
** been a prior call to [dbsql_deserialize(D,S,...)] with the same
** values of D and S.
** The size of the database is written into *P even if the
** DBSQL_SERIALIZE_NOCOPY bit is set but no contiguous copy
** of the database exists.
**
** After the call, if the DBSQL_SERIALIZE_NOCOPY bit had been set,
** the returned buffer content will remain accessible and unchanged
** until either the next write operation on the connection or when
** the connection is closed, and applications must not modify the
** buffer. If the bit had been clear, the returned buffer will not
** be accessed by dbsql after the call.
**
** A call to dbsql_serialize(D,S,P,F) might return NULL even if the
** DBSQL_SERIALIZE_NOCOPY bit is omitted from argument F if a memory
** allocation error occurs.
**
** This interface is omitted if dbsql is compiled with the
** [DBSQL_OMIT_DESERIALIZE] option.
*/
unsigned char *dbsql_serialize(
  DBSQL *db,           /* The database connection */
  const char *schema,   /* Which DB to serialize. ex: "main", "temp", ... */
  int64_t *pi_size, /* Write size of the DB here, if not NULL */
  unsigned int m_flags    /* Zero or more DBSQL_SERIALIZE_* flags */
);

/*
** CAPI3REF: Flags for dbsql_serialize
**
** Zero or more of the following constants can be OR-ed together for
** the F argument to [dbsql_serialize(D,S,P,F)].
**
** DBSQL_SERIALIZE_NOCOPY means that [dbsql_serialize()] will return
** a pointer to contiguous in-memory database that it is currently using,
** without making a copy of the database.  If dbsql is not currently using
** a contiguous in-memory database, then this option causes
** [dbsql_serialize()] to return a NULL pointer.  dbsql will only be
** using a contiguous in-memory database if it has been initialized by a
** prior call to [dbsql_deserialize()].
*/
#define DBSQL_SERIALIZE_NOCOPY 0x001   /* Do no memory allocations */

/*
** CAPI3REF: Deserialize a database
**
** The dbsql_deserialize(D,S,P,N,M,F) interface causes the
** [database connection] D to disconnect from database S and then
** reopen S as an in-memory database based on the serialization
** contained in P.  If S is a NULL pointer, the main database is
** used. The serialized database P is N bytes in size.  M is the size
** of the buffer P, which might be larger than N.  If M is larger than
** N, and the DBSQL_DESERIALIZE_READONLY bit is not set in F, then
** dbsql is permitted to add content to the in-memory database as
** long as the total size does not exceed M bytes.
**
** If the DBSQL_DESERIALIZE_FREEONCLOSE bit is set in F, then dbsql will
** invoke dbsql_free() on the serialization buffer when the database
** connection closes.  If the DBSQL_DESERIALIZE_RESIZEABLE bit is set, then
** dbsql will try to increase the buffer size using dbsql_realloc64()
** if writes on the database cause it to grow larger than M bytes.
**
** Applications must not modify the buffer P or invalidate it before
** the database connection D is closed.
**
** The dbsql_deserialize() interface will fail with DBSQL_BUSY if the
** database is currently in a read transaction or is involved in a backup
** operation.
**
** It is not possible to deserialize into the TEMP database.  If the
** S argument to dbsql_deserialize(D,S,P,N,M,F) is "temp" then the
** function returns DBSQL_ERROR.
**
** The deserialized database should not be in [WAL mode].  If the database
** is in WAL mode, then any attempt to use the database file will result
** in an [DBSQL_CANTOPEN] error.  The application can set the
** [file format version numbers] (bytes 18 and 19) of the input database P
** to 0x01 prior to invoking dbsql_deserialize(D,S,P,N,M,F) to force the
** database file into rollback mode and work around this limitation.
**
** If dbsql_deserialize(D,S,P,N,M,F) fails for any reason and if the
** DBSQL_DESERIALIZE_FREEONCLOSE bit is set in argument F, then
** [dbsql_free()] is invoked on argument P prior to returning.
**
** This interface is omitted if dbsql is compiled with the
** [DBSQL_OMIT_DESERIALIZE] option.
*/
int dbsql_deserialize(
  DBSQL *db,            /* The database connection */
  const char *schema,    /* Which DB to reopen with the deserialization */
  unsigned char *data,   /* The serialized database content */
  int64_t sz_db,     /* Number of bytes in the deserialization */
  int64_t sz_buf,    /* Total size of buffer data[] */
  unsigned m_flags         /* Zero or more DBSQL_DESERIALIZE_* flags */
);

/*
** CAPI3REF: Flags for dbsql_deserialize()
**
** The following are allowed values for the 6th argument (the F argument) to
** the [dbsql_deserialize(D,S,P,N,M,F)] interface.
**
** The DBSQL_DESERIALIZE_FREEONCLOSE means that the database serialization
** in the P argument is held in memory obtained from [dbsql_malloc64()]
** and that dbsql should take ownership of this memory and automatically
** free it when it has finished using it.  Without this flag, the caller
** is responsible for freeing any dynamically allocated memory.
**
** The DBSQL_DESERIALIZE_RESIZEABLE flag means that dbsql is allowed to
** grow the size of the database using calls to [dbsql_realloc64()].  This
** flag should only be used if DBSQL_DESERIALIZE_FREEONCLOSE is also used.
** Without this flag, the deserialized database cannot increase in size beyond
** the number of bytes specified by the M parameter.
**
** The DBSQL_DESERIALIZE_READONLY flag means that the deserialized database
** should be treated as read-only.
*/
#define DBSQL_DESERIALIZE_FREEONCLOSE 1 /* Call dbsql_free() on close */
#define DBSQL_DESERIALIZE_RESIZEABLE  2 /* Resize using dbsql_realloc64() */
#define DBSQL_DESERIALIZE_READONLY    4 /* Database is read-only */

/*
** CAPI3REF: Bind array values to the CARRAY table-valued function
**
** The dbsql_carray_bind_v2(S,I,P,N,F,X,D) interface binds an array value to
** parameter that is the first argument of the [carray() table-valued function].
** The S parameter is a pointer to the [prepared statement] that uses the
** carray() functions.  I is the parameter index to be bound.  I must be the
** index of the parameter that is the first argument to the carray()
** table-valued function. P is a pointer to the array to be bound, and N
** is the number of elements in the array.  The F argument is one of
** constants [DBSQL_CARRAY_INT32], [DBSQL_CARRAY_INT64],
** [DBSQL_CARRAY_DOUBLE], [DBSQL_CARRAY_TEXT],
** or [DBSQL_CARRAY_BLOB] to indicate the datatype of the array P.
**
** If the X argument is not a NULL pointer or one of the special
** values [DBSQL_STATIC] or [DBSQL_TRANSIENT], then dbsql will invoke
** the function X with argument D when it is finished using the data in P.
** The call to X(D) is a destructor for the array P. The destructor X(D)
** is invoked even if the call to dbsql_carray_bind_v2() fails. If the X
** parameter is the special-case value [DBSQL_STATIC], then dbsql assumes
** that the data static and the destructor is never invoked.  If the X
** parameter is the special-case value [DBSQL_TRANSIENT], then
** dbsql_carray_bind_v2() makes its own private copy of the data prior
** to returning and never invokes the destructor X.
**
** The dbsql_carray_bind() function works the same as dbsql_carray_bind_v2()
** with a D parameter set to P.  In other words,
** dbsql_carray_bind(S,I,P,N,F,X) is same as
** dbsql_carray_bind_v2(S,I,P,N,F,X,P).
*/
int dbsql_carray_bind_v2(
  dbsql_stmt_t *stmt,        /* Statement to be bound */
  int i,                      /* Parameter index */
  void *data,                /* Pointer to array data */
  int n_data,                  /* Number of data elements */
  int m_flags,                 /* CARRAY flags */
  void (*x_del)(void*),        /* Destructor for data */
  void *del                  /* Optional argument to del() */
);
int dbsql_carray_bind(
  dbsql_stmt_t *stmt,        /* Statement to be bound */
  int i,                      /* Parameter index */
  void *data,                /* Pointer to array data */
  int n_data,                  /* Number of data elements */
  int m_flags,                 /* CARRAY flags */
  void (*del)(void*)         /* Destructor for data */
);

/*
** CAPI3REF: Datatypes for the CARRAY table-valued function
**
** The fifth argument to the [dbsql_carray_bind()] interface musts be
** one of the following constants, to specify the datatype of the array
** that is being bound into the [carray table-valued function].
*/
#define DBSQL_CARRAY_INT32     0    /* Data is 32-bit signed integers */
#define DBSQL_CARRAY_INT64     1    /* Data is 64-bit signed integers */
#define DBSQL_CARRAY_DOUBLE    2    /* Data is doubles */
#define DBSQL_CARRAY_TEXT      3    /* Data is char* */
#define DBSQL_CARRAY_BLOB      4    /* Data is struct iovec */

/*
** Versions of the above #defines that omit the initial DBSQL_, for
** legacy compatibility.
*/
#define CARRAY_INT32     0    /* Data is 32-bit signed integers */
#define CARRAY_INT64     1    /* Data is 64-bit signed integers */
#define CARRAY_DOUBLE    2    /* Data is doubles */
#define CARRAY_TEXT      3    /* Data is char* */
#define CARRAY_BLOB      4    /* Data is struct iovec */

/*
** Undo the hack that converts floating point types to integer for
** builds on processors without floating point support.
*/
#ifdef DBSQL_OMIT_FLOATING_POINT
# undef double
#endif

#if defined(__wasi__)
# undef DBSQL_WASI
# define DBSQL_WASI 1
# ifndef DBSQL_OMIT_LOAD_EXTENSION
#  define DBSQL_OMIT_LOAD_EXTENSION
# endif
# ifndef DBSQL_THREADSAFE
#  define DBSQL_THREADSAFE 0
# endif
#endif

#ifdef __cplusplus
}  /* End of the 'extern "C"' block */
#endif
/* #endif for DBSQL_H will be added by mksqlite3.tcl */
