-s/\(vdbe_t *\*\)\{0,1\}\([a-zA-Z_][a-zA-Z0-9_]*\)->pNext\b/\1\2->next_vdbe/g
-s/\(vdbe_t *\*\)\{0,1\}\([a-zA-Z_][a-zA-Z0-9_]*\)\.pPrev\b/\1\2.prev_vdbe/g
-s/\(vdbe_t *\*\)\{0,1\}\([a-zA-Z_][a-zA-Z0-9_]*\)\.pNext\b/\1\2.next_vdbe/g
