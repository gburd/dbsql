-			__vdbe_mem_set_str(pDest, buf, payloadSize,
-			                   DBSQL_UTF8_ENCODED, __dbsql_free);
-		} else {
-			/* Other columns - would parse record here */
-			/* For now, return NULL */
-			__vdbe_mem_set_null(pDest);
-		}
-
-		/* Update cache status */
-		pC->cacheStatus = p->cacheCtr;
-	}
