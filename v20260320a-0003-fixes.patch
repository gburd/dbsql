-/* ===============================================================
- * OPCODE IMPLEMENTATIONS - Add these in __vdbe_exec() switch
- * =============================================================== */
-
-/* Opcode: NewRowid P1 P2 P3 * *
-** Synopsis: r[P2]=rowid
-**
-** Get a new integer rowid for cursor P1 and put it in register P2.
-** If P3 is not zero, P3 is a register holding the largest previously
-** generated rowid (for AUTOINCREMENT).
-**
-** The rowid generation uses a two-step algorithm:
-** 1. Try to find the largest existing rowid and add one
-** 2. If that fails (rowid = MAX_ROWID), use random selection
-*/
-case OP_NewRowid: {
-	i64 v;
-	VdbeCursor *pC;
-	int res;
-	int cnt;
-
-	v = 0;
-	res = 0;
-	DBSQL_ASSERT(pOp->p1>=0 && pOp->p1<p->nCursor);
-	pC = p->apCsr[pOp->p1];
-	DBSQL_ASSERT(pC!=0);
-	DBSQL_ASSERT(pC->isTable);
-	DBSQL_ASSERT(pC->uc.pCursor!=0);
-
-#define MAX_ROWID  (i64)( (((u64)0x7fffffff)<<32) | (u64)0xffffffff )
-
-	if (!pC->useRandomRowid) {
-		/* Try to use max(rowid)+1 */
-		rc = __sm_last_ex(pC->uc.pCursor, &res);
-		if (rc!=DBSQL_SUCCESS) {
-			goto abort_due_to_error;
-		}
-		if (res) {
-			v = 1;
-		} else {
-			v = __sm_integer_key(pC->uc.pCursor);
-			if (v>=MAX_ROWID) {
-				pC->useRandomRowid = 1;
-			} else {
-				v++;
-			}
-		}
-	}
-
-	/* P3 handling for AUTOINCREMENT */
-	if (pOp->p3) {
-		Mem *pMem;
-		DBSQL_ASSERT(pOp->p3>0);
-		pMem = &aMem[pOp->p3];
-		DBSQL_ASSERT(pMem->flags & MEM_Int);
-		if (pMem->u.i==MAX_ROWID || pC->useRandomRowid) {
-			rc = DBSQL_FULL;
-			goto abort_due_to_error;
-		}
-		if (v<pMem->u.i+1) {
-			v = pMem->u.i + 1;
-		}
-		pMem->u.i = v;
-	}
-
-	if (pC->useRandomRowid) {
-		/* Generate random rowid */
-		cnt = 0;
-		do {
-			__dbsql_random_bytes(db, sizeof(v), &v);
-			v &= (MAX_ROWID>>1);
-			v++;
-			rc = __sm_table_moveto(pC->uc.pCursor, (u64)v, 0, &res);
-			cnt++;
-		} while(rc==DBSQL_SUCCESS && res==0 && cnt<100);
-		if (rc!=DBSQL_SUCCESS) goto abort_due_to_error;
-		if (res==0) {
-			rc = DBSQL_FULL;
-			goto abort_due_to_error;
-		}
-	}
-
-	pC->deferredMoveto = 0;
-	pC->cacheStatus = CACHE_STALE;
-
-	/* Store result in register P2 */
-	aMem[pOp->p2].u.i = v;
-	aMem[pOp->p2].flags = MEM_Int;
-	break;
-}
-
-/* Opcode: Insert P1 P2 P3 P4 P5
-** Synopsis: intkey=r[P3] data=r[P2]
-**
-** Write an entry into table of cursor P1. A new entry is created if
-** it doesn't already exist or the data for an existing entry is
-** overwritten. Data is the value in register P2. The key is in
-** register P3 and must be an integer.
-**
-** P5 flags:
-**  OPFLAG_NCHANGE (0x01) - increment change count
-**  OPFLAG_LASTROWID (0x02) - set lastRowid
-**  OPFLAG_USESEEKRESULT (0x10) - use seekResult optimization
-**  OPFLAG_APPEND (0x08) - append to end
-**  OPFLAG_SAVEPOSITION (0x02) - save cursor position
-*/
-case OP_Insert: {
-	Mem *pData;
-	Mem *pKey;
-	VdbeCursor *pC;
-	int seekResult;
-	sm_payload_t x;
-	int flags;
-
-	pData = &aMem[pOp->p2];
-	pKey = &aMem[pOp->p3];
-	DBSQL_ASSERT(pOp->p1>=0 && pOp->p1<p->nCursor);
-	DBSQL_ASSERT(pKey->flags & MEM_Int);
-	pC = p->apCsr[pOp->p1];
-	DBSQL_ASSERT(pC!=0);
-	DBSQL_ASSERT(pC->uc.pCursor!=0);
-	DBSQL_ASSERT(pC->isTable);
-
-	/* Build payload structure */
-	memset(&x, 0, sizeof(x));
-	x.nKey = pKey->u.i;
-	x.pKey = 0;  /* Table btrees use nKey as rowid */
-	DBSQL_ASSERT((pData->flags & (MEM_Blob|MEM_Str))!=0 || pData->n==0);
-	x.pData = pData->z;
-	x.nData = pData->n;
-	x.nZero = (pData->flags & MEM_Zero) ? pData->u.nZero : 0;
-
-	/* Determine flags for __sm_insert_ex */
-	seekResult = 0;
-	flags = 0;
-	if (pOp->p5 & 0x10) {  /* OPFLAG_USESEEKRESULT */
-		seekResult = pC->seekResult;
-	}
-	if (pOp->p5 & 0x08) {  /* OPFLAG_APPEND */
-		flags |= 0x08;  /* SM_INSERT_APPEND */
-	}
-	if (pOp->p5 & 0x02) {  /* OPFLAG_SAVEPOSITION */
-		flags |= SM_DELETE_SAVEPOSITION;
-	}
-
-	rc = __sm_insert_ex(pC->uc.pCursor, &x, flags, seekResult);
-	if (rc!=DBSQL_SUCCESS) goto abort_due_to_error;
-
-	pC->deferredMoveto = 0;
-	pC->cacheStatus = CACHE_STALE;
-
-	/* Update change count and last rowid */
-	if (pOp->p5 & 0x01) {  /* OPFLAG_NCHANGE */
-		p->nChange++;
-		if (pOp->p5 & 0x02) {  /* OPFLAG_LASTROWID */
-			db->lastRowid = x.nKey;
-		}
-	}
-
-	break;
-}
-
-/* Opcode: Delete P1 P2 * * P5
-**
-** Delete the record at which cursor P1 is currently pointing.
-**
-** P2 is a combination of flags:
-**  0x01 (OPFLAG_NCHANGE) - increment change count
-**  0x02 (OPFLAG_SAVEPOSITION) - save cursor position
-**  0x04 (OPFLAG_AUXDELETE) - auxiliary delete operation
-**
-** P5 additional flags passed to __sm_delete_ex.
-**
-** If P2 has OPFLAG_NCHANGE set, the change counter is incremented.
-** If OPFLAG_SAVEPOSITION is set, the cursor is moved to the next or
-** previous entry after the delete.
-*/
-case OP_Delete: {
-	VdbeCursor *pC;
-	int opflags;
-
-	opflags = pOp->p2;
-	DBSQL_ASSERT(pOp->p1>=0 && pOp->p1<p->nCursor);
-	pC = p->apCsr[pOp->p1];
-	DBSQL_ASSERT(pC!=0);
-	DBSQL_ASSERT(pC->uc.pCursor!=0);
-	DBSQL_ASSERT(pC->deferredMoveto==0);
-
-	rc = __sm_delete_ex(pC->uc.pCursor, pOp->p5);
-	pC->cacheStatus = CACHE_STALE;
-	pC->seekResult = 0;
-	if (rc!=DBSQL_SUCCESS) goto abort_due_to_error;
-
-	if (opflags & 0x01) {  /* OPFLAG_NCHANGE */
-		p->nChange++;
-	}
-
-	break;
-}
-
-/* Opcode: MakeRecord P1 P2 P3 P4 P5
-** Synopsis: r[P3]=mkrec(r[P1@P2])
-**
-** Convert P2 registers beginning with P1 into the SQLite record format
-** and store the result in register P3.
-**
-** P4 is an optional string of length P2 that specifies column affinities:
-**  'a' - BLOB (no conversion)
-**  'b' - TEXT
-**  'c' - NUMERIC
-**  'd' - INTEGER
-**  'e' - REAL
-**
-** P5: file format version (typically 4 for SQLite 3.3.0+)
-**
-** The record format is:
-**  [varint: header size][varint: type0]...[varint: typeN-1][data0]...[dataN-1]
-*/
-case OP_MakeRecord: {
-	u8 *zNewRecord;
-	Mem *pRec;
-	Mem *pData0;
-	Mem *pLast;
-	int nField;
-	u64 nData;
-	int nHdr;
-	i64 nByte;
-	u32 serial_type;
-	int nVarint;
-	u8 *zHdr;
-	u8 *zPayload;
-	int file_format;
-
-	/* Identify input registers and output register */
-	nField = pOp->p2;
-	pData0 = &aMem[pOp->p1];
-	pLast = &pData0[nField-1];
-	Mem *pOut = &aMem[pOp->p3];
-
-	DBSQL_ASSERT(nField>0);
-	DBSQL_ASSERT(pOp->p1>0);
-	DBSQL_ASSERT(pOp->p1+nField <= (p->nMem+1 - p->nCursor)+1);
-
-	/* Apply column affinities if P4 is set */
-	if (pOp->p4.z) {
-		char *zAffinity = pOp->p4.z;
-		pRec = pData0;
-		while(pRec<=pLast && zAffinity[0]) {
-			/* Simplified affinity application */
-			/* Real implementation would call __vdbe_apply_affinity() */
-			zAffinity++;
-			pRec++;
-		}
-	}
-
-	/* Calculate space needed */
-	nData = 0;
-	nHdr = 0;
-	file_format = (pOp->p5 > 0) ? pOp->p5 : 1;
-
-	pRec = pData0;
-	while(pRec<=pLast) {
-		serial_type = __vdbe_serial_type(pRec, file_format, 0);
-		pRec->uTemp = serial_type;
-		nHdr += __vdbe_varint_len(serial_type);
-		nData += __vdbe_serial_type_len(serial_type);
-		pRec++;
-	}
-	nVarint = __vdbe_varint_len(nHdr);
-	nByte = nVarint + nHdr + nData;
-
-	/* Allocate space */
-	if (__dbsql_calloc(NULL, 1, nByte, &zNewRecord) == ENOMEM)
-		goto no_mem;
-
-	/* Write header size varint */
-	zHdr = (u8*)zNewRecord;
-	zPayload = zHdr + nVarint + nHdr;
-	zHdr += __vdbe_put_varint(zHdr, nHdr + nVarint);
-
-	/* Write serial types in header */
-	pRec = pData0;
-	while(pRec<=pLast) {
-		serial_type = pRec->uTemp;
-		zHdr += __vdbe_put_varint(zHdr, serial_type);
-		pRec++;
-	}
-
-	/* Write data */
-	pRec = pData0;
-	while(pRec<=pLast) {
-		serial_type = pRec->uTemp;
-		zPayload += __vdbe_serial_put(zPayload, pRec, serial_type);
-		pRec++;
-	}
-
-	/* Store result */
-	__entity_release_mem(pOut);
-	pOut->n = nByte;
-	pOut->z = (char*)zNewRecord;
-	pOut->flags = MEM_Blob | MEM_Dyn;
-	pOut->xDel = 0;
-
-	break;
-}
-
-/* Opcode: IdxInsert P1 P2 P3 P4 P5
-** Synopsis: key=r[P2]
-**
-** Write an entry into index of cursor P1. The key is in register P2.
-** P1 must be opened on an index cursor (not a table).
-**
-** P5 flags:
-**  0x01 (OPFLAG_NCHANGE) - increment change count
-**  0x08 (OPFLAG_APPEND) - append to end of index
-**  0x02 (OPFLAG_SAVEPOSITION) - save cursor position
-**  0x10 (OPFLAG_USESEEKRESULT) - use seekResult optimization
-*/
-case OP_IdxInsert: {
-	VdbeCursor *pC;
-	Mem *pKey;
-	sm_payload_t x;
-	int flags;
-
-	DBSQL_ASSERT(pOp->p1>=0 && pOp->p1<p->nCursor);
-	pC = p->apCsr[pOp->p1];
-	DBSQL_ASSERT(pC!=0);
-	DBSQL_ASSERT(!pC->isTable);
-	pKey = &aMem[pOp->p2];
-	DBSQL_ASSERT(pKey->flags & MEM_Blob);
-
