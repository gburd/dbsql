# The global gitignore excludes dist/; here dist/ is the build system.
!dist/

# Build output
build_unix/*
!build_unix/.gitkeep
*.o
*.lo
*.a
*.so
*.so.*
*.la
.libs/
.deps/
*.gcno
*.gcda
*.gcov
compile_commands.json

# Autotools output (dist/configure and config.hin are regenerated by s_config)
autom4te.cache/
dist/configure
dist/config.hin
dist/aclocal.m4
config.log
config.status

# Database and libdb environment files from test runs
*.db
__db.*
log.0*
*.dbsql

# Nix / direnv
result
result-*
.direnv/

# Editors and local tooling
.idea/
.vscode/
*.swp
*~
.DS_Store
.memelord/
.claude/settings.local.json
.claude/steering-domains.md
.kiro/
.agent-steering-domains.md
.mcp.json

# Agent archive (old reports, not guidance)
.agent/archive/

# Transform scratch
dist/transpile/work/
__pycache__/

# Validation-only transform of SQLite storage (dist/transpile/run --native)
/native/
