From 078056988388fa0a37d2fad5580b65c82ecf9903 Mon Sep 17 00:00:00 2001
From: Greg Burd <greg@burd.me>
Date: Sun, 11 Oct 2026 16:41:22 +0000
Subject: [PATCH 4/4] fix(recover): tolerate a foreign/empty data file during
 recovery

Recovery that must (re)open a data file referenced in the log fails with
EINVAL when that file still exists but is no longer a usable Berkeley DB
file -- empty, truncated, or replaced by a foreign file
(__fop_read_meta: "unexpected file type or format").  __dbreg_open_file
returned that EINVAL and __dbreg_register_recover mapped only ENOENT (a
missing file) to success, so the foreign-file EINVAL failed the whole
recovery.  __env_attach_regions then called __env_panic, which aborts
the process in diagnostic builds -- for a condition an application can
reach simply by leaving such a file behind.

A missing file is already tolerated: recovery records the failed open
and marks the fileid deleted so later log records for it are skipped.
Treat a foreign file (EINVAL) the same way.  Two sites:

  * __dbreg_do_open (src/dbreg/dbreg_util.c): on EINVAL, skip the
    in-memory-database retry (a foreign on-disk file is not an in-memory
    db) and record the failed open / mark the fileid deleted, exactly as
    for ENOENT.
  * __dbreg_register_recover (src/dbreg/dbreg_rec.c): map EINVAL, like
    ENOENT, to ret = 0 so recovery continues.

Everything else in the environment still recovers; only the foreign
file is skipped.

Test: test/db/recover_foreign_file.c creates two databases, SIGKILLs a
registered peer so the next open runs recovery, replaces one database
file with an empty file, reopens, and checks that the reopen succeeds,
the untouched second database keeps its committed record, and the
environment was not panicked.  The unpatched library aborts (DIAGNOSTIC)
or returns DB_RUNRECOVERY; the patched one recovers.

Found by dbsql (SQLite crash8 / ioerr / malloc, where a crashed writer
leaves a placeholder or deleted database behind).
---
 src/dbreg/dbreg_rec.c               |  14 +-
 src/dbreg/dbreg_util.c              |  26 +++-
 test/MANIFEST                       |   1 +
 test/db/recover_foreign_file.c      | 196 ++++++++++++++++++++++++++++
 test/db/run_recover_foreign_file.sh |  94 +++++++++++++
 5 files changed, 325 insertions(+), 6 deletions(-)
 create mode 100644 test/db/recover_foreign_file.c
 create mode 100755 test/db/run_recover_foreign_file.sh

diff --git a/src/dbreg/dbreg_rec.c b/src/dbreg/dbreg_rec.c
index e18f18e6e..2e8e4771d 100644
--- a/src/dbreg/dbreg_rec.c
+++ b/src/dbreg/dbreg_rec.c
@@ -160,10 +160,20 @@ __dbreg_register_recover(env, dbtp, lsnp, op, info)
 			}
 			/*
 			 * We treat ENOENT as OK since it's possible that
-			 * the file was renamed or deleted.
+			 * the file was renamed or deleted.  EINVAL means the
+			 * file still exists but is no longer a usable Berkeley
+			 * DB file (empty, truncated, or replaced by a foreign
+			 * file).  Recovery cannot restore logged state into it
+			 * and, like a missing file, must not fail the whole
+			 * recovery (which the environment-open path turns into
+			 * a panic, and a process abort in diagnostic builds)
+			 * for a condition an application can reach by leaving
+			 * such a file behind.  __dbreg_open_file has already
+			 * recorded the failed open and marked the fileid
+			 * deleted, so later records for it are skipped.
 			 * All other errors, we return.
 			 */
-			if (ret == ENOENT)
+			if (ret == ENOENT || ret == EINVAL)
 				ret = 0;
 		}
 		F_CLR(dblp, DBLOG_FORCE_OPEN);
diff --git a/src/dbreg/dbreg_util.c b/src/dbreg/dbreg_util.c
index 859b81bc5..fe9fdf097 100644
--- a/src/dbreg/dbreg_util.c
+++ b/src/dbreg/dbreg_util.c
@@ -741,8 +741,20 @@ skip_open:
 err:		if (cstat == TXN_UNEXPECTED)
 			goto not_right;
 		return (ret);
-	} else if (ret == ENOENT) {
+	} else if (ret == ENOENT || ret == EINVAL) {
 		/*
+		 * ENOENT: the file is missing.  EINVAL: the file exists but is
+		 * no longer a usable Berkeley DB file (empty, truncated, or
+		 * replaced by a foreign file -- __fop_read_meta reports
+		 * "unexpected file type or format").  Recovery cannot restore
+		 * logged state into either, and must not fail the whole
+		 * recovery (which the environment-open path turns into a panic
+		 * and, in diagnostic builds, a process abort) for a condition
+		 * an application can reach by leaving such a file behind.
+		 * Treat EINVAL exactly like ENOENT: record the open as failed
+		 * and mark the fileid deleted so later records for it are
+		 * skipped.
+		 *
 		 * If the open failed with ENOENT, retry it as a named in-mem
 		 * database.  Some record types do not distinguish between a
 		 * named in-memory database and one on-disk.  Therefore, an
@@ -750,8 +762,12 @@ err:		if (cstat == TXN_UNEXPECTED)
 		 * access this as a named in-mem database will not find it
 		 * on-disk, and we need to try to open it in-memory too.
 		 *     But don't do this for [P]REOPEN, since we're already
-		 * handling those cases specially, above.
+		 * handling those cases specially, above.  Only ENOENT (truly
+		 * absent) is worth an in-memory retry; a foreign on-disk file
+		 * is not an in-memory database.
 		 */
+		if (ret == EINVAL)
+			goto skip_inmem;
 		if (try_inmem == 0 &&
 		    opcode != DBREG_PREOPEN && opcode != DBREG_REOPEN && 
 		    opcode != DBREG_XREOPEN) {
@@ -762,9 +778,11 @@ err:		if (cstat == TXN_UNEXPECTED)
 		} else if (try_inmem != 0)
 			CLR_INMEM(dbp);
 
+skip_inmem:
 		/*
-		 * If it exists neither on disk nor in memory
-		 * record that the open failed in the txnlist.
+		 * If it exists neither on disk nor in memory, or exists as a
+		 * foreign file (EINVAL), record that the open failed in the
+		 * txnlist.
 		 */
 		if (id != TXN_INVALID && (ret = __db_txnlist_update(env,
 		    info, id, TXN_UNEXPECTED, NULL, &ret_stat, 1)) != 0)
