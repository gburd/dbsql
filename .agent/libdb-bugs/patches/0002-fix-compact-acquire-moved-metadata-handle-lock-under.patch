From 61fd2a246f62b77e00c1f541fb051f33419436d2 Mon Sep 17 00:00:00 2001
From: Greg Burd <greg@burd.me>
Date: Sun, 11 Oct 2026 16:26:40 +0000
Subject: [PATCH 2/4] fix(compact): acquire moved-metadata handle lock under
 the txn locker

When DB->compact(DB_FREE_SPACE) moves a sub-database's metadata page to
a lower page number, __db_move_metadata re-acquires the handle lock
keyed on the new page number.  When the compact runs inside a
transaction but the dbp was opened in an earlier transaction
(dbp->cur_txn == NULL), it took that lock under the dbp's own handle
locker as DB_LOCK_READ.

That self-deadlocks when the new (lower) page is one this same
transaction already holds a WRITE handle lock on -- for example a page
freed by a dbremove of a sibling sub-database earlier in the same
transaction, whose WRITE handle lock the transaction holds until commit
(TXN_REMOVE is deferred).  The READ get then blocks the one thread
against a lock it already owns under a different locker id.  It is not a
cycle, so neither DB_TXN_NOWAIT nor the deadlock detector can break it;
compact hangs forever in __fop_lock_handle -> __lock_get.

Acquire the lock under the transaction locker (WRITE) whenever a
transaction is in effect -- dbp->cur_txn if the dbp is still in its
opening txn, else dbc->txn -- and register a lock event so the lock is
traded to the handle locker at txn end, mirroring the cur_txn != NULL
path.  Only the no-transaction case keeps the READ-under-handle-locker
behavior.

Test: test/db/compact_subdb_remove.c creates four sub-databases, removes
one and compacts the survivors in one transaction (with a second handle
open on a survivor), and verifies every survivor reads back and the
removed one is gone.  It is SIGALRM-guarded so a regression is reported
as a failure, never a hung suite.  Control: compaction with no prior
remove.  The unpatched library hangs; the patched one passes.

Found by dbsql (SQLite auto_vacuum=FULL / VACUUM after DROP TABLE in one
transaction).
---
 src/db/db_compact.c                 |  52 ++++--
 test/MANIFEST                       |   1 +
 test/db/compact_subdb_remove.c      | 245 ++++++++++++++++++++++++++++
 test/db/run_compact_subdb_remove.sh |  93 +++++++++++
 4 files changed, 379 insertions(+), 12 deletions(-)
 create mode 100644 test/db/compact_subdb_remove.c
 create mode 100755 test/db/run_compact_subdb_remove.sh

diff --git a/src/db/db_compact.c b/src/db/db_compact.c
index c3395a6e8..cd4676ac4 100644
--- a/src/db/db_compact.c
+++ b/src/db/db_compact.c
@@ -1034,7 +1034,10 @@ __db_move_metadata(dbc, metap, c_data, pgs_donep)
 	BTREE *bt;
 	DB *dbp, *mdbp;
 	DB_LOCK handle_lock;
+	DB_LOCKER *lock_locker;
+	DB_TXN *lock_txn;
 	HASH *ht;
+	db_lockmode_t lock_mode;
 	int ret, t_ret;
 
 	dbp = dbc->dbp;
@@ -1059,22 +1062,47 @@ __db_move_metadata(dbc, metap, c_data, pgs_donep)
 
 	/*
 	 * The handle lock for subdb's depends on the metadata page number:
-	 * swap the old one for the new one.
+	 * swap the old one for the new one.  Acquire the handle lock keyed on
+	 * the new metadata page under the right locker.  Three cases:
+	 *
+	 *   1. The dbp is still in an opening transaction (cur_txn): the lock
+	 *	is already recorded as an event on that txn, so remove the
+	 *	stale event, re-get WRITE under the txn locker and re-register
+	 *	the event (below).
+	 *
+	 *   2. The compact itself runs in a transaction (dbc->txn), but the
+	 *	dbp was opened earlier (cur_txn == NULL): get the lock under
+	 *	the *transaction* locker, WRITE, and register an event so it is
+	 *	traded to the handle locker at txn end.  Using the dbp's own
+	 *	handle locker here self-deadlocks when the new page's
+	 *	handle-lock object is already held by this same transaction --
+	 *	e.g. the page was freed by a dbremove of a sibling
+	 *	sub-database earlier in the txn, whose WRITE handle lock the
+	 *	txn still holds until commit.  The get would then block a
+	 *	thread against a lock it already owns under a different locker
+	 *	id, which no DB_TXN_NOWAIT or deadlock detection can break (it
+	 *	is not a cycle).
+	 *
+	 *   3. No transaction at all: get READ under the handle locker.
 	 */
 	if (STD_LOCKING(dbc)) {
-		/*
-		 * If this dbp is still in an opening transaction we need to
-		 * change its lock in the event.
-		 */
-		if (dbp->cur_txn != NULL)
+		lock_txn = dbp->cur_txn != NULL ? dbp->cur_txn : dbc->txn;
+		if (dbp->cur_txn != NULL) {
 			__txn_remlock(dbp->env,
 			    dbp->cur_txn, &dbp->handle_lock, DB_LOCK_INVALIDID);
+			lock_locker = dbp->cur_locker;
+			lock_mode = DB_LOCK_WRITE;
+		} else if (dbc->txn != NULL) {
+			lock_locker = dbc->txn->locker;
+			lock_mode = DB_LOCK_WRITE;
+		} else {
+			lock_locker = dbp->locker;
+			lock_mode = DB_LOCK_READ;
+		}
 
 		handle_lock = dbp->handle_lock;
 		if ((ret = __fop_lock_handle(dbp->env, dbp,
-		    dbp->cur_locker != NULL ? dbp->cur_locker : dbp->locker,
-		    dbp->cur_txn != NULL ? DB_LOCK_WRITE : DB_LOCK_READ,
-		    NULL, 0)) != 0)
+		    lock_locker, lock_mode, NULL, 0)) != 0)
 			goto err;
 
 		/* Move all the other handles to the new lock. */
@@ -1082,10 +1110,10 @@ __db_move_metadata(dbc, metap, c_data, pgs_donep)
 		    &handle_lock, &dbp->handle_lock)) != 0)
 			goto err;
 
-		/* Reregister the event. */
-		if (dbp->cur_txn != NULL)
+		/* Reregister the event so the lock is traded at txn end. */
+		if (lock_txn != NULL)
 			ret = __txn_lockevent(dbp->env,
-			    dbp->cur_txn, dbp, &dbp->handle_lock, dbp->locker);
+			    lock_txn, dbp, &dbp->handle_lock, dbp->locker);
 	}
 	if (dbp->log_filename != NULL)
 		dbp->log_filename->meta_pgno = dbp->meta_pgno;
