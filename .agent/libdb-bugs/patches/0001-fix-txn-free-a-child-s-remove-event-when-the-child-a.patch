diff --git a/test/db/run_txn_remevent_leak.sh b/test/db/run_txn_remevent_leak.sh
new file mode 100755
index 000000000..6641bd7f5
--- /dev/null
+++ b/test/db/run_txn_remevent_leak.sh
@@ -0,0 +1,91 @@
+#!/bin/sh -
+#
+# $Id$
+#
+# run_txn_remevent_leak.sh --
+#	Build and run txn_remevent_leak.c, the regression test for the leak of
+#	a child transaction's TXN_REMOVE event (DB_ENV->dbremove inside a
+#	child txn) when the child or its parent aborts: __txn_doevents
+#	(src/txn/txn_util.c) kept the event "for the parent" on abort as well
+#	as on commit, but only a commit hands it over, so it was in no list.
+#	The test counts libdb's allocations through db_env_set_func_*.
+#
+# Exits non-zero on failure or hang.
+
+set -e
+
+BUILD=${BUILD:-.}
+# Anchor to THIS script's directory, not the caller's cwd.  ../test/db/X.c
+# only resolves when the build dir sits INSIDE the source tree; with a build
+# dir that is a sibling of the source tree -- the layout run_all.sh itself
+# documents, and the one the workflows use -- it resolved to nothing and the
+# compile failed with "no such file or directory".
+_HERE=$(cd "$(dirname "$0")" && pwd)
+SRC=${SRC:-$_HERE/txn_remevent_leak.c}
+HOME_DIR=${HOME_DIR:-TXN_REMEVENT_TESTDIR}
+TIMEOUT=${TIMEOUT:-180}
+
+# Prefer the STATIC library: on macOS the .dylib carries a baked-in install name
+# (/usr/local/BerkeleyDB.5.3/lib/...) which takes precedence over -rpath, so a
+# shared link runs against an uninstalled path and dyld aborts.  Static linking
+# avoids the dynamic loader entirely, which is what the other CI-wired suites
+# (e.g. test/fuzz) already do.  Fall back to the shared library if no static one
+# was built.
+LIB=""
+LIBRPATH=""
+for cand in "$BUILD"/libdb.a "$BUILD"/.libs/libdb-5.3.a "$BUILD"/.libs/libdb-*.a; do
+	if [ -f "$cand" ]; then LIB="$cand"; break; fi
+done
+if [ -z "$LIB" ]; then
+	for cand in "$BUILD"/.libs/libdb-5.3.so "$BUILD"/.libs/libdb-5.3.dylib \
+	    "$BUILD"/.libs/libdb-*.so "$BUILD"/.libs/libdb-*.dylib; do
+		if [ -f "$cand" ]; then LIB="$cand"; break; fi
+	done
+	[ -n "$LIB" ] && LIBRPATH="-Wl,-rpath,$(cd "$BUILD/.libs" && pwd)"
+fi
+[ -n "$LIB" ] || { echo "FAIL: no libdb library (static or shared) found under $BUILD"; exit 1; }
+
+# A static libdb needs its transitive deps named explicitly.
+EXTRALIBS=""
+for l in $(pkg-config --libs liburing 2>/dev/null); do EXTRALIBS="$EXTRALIBS $l"; done
+
+echo "Compiling txn_remevent_leak against $LIB"
+"${CC:-cc}" -g -O1 ${CFLAGS:-} -I"$BUILD" "$SRC" "$LIB" \
+    -lpthread $LIBRPATH $EXTRALIBS \
+    -o "$BUILD/txn_remevent_leak"
+
+# Start from an EMPTY home, regions included. Removing only *.db left the
+# previous run's __db.00N region files behind, so a second run (another arm,
+# another build) attached a region it did not create: on FreeBSD that is a
+# PANIC (a pshared mutex whose initialiser has exited, tracker row B3), and
+# between builds it is a DB_VERSION_MISMATCH. Either way a false red.
+[ -d "$HOME_DIR" ] && find "$HOME_DIR" -mindepth 1 -delete 2>/dev/null
+mkdir -p "$HOME_DIR"
+
+# `timeout` is GNU coreutils: present on Linux, absent on stock macOS (where it
+# is `gtimeout` if coreutils is installed).  Resolve it once; if neither exists,
+# run without a timeout rather than failing with rc=127.
+if command -v timeout >/dev/null 2>&1; then
+	TIMEOUT_CMD="timeout"
+elif command -v gtimeout >/dev/null 2>&1; then
+	TIMEOUT_CMD="gtimeout"
+else
+	TIMEOUT_CMD=""
+fi
+run_with_timeout() {
+	if [ -n "$TIMEOUT_CMD" ]; then
+		"$TIMEOUT_CMD" "$@"
+	else
+		shift	# drop the seconds argument
+		"$@"
+	fi
+}
+echo "Running txn_remevent_leak (timeout ${TIMEOUT}s)"
+if run_with_timeout "$TIMEOUT" "$BUILD/txn_remevent_leak"; then
+	echo "run_txn_remevent_leak.sh: PASS"
+	exit 0
+else
+	rc=$?
+	echo "run_txn_remevent_leak.sh: FAIL (rc=$rc)"
+	exit $rc
+fi
diff --git a/test/db/txn_remevent_leak.c b/test/db/txn_remevent_leak.c
new file mode 100644
index 000000000..01bc61886
--- /dev/null
+++ b/test/db/txn_remevent_leak.c
@@ -0,0 +1,236 @@
+/*-
+ * Copyright (c) 2026 libdb contributors.  All rights reserved.
+ *
+ * SPDX-License-Identifier: Sleepycat
+ *
+ * See the file LICENSE for redistribution information.
+ */
+
+/*-
+ * Regression test for the leak of a child transaction's remove event when
+ * the transaction is aborted.
+ *
+ * DB_ENV->dbremove inside a child transaction queues a TXN_REMOVE event on
+ * the child (__txn_remevent, from __db_inmem_remove for an in-memory
+ * database and __fop_ondisk_swap for an on-disk one).  When the child ends,
+ * __txn_doevents (src/txn/txn_util.c) hands a committing child's remove
+ * event to its parent; on abort it jumps straight to the free code, which
+ * still said "a child's event belongs to the parent now" and kept it, so the
+ * event -- in no list any more -- leaked with its name and file id.
+ *
+ * Every allocation and free libdb makes is counted through
+ * db_env_set_func_malloc/realloc/free, so the test needs no leak detector:
+ * after the environment is closed the number of live blocks must be the
+ * same as before the remove.
+ *
+ * Cases (each in a fresh private environment):
+ *   1. in-memory database, dbremove in a child, abort the parent   (leaked)
+ *   2. in-memory database, dbremove in a child, abort the child    (leaked)
+ *   3. on-disk database,   dbremove in a child, abort the parent   (leaked)
+ *   4. controls: no remove at all (calibrates the accounting); dbremove
+ *      committed through child and parent; dbremove in a top-level txn
+ *      that aborts -- no leak before or after the fix, and a committed
+ *      remove really removes.
+ */
+#include <sys/types.h>
+#include <errno.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+#include <db.h>
+
+static int failures = 0;
+static int checks = 0;
+
+#define CHECK(cond, ...) do {						\
+	checks++;							\
+	if (!(cond)) {							\
+		failures++;						\
+		printf("  FAIL: ");					\
+		printf(__VA_ARGS__);					\
+		printf("\n");						\
+	}								\
+} while (0)
+
+/*
+ * Allocation accounting.  Each block carries a header so free() of a block
+ * libdb allocated is counted, and foreign pointers (if any) pass through.
+ */
+#define	MAGIC	0x6c656b72u
+struct hdr { unsigned magic; unsigned pad; size_t size; };
+static long live;
+
+static void *
+t_malloc(size_t n)
+{
+	struct hdr *h;
+
+	if ((h = malloc(sizeof(*h) + n)) == NULL)
+		return (NULL);
+	h->magic = MAGIC;
+	h->size = n;
+	live++;
+	return (h + 1);
+}
+
+static void
+t_free(void *p)
+{
+	struct hdr *h;
+
+	if (p == NULL)
+		return;
+	h = (struct hdr *)p - 1;
+	if (h->magic != MAGIC) {
+		free(p);
+		return;
+	}
+	h->magic = 0;
+	live--;
+	free(h);
+}
+
+static void *
+t_realloc(void *p, size_t n)
+{
+	struct hdr *h, *nh;
+
+	if (p == NULL)
+		return (t_malloc(n));
+	h = (struct hdr *)p - 1;
+	if (h->magic != MAGIC)
+		return (realloc(p, n));
+	if ((nh = realloc(h, sizeof(*nh) + n)) == NULL)
+		return (NULL);
+	nh->size = n;
+	return (nh + 1);
+}
+
+enum end { ABORT_PARENT, ABORT_CHILD, COMMIT_BOTH, TOP_ABORT, NOREMOVE };
+
+/*
+ * run --
+ *	Create database "sub" (in memory, or file f.db), then remove it inside
+ *	a txn family that ends as 'how' says.  Returns the number of blocks
+ *	still live after the environment is closed that were allocated after
+ *	it was created: 0 unless something leaked.
+ */
+static long
+run(const char *label, int inmem, enum end how, int *existsp)
+{
+	char home[] = "/tmp/txnremleakXXXXXX";
+	DB_ENV *e;
+	DB_TXN *top, *child, *t;
+	DB *d;
+	long before;
+	int r;
+
+	if (mkdtemp(home) == NULL)
+		return (-1000);
+	before = live;		/* everything below is freed by e->close */
+	if ((r = db_env_create(&e, 0)) != 0)
+		return (-1001);
+	e->set_errfile(e, stderr);
+	if (inmem) {
+		e->log_set_config(e, DB_LOG_IN_MEMORY, 1);
+		e->set_lg_bsize(e, 4 * 1024 * 1024);
+	}
+	if ((r = e->open(e, home, DB_CREATE | DB_PRIVATE | DB_INIT_MPOOL |
+	    DB_INIT_LOCK | DB_INIT_LOG | DB_INIT_TXN, 0)) != 0) {
+		printf("  %s: env open: %s\n", label, db_strerror(r));
+		return (-1002);
+	}
+	e->txn_begin(e, NULL, &top, 0);
+	db_create(&d, e, 0);
+	r = d->open(d, top, inmem ? NULL : "f.db", inmem ? "sub" : NULL,
+	    DB_BTREE, DB_CREATE, 0644);
+	d->close(d, 0);
+	top->commit(top, 0);
+	CHECK(r == 0, "%s: create: %s", label, db_strerror(r));
+
+	e->txn_begin(e, NULL, &top, 0);
+	child = NULL;
+	if (how != TOP_ABORT && how != NOREMOVE)
+		e->txn_begin(e, top, &child, 0);
+	t = child != NULL ? child : top;
+	r = how == NOREMOVE ? 0 : e->dbremove(e, t, inmem ? NULL : "f.db",
+	    inmem ? "sub" : NULL, 0);
+	CHECK(r == 0, "%s: dbremove: %s", label, db_strerror(r));
+	switch (how) {
+	case ABORT_PARENT:
+		r = top->abort(top);
+		break;
+	case ABORT_CHILD:
+		if ((r = child->abort(child)) == 0)
+			r = top->commit(top, 0);
+		break;
+	case COMMIT_BOTH:
+		if ((r = child->commit(child, 0)) == 0)
+			r = top->commit(top, 0);
+		break;
+	case TOP_ABORT:
+	case NOREMOVE:
+		r = top->abort(top);
+		break;
+	}
+	CHECK(r == 0, "%s: end txn: %s", label, db_strerror(r));
+
+	/* Does the database still exist? */
+	db_create(&d, e, 0);
+	e->txn_begin(e, NULL, &top, 0);
+	*existsp = d->open(d, top, inmem ? NULL : "f.db",
+	    inmem ? "sub" : NULL, DB_BTREE, 0, 0644) == 0;
+	d->close(d, 0);
+	top->commit(top, 0);
+	e->close(e, 0);
+	return (live - before);
+}
+
+int
+main(void)
+{
+	long d;
+	int exists;
+
+	db_env_set_func_malloc(t_malloc);
+	db_env_set_func_realloc(t_realloc);
+	db_env_set_func_free(t_free);
+	printf("txn_remevent_leak: %s\n", db_version(NULL, NULL, NULL));
+
+	/* The accounting itself: no remove, nothing may stay live. */
+	d = run("calibrate inmem", 1, NOREMOVE, &exists);
+	CHECK(d == 0, "calibration inmem (no remove): %ld blocks live", d);
+	d = run("calibrate disk", 0, NOREMOVE, &exists);
+	CHECK(d == 0, "calibration disk (no remove): %ld blocks live", d);
+
+	d = run("inmem abort-parent", 1, ABORT_PARENT, &exists);
+	CHECK(d == 0, "inmem, dbremove in child, abort parent: %ld blocks "
+	    "leaked", d);
+	CHECK(exists, "inmem abort-parent: the aborted remove happened");
+
+	d = run("inmem abort-child", 1, ABORT_CHILD, &exists);
+	CHECK(d == 0, "inmem, dbremove in child, abort child: %ld blocks "
+	    "leaked", d);
+	CHECK(exists, "inmem abort-child: the aborted remove happened");
+
+	d = run("disk abort-parent", 0, ABORT_PARENT, &exists);
+	CHECK(d == 0, "on-disk, dbremove in child, abort parent: %ld blocks "
+	    "leaked", d);
+	CHECK(exists, "disk abort-parent: the aborted remove happened");
+
+	/* Controls. */
+	d = run("inmem commit", 1, COMMIT_BOTH, &exists);
+	CHECK(d == 0, "control inmem commit: %ld blocks leaked", d);
+	CHECK(!exists, "control inmem commit: database not removed");
+	d = run("disk commit", 0, COMMIT_BOTH, &exists);
+	CHECK(d == 0, "control disk commit: %ld blocks leaked", d);
+	CHECK(!exists, "control disk commit: database not removed");
+	d = run("inmem top-abort", 1, TOP_ABORT, &exists);
+	CHECK(d == 0, "control inmem top-level abort: %ld blocks leaked", d);
+	CHECK(exists, "control inmem top-abort: the aborted remove happened");
+
+	printf("txn_remevent_leak: %d checks, %d failures\n", checks,
+	    failures);
+	return (failures != 0);
+}
-- 
