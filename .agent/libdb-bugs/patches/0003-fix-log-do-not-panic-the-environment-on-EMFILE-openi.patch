diff --git a/test/db/log_emfile_nopanic.c b/test/db/log_emfile_nopanic.c
new file mode 100644
index 000000000..3ce9209e5
--- /dev/null
+++ b/test/db/log_emfile_nopanic.c
@@ -0,0 +1,184 @@
+/*-
+ * See the file LICENSE for redistribution information.
+ *
+ * SPDX-License-Identifier: Sleepycat
+ *
+ * $Id$
+ *
+ * log_emfile_nopanic -- regression test for the environment panic when a
+ * log-file open fails with EMFILE/ENFILE (the process is out of file
+ * descriptors).  __log_name (src/log/log_put.c) treated any non-ENOENT open
+ * error as fatal and panicked the whole environment; in diagnostic builds
+ * that aborts the process.  A transient, process-local descriptor shortage
+ * must instead be returned to the caller so it can free descriptors and
+ * retry, leaving the shared environment usable.
+ *
+ * The condition is injected deterministically through
+ * db_env_set_func_open: the installed open returns EMFILE for log files
+ * only.  No real descriptor exhaustion (and so no interference with the
+ * test harness) is needed.
+ */
+#include <sys/types.h>
+
+#include <errno.h>
+#include <stdarg.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+#include <fcntl.h>
+
+#include "db.h"
+
+#define	VALSZ	4096
+#define	NWRITES	200
+
+static int fails;
+static volatile int inject;		/* fail log-file opens while set */
+static volatile int injected;		/* count of injected failures */
+
+#define	CHECK(cond, ...)						\
+	do {								\
+		if (!(cond)) {						\
+			printf("  FAIL: ");				\
+			printf(__VA_ARGS__);				\
+			printf("\n");					\
+			fails++;					\
+		}							\
+	} while (0)
+
+static int
+my_open(const char *name, int flags, ...)
+{
+	va_list ap;
+	int mode;
+	const char *base;
+
+	va_start(ap, flags);
+	mode = va_arg(ap, int);
+	va_end(ap);
+
+	base = strrchr(name, '/');
+	base = base ? base + 1 : name;
+	if (inject && strncmp(base, "log.", 4) == 0) {
+		injected++;
+		errno = EMFILE;
+		return (-1);
+	}
+	return (open(name, flags, mode));
+}
+
+/*
+ * run -- write enough to roll the log so a new log file must be opened.
+ * With do_inject set, that open gets EMFILE.  Afterwards the environment
+ * must still be alive (a read returns something other than DB_RUNRECOVERY).
+ */
+static void
+run(const char *home, int do_inject)
+{
+	static char big[VALSZ];
+	char kb[16];
+	DB_ENV *e;
+	DB *d;
+	DBT k, v;
+	int i, r, panicked;
+
+	fails = 0;
+	injected = 0;
+	if ((r = db_env_create(&e, 0)) != 0) {
+		CHECK(0, "db_env_create: %s", db_strerror(r));
+		return;
+	}
+	e->set_errpfx(e, "log_emfile_nopanic");
+	(void)e->set_lg_max(e, 64 * 1024);	/* small logs: roll quickly */
+	if ((r = e->open(e, home, DB_CREATE | DB_INIT_LOCK | DB_INIT_LOG |
+	    DB_INIT_MPOOL | DB_INIT_TXN | DB_THREAD, 0644)) != 0) {
+		CHECK(0, "env open: %s", db_strerror(r));
+		(void)e->close(e, 0);
+		return;
+	}
+	if ((r = db_create(&d, e, 0)) != 0 ||
+	    (r = d->open(d, NULL, "f.db", NULL, DB_BTREE,
+	    DB_CREATE | DB_AUTO_COMMIT | DB_THREAD, 0644)) != 0) {
+		CHECK(0, "db open: %s", db_strerror(r));
+		(void)e->close(e, 0);
+		return;
+	}
+
+	memset(&k, 0, sizeof(k));
+	memset(&v, 0, sizeof(v));
+
+	inject = do_inject;
+	r = 0;
+	for (i = 0; i < NWRITES && r == 0; i++) {
+		snprintf(kb, sizeof(kb), "k%06d", i);
+		k.data = kb;
+		k.size = (u_int32_t)strlen(kb);
+		v.data = big;
+		v.size = sizeof(big);
+		r = d->put(d, NULL, &k, &v, DB_AUTO_COMMIT);
+	}
+	inject = 0;
+
+	if (do_inject) {
+		CHECK(injected > 0,
+		    "injection never forced a log open (inconclusive)");
+		CHECK(r == EMFILE || r == ENFILE,
+		    "write under EMFILE returned %d (%s), want EMFILE",
+		    r, db_strerror(r));
+	} else
+		CHECK(r == 0, "control write failed: %s", db_strerror(r));
+
+	/* Probe: is the environment panicked? */
+	{
+		DBT pk, pv;
+		memset(&pk, 0, sizeof(pk));
+		memset(&pv, 0, sizeof(pv));
+		pk.data = "k000000";
+		pk.size = 7;
+		pv.flags = DB_DBT_MALLOC;
+		r = d->get(d, NULL, &pk, &pv, 0);
+		panicked = (r == DB_RUNRECOVERY);
+		if (r == 0)
+			free(pv.data);
+	}
+	CHECK(!panicked, "environment was panicked by a transient EMFILE");
+
+	(void)d->close(d, 0);
+	(void)e->close(e, 0);
+}
+
+int
+main(int argc, char *argv[])
+{
+	char home[] = "./LOG_EMFILE_NOPANIC.XXXXXX";
+	int total;
+
+	(void)argc;
+	(void)argv;
+
+	printf("log_emfile_nopanic: %s\n", db_version(NULL, NULL, NULL));
+
+	(void)db_env_set_func_open(my_open);
+
+	total = 0;
+
+	/* Control: no injection, writes and reads succeed. */
+	if (mkdtemp(home) == NULL)
+		return (printf("mkdtemp: control\n"), 99);
+	printf(" control (no injection):\n");
+	run(home, 0);
+	total += fails;
+
+	/* The defect: EMFILE on a log open must not panic the environment. */
+	strcpy(home, "./LOG_EMFILE_NOPANIC.XXXXXX");
+	if (mkdtemp(home) == NULL)
+		return (printf("mkdtemp: inject\n"), 99);
+	printf(" EMFILE injected on log open:\n");
+	run(home, 1);
+	total += fails;
+
+	printf("log_emfile_nopanic: %d failure%s\n",
+	    total, total == 1 ? "" : "s");
+	return (total == 0 ? 0 : 1);
+}
diff --git a/test/db/run_log_emfile_nopanic.sh b/test/db/run_log_emfile_nopanic.sh
new file mode 100755
index 000000000..0f5127122
--- /dev/null
+++ b/test/db/run_log_emfile_nopanic.sh
@@ -0,0 +1,92 @@
+#!/bin/sh -
+#
+# $Id$
+#
+# run_log_emfile_nopanic.sh --
+#	Build and run log_emfile_nopanic.c, the regression test for the
+#	environment panic when a log-file open fails with EMFILE/ENFILE.
+#	__log_name (src/log/log_put.c) treated any non-ENOENT open error as
+#	fatal and panicked the environment (abort, in diagnostic builds); a
+#	transient descriptor shortage must instead be returned to the caller.
+#	The condition is injected through db_env_set_func_open, so no real
+#	descriptor exhaustion is needed.
+#
+# Exits non-zero on failure or hang.
+
+set -e
+
+BUILD=${BUILD:-.}
+# Anchor to THIS script's directory, not the caller's cwd.  ../test/db/X.c
+# only resolves when the build dir sits INSIDE the source tree; with a build
+# dir that is a sibling of the source tree -- the layout run_all.sh itself
+# documents, and the one the workflows use -- it resolved to nothing and the
+# compile failed with "no such file or directory".
+_HERE=$(cd "$(dirname "$0")" && pwd)
+SRC=${SRC:-$_HERE/log_emfile_nopanic.c}
+HOME_DIR=${HOME_DIR:-LOG_EMFILE_NOPANIC}
+TIMEOUT=${TIMEOUT:-180}
+
+# Prefer the STATIC library: on macOS the .dylib carries a baked-in install name
+# (/usr/local/BerkeleyDB.5.3/lib/...) which takes precedence over -rpath, so a
+# shared link runs against an uninstalled path and dyld aborts.  Static linking
+# avoids the dynamic loader entirely, which is what the other CI-wired suites
+# (e.g. test/fuzz) already do.  Fall back to the shared library if no static one
+# was built.
+LIB=""
+LIBRPATH=""
+for cand in "$BUILD"/libdb.a "$BUILD"/.libs/libdb-5.3.a "$BUILD"/.libs/libdb-*.a; do
+	if [ -f "$cand" ]; then LIB="$cand"; break; fi
+done
+if [ -z "$LIB" ]; then
+	for cand in "$BUILD"/.libs/libdb-5.3.so "$BUILD"/.libs/libdb-5.3.dylib \
+	    "$BUILD"/.libs/libdb-*.so "$BUILD"/.libs/libdb-*.dylib; do
+		if [ -f "$cand" ]; then LIB="$cand"; break; fi
+	done
+	[ -n "$LIB" ] && LIBRPATH="-Wl,-rpath,$(cd "$BUILD/.libs" && pwd)"
+fi
+[ -n "$LIB" ] || { echo "FAIL: no libdb library (static or shared) found under $BUILD"; exit 1; }
+
+# A static libdb needs its transitive deps named explicitly.
+EXTRALIBS=""
+for l in $(pkg-config --libs liburing 2>/dev/null); do EXTRALIBS="$EXTRALIBS $l"; done
+
+echo "Compiling log_emfile_nopanic against $LIB"
+"${CC:-cc}" -g -O1 ${CFLAGS:-} -I"$BUILD" "$SRC" "$LIB" \
+    -lpthread $LIBRPATH $EXTRALIBS \
+    -o "$BUILD/log_emfile_nopanic"
+
+# Start from an EMPTY home, regions included. Removing only *.db left the
+# previous run's __db.00N region files behind, so a second run (another arm,
+# another build) attached a region it did not create: on FreeBSD that is a
+# PANIC (a pshared mutex whose initialiser has exited, tracker row B3), and
+# between builds it is a DB_VERSION_MISMATCH. Either way a false red.
+[ -d "$HOME_DIR" ] && find "$HOME_DIR" -mindepth 1 -delete 2>/dev/null
+mkdir -p "$HOME_DIR"
+
+# `timeout` is GNU coreutils: present on Linux, absent on stock macOS (where it
+# is `gtimeout` if coreutils is installed).  Resolve it once; if neither exists,
+# run without a timeout rather than failing with rc=127.
+if command -v timeout >/dev/null 2>&1; then
+	TIMEOUT_CMD="timeout"
+elif command -v gtimeout >/dev/null 2>&1; then
+	TIMEOUT_CMD="gtimeout"
+else
+	TIMEOUT_CMD=""
+fi
+run_with_timeout() {
+	if [ -n "$TIMEOUT_CMD" ]; then
+		"$TIMEOUT_CMD" "$@"
+	else
+		shift	# drop the seconds argument
+		"$@"
+	fi
+}
+echo "Running log_emfile_nopanic (timeout ${TIMEOUT}s)"
+if run_with_timeout "$TIMEOUT" "$BUILD/log_emfile_nopanic"; then
+	echo "run_log_emfile_nopanic.sh: PASS"
+	exit 0
+else
+	rc=$?
+	echo "run_log_emfile_nopanic.sh: FAIL (rc=$rc)"
+	exit $rc
+fi
-- 
