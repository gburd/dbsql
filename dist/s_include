# Copyright (c) 2007-2026  The DBSQL Group, Inc.
#
# s_include -- build src/sm/sm_ext.h from the "PUBLIC:" prototype lines in
# the hand-written storage manager, in libdb style.  (The transformed SQL
# layer keeps upstream's prototypes in src/inc/dbsql_int.h.)
# Run from the dist directory.

set -e
out=../src/sm/sm_ext.h
tmp=/tmp/__dbsql_ext.$$
trap 'rm -f $tmp' 0 1 2 3 13 15
{
	echo "/* DO NOT EDIT: automatically built by dist/s_include. */"
	echo "#ifndef	_SM_EXT_H_"
	echo "#define	_SM_EXT_H_"
	echo ""
	echo "#if defined(__cplusplus)"
	echo "extern \"C\" {"
	echo "#endif"
	echo ""
	# "PUBLIC:" lines, in block comments (" * PUBLIC: ...") or one-line
	# comments ("/* PUBLIC: ... */"); a prototype continues on following
	# PUBLIC: lines until its ';'.
	for f in ../src/sm/*.c; do
		sed -n -e 's|^/\* PUBLIC: \(.*\) \*/$|\1|p' \
		    -e 's|^/\* PUBLIC: \(.*\)$|\1|p' \
		    -e 's|^ \* PUBLIC: \(.*\) \*/$|\1|p' \
		    -e 's|^ \* PUBLIC: \(.*\)$|\1|p' "$f" |
		    awk '{ line = line (line == "" ? "" : " ") $0 }
			/;[ \t]*$/ { gsub(/[ \t]+/, " ", line); print line; line = "" }' |
		    sed -e 's/ __P((\(.*\)));/(\1);/'
	done
	echo ""
	echo "#if defined(__cplusplus)"
	echo "}"
	echo "#endif"
	echo "#endif /* !_SM_EXT_H_ */"
} > $tmp
cmp -s $tmp $out || { cp $tmp $out; echo "s_include: updated $out"; }
