DBSQL_VERSION_MAJOR=1
DBSQL_VERSION_MINOR=0
DBSQL_VERSION_PATCH=0
DBSQL_VERSION="$DBSQL_VERSION_MAJOR.$DBSQL_VERSION_MINOR.$DBSQL_VERSION_PATCH"
DBSQL_VERSION_NUMBER=`printf "%d%03d%03d" $DBSQL_VERSION_MAJOR $DBSQL_VERSION_MINOR $DBSQL_VERSION_PATCH`

# The upstream releases this tree is generated from / built against.
DBSQL_SQLITE_VERSION="3.53.4"
DBSQL_LIBDB_VERSION="2026.10.4"

DBSQL_RELEASE_DATE="October 2026"
DBSQL_VERSION_STRING="DBSQL $DBSQL_VERSION ($DBSQL_RELEASE_DATE; SQLite $DBSQL_SQLITE_VERSION SQL, libdb $DBSQL_LIBDB_VERSION storage)"
