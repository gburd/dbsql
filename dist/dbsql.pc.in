prefix=@prefix@
exec_prefix=@exec_prefix@
libdir=@libdir@
includedir=@includedir@

Name: dbsql
Description: SQL database engine (SQLite @DBSQL_SQLITE_VERSION@ SQL on libdb @DBSQL_LIBDB_VERSION@ storage)
Version: @DBSQL_VERSION@
Libs: -L${libdir} -ldbsql-@DBSQL_VERSION_MAJOR@.@DBSQL_VERSION_MINOR@
Libs.private: @DB_LIBS@ @ICU_LIBS@ @LIBS@
Cflags: -I${includedir}
