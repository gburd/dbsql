#!/usr/bin/env python3
"""mk-known-failures RESULTS NATIVE CLASSIFIED > known-failures.txt

Build test/tcl/known-failures.txt from a dbsql suite run (RESULTS), the
same suite on stock SQLite storage (NATIVE) and classify.sh output
(CLASSIFIED: name<TAB>category<TAB>first failure).  Every file that does
not pass on dbsql gets a reason:

  [native]       fails on stock SQLite too (platform / harness)
  [libdb-Rn]     a reported libdb defect (.agent/libdb-bugs)
  [<category>]   a listed divergence (.agent/steering/DIVERGENCES.md)
  [triage]       not yet explained: a bug until shown otherwise
"""
import sys

# Files traced to a specific reported libdb defect.
LIBDB = {
	'without_rowid1': 'R1', 'upfrom2': 'R1',
	'shell1': 'R6', 'savepoint4': 'R6', 'crash': 'R6', 'crash2': 'R6',
	'crash3': 'R6', 'crash4': 'R6', 'crash5': 'R6', 'crash6': 'R6',
	'crash7': 'R6', 'crash8': 'R6',
}
# Files whose failures were read and traced to a divergence, where the
# classifier's API scan does not see it.
MANUAL = {
	'alterauth2': 'naming',
	'auth': 'naming',
	'alter': 'naming',
	'attach': 'concurrency',
	'attach2': 'lockstatus',
	'busy': 'concurrency', 'busy2': 'concurrency', 'capi2': 'concurrency',
	'capi3b': 'concurrency', 'lock': 'concurrency', 'lock2': 'concurrency',
	'lock3': 'concurrency', 'thread1': 'concurrency',
	'tkt4018': 'concurrency', 'exclusive': 'concurrency',
	'savepoint': 'lockstatus', 'capi3': 'fileformat',
	'tempdb': 'pager', 'stmt': 'journal', 'backup2': 'concurrency',
	'symlink': 'fileformat', 'shell2': 'fileformat', 'shellA': 'fileformat',
	'strict2': 'droptable',
	'alterfault': 'filecopy', 'fuzz3': 'fileformat',
	'swarmvtab': 'vfs',
}
NOTES = {
	'naming': 'dbsql_autoindex_* sorts before user names (sqlite_* after)',
	'concurrency': 'WAL-mode concurrency: a reader does not block commit',
	'lockstatus': 'lock_status reports "unknown"',
	'fileformat': 'SQLite file format / header expected',
	'journal': 'rollback journal / WAL / statement journal expected',
	'pager': 'SQLite pager pages or counters expected',
	'vfs': 'database I/O through a test VFS or fault injector expected',
	'memdb': 'serialize/deserialize/memdb not built',
	'droptable': 'dropped table numbers are retired, not reused',
	'filecopy': 'restores a database by copying test.db*; a libdb database is its file plus the environment log',
}


def load(p):
	d = {}
	for line in open(p):
		if '\t' in line:
			k, v = line.rstrip('\n').split('\t', 1)
			d[k] = v
	return d


res, nat = load(sys.argv[1]), load(sys.argv[2])
cls = {}
for line in open(sys.argv[3]):
	f = line.rstrip('\n').split('\t')
	if len(f) >= 2:
		cls[f[0]] = (f[1], f[2] if len(f) > 2 else '')

print('# test/tcl/known-failures.txt -- generated by '
    'dist/transpile/mk-known-failures; edit the tables there.')
print('# name<TAB>[reason] result: detail.  Reasons are defined in '
    '.agent/steering/DIVERGENCES.md;')
print('# [triage] entries are unexplained and count as bugs.')
for name in sorted(res):
	r = res[name]
	if r.startswith('PASS'):
		continue
	if not nat.get(name, '').startswith('PASS'):
		tag, why = 'native', 'also fails on stock SQLite: ' + nat.get(name, '?')
	elif name in LIBDB:
		tag = 'libdb-' + LIBDB[name]
		why = '.agent/libdb-bugs ' + LIBDB[name]
	elif name in MANUAL:
		tag = MANUAL[name]
		why = NOTES[tag]
	elif name in cls and cls[name][0] in NOTES:
		tag = cls[name][0]
		why = NOTES[tag]
	else:
		tag = 'triage'
		why = cls.get(name, ('', ''))[1][:100] or 'not classified'
	print('%s\t[%s] %s: %s' % (name, tag, r, why))
