#!/usr/bin/env python3
"""
tests -- prepare SQLite's TCL test suite for a dbsql testfixture.

usage: tests SQLITE_DIR OUT_DIR

Copies SQLITE_DIR/test (and ext/fts5/test, ext/misc test helpers) to
OUT_DIR, rewriting the dbsql-visible names exactly as dist/transpile/run
rewrites the C sources:

  Tcl commands     sqlite3 -> dbsql, sqlite3_foo -> dbsql_foo
  SQL names        sqlite_schema/master/sequence/stat* -> dbsql_*
  constants        SQLITE_FOO -> DBSQL_FOO
  test hooks       sqlite_search_count ... -> dbsql_search_count

Test *names* and file names keep upstream spelling, so results compare
line-by-line with a stock run.
"""
import os, re, shutil, sys

# (pattern, replacement, sql) -- sql=True marks a rename of an SQL-level
# reserved name (sqlite_schema, sqlite_stat1 ...), which --keep-sql-names
# leaves alone.
RULES = [
	# Tcl procs whose dbsql_ spelling would replace a testfixture command
	# (bind.test's "proc sqlite_step" vs the C command for sqlite3_step).
	(re.compile(r'\bsqlite_step\b'), 'dbsql_legacy_step', False),
	(re.compile(r'\bsqlite_temp_schema\b'), 'dbsql_temp_schema', True),
	(re.compile(r'\bsqlite_temp_master\b'), 'dbsql_temp_master', True),
	(re.compile(r'sqlite_'), 'dbsql_', True),
	# mixed-case spellings of reserved SQL names (SqLiTe_master,
	# SQLite_stat1): names are case-insensitive, so any case maps
	(re.compile(r'\b(?!SQLITE_|sqlite_)[Ss][Qq][Ll][Ii][Tt][Ee]_(?=[a-z])'),
	    'Dbsql_', True),
	# a GLOB over reserved names: name NOT GLOB 'sqlite*'
	(re.compile(r"(GLOB ')sqlite\*'"), r"\1dbsql*'", True),
	(re.compile(r'\bsqlite3_'), 'dbsql_', False),
	(re.compile(r'\bSQLITE_'), 'DBSQL_', False),
	(re.compile(r'\bsqliteX_'), 'dbsqlX_', True),
	(re.compile(r'sqlite\\\\_'), r'dbsql\\\\_', True),
	(re.compile(r'\bsqlite3\b'), 'dbsql', False),
	# the legacy Tcl command name, only where it is used as a command
	(re.compile(r'(^|[\[;{]\s*|\n\s*)sqlite(\s+(?:db|complete|\$|-))', re.M),
	    r'\1dbsql_legacy\2', False),
	(re.compile(r'\bSqlite3?\b'), 'Dbsql', False),
]

SKIP_DIRS = ('fuzzdata',)


KEEP_SQL_NAMES = False


def rewrite(text):
	for rx, rep, sql in RULES:
		if KEEP_SQL_NAMES and sql:
			continue
		text = rx.sub(rep, text)
	return text


def main(src, out):
	tdir = os.path.join(src, 'test')
	os.makedirs(out, exist_ok=True)
	for name in sorted(os.listdir(tdir)):
		p = os.path.join(tdir, name)
		if os.path.isdir(p):
			continue
		q = os.path.join(out, name)
		if name.endswith(('.test', '.tcl', '.txt', '.sql')) or '.' not in name:
			try:
				text = open(p, encoding='utf-8').read()
			except UnicodeDecodeError:
				shutil.copyfile(p, q)
				continue
			open(q, 'w', encoding='utf-8').write(rewrite(text))
		else:
			shutil.copyfile(p, q)
	# ext/fts5/test lives under ../ext/fts5/test relative to test/
	f5 = os.path.join(src, 'ext', 'fts5', 'test')
	q5 = os.path.join(out, '..', 'ext', 'fts5', 'test')
	os.makedirs(q5, exist_ok=True)
	for name in sorted(os.listdir(f5)):
		p = os.path.join(f5, name)
		if os.path.isfile(p):
			text = open(p, encoding='utf-8', errors='surrogateescape').read()
			open(os.path.join(q5, name), 'w', encoding='utf-8',
			    errors='surrogateescape').write(rewrite(text))


if __name__ == '__main__':
	args = [a for a in sys.argv[1:] if a != '--keep-sql-names']
	KEEP_SQL_NAMES = len(args) != len(sys.argv) - 1
	main(args[0], args[1])
