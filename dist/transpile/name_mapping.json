{
  "description": "DBSQL naming conventions reference for SQLite to DBSQL transpilation",
  "version": "1.0",
  "patterns": {
    "function_naming": {
      "rule": "Add __ prefix and convert CamelCase to snake_case",
      "examples": [
        "sqliteParseBegin -> __parse_begin",
        "sqliteVdbeExec -> __vdbe_exec",
        "sqliteLocateTable -> __locate_table",
        "sqliteExprCode -> __expr_code",
        "sqliteFindFunction -> __find_function"
      ]
    },
    "type_naming": {
      "rule": "Add _t suffix to all typedef struct names",
      "examples": [
        "Table -> table_t",
        "Vdbe -> vdbe_t",
        "Expr -> expr_t",
        "Parser -> parser_t",
        "Token -> token_t",
        "Index -> index_t",
        "Select -> select_t"
      ]
    },
    "type_substitutions": {
      "u8": "u_int8_t",
      "u16": "u_int16_t",
      "u32": "u_int32_t",
      "i64": "int64_t",
      "u64": "uint64_t",
      "sqlite_*": "dbsql_*"
    },
    "bdb_types_preserved": [
      "DB",
      "DBT",
      "DBC",
      "DB_ENV",
      "DB_TXN",
      "DB_SEQUENCE",
      "DB_MPOOLFILE",
      "DB_LOCK",
      "DB_LOGC",
      "DB_LSN",
      "db_recno_t",
      "db_seq_t",
      "db_threadid_t",
      "db_pgno_t"
    ],
    "hungarian_notation": {
      "description": "Prefix conventions for struct field names",
      "z": {
        "meaning": "zero-terminated string (char *)",
        "examples": [
          "char *zName",
          "char *zDflt",
          "char *zType",
          "char *zDatabase",
          "char *zAlias",
          "char *zSelect",
          "char *zErrMsg",
          "char *zTo",
          "char *zCol"
        ]
      },
      "n": {
        "meaning": "count/number/length (int)",
        "examples": [
          "int nArg",
          "int nCol",
          "int nColumn",
          "int nExpr",
          "int nAlloc",
          "int nId",
          "int nLevel",
          "int nLimit",
          "int nOffset",
          "int nErr",
          "int nTab",
          "int nMem",
          "int nSet",
          "int nAgg",
          "int nVar"
        ]
      },
      "a": {
        "meaning": "array pointer (type_t *)",
        "examples": [
          "column_t *aCol",
          "agg_expr_t *aAgg",
          "db_t *aDb"
        ]
      },
      "p": {
        "meaning": "pointer to single item or list (type_t *)",
        "examples": [
          "func_def_t *pNext",
          "void *pUserData",
          "table_t *pTable",
          "index_t *pIndex",
          "expr_t *pExpr",
          "select_t *pSelect"
        ]
      },
      "i": {
        "meaning": "index value/integer index (int)",
        "examples": [
          "int iPKey",
          "int iFrom",
          "int iTable",
          "int iColumn",
          "int iAgg",
          "int iCursor",
          "int iMem",
          "int iCur",
          "int iLeftJoin",
          "int iContinue",
          "int iBreak",
          "int iLimit",
          "int iOffset"
        ]
      },
      "x": {
        "meaning": "function pointer",
        "examples": [
          "void (*xFunc)(dbsql_func_t*,int,const char**)",
          "void (*xStep)(dbsql_func_t*,int,const char**)",
          "void (*xFinalize)(dbsql_func_t*)"
        ]
      },
      "no_prefix": {
        "meaning": "scalar types, enums, flags",
        "examples": [
          "u_int8_t readOnly",
          "int dataType",
          "u_int32_t flags"
        ]
      }
    },
    "header_markers": {
      "PUBLIC": "Internal API - generates prototypes in inc/*_ext.h",
      "STATIC": "File-local functions - generates prototypes in inc/*_decl.h",
      "EXTERN": "External public API - generates prototypes in dbsql.h"
    },
    "code_style": {
      "function_declarations": "ANSI C (not K&R style)",
      "line_length": "79 characters maximum",
      "indent": "tabs for indentation"
    }
  },
  "function_mappings": {
    "description": "Known SQLite to DBSQL function name mappings extracted from existing code",
    "sqliteLocateTable": "__locate_table",
    "sqliteFindTable": "__find_table",
    "sqliteFindIndex": "__find_index",
    "sqliteIdListAppend": "__id_list_append",
    "sqliteIdListDup": "__id_list_dup",
    "sqliteSrcListAppend": "__src_list_append",
    "sqliteSrcListDup": "__src_list_dup",
    "sqliteSrcListLookup": "__src_list_lookup",
    "sqliteExpr": "__expr",
    "sqliteExprFunction": "__expr_function",
    "sqliteExprDup": "__expr_dup",
    "sqliteExprListDup": "__expr_list_dup",
    "sqliteExprListAppend": "__expr_list_append",
    "sqliteSelectNew": "__select_new",
    "sqliteSelectDup": "__select_dup",
    "sqliteFindFunction": "__find_function",
    "sqliteGetVdbe": "__parser_get_vdbe",
    "sqliteWhereBegin": "__where_begin",
    "sqliteVdbeCreate": "__vdbe_create",
    "sqliteVdbeGetOp": "__vdbe_get_op",
    "sqliteTableFromToken": "__table_from_token",
    "sqliteSelectResultSet": "__select_result_set",
    "sqliteTriggerSelectStep": "__trigger_select_step",
    "sqliteTriggerInsertStep": "__trigger_insert_step",
    "sqliteTriggerUpdateStep": "__trigger_update_step",
    "sqliteTriggerDeleteStep": "__trigger_delete_step",
    "sqliteAttach": "__attach",
    "sqliteDetach": "__detach",
    "sqliteVacuum": "__vacuum",
    "sqliteParseBegin": "__parse_begin",
    "sqliteRegisterDateTimeFunctions": "__register_datetime_funcs"
  },
  "type_mappings": {
    "description": "Known SQLite to DBSQL type name mappings",
    "Table": "table_t",
    "Column": "column_t",
    "Index": "index_t",
    "Expr": "expr_t",
    "ExprList": "expr_list_t",
    "Parser": "parser_t",
    "Token": "token_t",
    "IdList": "id_list_t",
    "SrcList": "src_list_t",
    "WhereInfo": "where_info_t",
    "WhereLevel": "where_level_t",
    "Select": "select_t",
    "Agg": "agg_t",
    "AggExpr": "agg_expr_t",
    "AggElem": "agg_elem_t",
    "KeyList": "keylist_t",
    "Cursor": "cursor_t",
    "FuncDef": "func_def_t",
    "Trigger": "trigger_t",
    "TriggerStep": "trigger_step_t",
    "TriggerStack": "trigger_stack_t",
    "ForeignKey": "foreign_key_t",
    "AuthContext": "auth_context_t",
    "Vdbe": "vdbe_t",
    "VdbeOp": "vdbe_op_t",
    "Datetime": "datetime_t",
    "SmCursor": "sm_cursor_t"
  },
  "vdbe_op_fields_3_52_0": {
    "description": "VDBE opcode structure fields (SQLite 3.52.0)",
    "p1": "Primary parameter (register, cursor, label)",
    "p2": "Secondary parameter (register, cursor, jump target)",
    "p3": "Tertiary parameter (register)",
    "p4": "Union parameter (string, int, pointer, keyinfo)",
    "p4type": "P4 union discriminator (P4_INT32, P4_STRING, P4_KEYINFO, etc.)",
    "p5": "Flags (u16 bitfield for opcode-specific options)",
    "comment": "Debug comment string (only if SQLITE_ENABLE_EXPLAIN_COMMENTS)"
  },
  "mem_fields_3_52_0": {
    "description": "Memory cell structure fields (SQLite 3.52.0)",
    "flags": "Type flags (MEM_Int, MEM_Real, MEM_Str, MEM_Blob, etc.)",
    "enc": "String encoding (SQLITE_UTF8, SQLITE_UTF16LE, SQLITE_UTF16BE)",
    "eSubtype": "Subtype for JSON/custom types (0=none)",
    "n": "String length (bytes) or blob size",
    "z": "String/blob pointer (may be zMalloc or external)",
    "zMalloc": "Owned malloc buffer (if MEM_Dyn flag set)",
    "szMalloc": "Size of zMalloc buffer",
    "u": "Union of i64/double/nZero/pDef",
    "u.i": "Integer value (if MEM_Int)",
    "u.r": "Real (double) value (if MEM_Real)",
    "u.nZero": "Zero-blob size (if MEM_Zero)",
    "u.pDef": "Function definition pointer (if MEM_Agg)",
    "uTemp": "Temporary value for operations",
    "xDel": "Destructor callback for external memory"
  },
  "parser_fields_3_52_0": {
    "description": "Parser state structure fields (SQLite 3.52.0)",
    "nRangeReg": "Size of temporary register block",
    "iRangeReg": "First register in temp register block",
    "nLabelAlloc": "Number of slots allocated in aLabel array",
    "aLabel": "Space to hold labels (array of int)",
    "nLabel": "Negative of number of labels used",
    "nQueryLoop": "Estimated iterations of query (10*log2(N))",
    "isMultiWrite": "True if may modify/insert multiple rows",
    "eTriggerOp": "TK_UPDATE, TK_INSERT, or TK_DELETE",
    "eOrconf": "Default ON CONFLICT policy for triggers",
    "selId": "Unique identifier for SELECT statements"
  },
  "expr_fields_3_52_0": {
    "description": "Expression tree node structure fields (SQLite 3.52.0)",
    "op": "Operation performed by this node (TK_* token)",
    "op2": "TK_REGISTER: original op; TK_COLUMN: p5 for OP_Column",
    "flags": "Various flags (EP_*)",
    "u": "Union of zToken (struct {z, n}), zTokenStr, or iValue",
    "u.zToken": "Token with explicit length (anonymous struct)",
    "u.zToken.z": "Token string pointer",
    "u.zToken.n": "Token length",
    "u.iValue": "Non-negative integer value (if EP_IntValue)",
    "x": "Union of pList or pSelect",
    "x.pList": "Expression list (for IN, CASE, FUNCTION, etc.)",
    "x.pSelect": "SELECT statement (if EP_xIsSelect)",
    "y": "Union of pTab, pWin, nReg, or sub",
    "y.pTab": "Table containing column (TK_COLUMN)",
    "y.pWin": "Window/Filter definition (EP_WinFunc)",
    "w": "Union of iJoin or iOfst",
    "w.iJoin": "Right table in join (if EP_OuterON/EP_InnerON)",
    "w.iOfst": "Token offset from statement start (else)",
    "pAggInfo": "Aggregate info (TK_AGG_COLUMN/TK_AGG_FUNCTION)",
    "iTable": "TK_COLUMN: cursor; TK_REGISTER: register; TK_IN: ephemeral table",
    "iColumn": "TK_COLUMN: column index (-1=rowid); TK_VARIABLE: variable number",
    "iAgg": "Entry in pAggInfo->aCol[] or ->aFunc[]"
  },
  "notes": [
    "Hungarian notation requires semantic analysis and cannot be fully automated",
    "The 'a' vs 'p' distinction: 'a' is for arrays accessed by index, 'p' for single items or linked lists",
    "BerkeleyDB types must never be modified during transpilation",
    "Storage Manager interface (src/sm.c) must be preserved exactly",
    "Line wrapping at 79 chars may require manual adjustment for readability",
    "PUBLIC/STATIC/EXTERN markers placement requires understanding of function scope and API",
    "SQLite 3.52.0 structure field mappings added for VdbeOp, Mem, Parse, and Expr",
    "VDBE validation rules check P5 flags, register ranges, and MEM flag combinations"
  ]
}
