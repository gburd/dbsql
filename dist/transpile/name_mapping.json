{
  "description": "DBSQL naming conventions reference for SQLite to DBSQL transpilation",
  "version": "1.0",
  "patterns": {
    "function_naming": {
      "rule": "Add __ prefix and convert CamelCase to snake_case",
      "examples": [
        "sqliteParseBegin -> __parse_begin",
        "sqliteVdbeExec -> __vdbe_exec",
        "sqliteLocateTable -> __locate_table",
        "sqliteExprCode -> __expr_code",
        "sqliteFindFunction -> __find_function"
      ]
    },
    "type_naming": {
      "rule": "Add _t suffix to all typedef struct names",
      "examples": [
        "Table -> table_t",
        "Vdbe -> vdbe_t",
        "Expr -> expr_t",
        "Parser -> parser_t",
        "Token -> token_t",
        "Index -> index_t",
        "Select -> select_t"
      ]
    },
    "type_substitutions": {
      "u8": "u_int8_t",
      "u16": "u_int16_t",
      "u32": "u_int32_t",
      "i64": "int64_t",
      "u64": "uint64_t",
      "sqlite_*": "dbsql_*"
    },
    "bdb_types_preserved": [
      "DB",
      "DBT",
      "DBC",
      "DB_ENV",
      "DB_TXN",
      "DB_SEQUENCE",
      "DB_MPOOLFILE",
      "DB_LOCK",
      "DB_LOGC",
      "DB_LSN",
      "db_recno_t",
      "db_seq_t",
      "db_threadid_t",
      "db_pgno_t"
    ],
    "hungarian_notation": {
      "description": "Prefix conventions for struct field names",
      "z": {
        "meaning": "zero-terminated string (char *)",
        "examples": [
          "char *zName",
          "char *zDflt",
          "char *zType",
          "char *zDatabase",
          "char *zAlias",
          "char *zSelect",
          "char *zErrMsg",
          "char *zTo",
          "char *zCol"
        ]
      },
      "n": {
        "meaning": "count/number/length (int)",
        "examples": [
          "int nArg",
          "int nCol",
          "int nColumn",
          "int nExpr",
          "int nAlloc",
          "int nId",
          "int nLevel",
          "int nLimit",
          "int nOffset",
          "int nErr",
          "int nTab",
          "int nMem",
          "int nSet",
          "int nAgg",
          "int nVar"
        ]
      },
      "a": {
        "meaning": "array pointer (type_t *)",
        "examples": [
          "column_t *aCol",
          "agg_expr_t *aAgg",
          "db_t *aDb"
        ]
      },
      "p": {
        "meaning": "pointer to single item or list (type_t *)",
        "examples": [
          "func_def_t *pNext",
          "void *pUserData",
          "table_t *pTable",
          "index_t *pIndex",
          "expr_t *pExpr",
          "select_t *pSelect"
        ]
      },
      "i": {
        "meaning": "index value/integer index (int)",
        "examples": [
          "int iPKey",
          "int iFrom",
          "int iTable",
          "int iColumn",
          "int iAgg",
          "int iCursor",
          "int iMem",
          "int iCur",
          "int iLeftJoin",
          "int iContinue",
          "int iBreak",
          "int iLimit",
          "int iOffset"
        ]
      },
      "x": {
        "meaning": "function pointer",
        "examples": [
          "void (*xFunc)(dbsql_func_t*,int,const char**)",
          "void (*xStep)(dbsql_func_t*,int,const char**)",
          "void (*xFinalize)(dbsql_func_t*)"
        ]
      },
      "no_prefix": {
        "meaning": "scalar types, enums, flags",
        "examples": [
          "u_int8_t readOnly",
          "int dataType",
          "u_int32_t flags"
        ]
      }
    },
    "header_markers": {
      "PUBLIC": "Internal API - generates prototypes in inc/*_ext.h",
      "STATIC": "File-local functions - generates prototypes in inc/*_decl.h",
      "EXTERN": "External public API - generates prototypes in dbsql.h"
    },
    "code_style": {
      "function_declarations": "ANSI C (not K&R style)",
      "line_length": "79 characters maximum",
      "indent": "tabs for indentation"
    }
  },
  "function_mappings": {
    "description": "Known SQLite to DBSQL function name mappings extracted from existing code",
    "sqliteLocateTable": "__locate_table",
    "sqliteFindTable": "__find_table",
    "sqliteFindIndex": "__find_index",
    "sqliteIdListAppend": "__id_list_append",
    "sqliteIdListDup": "__id_list_dup",
    "sqliteSrcListAppend": "__src_list_append",
    "sqliteSrcListDup": "__src_list_dup",
    "sqliteSrcListLookup": "__src_list_lookup",
    "sqliteExpr": "__expr",
    "sqliteExprFunction": "__expr_function",
    "sqliteExprDup": "__expr_dup",
    "sqliteExprListDup": "__expr_list_dup",
    "sqliteExprListAppend": "__expr_list_append",
    "sqliteSelectNew": "__select_new",
    "sqliteSelectDup": "__select_dup",
    "sqliteFindFunction": "__find_function",
    "sqliteGetVdbe": "__parser_get_vdbe",
    "sqliteWhereBegin": "__where_begin",
    "sqliteVdbeCreate": "__vdbe_create",
    "sqliteVdbeGetOp": "__vdbe_get_op",
    "sqliteTableFromToken": "__table_from_token",
    "sqliteSelectResultSet": "__select_result_set",
    "sqliteTriggerSelectStep": "__trigger_select_step",
    "sqliteTriggerInsertStep": "__trigger_insert_step",
    "sqliteTriggerUpdateStep": "__trigger_update_step",
    "sqliteTriggerDeleteStep": "__trigger_delete_step",
    "sqliteAttach": "__attach",
    "sqliteDetach": "__detach",
    "sqliteVacuum": "__vacuum",
    "sqliteParseBegin": "__parse_begin",
    "sqliteRegisterDateTimeFunctions": "__register_datetime_funcs"
  },
  "type_mappings": {
    "description": "Known SQLite to DBSQL type name mappings",
    "Table": "table_t",
    "Column": "column_t",
    "Index": "index_t",
    "Expr": "expr_t",
    "ExprList": "expr_list_t",
    "Parser": "parser_t",
    "Token": "token_t",
    "IdList": "id_list_t",
    "SrcList": "src_list_t",
    "WhereInfo": "where_info_t",
    "WhereLevel": "where_level_t",
    "Select": "select_t",
    "Agg": "agg_t",
    "AggExpr": "agg_expr_t",
    "AggElem": "agg_elem_t",
    "KeyList": "keylist_t",
    "Cursor": "cursor_t",
    "FuncDef": "func_def_t",
    "Trigger": "trigger_t",
    "TriggerStep": "trigger_step_t",
    "TriggerStack": "trigger_stack_t",
    "ForeignKey": "foreign_key_t",
    "AuthContext": "auth_context_t",
    "Vdbe": "vdbe_t",
    "VdbeOp": "vdbe_op_t",
    "Datetime": "datetime_t",
    "SmCursor": "sm_cursor_t"
  },
  "vdbe_op_fields_3_52_0": {
    "description": "VDBE opcode structure fields (SQLite 3.52.0)",
    "p1": "Primary parameter (register, cursor, label)",
    "p2": "Secondary parameter (register, cursor, jump target)",
    "p3": "Tertiary parameter (register)",
    "p4": "Union parameter (string, int, pointer, keyinfo)",
    "p4type": "P4 union discriminator (P4_INT32, P4_STRING, P4_KEYINFO, P4_POINTER, P4_REAL, P4_FUNCDEF, P4_INTARRAY, P4_SUBPROGRAM)",
    "p5": "Flags (u16 bitfield for opcode-specific options)",
    "comment": "Debug comment string (only if SQLITE_ENABLE_EXPLAIN_COMMENTS)",
    "p4_types": {
      "P4_NOTUSED": "p4 not used",
      "P4_INT32": "p4.i is 32-bit signed integer",
      "P4_INT64": "p4.i is 64-bit signed integer",
      "P4_REAL": "p4.pReal points to 8-byte real",
      "P4_STRING": "p4.z is null-terminated string",
      "P4_KEYINFO": "p4.pKeyInfo is KeyInfo structure",
      "P4_COLLSEQ": "p4.pColl is CollSeq structure",
      "P4_FUNCDEF": "p4.pFunc is FuncDef structure",
      "P4_INTARRAY": "p4.ai is array of integers",
      "P4_SUBPROGRAM": "p4.pProgram is SubProgram",
      "P4_POINTER": "p4.p is generic pointer"
    },
    "p5_common_flags": {
      "OPFLAG_NCHANGE": "Increment db->nChange counter",
      "OPFLAG_LASTROWID": "Set db->lastRowid",
      "OPFLAG_ISUPDATE": "Treat as UPDATE not INSERT",
      "OPFLAG_APPEND": "Cursor hint: append operation",
      "OPFLAG_USESEEKRESULT": "Use seekResult for efficiency",
      "OPFLAG_LENGTHARG": "Make arg length available",
      "OPFLAG_TYPEOFARG": "Request type of argument",
      "OPFLAG_BULKCSR": "Cursor is for bulk operations",
      "OPFLAG_SEEKEQ": "Seek exactly this key",
      "OPFLAG_FORDELETE": "Cursor opened for delete"
    }
  },
  "mem_fields_3_52_0": {
    "description": "Memory cell structure fields (SQLite 3.52.0)",
    "flags": "Type flags (MEM_Int, MEM_Real, MEM_Str, MEM_Blob, etc.)",
    "enc": "String encoding (SQLITE_UTF8, SQLITE_UTF16LE, SQLITE_UTF16BE)",
    "e_subtype": "Subtype for JSON/custom types (0=none) [DBSQL: eSubtype->e_subtype]",
    "n": "String length (bytes) or blob size",
    "z": "String/blob pointer (may be zMalloc or external)",
    "z_malloc": "Owned malloc buffer (if MEM_Dyn flag set) [DBSQL: zMalloc->z_malloc]",
    "sz_malloc": "Size of zMalloc buffer [DBSQL: szMalloc->sz_malloc]",
    "u": "Union of i64/double/nZero/pDef",
    "u.i": "Integer value (if MEM_Int)",
    "u.r": "Real (double) value (if MEM_Real)",
    "u.n_zero": "Zero-blob size (if MEM_Zero) [DBSQL: nZero->n_zero]",
    "u.p_def": "Function definition pointer (if MEM_Agg) [DBSQL: pDef->p_def]",
    "u_temp": "Temporary value for operations [DBSQL: uTemp->u_temp]",
    "x_del": "Destructor callback for external memory [DBSQL: xDel->x_del]",
    "mem_flags": {
      "MEM_Null": "NULL value",
      "MEM_Int": "Value is i64 integer",
      "MEM_Real": "Value is double",
      "MEM_Str": "Value is string",
      "MEM_Blob": "Value is binary blob",
      "MEM_AffMask": "Affinity mask",
      "MEM_RowSet": "Value is RowSet object",
      "MEM_Frame": "Value is VdbeFrame object",
      "MEM_Undefined": "Value undefined (internal use)",
      "MEM_Cleared": "Memory cleared (internal use)",
      "MEM_TypeMask": "Type mask (Null|Int|Real|Str|Blob)",
      "MEM_Term": "String is null-terminated",
      "MEM_Dyn": "String/blob needs deallocation",
      "MEM_Static": "String/blob in static memory",
      "MEM_Ephem": "String/blob is ephemeral",
      "MEM_Agg": "Aggregate accumulator",
      "MEM_Zero": "Allocate zero-blob"
    }
  },
  "parser_fields_3_52_0": {
    "description": "Parser state structure fields (SQLite 3.52.0)",
    "n_range_reg": "Size of temporary register block [DBSQL: nRangeReg->n_range_reg]",
    "i_range_reg": "First register in temp register block [DBSQL: iRangeReg->i_range_reg]",
    "n_label_alloc": "Number of slots allocated in aLabel array [DBSQL: nLabelAlloc->n_label_alloc]",
    "a_label": "Space to hold labels (array of int) [DBSQL: aLabel->a_label]",
    "n_label": "Negative of number of labels used [DBSQL: nLabel->n_label]",
    "n_query_loop": "Estimated iterations of query (10*log2(N)) [DBSQL: nQueryLoop->n_query_loop]",
    "is_multi_write": "True if may modify/insert multiple rows [DBSQL: isMultiWrite->is_multi_write]",
    "e_trigger_op": "TK_UPDATE, TK_INSERT, or TK_DELETE [DBSQL: eTriggerOp->e_trigger_op]",
    "e_orconf": "Default ON CONFLICT policy for triggers [DBSQL: eOrconf->e_orconf]",
    "sel_id": "Unique identifier for SELECT statements [DBSQL: selId->sel_id]",
    "n_var": "Number of SQL variables [DBSQL: nVar->n_var]",
    "n_mem": "Number of memory cells [DBSQL: nMem->n_mem]",
    "n_tab": "Number of cursors [DBSQL: nTab->n_tab]",
    "explain": "True if EXPLAIN statement [DBSQL: explain->explain]",
    "nested": "Depth of nested parse [DBSQL: nested->nested]"
  },
  "expr_fields_3_52_0": {
    "description": "Expression tree node structure fields (SQLite 3.52.0)",
    "op": "Operation performed by this node (TK_* token)",
    "op2": "TK_REGISTER: original op; TK_COLUMN: p5 for OP_Column",
    "flags": "Various flags (EP_*)",
    "u": "Union of zToken (struct {z, n}), zTokenStr, or iValue",
    "u.zToken": "Token with explicit length (anonymous struct)",
    "u.zToken.z": "Token string pointer",
    "u.zToken.n": "Token length",
    "u.iValue": "Non-negative integer value (if EP_IntValue)",
    "x": "Union of pList or pSelect",
    "x.pList": "Expression list (for IN, CASE, FUNCTION, etc.)",
    "x.pSelect": "SELECT statement (if EP_xIsSelect)",
    "y": "Union of pTab, pWin, nReg, or sub",
    "y.pTab": "Table containing column (TK_COLUMN)",
    "y.pWin": "Window/Filter definition (EP_WinFunc)",
    "w": "Union of iJoin or iOfst",
    "w.iJoin": "Right table in join (if EP_OuterON/EP_InnerON)",
    "w.iOfst": "Token offset from statement start (else)",
    "pAggInfo": "Aggregate info (TK_AGG_COLUMN/TK_AGG_FUNCTION)",
    "iTable": "TK_COLUMN: cursor; TK_REGISTER: register; TK_IN: ephemeral table",
    "iColumn": "TK_COLUMN: column index (-1=rowid); TK_VARIABLE: variable number",
    "iAgg": "Entry in pAggInfo->aCol[] or ->aFunc[]"
  },
  "sqlite_3_52_0_opcodes": {
    "description": "SQLite 3.52.0 opcodes (documented for reference, no name changes needed)",
    "opcode_categories": {
      "memory": ["OP_Move", "OP_Copy", "OP_SCopy", "OP_IntCopy"],
      "arithmetic": ["OP_Add", "OP_Subtract", "OP_Multiply", "OP_Divide", "OP_Remainder"],
      "bitwise": ["OP_BitAnd", "OP_BitOr", "OP_ShiftLeft", "OP_ShiftRight", "OP_BitNot"],
      "comparison": ["OP_Eq", "OP_Ne", "OP_Lt", "OP_Le", "OP_Gt", "OP_Ge"],
      "control_flow": ["OP_If", "OP_IfNot", "OP_Goto", "OP_Gosub", "OP_Return"],
      "cursor_ops": ["OP_OpenRead", "OP_OpenWrite", "OP_Close", "OP_Rewind", "OP_Next"],
      "seek_ops": ["OP_SeekGE", "OP_SeekGT", "OP_SeekLE", "OP_SeekLT", "OP_SeekRowid"],
      "data_ops": ["OP_Column", "OP_MakeRecord", "OP_Insert", "OP_Delete", "OP_Rowid"],
      "result_ops": ["OP_ResultRow", "OP_Halt", "OP_Integer", "OP_String", "OP_Null"],
      "aggregate_ops": ["OP_AggStep", "OP_AggFinal", "OP_AggValue", "OP_AggInverse"],
      "sorter_ops": ["OP_SorterOpen", "OP_SorterInsert", "OP_SorterSort", "OP_SorterNext"]
    },
    "register_addressing": {
      "note": "Registers are 0-indexed in SQLite 3.52.0 and DBSQL",
      "p1_usage": "Often register number, cursor id, or jump target",
      "p2_usage": "Often register number, count, or flags",
      "p3_usage": "Often destination register",
      "valid_register_range": "0-255 typical, up to 32767 theoretical"
    }
  },
  "notes": [
    "Hungarian notation requires semantic analysis and cannot be fully automated",
    "The 'a' vs 'p' distinction: 'a' is for arrays accessed by index, 'p' for single items or linked lists",
    "BerkeleyDB types must never be modified during transpilation",
    "Storage Manager interface (src/sm.c) must be preserved exactly",
    "Line wrapping at 79 chars may require manual adjustment for readability",
    "PUBLIC/STATIC/EXTERN markers placement requires understanding of function scope and API",
    "SQLite 3.52.0 structure field mappings added for VdbeOp, Mem, Parse, and Expr",
    "VDBE validation rules check P5 flags, register ranges, and MEM flag combinations",
    "Register addressing is 0-indexed: register 0 is valid and often used",
    "P5 flags are u16 (0-65535), used for opcode-specific options",
    "MEM flag validation: Int/Real/Str/Blob are mutually exclusive type flags",
    "P4 type must match p4type discriminator for proper union access"
  ]
}
