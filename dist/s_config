#!/bin/sh -
# DBSQL - A SQL database engine.
#
# Copyright (c) 2007-2026  The DBSQL Group, Inc.
#
# s_config -- build dist/configure and dist/config.hin from configure.ac.
# Run from the dist directory.

set -e
. ./RELEASE

echo "autoconf: building aclocal.m4..."
cat aclocal/libtool.m4 aclocal/ltoptions.m4 aclocal/ltsugar.m4 \
    aclocal/ltversion.m4 aclocal/lt~obsolete.m4 > aclocal.m4

echo "autoconf: running autoheader to build config.hin..."
rm -f config.hin
autoheader
echo "autoconf: running autoconf to build configure..."
rm -f configure
autoconf

ed -s configure <<EOF
1,\$s/__EDIT_DBSQL_VERSION_MAJOR__/$DBSQL_VERSION_MAJOR/g
1,\$s/__EDIT_DBSQL_VERSION_MINOR__/$DBSQL_VERSION_MINOR/g
1,\$s/__EDIT_DBSQL_VERSION_PATCH__/$DBSQL_VERSION_PATCH/g
1,\$s/__EDIT_DBSQL_VERSION_NUMBER__/$DBSQL_VERSION_NUMBER/g
1,\$s/__EDIT_DBSQL_VERSION_STRING__/$DBSQL_VERSION_STRING/g
1,\$s/__EDIT_DBSQL_SQLITE_VERSION__/$DBSQL_SQLITE_VERSION/g
1,\$s/__EDIT_DBSQL_LIBDB_VERSION__/$DBSQL_LIBDB_VERSION/g
1,\$s/__EDIT_DBSQL_VERSION__/$DBSQL_VERSION/g
w
q
EOF
rm -rf autom4te.cache aclocal.m4
chmod 555 configure
echo "s_config: done (dbsql $DBSQL_VERSION)"
