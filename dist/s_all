# s_all -- regenerate everything that is generated in the source tree.
# Run from the dist directory.
#
#   1. src/, test/tcl/ from upstream SQLite (needs a fossil checkout of the
#      pinned tag; see .agent/steering/TRANSFORM.md):
#        SQLITE=/path/to/sqlite-3.53.4 sh s_all
#   2. src/sm/sm_ext.h prototypes from the PUBLIC: lines in src/sm/*.c
#   3. dist/configure

set -e
if [ -n "$SQLITE" ]; then
	python3 transpile/run --sqlite "$SQLITE" --out ..
fi
sh s_include
sh s_config
