# DBSQL - A SQL database engine.
#
# Copyright (C) 2007-2026  The DBSQL Group, Inc.
#
# Makefile.in -- processed by dist/configure.  Requires GNU make.

top_builddir=	.
srcdir=		@srcdir@/../src
distdir=	@srcdir@/../dist
testdir=	@srcdir@/../test
topdir=		@srcdir@/..

prefix=		@prefix@
exec_prefix=	@exec_prefix@
bindir=		@bindir@
libdir=		@libdir@
includedir=	@includedir@
datarootdir=	@datarootdir@
mandir=		@mandir@
pkgconfigdir=	$(libdir)/pkgconfig

CC=		@CC@
LIBTOOL=	@LIBTOOL@
INSTALL=	@INSTALL@
TCLSH=		@TCLSH@
CFLAGS=		@CFLAGS@ @DBSQL_CFLAGS@
LDFLAGS=	@LDFLAGS@
LIBS=		@LIBS@

STORAGE=	@with_storage@
DEFS=		@DBSQL_DEFS@ @DEFS@
DB_CPPFLAGS=	@DB_CPPFLAGS@
DB_LIBS=	@DB_LIBS@
ICU_CFLAGS=	@ICU_CFLAGS@
ICU_LIBS=	@ICU_LIBS@
TCL_CPPFLAGS=	@TCL_CPPFLAGS@
TCL_LIBS=	@TCL_LIBS@
SHELL_CPPFLAGS=	@SHELL_CPPFLAGS@
SHELL_LIBS=	@SHELL_LIBS@
ENABLE_TCL=	@enable_tcl@
ENABLE_TEST=	@enable_test@
ENABLE_ICU=	@enable_icu@
ENABLE_FTS5=	@enable_fts5@

VERSION=	@DBSQL_VERSION@
LIBVERSION=	@DBSQL_VERSION_MAJOR@.@DBSQL_VERSION_MINOR@

CPPFLAGS=	-I. -I$(srcdir) -I$(srcdir)/inc -I$(srcdir)/sm -I$(srcdir)/ext/icu \
		-I$(srcdir)/ext/fts5 $(DB_CPPFLAGS) $(ICU_CFLAGS)
COMPILE=	$(CC) $(CFLAGS) $(DEFS) $(CPPFLAGS)
LTCOMPILE=	$(LIBTOOL) --mode=compile --tag=CC $(COMPILE)
LTLINK=		$(LIBTOOL) --mode=link --tag=CC $(CC) $(CFLAGS) $(LDFLAGS)

##################################################
# Sources.
##################################################
SQL_SRCS=	$(wildcard $(srcdir)/*.c) $(wildcard $(srcdir)/vdbe/*.c) \
		$(filter-out %/backup.c %/dbstat.c, $(wildcard $(srcdir)/api/*.c)) \
		$(filter-out %/mem0.c %/mem2.c %/mem3.c %/mem5.c, \
		    $(wildcard $(srcdir)/common/*.c)) \
		$(wildcard $(srcdir)/os/*.c)
ifeq ($(STORAGE),native)
STORAGE_SRCS=	$(wildcard $(topdir)/native/*.c) $(srcdir)/api/backup.c
CPPFLAGS+=	-I$(topdir)/native
else
STORAGE_SRCS=	$(wildcard $(srcdir)/sm/*.c)
endif
EXT_SRCS=
ifeq ($(ENABLE_FTS5),yes)
EXT_SRCS+=	$(srcdir)/ext/fts5/fts5.c
endif
ifeq ($(ENABLE_ICU),yes)
EXT_SRCS+=	$(srcdir)/ext/icu/icu.c
endif

LIB_SRCS=	$(SQL_SRCS) $(STORAGE_SRCS) $(EXT_SRCS)
# Objects are named after their source file, as in libdb (vdbe_aux.lo,
# fts5.lo, sm_cursor.lo); source basenames are unique across src/.
LIB_LOBJS=	$(patsubst %.c,%.lo,$(notdir $(LIB_SRCS))) sql_parser.lo
vpath %.c $(sort $(dir $(LIB_SRCS)))

TCL_SRCS=	$(wildcard $(testdir)/tcl/*.c) $(wildcard $(testdir)/tcl/ext/*.c)
UNIT_SRCS=	$(wildcard $(testdir)/unit/*_test.c)
UNIT_PROGS=	$(patsubst $(testdir)/unit/%.c,%,$(UNIT_SRCS))

libdbsql=	libdbsql-$(LIBVERSION).la

PROGS=		dbsql
ifeq ($(ENABLE_TEST),yes)
PROGS+=		testfixture $(UNIT_PROGS)
endif
ifeq ($(ENABLE_TCL),yes)
PROGS+=		libdbsql_tcl.la
endif

##################################################
# Targets.
##################################################
all: dbsql.h $(libdbsql) $(PROGS)

# The parser generator is a build-host tool (upstream lemon, unchanged).
lemon: $(srcdir)/lemon/lemon.c
	$(CC) -O2 -o $@ $(srcdir)/lemon/lemon.c
lempar.c: $(srcdir)/lemon/lempar.c
	cp $(srcdir)/lemon/lempar.c $@

sql_parser.c: $(srcdir)/sql_parser.y lemon lempar.c
	cp $(srcdir)/sql_parser.y .
	./lemon -S sql_parser.y
sql_parser.h: sql_parser.c

fts5_parser.c: $(srcdir)/ext/fts5/fts5_parser.y lemon lempar.c
	cp $(srcdir)/ext/fts5/fts5_parser.y .
	./lemon -S fts5_parser.y
	sed -e 's/yy/fts5yy/g' -e 's/YY/fts5YY/g' -e 's/TOKEN/FTS5TOKEN/g' \
	    fts5_parser.c > fts5_parser.c.tmp && mv fts5_parser.c.tmp fts5_parser.c

# dbsql.h is the transformed upstream sqlite3.h (sqlite.h.in + rtree,
# session and fts5 headers, as mksqlite3h.tcl assembles it), with the dbsql
# release in DBSQL_VERSION* and the SQLite release it carries kept as
# DBSQL_SQLITE_VERSION / DBSQL_SQLITE_SOURCE_ID.
dbsql.h: $(srcdir)/inc/dbsql_api_ref.h $(distdir)/RELEASE
	sed -e 's/^#define DBSQL_VERSION  *"\(.*\)"$$/#define DBSQL_VERSION        "$(VERSION)"\n#define DBSQL_SQLITE_VERSION "\1"/' \
	    -e 's/^#define DBSQL_VERSION_NUMBER .*/#define DBSQL_VERSION_NUMBER @DBSQL_VERSION_NUMBER@/' \
	    -e 's/^#define DBSQL_SOURCE_ID  *"\(.*\)"$$/#define DBSQL_SOURCE_ID      "@DBSQL_VERSION_STRING@"\n#define DBSQL_SQLITE_SOURCE_ID "\1"/' \
	    $(srcdir)/inc/dbsql_api_ref.h > $@

dbsql_ext.h: $(srcdir)/dbsql_ext.h
	cp $(srcdir)/dbsql_ext.h $@

$(LIB_LOBJS): dbsql.h sql_parser.h $(if $(filter yes,$(ENABLE_FTS5)),fts5_parser.c)

%.lo: %.c
	$(LTCOMPILE) -c $< -o $@

$(libdbsql): $(LIB_LOBJS)
	$(LTLINK) -o $@ $(LIB_LOBJS) -rpath $(libdir) \
	    -version-info 1:0:0 $(DB_LIBS) $(ICU_LIBS) $(LIBS)

dbsql: $(srcdir)/shell/dbsql.c $(libdbsql) dbsql.h
	$(LTLINK) $(DEFS) $(CPPFLAGS) $(SHELL_CPPFLAGS) -o $@ \
	    $(srcdir)/shell/dbsql.c $(libdbsql) $(SHELL_LIBS) $(LIBS)

# Tcl package "dbsql" (load libdbsql_tcl.so Dbsql).
libdbsql_tcl.la: $(testdir)/tcl/tcl_dbsql.c $(libdbsql)
	$(LTLINK) $(DEFS) $(CPPFLAGS) $(TCL_CPPFLAGS) -module -avoid-version \
	    -o $@ $(testdir)/tcl/tcl_dbsql.c $(libdbsql) -rpath $(libdir) \
	    $(TCL_LIBS)

# Testfixture: the library compiled with the test hooks, plus test/tcl.
TF_DEFS=	-DDBSQL_TEST=1 -DTCLSH_INIT_PROC=__test_init -DDBSQL_SERVER=1 \
		-DDBSQL_PRIVATE= -DDBSQL_CORE -DBUILD_dbsql \
		-DDBSQL_SERIES_CONSTRAINT_VERIFY=1 -DDBSQL_DEFAULT_PAGE_SIZE=1024 \
		-DDBSQL_ENABLE_STMTVTAB -DDBSQL_ENABLE_BYTECODE_VTAB \
		-DDBSQL_STATIC_RANDOMJSON -DDBSQL_STRICT_SUBTYPE=1 \
		-DDBSQL_CKSUMVFS_STATIC -DDBSQL_NO_SYNC=1 -DDBSQL_DEBUG=1
TF_EXCLUDE=	$(if $(filter native,$(STORAGE)),,%/test2.c %/test3.c %/test_btree.c)
TF_SRCS=	$(LIB_SRCS) $(filter-out $(TF_EXCLUDE),$(TCL_SRCS)) \
		$(testdir)/tcl/tf_stubs.c
testfixture: $(TF_SRCS) dbsql.h sql_parser.c fts5_parser.c
	$(COMPILE) $(TF_DEFS) -I$(testdir)/tcl -I$(testdir)/tcl/ext \
	    $(TCL_CPPFLAGS) -o $@ $(TF_SRCS) sql_parser.c \
	    $(DB_LIBS) $(ICU_LIBS) $(TCL_LIBS) -lz $(LIBS)

%_test: $(testdir)/unit/%_test.c $(libdbsql)
	$(LTLINK) $(DEFS) $(CPPFLAGS) -DDBSQL_CORE -o $@ $< $(libdbsql) \
	    $(DB_LIBS) $(LIBS)

##################################################
# Testing.  See .agent/steering/TESTING.md.
##################################################
check: all
	@test "$(ENABLE_TEST)" = yes || \
	    { echo "check: reconfigure with --enable-test"; exit 1; }
	@fail=0; for t in $(UNIT_PROGS); do \
	    echo "== $$t"; ./$$t || fail=1; done; \
	    sh $(testdir)/shell/run.sh ./dbsql || fail=1; \
	    sh $(testdir)/tcl/run.sh ./testfixture $(topdir) || fail=1; \
	    exit $$fail

##################################################
# Installation.
##################################################
install: all
	$(INSTALL) -d $(DESTDIR)$(bindir) $(DESTDIR)$(libdir) \
	    $(DESTDIR)$(includedir) $(DESTDIR)$(mandir)/man1 \
	    $(DESTDIR)$(pkgconfigdir)
	$(LIBTOOL) --mode=install $(INSTALL) $(libdbsql) $(DESTDIR)$(libdir)
	$(LIBTOOL) --mode=install $(INSTALL) dbsql $(DESTDIR)$(bindir)
	$(INSTALL) -m 644 dbsql.h $(DESTDIR)$(includedir)/dbsql.h
	$(INSTALL) -m 644 $(srcdir)/dbsql_ext.h $(DESTDIR)$(includedir)/dbsql_ext.h
	$(INSTALL) -m 644 $(topdir)/docs_src/dbsql.1 $(DESTDIR)$(mandir)/man1/dbsql.1
	$(INSTALL) -m 644 dbsql.pc $(DESTDIR)$(pkgconfigdir)/dbsql.pc
	test "$(ENABLE_TCL)" != yes || \
	    $(LIBTOOL) --mode=install $(INSTALL) libdbsql_tcl.la $(DESTDIR)$(libdir)

uninstall:
	$(LIBTOOL) --mode=uninstall rm -f $(DESTDIR)$(libdir)/$(libdbsql) \
	    $(DESTDIR)$(bindir)/dbsql
	rm -f $(DESTDIR)$(includedir)/dbsql.h $(DESTDIR)$(includedir)/dbsql_ext.h \
	    $(DESTDIR)$(mandir)/man1/dbsql.1 $(DESTDIR)$(pkgconfigdir)/dbsql.pc

##################################################
# Housekeeping.
##################################################
clean:
	$(LIBTOOL) --mode=clean rm -f $(LIB_LOBJS) $(libdbsql) dbsql \
	    libdbsql_tcl.la
	rm -f testfixture $(UNIT_PROGS) lemon lempar.c sql_parser.* \
	    fts5_parser.* dbsql.h dbsql_ext.h *.o
	rm -rf .libs

distclean: clean
	rm -f Makefile dbsql.pc dbsql_config.h config.log config.status libtool

DISTNAME=	dbsql-$(VERSION)
dist:
	cd $(topdir) && git archive --prefix=$(DISTNAME)/ -o \
	    $(CURDIR)/$(DISTNAME).tar.gz HEAD
	@echo "wrote $(DISTNAME).tar.gz (run dist/s_config in the tree first)"

.PHONY: all check install uninstall clean distclean dist
