#***********************************************************************
# This file implements regression tests for DBSQL library.  The
# focus of this file is testing the register-based VDBE architecture
# modernization from stack-based operations.
#
# In SQLite 2.x, the VDBE used a stack-based architecture with
# opcodes like OP_Callback and stack manipulation operations.
#
# In SQLite 3.x+, the VDBE uses a register-based architecture with
# OP_ResultRow and direct register addressing.
#
# This test file validates that DBSQL has been properly modernized
# to use the register-based approach.
#

set testdir [file dirname $argv0]
source $testdir/tester.tcl

# Test 1: OP_ResultRow Exists (Modern Architecture)
#
do_test register-vdbe-1.1 {
  execsql {
    CREATE TABLE t1(a INT, b INT);
    INSERT INTO t1 VALUES(1, 2);
  }
  set plan [execsql {EXPLAIN SELECT * FROM t1 LIMIT 1;}]
  string match {*ResultRow*} $plan
} {1}

do_test register-vdbe-1.2 {
  set plan [execsql {EXPLAIN SELECT a, b FROM t1;}]
  string match {*ResultRow*} $plan
} {1}

# Test 2: Legacy OP_Callback Absent (Stack-Based Removed)
#
do_test register-vdbe-2.1 {
  set plan [execsql {EXPLAIN SELECT * FROM t1;}]
  string match {*Callback*} $plan
} {0}

do_test register-vdbe-2.2 {
  set plan [execsql {EXPLAIN SELECT a FROM t1 WHERE b > 0;}]
  string match {*Callback*} $plan
} {0}

# Test 3: Legacy OP_ColumnName Absent
#
do_test register-vdbe-3.1 {
  set plan [execsql {EXPLAIN SELECT * FROM t1;}]
  string match {*ColumnName*} $plan
} {0}

# Test 4: Legacy OP_Recno Absent (Replaced by OP_Rowid)
#
do_test register-vdbe-4.1 {
  set plan [execsql {EXPLAIN SELECT rowid FROM t1;}]
  string match {*Recno*} $plan
} {0}

do_test register-vdbe-4.2 {
  set plan [execsql {EXPLAIN SELECT rowid FROM t1;}]
  expr {[string match {*Rowid*} $plan] || [string match {*Column*} $plan]}
} {1}

# Test 5: Register Operations (Modern Architecture)
#
do_test register-vdbe-5.1 {
  # Modern VDBE should have register-based operations
  set plan [execsql {EXPLAIN SELECT 1 + 2;}]
  # Should contain Integer or Add operations
  expr {[string match {*Integer*} $plan] || [string match {*Add*} $plan]}
} {1}

# Test 6: Multiple Columns Use Registers
#
do_test register-vdbe-6.1 {
  execsql {
    DROP TABLE IF EXISTS t2;
    CREATE TABLE t2(x INT, y INT, z INT);
    INSERT INTO t2 VALUES(10, 20, 30);
    SELECT x, y, z FROM t2;
  }
} {10 20 30}

do_test register-vdbe-6.2 {
  set plan [execsql {EXPLAIN SELECT x, y, z FROM t2;}]
  # Should contain ResultRow
  string match {*ResultRow*} $plan
} {1}

# Test 7: Expression Evaluation in Registers
#
do_test register-vdbe-7.1 {
  execsql {
    SELECT a + b FROM t1;
  }
} {3}

do_test register-vdbe-7.2 {
  execsql {
    SELECT a * 2, b * 3 FROM t1;
  }
} {2 6}

do_test register-vdbe-7.3 {
  set plan [execsql {EXPLAIN SELECT a + b FROM t1;}]
  # Modern VDBE uses Add opcode with register operands
  string match {*Add*} $plan
} {1}

# Test 8: Aggregate Functions Use Registers
#
do_test register-vdbe-8.1 {
  execsql {
    INSERT INTO t1 VALUES(3, 4),(5, 6);
    SELECT SUM(a), MAX(b) FROM t1;
  }
} {9 6}

do_test register-vdbe-8.2 {
  set plan [execsql {EXPLAIN SELECT SUM(a) FROM t1;}]
  # Should contain AggStep or similar aggregate opcodes
  expr {[string match {*Agg*} $plan] || [string match {*Function*} $plan]}
} {1}

# Test 9: Subqueries Use Register-Based Architecture
#
do_test register-vdbe-9.1 {
  execsql {
    SELECT * FROM t1 WHERE a IN (SELECT a FROM t1 WHERE b > 3);
  }
} {3 4 5 6}

do_test register-vdbe-9.2 {
  set plan [execsql {EXPLAIN SELECT * FROM t1 WHERE a IN (SELECT a FROM t1);}]
  # Subqueries should also use ResultRow
  string match {*ResultRow*} $plan
} {1}

# Test 10: JOIN Operations Use Registers
#
do_test register-vdbe-10.1 {
  execsql {
    DROP TABLE IF EXISTS t3;
    CREATE TABLE t3(c INT, d INT);
    INSERT INTO t3 VALUES(1, 100),(3, 300);
    SELECT t1.a, t1.b, t3.c, t3.d FROM t1 JOIN t3 ON t1.a = t3.c;
  }
} {1 2 1 100 3 4 3 300}

do_test register-vdbe-10.2 {
  set plan [execsql {EXPLAIN SELECT * FROM t1 JOIN t3 ON t1.a = t3.c;}]
  string match {*ResultRow*} $plan
} {1}

# Test 11: ORDER BY Uses Registers
#
do_test register-vdbe-11.1 {
  execsql {
    SELECT a FROM t1 ORDER BY b DESC;
  }
} {5 3 1}

do_test register-vdbe-11.2 {
  set plan [execsql {EXPLAIN SELECT a FROM t1 ORDER BY b;}]
  # Modern VDBE uses SorterData or similar
  expr {[string match {*Sort*} $plan] || [string match {*ResultRow*} $plan]}
} {1}

# Test 12: GROUP BY Uses Registers
#
do_test register-vdbe-12.1 {
  execsql {
    DROP TABLE IF EXISTS t4;
    CREATE TABLE t4(grp TEXT, val INT);
    INSERT INTO t4 VALUES('A', 10),('A', 20),('B', 30);
    SELECT grp, SUM(val) FROM t4 GROUP BY grp;
  }
} {A 30 B 30}

do_test register-vdbe-12.2 {
  set plan [execsql {EXPLAIN SELECT grp, SUM(val) FROM t4 GROUP BY grp;}]
  string match {*ResultRow*} $plan
} {1}

# Test 13: DISTINCT Uses Registers
#
do_test register-vdbe-13.1 {
  execsql {
    DROP TABLE IF EXISTS t5;
    CREATE TABLE t5(n INT);
    INSERT INTO t5 VALUES(1),(2),(2),(3),(3),(3);
    SELECT DISTINCT n FROM t5;
  }
} {1 2 3}

do_test register-vdbe-13.2 {
  set plan [execsql {EXPLAIN SELECT DISTINCT n FROM t5;}]
  string match {*ResultRow*} $plan
} {1}

# Test 14: UNION Uses Register-Based Architecture
#
do_test register-vdbe-14.1 {
  execsql {
    SELECT a FROM t1 UNION SELECT c FROM t3;
  }
} {1 3 5}

do_test register-vdbe-14.2 {
  set plan [execsql {EXPLAIN SELECT a FROM t1 UNION SELECT c FROM t3;}]
  string match {*ResultRow*} $plan
} {1}

# Test 15: CASE Expressions Use Registers
#
do_test register-vdbe-15.1 {
  execsql {
    SELECT a, CASE WHEN b > 3 THEN 'high' ELSE 'low' END FROM t1;
  }
} {1 low 3 high 5 high}

do_test register-vdbe-15.2 {
  set plan [execsql {EXPLAIN SELECT CASE WHEN a > 0 THEN 1 ELSE 0 END FROM t1;}]
  # CASE implemented with conditional jumps and registers
  expr {[string match {*If*} $plan] || [string match {*ResultRow*} $plan]}
} {1}

# Test 16: String Operations Use Registers
#
do_test register-vdbe-16.1 {
  execsql {
    DROP TABLE IF EXISTS t6;
    CREATE TABLE t6(s TEXT);
    INSERT INTO t6 VALUES('hello'),('world');
    SELECT upper(s) FROM t6;
  }
} {HELLO WORLD}

do_test register-vdbe-16.2 {
  set plan [execsql {EXPLAIN SELECT upper(s) FROM t6;}]
  string match {*Function*} $plan
} {1}

# Test 17: NULL Handling in Registers
#
do_test register-vdbe-17.1 {
  execsql {
    DROP TABLE IF EXISTS t7;
    CREATE TABLE t7(x INT);
    INSERT INTO t7 VALUES(NULL),(1),(NULL),(2);
    SELECT x FROM t7 WHERE x IS NULL;
  }
} {{} {}}

do_test register-vdbe-17.2 {
  set plan [execsql {EXPLAIN SELECT * FROM t7 WHERE x IS NULL;}]
  # IsNull opcode should exist
  string match {*IsNull*} $plan
} {1}

# Test 18: Type Coercion in Registers
#
do_test register-vdbe-18.1 {
  execsql {
    DROP TABLE IF EXISTS t8;
    CREATE TABLE t8(i INT, r REAL, t TEXT);
    INSERT INTO t8 VALUES(42, 3.14, '100');
    SELECT i + r, i + t FROM t8;
  }
} {45.14 142}

# Test 19: Comparison Operations Use Registers
#
do_test register-vdbe-19.1 {
  execsql {
    SELECT a FROM t1 WHERE b > 3;
  }
} {3 5}

do_test register-vdbe-19.2 {
  set plan [execsql {EXPLAIN SELECT a FROM t1 WHERE b > 3;}]
  # Should contain Gt or comparison opcodes
  expr {[string match {*Gt*} $plan] || [string match {*Ge*} $plan] || [string match {*Compare*} $plan]}
} {1}

# Test 20: Arithmetic in Registers
#
do_test register-vdbe-20.1 {
  execsql {
    SELECT (a * b) + (a - b) FROM t1;
  }
} {1 8 19}

do_test register-vdbe-20.2 {
  set plan [execsql {EXPLAIN SELECT a * b FROM t1;}]
  string match {*Multiply*} $plan
} {1}

# Test 21: Verify P3 vs P4 Parameter Usage
# In modern VDBE:
# - P3 is for integer parameters
# - P4 is for string/pointer parameters
#
do_test register-vdbe-21.1 {
  set plan [execsql {EXPLAIN SELECT 'constant';}]
  # Should have String opcode (P4 for string literal)
  string match {*String*} $plan
} {1}

# Test 22: EXPLAIN Sanity Check
#
do_test register-vdbe-22.1 {
  set plan [execsql {EXPLAIN SELECT 1;}]
  # EXPLAIN should return valid opcode listing
  expr {[llength $plan] > 0}
} {1}

do_test register-vdbe-22.2 {
  # Verify EXPLAIN QUERY PLAN also works
  set plan [execsql {EXPLAIN QUERY PLAN SELECT * FROM t1;}]
  expr {[llength $plan] > 0}
} {1}

# Test 23: INSERT Uses Register-Based Architecture
#
do_test register-vdbe-23.1 {
  set plan [execsql {EXPLAIN INSERT INTO t1 VALUES(99, 88);}]
  # Should not have stack-based operations
  expr {![string match {*Push*} $plan] && ![string match {*Pop*} $plan]}
} {1}

# Test 24: UPDATE Uses Register-Based Architecture
#
do_test register-vdbe-24.1 {
  set plan [execsql {EXPLAIN UPDATE t1 SET b = 999 WHERE a = 1;}]
  string match {*ResultRow*} $plan
} {0}

# Test 25: DELETE Uses Register-Based Architecture
#
do_test register-vdbe-25.1 {
  set plan [execsql {EXPLAIN DELETE FROM t1 WHERE a > 10;}]
  expr {![string match {*Callback*} $plan]}
} {1}

finish_test
