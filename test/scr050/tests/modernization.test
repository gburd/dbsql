#***********************************************************************
# This file implements regression tests for DBSQL library.  The
# focus of this file is testing SQLite 3.52.0 modernization features
# that were added or updated during the modernization effort.
#
# This includes:
# - Updated SQL built-in functions
# - Enhanced tokenizer features
# - Type system improvements
# - Error message modernization
#

set testdir [file dirname $argv0]
source $testdir/tester.tcl

# Test 1: Modern Math Functions (SQLite 3.35.0+)
#
do_test modern-1.1 {
  # Test acos function
  set result [execsql {SELECT acos(0.5);}]
  expr {$result > 1.04 && $result < 1.05}
} {1}

do_test modern-1.2 {
  # Test asin function
  set result [execsql {SELECT asin(0.5);}]
  expr {$result > 0.52 && $result < 0.53}
} {1}

do_test modern-1.3 {
  # Test atan function
  set result [execsql {SELECT atan(1.0);}]
  expr {$result > 0.78 && $result < 0.79}
} {1}

do_test modern-1.4 {
  # Test cos function
  set result [execsql {SELECT cos(0.0);}]
  expr {$result == 1.0}
} {1}

do_test modern-1.5 {
  # Test sin function
  set result [execsql {SELECT sin(0.0);}]
  expr {$result == 0.0}
} {1}

do_test modern-1.6 {
  # Test tan function
  set result [execsql {SELECT tan(0.0);}]
  expr {$result == 0.0}
} {1}

do_test modern-1.7 {
  # Test sqrt function
  execsql {SELECT sqrt(16.0);}
} {4.0}

do_test modern-1.8 {
  # Test power function
  execsql {SELECT power(2.0, 3.0);}
} {8.0}

do_test modern-1.9 {
  # Test exp function
  set result [execsql {SELECT exp(1.0);}]
  expr {$result > 2.71 && $result < 2.72}
} {1}

do_test modern-1.10 {
  # Test ln (natural log) function
  set result [execsql {SELECT ln(2.718281828);}]
  expr {$result > 0.99 && $result < 1.01}
} {1}

# Test 2: String Functions Modernization
#
do_test modern-2.1 {
  # Test concat function
  execsql {SELECT concat('Hello', ' ', 'World');}
} {{Hello World}}

do_test modern-2.2 {
  # Test trim with multiple characters
  execsql {SELECT trim('  test  ');}
} {test}

do_test modern-2.3 {
  # Test ltrim
  execsql {SELECT ltrim('  test  ');}
} {{test  }}

do_test modern-2.4 {
  # Test rtrim
  execsql {SELECT rtrim('  test  ');}
} {{  test}}

do_test modern-2.5 {
  # Test replace function
  execsql {SELECT replace('hello world', 'world', 'DBSQL');}
} {{hello DBSQL}}

do_test modern-2.6 {
  # Test substring (substr) function
  execsql {SELECT substr('SQLite', 1, 3);}
} {SQL}

# Test 3: Aggregate Function Enhancements
#
do_test modern-3.1 {
  execsql {
    CREATE TABLE t1(grp TEXT, val INT);
    INSERT INTO t1 VALUES('A', 10),('A', 20),('B', 30);
    SELECT grp, total(val) FROM t1 GROUP BY grp;
  }
} {A 30.0 B 30.0}

do_test modern-3.2 {
  execsql {
    SELECT avg(val) FROM t1;
  }
} {20.0}

do_test modern-3.3 {
  execsql {
    SELECT count(*) FROM t1;
  }
} {3}

do_test modern-3.4 {
  execsql {
    SELECT count(DISTINCT grp) FROM t1;
  }
} {2}

do_test modern-3.5 {
  execsql {
    SELECT group_concat(grp, ', ') FROM t1;
  }
} {{A, A, B}}

# Test 4: Type Affinity Rules (SQLite 3.x)
#
do_test modern-4.1 {
  execsql {
    DROP TABLE IF EXISTS t2;
    CREATE TABLE t2(i INTEGER, t TEXT, n NUMERIC, r REAL, b BLOB);
    INSERT INTO t2 VALUES(1, '2', 3, 4.0, x'0500');
    SELECT typeof(i), typeof(t), typeof(n), typeof(r), typeof(b) FROM t2;
  }
} {integer text integer real blob}

do_test modern-4.2 {
  # INTEGER type affinity
  execsql {
    DROP TABLE IF EXISTS t3;
    CREATE TABLE t3(x INTEGER);
    INSERT INTO t3 VALUES('42');
    SELECT typeof(x) FROM t3;
  }
} {integer}

do_test modern-4.3 {
  # TEXT type affinity
  execsql {
    DROP TABLE IF EXISTS t4;
    CREATE TABLE t4(x TEXT);
    INSERT INTO t4 VALUES(42);
    SELECT typeof(x) FROM t4;
  }
} {text}

do_test modern-4.4 {
  # REAL type affinity
  execsql {
    DROP TABLE IF EXISTS t5;
    CREATE TABLE t5(x REAL);
    INSERT INTO t5 VALUES(42);
    SELECT typeof(x) FROM t5;
  }
} {real}

# Test 5: Modern NULL Handling
#
do_test modern-5.1 {
  execsql {
    SELECT NULL IS NULL;
  }
} {1}

do_test modern-5.2 {
  execsql {
    SELECT NULL IS NOT NULL;
  }
} {0}

do_test modern-5.3 {
  execsql {
    SELECT coalesce(NULL, NULL, 'default');
  }
} {default}

do_test modern-5.4 {
  execsql {
    SELECT ifnull(NULL, 'replacement');
  }
} {replacement}

do_test modern-5.5 {
  execsql {
    SELECT nullif('same', 'same');
  }
} {{}}

do_test modern-5.6 {
  execsql {
    SELECT nullif('different', 'values');
  }
} {different}

# Test 6: Modern Error Messages
#
do_test modern-6.1 {
  catchsql {
    SELECT * FROM nonexistent_table;
  }
} {1 {no such table: nonexistent_table}}

do_test modern-6.2 {
  catchsql {
    INSERT INTO t1(nonexistent_column) VALUES(1);
  }
} {1 {table t1 has no column named nonexistent_column}}

do_test modern-6.3 {
  catchsql {
    SELECT invalid_function();
  }
} {1 {no such function: invalid_function}}

do_test modern-6.4 {
  catchsql {
    CREATE TABLE t1(x INT);
  }
} {1 {table t1 already exists}}

# Test 7: PRAGMA Modernization
#
do_test modern-7.1 {
  execsql {
    PRAGMA table_info(t1);
  }
  # Should return table schema information
  set result [execsql {PRAGMA table_info(t1);}]
  expr {[llength $result] > 0}
} {1}

do_test modern-7.2 {
  execsql {
    PRAGMA database_list;
  }
  set result [execsql {PRAGMA database_list;}]
  expr {[llength $result] > 0}
} {1}

# Test 8: Transaction Semantics
#
do_test modern-8.1 {
  execsql {
    DROP TABLE IF EXISTS t6;
    CREATE TABLE t6(x INT);
    BEGIN;
    INSERT INTO t6 VALUES(1);
    ROLLBACK;
    SELECT COUNT(*) FROM t6;
  }
} {0}

do_test modern-8.2 {
  execsql {
    BEGIN;
    INSERT INTO t6 VALUES(2);
    COMMIT;
    SELECT * FROM t6;
  }
} {2}

do_test modern-8.3 {
  execsql {
    BEGIN;
    INSERT INTO t6 VALUES(3);
    INSERT INTO t6 VALUES(4);
    COMMIT;
    SELECT COUNT(*) FROM t6;
  }
} {3}

# Test 9: CASE Expression Enhancements
#
do_test modern-9.1 {
  execsql {
    SELECT CASE
      WHEN 1 > 2 THEN 'greater'
      WHEN 1 < 2 THEN 'less'
      ELSE 'equal'
    END;
  }
} {less}

do_test modern-9.2 {
  execsql {
    SELECT CASE 1
      WHEN 0 THEN 'zero'
      WHEN 1 THEN 'one'
      WHEN 2 THEN 'two'
      ELSE 'other'
    END;
  }
} {one}

do_test modern-9.3 {
  execsql {
    SELECT x, CASE
      WHEN x < 3 THEN 'small'
      WHEN x < 10 THEN 'medium'
      ELSE 'large'
    END AS size
    FROM t6;
  }
} {2 small 3 medium 4 medium}

# Test 10: Subquery Enhancements
#
do_test modern-10.1 {
  execsql {
    SELECT * FROM t6 WHERE x IN (SELECT x FROM t6 WHERE x > 2);
  }
} {3 4}

do_test modern-10.2 {
  execsql {
    SELECT x, (SELECT COUNT(*) FROM t6) AS total FROM t6 LIMIT 1;
  }
} {2 3}

do_test modern-10.3 {
  execsql {
    SELECT * FROM t6 WHERE EXISTS (SELECT 1 FROM t1 WHERE grp = 'A');
  }
} {2 3 4}

do_test modern-10.4 {
  execsql {
    SELECT * FROM t6 WHERE NOT EXISTS (SELECT 1 FROM t1 WHERE grp = 'Z');
  }
} {2 3 4}

# Test 11: LIKE and GLOB Patterns
#
do_test modern-11.1 {
  execsql {
    DROP TABLE IF EXISTS t7;
    CREATE TABLE t7(name TEXT);
    INSERT INTO t7 VALUES('Alice'),('Bob'),('Charlie'),('David');
    SELECT * FROM t7 WHERE name LIKE 'A%';
  }
} {Alice}

do_test modern-11.2 {
  execsql {
    SELECT * FROM t7 WHERE name LIKE '%a%';
  }
} {Charlie}

do_test modern-11.3 {
  execsql {
    SELECT * FROM t7 WHERE name GLOB '*i*';
  }
} {Alice Charlie David}

# Test 12: BETWEEN Operator
#
do_test modern-12.1 {
  execsql {
    SELECT * FROM t6 WHERE x BETWEEN 2 AND 3;
  }
} {2 3}

do_test modern-12.2 {
  execsql {
    SELECT * FROM t6 WHERE x NOT BETWEEN 2 AND 3;
  }
} {4}

# Test 13: CAST Function
#
do_test modern-13.1 {
  execsql {
    SELECT CAST('123' AS INTEGER);
  }
} {123}

do_test modern-13.2 {
  execsql {
    SELECT CAST(123 AS TEXT);
  }
} {123}

do_test modern-13.3 {
  execsql {
    SELECT CAST(123.456 AS INTEGER);
  }
} {123}

do_test modern-13.4 {
  execsql {
    SELECT typeof(CAST(123 AS REAL));
  }
} {real}

# Test 14: Date/Time Functions
#
do_test modern-14.1 {
  # Test date function
  set result [execsql {SELECT date('2024-01-15');}]
  expr {$result == "2024-01-15"}
} {1}

do_test modern-14.2 {
  # Test time function
  set result [execsql {SELECT time('12:30:45');}]
  expr {$result == "12:30:45"}
} {1}

do_test modern-14.3 {
  # Test datetime function
  set result [execsql {SELECT datetime('2024-01-15 12:30:45');}]
  expr {$result == "2024-01-15 12:30:45"}
} {1}

# Test 15: Row Value Comparisons
#
do_test modern-15.1 {
  execsql {
    SELECT * FROM t6 WHERE (x, x+1) = (2, 3);
  }
} {2}

do_test modern-15.2 {
  execsql {
    SELECT * FROM t6 WHERE (x, x*2) IN ((2, 4), (3, 6));
  }
} {2 3}

# Test 16: Hexadecimal Integer Literals
#
do_test modern-16.1 {
  execsql {
    SELECT 0x10;
  }
} {16}

do_test modern-16.2 {
  execsql {
    SELECT 0xFF;
  }
} {255}

do_test modern-16.3 {
  execsql {
    SELECT 0x00;
  }
} {0}

# Test 17: Compound SELECT Statements
#
do_test modern-17.1 {
  execsql {
    SELECT x FROM t6 WHERE x < 4
    UNION
    SELECT val FROM t1 WHERE grp = 'A';
  }
} {2 3 10 20}

do_test modern-17.2 {
  execsql {
    SELECT x FROM t6 WHERE x < 4
    INTERSECT
    SELECT val FROM t1;
  }
} {}

do_test modern-17.3 {
  execsql {
    SELECT x FROM t6
    EXCEPT
    SELECT val FROM t1;
  }
} {2 3 4}

# Test 18: Multiple Table Aliases
#
do_test modern-18.1 {
  execsql {
    SELECT a.x, b.x FROM t6 AS a, t6 AS b WHERE a.x < b.x LIMIT 3;
  }
} {2 3 2 4 3 4}

# Test 19: Column Aliases in WHERE (Should Fail)
#
do_test modern-19.1 {
  catchsql {
    SELECT x AS y FROM t6 WHERE y > 2;
  }
} {1 {no such column: y}}

# Test 20: Column Aliases in ORDER BY (Should Work)
#
do_test modern-20.1 {
  execsql {
    SELECT x AS y FROM t6 ORDER BY y DESC;
  }
} {4 3 2}

finish_test
