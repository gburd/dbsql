/*
 * Phase 3 DML Opcode Implementations for VDBE
 * SQLite 3.52.0 register-based architecture
 *
 * This file contains implementations for:
 * 1. OP_NewRowid - Generate unique rowid
 * 2. OP_Insert - Insert record into table
 * 3. OP_Delete - Delete at current cursor position
 * 4. OP_MakeRecord - Pack registers into SQLite record format
 * 5. OP_IdxInsert - Insert into index
 *
 * Helper functions for varint encoding and serial type handling.
 */

/* ===============================================================
 * HELPER FUNCTIONS - Add these before __vdbe_exec()
 * =============================================================== */

/*
 * __vdbe_put_varint --
 *	Write a varint into z[] and return the number of bytes written.
 *	Matches sqlite3PutVarint() from SQLite 3.52.0.
 *
 * STATIC: static u8 __vdbe_put_varint __P((unsigned char *, u64));
 */
static u8
__vdbe_put_varint(unsigned char *p, u64 v)
{
	int i, j, n;
	u8 buf[10];
	if (v & (((u64)0xff000000)<<32)) {
		p[8] = (u8)v;
		v >>= 8;
		for(i=7; i>=0; i--) {
			p[i] = (u8)((v & 0x7f) | 0x80);
			v >>= 7;
		}
		return 9;
	}
	n = 0;
	do {
		buf[n++] = (u8)((v & 0x7f) | 0x80);
		v >>= 7;
	} while(v!=0);
	buf[0] &= 0x7f;
	for(i=0, j=n-1; j>=0; j--, i++) {
		p[i] = buf[j];
	}
	return n;
}

/*
 * __vdbe_varint_len --
 *	Return the number of bytes required to encode value v as a varint.
 *	Matches sqlite3VarintLen() from SQLite 3.52.0.
 *
 * STATIC: static int __vdbe_varint_len __P((u64));
 */
static int
__vdbe_varint_len(u64 v)
{
	int i;
	for(i=1; (v >>= 7)!=0; i++) {
		/* Intentionally empty */
	}
	return i;
}

/*
 * __vdbe_serial_type --
 *	Return the serial type for the value in pMem.
 *	Matches sqlite3VdbeSerialType() from SQLite 3.52.0.
 *
 * STATIC: static u32 __vdbe_serial_type __P((Mem *, int, u8 *));
 */
static u32
__vdbe_serial_type(Mem *pMem, int file_format, u8 *pnZero)
{
	int flags = pMem->flags;
	u32 n;
	i64 i;
	u64 u;

	if (pnZero) *pnZero = 0;

	if (flags & MEM_Null) {
		return 0;
	}
	if (flags & (MEM_Int|MEM_IntReal)) {
		i = pMem->u.i;
		if (i < 0) {
			u = ~i;
		} else {
			u = i;
		}
		if (u<=127) {
			if ((i&1)==i && file_format>=4) {
				return 8+(u32)u;
			}
			return 1;
		}
		if (u<=32767) return 2;
		if (u<=8388607) return 3;
		if (u<=2147483647) return 4;
		if (u<=140737488355327LL) return 5;
		return 6;
	}
	if (flags & MEM_Real) {
		return 7;
	}
	DBSQL_ASSERT(pMem->db->mallocFailed || (flags & (MEM_Str|MEM_Blob)));
	n = (u32)pMem->n;
	if (flags & MEM_Zero) {
		n += (u32)pMem->u.nZero;
		if (pnZero) *pnZero = (u8)pMem->u.nZero;
	}
	return ((n*2) + 12 + ((flags & MEM_Str)!=0));
}

/*
 * __vdbe_serial_type_len --
 *	Return the length of data corresponding to serial type.
 *	Matches sqlite3VdbeSerialTypeLen() from SQLite 3.52.0.
 *
 * STATIC: static u32 __vdbe_serial_type_len __P((u32));
 */
static u32
__vdbe_serial_type_len(u32 serial_type)
{
	if (serial_type>=12) {
		return (serial_type-12)/2;
	}
	static const u8 aSize[] = { 0, 1, 2, 3, 4, 6, 8, 8, 0, 0, 0, 0 };
	return aSize[serial_type];
}

/*
 * __vdbe_serial_put --
 *	Write the serialized data for a value into buf.
 *	Returns number of bytes written.
 *	Matches sqlite3VdbeSerialPut() from SQLite 3.52.0.
 *
 * STATIC: static u32 __vdbe_serial_put __P((u8 *, Mem *, u32));
 */
static u32
__vdbe_serial_put(u8 *buf, Mem *pMem, u32 serial_type)
{
	u32 len;
	u64 v;
	u32 i;

	if (serial_type<=7 && serial_type>0) {
		v = pMem->u.i;
		len = i = __vdbe_serial_type_len(serial_type);
		while(i--) {
			buf[i] = (u8)(v&0xFF);
			v >>= 8;
		}
		return len;
	}
	if (serial_type>=12) {
		len = __vdbe_serial_type_len(serial_type);
		if (pMem->flags & MEM_Zero) {
			len -= (u32)pMem->u.nZero;
		}
		if (len>0) {
			memcpy(buf, pMem->z, len);
		}
		return len;
	}
	return 0;
}


/* ===============================================================
 * OPCODE IMPLEMENTATIONS - Add these in __vdbe_exec() switch
 * =============================================================== */

/* Opcode: NewRowid P1 P2 P3 * *
** Synopsis: r[P2]=rowid
**
** Get a new integer rowid for cursor P1 and put it in register P2.
** If P3 is not zero, P3 is a register holding the largest previously
** generated rowid (for AUTOINCREMENT).
**
** The rowid generation uses a two-step algorithm:
** 1. Try to find the largest existing rowid and add one
** 2. If that fails (rowid = MAX_ROWID), use random selection
*/
case OP_NewRowid: {
	i64 v;
	VdbeCursor *pC;
	int res;
	int cnt;

	v = 0;
	res = 0;
	DBSQL_ASSERT(pOp->p1>=0 && pOp->p1<p->nCursor);
	pC = p->apCsr[pOp->p1];
	DBSQL_ASSERT(pC!=0);
	DBSQL_ASSERT(pC->isTable);
	DBSQL_ASSERT(pC->uc.pCursor!=0);

#define MAX_ROWID  (i64)( (((u64)0x7fffffff)<<32) | (u64)0xffffffff )

	if (!pC->useRandomRowid) {
		/* Try to use max(rowid)+1 */
		rc = __sm_last_ex(pC->uc.pCursor, &res);
		if (rc!=DBSQL_SUCCESS) {
			goto abort_due_to_error;
		}
		if (res) {
			v = 1;
		} else {
			v = __sm_integer_key(pC->uc.pCursor);
			if (v>=MAX_ROWID) {
				pC->useRandomRowid = 1;
			} else {
				v++;
			}
		}
	}

	/* P3 handling for AUTOINCREMENT */
	if (pOp->p3) {
		Mem *pMem;
		DBSQL_ASSERT(pOp->p3>0);
		pMem = &aMem[pOp->p3];
		DBSQL_ASSERT(pMem->flags & MEM_Int);
		if (pMem->u.i==MAX_ROWID || pC->useRandomRowid) {
			rc = DBSQL_FULL;
			goto abort_due_to_error;
		}
		if (v<pMem->u.i+1) {
			v = pMem->u.i + 1;
		}
		pMem->u.i = v;
	}

	if (pC->useRandomRowid) {
		/* Generate random rowid */
		cnt = 0;
		do {
			__dbsql_random_bytes(db, sizeof(v), &v);
			v &= (MAX_ROWID>>1);
			v++;
			rc = __sm_table_moveto(pC->uc.pCursor, (u64)v, 0, &res);
			cnt++;
		} while(rc==DBSQL_SUCCESS && res==0 && cnt<100);
		if (rc!=DBSQL_SUCCESS) goto abort_due_to_error;
		if (res==0) {
			rc = DBSQL_FULL;
			goto abort_due_to_error;
		}
	}

	pC->deferredMoveto = 0;
	pC->cacheStatus = CACHE_STALE;

	/* Store result in register P2 */
	aMem[pOp->p2].u.i = v;
	aMem[pOp->p2].flags = MEM_Int;
	break;
}

/* Opcode: Insert P1 P2 P3 P4 P5
** Synopsis: intkey=r[P3] data=r[P2]
**
** Write an entry into table of cursor P1. A new entry is created if
** it doesn't already exist or the data for an existing entry is
** overwritten. Data is the value in register P2. The key is in
** register P3 and must be an integer.
**
** P5 flags:
**  OPFLAG_NCHANGE (0x01) - increment change count
**  OPFLAG_LASTROWID (0x02) - set lastRowid
**  OPFLAG_USESEEKRESULT (0x10) - use seekResult optimization
**  OPFLAG_APPEND (0x08) - append to end
**  OPFLAG_SAVEPOSITION (0x02) - save cursor position
*/
case OP_Insert: {
	Mem *pData;
	Mem *pKey;
	VdbeCursor *pC;
	int seekResult;
	sm_payload_t x;
	int flags;

	pData = &aMem[pOp->p2];
	pKey = &aMem[pOp->p3];
	DBSQL_ASSERT(pOp->p1>=0 && pOp->p1<p->nCursor);
	DBSQL_ASSERT(pKey->flags & MEM_Int);
	pC = p->apCsr[pOp->p1];
	DBSQL_ASSERT(pC!=0);
	DBSQL_ASSERT(pC->uc.pCursor!=0);
	DBSQL_ASSERT(pC->isTable);

	/* Build payload structure */
	memset(&x, 0, sizeof(x));
	x.nKey = pKey->u.i;
	x.pKey = 0;  /* Table btrees use nKey as rowid */
	DBSQL_ASSERT((pData->flags & (MEM_Blob|MEM_Str))!=0 || pData->n==0);
	x.pData = pData->z;
	x.nData = pData->n;
	x.nZero = (pData->flags & MEM_Zero) ? pData->u.nZero : 0;

	/* Determine flags for __sm_insert_ex */
	seekResult = 0;
	flags = 0;
	if (pOp->p5 & 0x10) {  /* OPFLAG_USESEEKRESULT */
		seekResult = pC->seekResult;
	}
	if (pOp->p5 & 0x08) {  /* OPFLAG_APPEND */
		flags |= 0x08;  /* SM_INSERT_APPEND */
	}
	if (pOp->p5 & 0x02) {  /* OPFLAG_SAVEPOSITION */
		flags |= SM_DELETE_SAVEPOSITION;
	}

	rc = __sm_insert_ex(pC->uc.pCursor, &x, flags, seekResult);
	if (rc!=DBSQL_SUCCESS) goto abort_due_to_error;

	pC->deferredMoveto = 0;
	pC->cacheStatus = CACHE_STALE;

	/* Update change count and last rowid */
	if (pOp->p5 & 0x01) {  /* OPFLAG_NCHANGE */
		p->nChange++;
		if (pOp->p5 & 0x02) {  /* OPFLAG_LASTROWID */
			db->lastRowid = x.nKey;
		}
	}

	break;
}

/* Opcode: Delete P1 P2 * * P5
**
** Delete the record at which cursor P1 is currently pointing.
**
** P2 is a combination of flags:
**  0x01 (OPFLAG_NCHANGE) - increment change count
**  0x02 (OPFLAG_SAVEPOSITION) - save cursor position
**  0x04 (OPFLAG_AUXDELETE) - auxiliary delete operation
**
** P5 additional flags passed to __sm_delete_ex.
**
** If P2 has OPFLAG_NCHANGE set, the change counter is incremented.
** If OPFLAG_SAVEPOSITION is set, the cursor is moved to the next or
** previous entry after the delete.
*/
case OP_Delete: {
	VdbeCursor *pC;
	int opflags;

	opflags = pOp->p2;
	DBSQL_ASSERT(pOp->p1>=0 && pOp->p1<p->nCursor);
	pC = p->apCsr[pOp->p1];
	DBSQL_ASSERT(pC!=0);
	DBSQL_ASSERT(pC->uc.pCursor!=0);
	DBSQL_ASSERT(pC->deferredMoveto==0);

	rc = __sm_delete_ex(pC->uc.pCursor, pOp->p5);
	pC->cacheStatus = CACHE_STALE;
	pC->seekResult = 0;
	if (rc!=DBSQL_SUCCESS) goto abort_due_to_error;

	if (opflags & 0x01) {  /* OPFLAG_NCHANGE */
		p->nChange++;
	}

	break;
}

/* Opcode: MakeRecord P1 P2 P3 P4 P5
** Synopsis: r[P3]=mkrec(r[P1@P2])
**
** Convert P2 registers beginning with P1 into the SQLite record format
** and store the result in register P3.
**
** P4 is an optional string of length P2 that specifies column affinities:
**  'a' - BLOB (no conversion)
**  'b' - TEXT
**  'c' - NUMERIC
**  'd' - INTEGER
**  'e' - REAL
**
** P5: file format version (typically 4 for SQLite 3.3.0+)
**
** The record format is:
**  [varint: header size][varint: type0]...[varint: typeN-1][data0]...[dataN-1]
*/
case OP_MakeRecord: {
	u8 *zNewRecord;
	Mem *pRec;
	Mem *pData0;
	Mem *pLast;
	int nField;
	u64 nData;
	int nHdr;
	i64 nByte;
	u32 serial_type;
	int nVarint;
	u8 *zHdr;
	u8 *zPayload;
	int file_format;

	/* Identify input registers and output register */
	nField = pOp->p2;
	pData0 = &aMem[pOp->p1];
	pLast = &pData0[nField-1];
	Mem *pOut = &aMem[pOp->p3];

	DBSQL_ASSERT(nField>0);
	DBSQL_ASSERT(pOp->p1>0);
	DBSQL_ASSERT(pOp->p1+nField <= (p->nMem+1 - p->nCursor)+1);

	/* Apply column affinities if P4 is set */
	if (pOp->p4.z) {
		char *zAffinity = pOp->p4.z;
		pRec = pData0;
		while(pRec<=pLast && zAffinity[0]) {
			/* Simplified affinity application */
			/* Real implementation would call __vdbe_apply_affinity() */
			zAffinity++;
			pRec++;
		}
	}

	/* Calculate space needed */
	nData = 0;
	nHdr = 0;
	file_format = (pOp->p5 > 0) ? pOp->p5 : 1;

	pRec = pData0;
	while(pRec<=pLast) {
		serial_type = __vdbe_serial_type(pRec, file_format, 0);
		pRec->uTemp = serial_type;
		nHdr += __vdbe_varint_len(serial_type);
		nData += __vdbe_serial_type_len(serial_type);
		pRec++;
	}
	nVarint = __vdbe_varint_len(nHdr);
	nByte = nVarint + nHdr + nData;

	/* Allocate space */
	if (__dbsql_calloc(NULL, 1, nByte, &zNewRecord) == ENOMEM)
		goto no_mem;

	/* Write header size varint */
	zHdr = (u8*)zNewRecord;
	zPayload = zHdr + nVarint + nHdr;
	zHdr += __vdbe_put_varint(zHdr, nHdr + nVarint);

	/* Write serial types in header */
	pRec = pData0;
	while(pRec<=pLast) {
		serial_type = pRec->uTemp;
		zHdr += __vdbe_put_varint(zHdr, serial_type);
		pRec++;
	}

	/* Write data */
	pRec = pData0;
	while(pRec<=pLast) {
		serial_type = pRec->uTemp;
		zPayload += __vdbe_serial_put(zPayload, pRec, serial_type);
		pRec++;
	}

	/* Store result */
	__entity_release_mem(pOut);
	pOut->n = nByte;
	pOut->z = (char*)zNewRecord;
	pOut->flags = MEM_Blob | MEM_Dyn;
	pOut->xDel = 0;

	break;
}

/* Opcode: IdxInsert P1 P2 P3 P4 P5
** Synopsis: key=r[P2]
**
** Write an entry into index of cursor P1. The key is in register P2.
** P1 must be opened on an index cursor (not a table).
**
** P5 flags:
**  0x01 (OPFLAG_NCHANGE) - increment change count
**  0x08 (OPFLAG_APPEND) - append to end of index
**  0x02 (OPFLAG_SAVEPOSITION) - save cursor position
**  0x10 (OPFLAG_USESEEKRESULT) - use seekResult optimization
*/
case OP_IdxInsert: {
	VdbeCursor *pC;
	Mem *pKey;
	sm_payload_t x;
	int flags;

	DBSQL_ASSERT(pOp->p1>=0 && pOp->p1<p->nCursor);
	pC = p->apCsr[pOp->p1];
	DBSQL_ASSERT(pC!=0);
	DBSQL_ASSERT(!pC->isTable);
	pKey = &aMem[pOp->p2];
	DBSQL_ASSERT(pKey->flags & MEM_Blob);

	/* Build payload structure for index */
	memset(&x, 0, sizeof(x));
	x.pKey = pKey->z;
	x.nKey = pKey->n;
	x.pData = 0;
	x.nData = 0;
	x.nZero = 0;

	/* Determine flags */
	flags = 0;
	if (pOp->p5 & 0x08) flags |= 0x08;  /* APPEND */
	if (pOp->p5 & 0x02) flags |= SM_DELETE_SAVEPOSITION;

	rc = __sm_insert_ex(pC->uc.pCursor, &x, flags,
			    (pOp->p5 & 0x10) ? pC->seekResult : 0);

	if (rc!=DBSQL_SUCCESS) goto abort_due_to_error;

	pC->cacheStatus = CACHE_STALE;

	if (pOp->p5 & 0x01) {  /* OPFLAG_NCHANGE */
		p->nChange++;
	}

	break;
}
