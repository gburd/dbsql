diff --git a/src/os/os_aio_kqueue.c b/src/os/os_aio_kqueue.c
index cda35574..f9829e37 100644
--- a/src/os/os_aio_kqueue.c
+++ b/src/os/os_aio_kqueue.c
@@ -26,6 +26,12 @@
 
 #ifdef HAVE_AIO_KQUEUE
 
+/*
+ * libdb's dbinc/queue.h defines QUEUE_MACRO_DEBUG (to 0); FreeBSD's
+ * <sys/queue.h>, pulled in by <sys/event.h>, tests it with #ifdef and then
+ * hits a #warn directive that clang rejects.  Hide libdb's definition.
+ */
+#undef	QUEUE_MACRO_DEBUG
 #include <sys/event.h>
 #include <sys/types.h>
 #include <aio.h>
